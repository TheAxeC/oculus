diff --git a/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/published.ts b/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/published.ts
new file mode 100644
index 000000000..709fd4db0
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/published.ts
@@ -0,0 +1,60 @@
+// Layer 2, server. What a server publishes about a document, on its own or as the relay pulled it
+// (`textDocument/publishDiagnostics`, clangd's inactive regions): the message goes through the
+// entry's filter for the file's diagnostics, its addresses and versions are put back to the page's,
+// and it is sent to the channel the document was opened on, once under each name the page has for
+// the document.
+
+import type { DiagnosticView } from '../../servers.ts';
+import type { LspRpc, LspToPage } from '../../../../../data/model/index.ts';
+import type { Mapper, ServedRoot } from '../../uris.ts';
+import { toPage } from '../../uris.ts';
+import { isRecord } from '../../wire.ts';
+import { docKey, type Held, type Page } from '../held.ts';
+
+/** What the relay gives a published message's way to the page. */
+export type Publishing = {
+    roots(): readonly ServedRoot[];
+    catalog(): Record<string, string>;
+    mapper(page: Page, held: Held): Mapper;
+    send(page: Page, channel: string, payload: LspRpc | LspToPage): void;
+};
+
+/** The notifications about a document that reach the page. */
+export const PUBLISHED = ['textDocument/publishDiagnostics', 'textDocument/inactiveRegions'];
+
+/** Send the page a server's publication about a document. */
+export function publish(context: Publishing, held: Held, message: LspRpc): void {
+    const params = isRecord(message.params) ? message.params : {};
+    const page = held.owner as Page | null;
+    const named = isRecord(params.textDocument) ? params.textDocument.uri : params.uri;
+    const doc = held.docs.get(docKey(String(named)));
+    if (page === null || doc === undefined) return;
+    const view: DiagnosticView = {
+        real: doc.real,
+        text: doc.text,
+        root: held.root,
+        roots: context.roots(),
+        catalog: context.catalog()
+    };
+    const shown =
+        message.method === 'textDocument/publishDiagnostics' && held.entry.diagnostics
+            ? held.entry.diagnostics(params, view)
+            : message.params;
+    const mapped = toPage(held.pageVersions(shown), context.mapper(page, held));
+    if (mapped === null) return;
+    context.send(page, doc.channel, {
+        jsonrpc: '2.0',
+        method: message.method,
+        params: mapped.value
+    });
+    // The other names the page has for the document are told the same.
+    const first = isRecord(mapped.value) ? mapped.value.uri : undefined;
+    for (const [name, open] of page.docs) {
+        if (open.doc !== doc || name === first || !isRecord(mapped.value)) continue;
+        context.send(page, doc.channel, {
+            jsonrpc: '2.0',
+            method: message.method,
+            params: { ...mapped.value, uri: name }
+        });
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/pulls.ts b/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/pulls.ts
new file mode 100644
index 000000000..ee9b69ec1
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/held/diagnostics/pulls.ts
@@ -0,0 +1,81 @@
+// Layer 2, server. The diagnostics of a server that answers `textDocument/diagnostic` and publishes
+// nothing (the Markdown server). A document's diagnostics are asked for 500 ms after it was opened
+// or last changed, so typing is not followed by a request per key, and for every open document when
+// the server says its answers changed (`workspace/diagnostic/refresh`). An answer is published as
+// the `textDocument/publishDiagnostics` the page already reads, in the server's addresses, and is
+// dropped when the document was changed, closed or opened again while it was out, since the answer
+// is then about text other than the one the server holds.
+
+import type { LspRpc } from '../../../../../data/model/index.ts';
+import { docKey } from '../doc-key.ts';
+import type { Doc, Held } from '../held.ts';
+
+/** The milliseconds a document waits after its last open or change before it is asked about. */
+const PULL_MS = 500;
+
+export class Pulls {
+    #held: Held;
+    #publish: (message: LspRpc) => void;
+    #timers = new Map<string, ReturnType<typeof setTimeout>>();
+
+    constructor(held: Held, publish: (message: LspRpc) => void) {
+        this.#held = held;
+        this.#publish = publish;
+    }
+
+    /** Ask for a document's diagnostics 500 ms from now, in place of an ask already waiting. */
+    schedule(doc: Doc): void {
+        const key = docKey(doc.fileUri);
+        this.#forget(key);
+        const timer = setTimeout(() => {
+            this.#timers.delete(key);
+            void this.#pull(key);
+        }, PULL_MS);
+        if (typeof timer === 'object' && typeof timer.unref === 'function') timer.unref();
+        this.#timers.set(key, timer);
+    }
+
+    /** A document was closed: nothing is asked about it. */
+    forget(doc: Doc): void {
+        this.#forget(docKey(doc.fileUri));
+    }
+
+    /** Ask for the diagnostics of every open document now. */
+    all(): void {
+        for (const key of [...this.#held.docs.keys()]) {
+            this.#forget(key);
+            void this.#pull(key);
+        }
+    }
+
+    /** Ask about nothing more. */
+    clear(): void {
+        for (const timer of this.#timers.values()) clearTimeout(timer);
+        this.#timers.clear();
+    }
+
+    #forget(key: string): void {
+        const timer = this.#timers.get(key);
+        if (timer !== undefined) clearTimeout(timer);
+        this.#timers.delete(key);
+    }
+
+    async #pull(key: string): Promise<void> {
+        const doc = this.#held.docs.get(key);
+        if (doc === undefined) return;
+        const version = doc.version;
+        const answer = await this.#held.call('textDocument/diagnostic', {
+            textDocument: { uri: doc.fileUri }
+        });
+        if (this.#held.docs.get(key) !== doc || doc.version !== version) return;
+        const result = answer?.result;
+        if (answer?.error !== undefined || typeof result !== 'object' || result === null) return;
+        const items = (result as { items?: unknown }).items;
+        if (!Array.isArray(items)) return;
+        this.#publish({
+            jsonrpc: '2.0',
+            method: 'textDocument/publishDiagnostics',
+            params: { uri: doc.fileUri, version: doc.version, diagnostics: items }
+        });
+    }
+}
