@@ -0,0 +1,35 @@
+// Layer 2, server. The capabilities the page is told the Markdown server has for a language: every
+// provider of the server that VS Code's Markdown support uses, each with the selector of the
+// language. The registry passes how a provider is declared for a language (`serving`) and the
+// incremental synchronisation kind, so this file imports nothing from the registry.
+
+/** How the registry declares a provider for one language. */
+type Serving = (language: string, options?: Record<string, unknown>) => Record<string, unknown>;
+
+/** The characters Markdown completes after: a path after `](` or `<`, a heading after `#`. */
+const TRIGGERS = ['.', '/', '#', '(', '[', '<'];
+
+/** The capabilities of the Markdown server for one language. */
+export function markdownCapabilities(
+    language: string,
+    serving: Serving,
+    incremental: number
+): Record<string, unknown> {
+    return {
+        textDocumentSync: incremental,
+        hoverProvider: serving(language),
+        completionProvider: serving(language, { triggerCharacters: TRIGGERS }),
+        definitionProvider: serving(language),
+        referencesProvider: serving(language),
+        renameProvider: serving(language, { prepareProvider: true }),
+        documentSymbolProvider: serving(language),
+        workspaceSymbolProvider: serving(language),
+        foldingRangeProvider: serving(language),
+        selectionRangeProvider: serving(language),
+        codeActionProvider: serving(language, {
+            codeActionKinds: ['quickfix', 'refactor', 'source.organizeLinkDefinitions'],
+            resolveProvider: true
+        }),
+        documentLinkProvider: serving(language, { resolveProvider: true })
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/diagnostics.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/diagnostics.ts
new file mode 100644
index 000000000..3dfd8d710
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/diagnostics.ts
@@ -0,0 +1,68 @@
+// Layer 2, server. The diagnostics of a Markdown file as the page is shown them: the server's
+// marks for links to files that are not there, with the path inside the root in place of the
+// absolute path the server writes, and with every mark dropped whose path lies outside the root or
+// in a folder the server is never given; plus the entry's own mark for a backticked path that is
+// not there (backticks.ts). Both are worded by one catalog sentence, `source.md_no_such_path`.
+
+import { relative, sep } from 'node:path';
+import { words } from '../../../../core/words.ts';
+import type { DiagnosticView } from '../../servers.ts';
+import { resolvedPaths } from './backticks.ts';
+import { served } from './places.ts';
+
+/** The code of the server's mark for a link to a file that is not there. */
+const NO_SUCH_FILE = 'link.no-such-file';
+
+/** The code of the entry's mark for a backticked path that is not there. */
+const NO_SUCH_PATH = 'oculus.no-such-path';
+
+/** How the server's message starts; the absolute path follows. */
+const SERVER_PREFIX = 'File does not exist at path: ';
+
+/** The warning's severity in the protocol. */
+const WARNING = 2;
+
+/** The sentence for a path that is not there, or null when the catalog lacks it. */
+function noSuchPath(catalog: Record<string, string>, path: string): string | null {
+    return Object.hasOwn(catalog, 'source.md_no_such_path')
+        ? words(catalog, 'source.md_no_such_path', path)
+        : null;
+}
+
+/** The server's diagnostics of a file after the page's rules, and the entry's own. */
+export function markdownDiagnostics(
+    params: Record<string, unknown>,
+    view: DiagnosticView
+): Record<string, unknown> {
+    const reach = { root: view.root, roots: view.roots };
+    const given: unknown[] = Array.isArray(params.diagnostics) ? params.diagnostics : [];
+    const kept = given.flatMap((one) => {
+        const mark = one as { code?: unknown; message?: unknown };
+        if (mark.code !== NO_SUCH_FILE) return [one];
+        const message = typeof mark.message === 'string' ? mark.message : '';
+        const path = message.startsWith(SERVER_PREFIX) ? message.slice(SERVER_PREFIX.length) : '';
+        if (path === '' || !served(path, reach)) return [];
+        const shown = noSuchPath(view.catalog, relative(view.root.real, path).split(sep).join('/'));
+        if (shown === null) return [];
+        // The server's note on the mark holds the absolute path of the file, which nothing uses.
+        const { data: _note, ...rest } = one as Record<string, unknown>;
+        return [{ ...rest, message: shown }];
+    });
+    const own = resolvedPaths(view.text, view.real, reach).flatMap((span) => {
+        const message = span.kind === 'none' ? noSuchPath(view.catalog, span.path) : null;
+        if (message === null) return [];
+        return [
+            {
+                range: {
+                    start: { line: span.line, character: span.start },
+                    end: { line: span.line, character: span.end }
+                },
+                severity: WARNING,
+                code: NO_SUCH_PATH,
+                source: 'oculus',
+                message
+            }
+        ];
+    });
+    return { ...params, diagnostics: [...kept, ...own] };
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/places.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/places.ts
new file mode 100644
index 000000000..59f7538c3
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/places.ts
@@ -0,0 +1,137 @@
+// Layer 2, server. Which files of this machine the Markdown server may be given, and how its files
+// are listed. The server runs with no read access beyond its own packages, so every file it looks
+// at goes through the requests answered here (requests.ts), and each one asks first whether the
+// file is in the server's root, is not the machine's own `local.yml`, and does not lie in the
+// hub's `secrets` folder or in `~/.oculus`, whatever letter case names it.
+
+import { readdir, stat } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { inside, realPath } from '../../../../core/paths.ts';
+import type { ServedRoot } from '../../uris.ts';
+import { isMachineFile, isPrivateFile } from '../yaml/machine-file.ts';
+
+/** The roots a path is judged against: the root of the server, and every served root. */
+export type Reach = { root: ServedRoot; roots: readonly ServedRoot[] };
+
+/** The folders a walk for files never enters. */
+const SKIPPED = ['node_modules'];
+
+/**
+ * The real path of a path that may not exist: the nearest folder above it that does, resolved,
+ * with the rest of the path put back. A link that leaves the root through a link is outside it.
+ */
+function resolved(path: string): string {
+    const full = resolve(path);
+    let head = full;
+    const tail: string[] = [];
+    while (realPath(head, true) === null && dirname(head) !== head) {
+        tail.unshift(head.slice(dirname(head).length + 1));
+        head = dirname(head);
+    }
+    return join(realPath(head, true) ?? head, ...tail);
+}
+
+/** Whether a real path is a file the server is never given. */
+export function withheld(real: string, reach: Reach): boolean {
+    return isMachineFile(real, reach.roots) || isPrivateFile(real, reach.roots);
+}
+
+/** Whether a real path is in the root and is not withheld. */
+export function served(real: string, reach: Reach): boolean {
+    return inside(real, reach.root.real) && !withheld(real, reach);
+}
+
+/** The real path of a `file:` address the server may be given, or null for any other. */
+export function reachable(uri: unknown, reach: Reach): string | null {
+    if (typeof uri !== 'string' || !uri.startsWith('file:')) return null;
+    let path: string;
+    try {
+        path = fileURLToPath(uri);
+    } catch {
+        return null;
+    }
+    const real = resolved(path);
+    return served(real, reach) ? real : null;
+}
+
+/** Whether a file name ends in one of the extensions, which are compared in lower case. */
+function hasExtension(name: string, extensions: readonly string[]): boolean {
+    const at = name.lastIndexOf('.');
+    return at > 0 && extensions.includes(name.slice(at + 1).toLowerCase());
+}
+
+/**
+ * The Markdown files of a root, as real paths: the folders are read one at a time without
+ * blocking the process, a folder whose name starts with a dot, `node_modules`, a link to a folder
+ * and everything withheld are left out.
+ */
+export async function markdownFiles(
+    reach: Reach,
+    extensions: readonly string[]
+): Promise<string[]> {
+    const found: string[] = [];
+    const folders = [reach.root.real];
+    for (let folder = folders.pop(); folder !== undefined; folder = folders.pop()) {
+        let entries;
+        try {
+            entries = await readdir(folder, { withFileTypes: true });
+        } catch {
+            continue;
+        }
+        for (const entry of entries) {
+            const path = join(folder, entry.name);
+            if (entry.isDirectory()) {
+                if (
+                    !entry.name.startsWith('.') &&
+                    !SKIPPED.includes(entry.name) &&
+                    !withheld(path, reach)
+                ) {
+                    folders.push(path);
+                }
+            } else if (entry.isFile() && hasExtension(entry.name, extensions)) {
+                if (!withheld(path, reach)) found.push(path);
+            }
+        }
+    }
+    return found.sort();
+}
+
+/** What a stat of a path says, or null for a path that is not served or not there. */
+async function infoOf(
+    path: string,
+    reach: Reach
+): Promise<{ isDirectory: boolean; size: number } | null> {
+    const real = resolved(path);
+    if (!served(real, reach)) return null;
+    try {
+        const info = await stat(real);
+        return { isDirectory: info.isDirectory(), size: info.size };
+    } catch {
+        return null;
+    }
+}
+
+/** What a stat of a served address says, or null for one that is not served or not there. */
+export async function statOf(
+    uri: unknown,
+    reach: Reach
+): Promise<{ isDirectory: boolean; size: number } | null> {
+    const real = reachable(uri, reach);
+    return real === null ? null : infoOf(real, reach);
+}
+
+/** The entries of a served folder with whether each is a folder; withheld ones are left out. */
+export async function listing(
+    uri: unknown,
+    reach: Reach
+): Promise<[string, { isDirectory: boolean }][]> {
+    const real = reachable(uri, reach);
+    if (real === null) throw new Error('the folder is not one the server may read');
+    const listed: [string, { isDirectory: boolean }][] = [];
+    for (const name of await readdir(real)) {
+        const info = await infoOf(join(real, name), reach);
+        if (info !== null) listed.push([name, { isDirectory: info.isDirectory }]);
+    }
+    return listed;
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/requests.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/requests.ts
new file mode 100644
index 000000000..c2ba95c85
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/requests.ts
@@ -0,0 +1,77 @@
+// Layer 2, server. The requests the Markdown server makes of its client, answered in the oculus
+// process: it runs with no read access beyond its own packages, so it asks for the parse of a text,
+// the bytes of a file, the kind of a path, the entries of a folder, the Markdown files of the
+// workspace, and watchers for the paths its links lead to. Every path is judged first by places.ts:
+// only a file in the server's root that is not withheld is read, listed or watched, and a file over
+// the text limit is refused. A watcher is followed by the held server (held/requests/followed.ts)
+// and each change under it is asked of the server as `markdown/fs/watcher/onChange`.
+
+import { readFile, stat } from 'node:fs/promises';
+import { pathToFileURL } from 'node:url';
+import MarkdownIt from 'markdown-it';
+import { TEXT_LIMIT } from '../../../../../data/file-ops.ts';
+import type { ServerAsk } from '../../servers.ts';
+import { listing, markdownFiles, reachable, statOf } from './places.ts';
+
+/** The tokens of a text, as the server reads them; raw HTML is parsed as VS Code's preview does. */
+const parser = new MarkdownIt({ html: true });
+
+/** A non-empty text of a request's parameter, or undefined. */
+function textOf(value: unknown): string | undefined {
+    return typeof value === 'string' && value !== '' ? value : undefined;
+}
+
+/** The parameters of a request, as a record. */
+function paramsOf(params: unknown): Record<string, unknown> {
+    return typeof params === 'object' && params !== null ? (params as Record<string, unknown>) : {};
+}
+
+/** The bytes of a served file, refused when it is over the text limit before they are read. */
+async function bytesOf(uri: unknown, ask: ServerAsk): Promise<Buffer> {
+    const real = reachable(uri, ask);
+    if (real === null) throw new Error('the file is not one the server may read');
+    if ((await stat(real)).size > TEXT_LIMIT) throw new Error('the file is too large to read');
+    const bytes = await readFile(real);
+    if (bytes.length > TEXT_LIMIT) throw new Error('the file is too large to read');
+    return bytes;
+}
+
+/** The handlers of the Markdown server's requests, for files with these extensions. */
+export function markdownRequests(
+    extensions: () => string[]
+): Readonly<Record<string, (params: unknown, ask: ServerAsk) => unknown>> {
+    return {
+        'markdown/parse': async (params, ask) => {
+            const { uri, text } = paramsOf(params);
+            const source = typeof text === 'string' ? text : (await bytesOf(uri, ask)).toString();
+            return parser.parse(source, {});
+        },
+        'markdown/fs/readFile': async (params, ask) => [
+            ...(await bytesOf(paramsOf(params).uri, ask))
+        ],
+        'markdown/fs/stat': async (params, ask) => {
+            const info = await statOf(paramsOf(params).uri, ask);
+            return info === null ? null : { isDirectory: info.isDirectory };
+        },
+        'markdown/fs/readDirectory': (params, ask) => listing(paramsOf(params).uri, ask),
+        'markdown/findMarkdownFilesInWorkspace': async (_params, ask) =>
+            (await markdownFiles(ask, extensions())).map((real) => pathToFileURL(real).href),
+        'markdown/fs/watcher/create': (params, ask) => {
+            const { id, uri, watchParentDirs } = paramsOf(params);
+            const real = reachable(uri, ask);
+            const key = textOf(id) ?? (typeof id === 'number' ? String(id) : undefined);
+            if (real === null || key === undefined) return null;
+            ask.follow(key, real, watchParentDirs === true, (changed, kind) => ({
+                method: 'markdown/fs/watcher/onChange',
+                params: { id, uri: pathToFileURL(changed).href, kind }
+            }));
+            return null;
+        },
+        'markdown/fs/watcher/delete': (params, ask) => {
+            const { id } = paramsOf(params);
+            const key = textOf(id) ?? (typeof id === 'number' ? String(id) : undefined);
+            if (key !== undefined) ask.unfollow(key);
+            return null;
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/rewrite.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/rewrite.ts
new file mode 100644
index 000000000..77c4afcf3
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/rewrite.ts
@@ -0,0 +1,102 @@
+// Layer 2, server. The edits of a move for the backticked paths of a Markdown text. The Markdown
+// server rewrites the links that lead to a moved file or folder (`markdown/getEditForFileRenames`)
+// and knows nothing of backticks, so the paths that were written as `docs/DATA.md:3` are rewritten
+// here, in the form they were written in: from the root, or from the folder of the file.
+//
+// The move has happened when this is asked, so the rule of backticks.ts is run over the disk as it
+// was before: a place under a moved item was there if the item is there now, and a place under a
+// new place was not. A path that led to something that moved leads to its new place, written again
+// the way it was written; the file's own folder is its old folder when the file itself moved.
+
+import { readdirSync } from 'node:fs';
+import { basename, dirname, relative, sep } from 'node:path';
+import { normal } from '../../uris.ts';
+import { diskGround, resolvedPaths, type Ground, type Kind } from './backticks.ts';
+import type { Reach } from './places.ts';
+
+/** One item that moved, by real paths. */
+export type Moved = { from: string; to: string };
+
+/** A change of a text, in the protocol's form. */
+export type TextChange = {
+    range: { start: { line: number; character: number }; end: { line: number; character: number } };
+    newText: string;
+};
+
+/** Whether a path is another or lies under it. */
+function isUnder(path: string, folder: string): boolean {
+    return path === folder || path.startsWith(folder + sep);
+}
+
+/** The place a path went, or the path itself when no move touched it. */
+function after(path: string, moves: readonly Moved[]): string {
+    for (const { from, to } of moves) {
+        if (isUnder(path, from)) return to + path.slice(from.length);
+    }
+    return path;
+}
+
+/** The place a path was before the moves, or the path itself when no move touched it. */
+function before(path: string, moves: readonly Moved[]): string {
+    for (const { from, to } of moves) {
+        if (isUnder(path, to)) return from + path.slice(to.length);
+    }
+    return path;
+}
+
+/** The disk as it was before the moves. */
+function groundBefore(reach: Reach, moves: readonly Moved[]): Ground {
+    const now = diskGround(reach.root.real);
+    const base = reach.root.real;
+    const kind = (path: string): Kind => {
+        for (const move of moves) {
+            if (isUnder(path, move.from)) return now.kind(move.to + path.slice(move.from.length));
+            if (isUnder(path, move.to)) return 'none';
+        }
+        return now.kind(path);
+    };
+    const topNow = new Set(readdirSync(base).map((one) => normal(one)));
+    const topBefore = new Set(topNow);
+    for (const { from, to } of moves) {
+        if (dirname(to) === base) topBefore.delete(normal(basename(to)));
+        if (dirname(from) === base) topBefore.add(normal(basename(from)));
+    }
+    return { kind, top: (name) => topBefore.has(normal(name)) };
+}
+
+/** The path written as a path written from a folder reads, with `/` and a closing `/` kept. */
+function written(target: string, folder: string, original: string): string {
+    const path = relative(folder, target).split(sep).join('/');
+    return original.endsWith('/') && !path.endsWith('/') ? `${path}/` : path;
+}
+
+/**
+ * The changes to the backticked paths of one text that the moves make wrong. `file` is the real
+ * path of the file now and `text` its text; the moves are real paths of items that were moved
+ * within the root.
+ */
+export function movedPathChanges(
+    text: string,
+    file: string,
+    reach: Reach,
+    moves: readonly Moved[]
+): TextChange[] {
+    const ground = groundBefore(reach, moves);
+    const wasAt = before(file, moves);
+    const changes: TextChange[] = [];
+    for (const span of resolvedPaths(text, wasAt, reach, ground)) {
+        if (span.real === null) continue;
+        const target = after(span.real, moves);
+        const folder = span.from === 'root' ? reach.root.real : dirname(file);
+        const path = written(target, folder, span.path);
+        if (path === span.path) continue;
+        changes.push({
+            range: {
+                start: { line: span.line, character: span.start },
+                end: { line: span.line, character: span.end }
+            },
+            newText: path
+        });
+    }
+    return changes;
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/scrub.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/scrub.ts
new file mode 100644
index 000000000..b8a0e4fed
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/scrub.ts
@@ -0,0 +1,31 @@
+// Layer 2, server. What the Markdown server writes into an answer that the page is not given: a
+// completion item or a hover quotes the file it leads to in the absolute path of this machine, in
+// its documentation text. The path inside the root stays, written relative to it, and a text that
+// holds a `file://` address afterwards (a file outside the root) is emptied.
+
+import type { ServedRoot } from '../../uris.ts';
+
+/** The methods whose answers quote the files they lead to. */
+const QUOTING = ['textDocument/completion', 'completionItem/resolve', 'textDocument/hover'];
+
+/** A text without the root's path in either of its spellings, or empty if it names another file. */
+function relativeText(text: string, root: ServedRoot): string {
+    const folder = root.real.endsWith('/') ? root.real : `${root.real}/`;
+    const bare = text.split(`file://${folder}`).join('').split(folder).join('');
+    return bare.includes('file://') ? '' : bare;
+}
+
+/** A value with the machine's paths taken out of every text in it. */
+function scrubbed(value: unknown, root: ServedRoot): unknown {
+    if (typeof value === 'string') return relativeText(value, root);
+    if (Array.isArray(value)) return value.map((one) => scrubbed(one, root));
+    if (typeof value !== 'object' || value === null) return value;
+    return Object.fromEntries(
+        Object.entries(value).map(([key, inner]) => [key, scrubbed(inner, root)])
+    );
+}
+
+/** The answer to a request of the page, without the paths of this machine in its texts. */
+export function markdownResults(method: string, result: unknown, root: ServedRoot): unknown {
+    return QUOTING.includes(method) ? scrubbed(result, root) : result;
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/settings.ts b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/settings.ts
new file mode 100644
index 000000000..9a7476cb9
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/adapters/markdown/settings.ts
@@ -0,0 +1,35 @@
+// Layer 2, server. What the Markdown server is told of its client: the extensions that make a file
+// Markdown, read from the `languages:` key of config/sources.yml, and the settings it reads once
+// after `initialized` (it never asks `workspace/configuration`). A link to a file that is not
+// there is a warning; a link to a heading or to a reference is not checked, since the server
