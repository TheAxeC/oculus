+import type { Adapter } from '../../servers.ts';
+
+export const markdownAdapter: Adapter = {
+    prepare(entry, env) {
+        return prepareBare(entry, env);
+    },
+
+    ...NO_CHOICE,
+    ...NO_APPROVAL
