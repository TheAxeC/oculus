+// Layer 2, server. What oculus answers to the workspace requests a host makes: the files and
+// folders of the app's scope (`oculus/workspace/fs`), the files a glob finds (`findFiles`), the
+// edit a `WorkspaceEdit` asks for (`applyEdit`), the file system watchers (`watch`, `unwatch` and
+// the `watched` notice back), the schemes the host serves text for (`content/register`) and the
+// documents (`readDocument`, which gives a file's text and the language of its name).
+//
+// Every URI is judged by the scope (scope.ts) before anything is read or written: one outside the
+// folders of the app's scope answers `outside`, a closed or private one `closed`, and a missing one
+// `missing`. A write keeps the file it replaces in the local history first, as a save does, and an
+// edit to files is written by the same chain a language server's edit uses (files/fs/lsp-edit.ts),
+// so a tab that holds the file follows and the history records it.
+
+import {
+    type Stats,
+    copyFileSync,
+    cpSync,
+    existsSync,
+    lstatSync,
+    mkdirSync,
+    readFileSync,
+    readdirSync,
+    renameSync,
+    rmSync,
+    statSync
+} from 'node:fs';
+import { matchesGlob } from 'node:path';
+import { z } from 'zod';
+import { languageOf } from '../../../../data/helpers/files/languages.ts';
+import { isWholeText } from '../../../../data/helpers/files/text-kind.ts';
+import { hashOf } from '../../../core/file-bytes.ts';
+import { writeBytesAtomic } from '../../../core/json.ts';
+import { keepCopy } from '../../../files/fs/history.ts';
+import { RootWatch, type FileChange } from '../../lsp/held/watch.ts';
+import { Refused, parsed, type HostHandler } from '../host/connection.ts';
+import type { HostTools } from './registry.ts';
+import { ToolsScope, type ScopeFile } from './scope.ts';
+
+/** VS Code's `FileType`. */
+const FILE = 1;
+const FOLDER = 2;
+const LINK = 64;
+
+const fsShape = z.object({
+    op: z.enum([
+        'readFile',
+        'readDocument',
+        'writeFile',
+        'stat',
+        'readDirectory',
+        'createDirectory',
+        'delete',
+        'rename',
+        'copy'
+    ]),
+    uri: z.string(),
+    target: z.string().optional(),
+    bytes: z.string().optional(),
+    recursive: z.boolean().default(false),
+    overwrite: z.boolean().default(false)
+});
+
+const globShape = z.object({ base: z.string().optional(), pattern: z.string() });
+
+const findShape = z.object({
+    include: globShape.nullable(),
+    exclude: globShape.nullable().optional(),
+    maxResults: z.number().int().min(0).default(0)
+});
+
+const editShape = z.object({
+    changes: z.record(
+        z.string(),
+        z.array(
+            z.object({
+                range: z.object({
+                    start: z.object({ line: z.number(), character: z.number() }),
+                    end: z.object({ line: z.number(), character: z.number() })
+                }),
+                newText: z.string()
+            })
+        )
+    ),
+    files: z
+        .array(
+            z.object({
+                kind: z.enum(['create', 'delete', 'rename']),
+                uri: z.string(),
+                to: z.string().optional(),
+                overwrite: z.boolean().default(false),
+                ignoreIfExists: z.boolean().default(false),
+                recursive: z.boolean().default(false)
+            })
+        )
+        .default([])
+});
+
+/** The most entries a `findFiles` walk visits. */
+const WALK_LIMIT = 200_000;
+
+/** The type of a path as VS Code's `FileType`, 64 added for a link. */
+function typeOf(path: string): number {
+    let own;
+    try {
+        own = lstatSync(path);
+    } catch {
+        return 0;
+    }
+    const kind = (info: Stats): number => (info.isFile() ? FILE : info.isDirectory() ? FOLDER : 0);
+    if (!own.isSymbolicLink()) return kind(own);
+    try {
+        return LINK + kind(statSync(path));
+    } catch {
+        return LINK;
+    }
+}
+
+/** What a watcher registered: where, and the test of a path under a root. */
+type Watching = { root: string; match: (relative: string) => boolean };
+
+/** The handlers and notices of the workspace requests of one host. */
+export function workspaceHandlers(host: HostTools): {
+    handlers: Record<string, HostHandler>;
+    stop: () => void;
+} {
+    const { scope } = host;
+    const watchers = new Map<string, Watching[]>();
+    const rootWatches = new Map<string, RootWatch>();
+    const base = new Set<string>();
+
+    const file = (uri: unknown, write = false, folder = false): ScopeFile => {
+        const app = host.app();
+        const found = write ? scope.resolveForWrite(app, uri) : scope.resolve(app, uri, folder);
+        if (!found.ok) throw new Refused(found.word);
+        return found.file;
+    };
+
+    /** The change log and history are fed by the same chain as a language server's edit. */
+    const keep = (real: string): void => {
+        const kept = keepCopy(scope.env.history(), real, 'save');
+        if (!kept.ok) throw new Refused('denied');
+    };
+
+    const read = (target: ScopeFile): Buffer => {
+        let info;
+        try {
+            info = statSync(target.real);
+        } catch {
+            throw new Refused('missing');
+        }
+        if (info.isDirectory()) throw new Refused('is_a_folder');
+        if (!info.isFile()) throw new Refused('closed');
+        if (info.size > scope.env.maxBytes()) throw new Refused('too_large');
+        try {
+            return readFileSync(target.real);
+        } catch {
+            throw new Refused('denied');
+        }
+    };
+
+    const ops: Record<string, (params: z.infer<typeof fsShape>) => unknown> = {
+        readFile: (params) => ({ bytes: read(file(params.uri)).toString('base64') }),
+        readDocument: (params) => {
+            const target = file(params.uri);
+            const bytes = read(target);
+            if (!isWholeText(bytes)) throw new Refused('binary');
+            return {
+                text: bytes.toString('utf8'),
+                languageId: languageOf(target.path, scope.env.languages())
+            };
+        },
+        stat: (params) => {
+            const target = file(params.uri, false, true);
+            const info = statSync(target.real);
+            const type = typeOf(target.real);
+            return {
+                type: type === 0 ? (info.isFile() ? FILE : FOLDER) : type,
+                ctime: info.ctimeMs,
+                mtime: info.mtimeMs,
+                size: info.size
+            };
+        },
+        readDirectory: (params) => {
+            const target = file(params.uri, false, true);
+            if (!statSync(target.real).isDirectory()) throw new Refused('not_a_folder');
+            const names: [string, number][] = [];
+            for (const entry of readdirSync(target.real, { withFileTypes: true })) {
+                if (names.length >= scope.env.scanEntries()) break;
+                if (entry.name.startsWith('.')) continue;
+                const child = scope.resolve(
+                    host.app(),
+                    ToolsScope.uriOf(`${target.real}/${entry.name}`),
+                    true
+                );
+                if (child.ok) names.push([entry.name, typeOf(child.file.real)]);
+            }
+            return names;
+        },
+        writeFile: (params) => {
+            const target = file(params.uri, true);
+            const bytes = Buffer.from(params.bytes ?? '', 'base64');
+            if (bytes.length > scope.env.maxBytes()) throw new Refused('too_large');
+            if (existsSync(target.real)) {
+                const before = read(target);
+                keep(target.real);
+                if (hashOf(before) === hashOf(bytes)) return null;
+            } else if (!existsSync(target.real.replace(/[^/]*$/, ''))) {
+                throw new Refused('missing');
+            }
+            try {
+                writeBytesAtomic(target.real, bytes);
+            } catch {
+                throw new Refused('denied');
+            }
+            return null;
+        },
+        createDirectory: (params) => {
+            const found = scope.resolveForCreate(host.app(), params.uri);
+            if (!found.ok) throw new Refused(found.word);
+            const target = found.file;
+            try {
+                mkdirSync(target.real, { recursive: true });
+            } catch {
+                throw new Refused('denied');
+            }
+            return null;
+        },
+        delete: (params) => {
+            const target = file(params.uri);
+            const info = lstatSync(target.real);
+            if (info.isDirectory() && !params.recursive) {
+                if (readdirSync(target.real).length > 0) throw new Refused('not_empty');
+            }
+            if (info.isFile()) keep(target.real);
+            try {
+                rmSync(target.real, { recursive: params.recursive, force: false });
+            } catch {
+                throw new Refused('denied');
+            }
+            return null;
+        },
+        rename: (params) => {
+            const from = file(params.uri);
+            const to = file(params.target, true);
+            if (existsSync(to.real) && !params.overwrite) throw new Refused('exists');
+            try {
+                renameSync(from.real, to.real);
+            } catch {
+                throw new Refused('denied');
+            }
+            return null;
+        },
+        copy: (params) => {
+            const from = file(params.uri);
+            const to = file(params.target, true);
+            if (existsSync(to.real) && !params.overwrite) throw new Refused('exists');
+            try {
+                if (lstatSync(from.real).isDirectory())
+                    cpSync(from.real, to.real, { recursive: true });
+                else copyFileSync(from.real, to.real);
+            } catch {
+                throw new Refused('denied');
+            }
+            return null;
+        }
+    };
+
+    /** The files under the roots of the scope that match a glob. */
+    const find = (params: z.infer<typeof findShape>): string[] => {
+        const app = host.app();
+        if (params.include === null) return [];
+        const limit = params.maxResults === 0 ? Infinity : params.maxResults;
+        const out: string[] = [];
+        let visited = 0;
+        const wanted = (
+            glob: { base?: string; pattern: string } | null | undefined,
+            root: string,
+            relative: string,
+            whole: string
+        ): boolean => {
+            if (glob === null || glob === undefined) return false;
+            const prefix = glob.base === undefined ? root : (ToolsScope.pathOf(glob.base) ?? root);
+            if (!whole.startsWith(`${prefix}/`)) return false;
+            try {
+                return matchesGlob(whole.slice(prefix.length + 1), glob.pattern);
+            } catch {
+                return relative === glob.pattern;
+            }
+        };
+        const walk = (root: string, folder: string, relative: string): void => {
+            if (out.length >= limit || visited > WALK_LIMIT) return;
+            let entries;
+            try {
+                entries = readdirSync(folder, { withFileTypes: true });
+            } catch {
+                return;
+            }
+            for (const entry of entries) {
+                visited += 1;
+                if (out.length >= limit || visited > WALK_LIMIT) return;
+                if (entry.name.startsWith('.')) continue;
+                const here = relative === '' ? entry.name : `${relative}/${entry.name}`;
+                const whole = `${folder}/${entry.name}`;
+                if (entry.isDirectory()) {
+                    if (entry.name !== 'node_modules' || params.exclude === undefined) {
+                        walk(root, whole, here);
+                    }
+                } else if (entry.isFile() && wanted(params.include, root, here, whole)) {
+                    if (params.exclude !== undefined && wanted(params.exclude, root, here, whole))
+                        continue;
+                    const found = scope.resolve(app, ToolsScope.uriOf(whole));
+                    if (found.ok) out.push(ToolsScope.uriOf(found.file.real));
+                }
+            }
+        };
+        for (const folder of scope.folders(app)) walk(folder.real, folder.real, '');
+        return out;
+    };
+
+    /** The watch of a root, made with the first watcher registered under it. */
+    const watchOf = (real: string): RootWatch => {
+        let watch = rootWatches.get(real);
+        if (watch === undefined) {
+            watch = new RootWatch({
+                root: real,
+                open: () => false,
+                changed: (changes) => tell(real, changes)
+            });
+            rootWatches.set(real, watch);
+        }
+        return watch;
+    };
+
+    /** The changes of a root, told to every watcher whose glob matches each. */
+    const tell = (real: string, changes: FileChange[]): void => {
+        for (const [id, list] of watchers) {
+            const events = changes.filter((change) => {
+                const path = ToolsScope.pathOf(change.uri);
+                if (!path?.startsWith(`${real}/`)) return false;
+                const relative = path.slice(real.length + 1);
+                return list.some((one) => one.root === real && one.match(relative));
+            });
+            if (events.length > 0) host.notify('oculus/workspace/watched', { id, events });
+        }
+    };
+
+    const handlers: Record<string, HostHandler> = {
+        'oculus/workspace/fs': (params) => {
+            host.app();
+            const body = parsed(fsShape, params);
+            return ops[body.op](body);
+        },
+        'oculus/workspace/findFiles': (params) => find(parsed(findShape, params)),
+        'oculus/workspace/applyEdit': async (params) => {
+            const app = host.app();
+            const body = parsed(editShape, params);
+            const files = [];
+            for (const [uri, edits] of Object.entries(body.changes)) {
+                const target = scope.resolve(app, uri);
+                if (!target.ok) return { applied: false, failureReason: target.word };
+                const bytes = read(target.file);
+                files.push({
+                    root: target.file.root.key,
+                    path: target.file.path,
+                    hash: hashOf(bytes),
+                    edits
+                });
+            }
+            // Every file operation is judged before any text is written, so a refused one leaves
+            // the files as they were.
+            for (const operation of body.files) {
+                const first =
+                    operation.kind === 'create'
+                        ? scope.resolveForWrite(app, operation.uri)
+                        : scope.resolve(app, operation.uri);
+                if (!first.ok) return { applied: false, failureReason: first.word };
+                if (operation.kind !== 'rename') continue;
+                const to = scope.resolveForWrite(app, operation.to);
+                if (!to.ok) return { applied: false, failureReason: to.word };
+            }
+            const done = files.length === 0 ? { ok: true as const } : await scope.env.edit(files);
+            if (!done.ok) return { applied: false, failureReason: done.error };
+            for (const operation of body.files) {
+                if (operation.kind === 'create') {
+                    const target = file(operation.uri, true);
+                    if (existsSync(target.real)) {
+                        if (operation.ignoreIfExists) continue;
+                        if (!operation.overwrite)
+                            return { applied: false, failureReason: 'exists' };
+                    }
+                    writeBytesAtomic(target.real, Buffer.alloc(0));
+                } else if (operation.kind === 'delete') {
+                    ops.delete({
+                        op: 'delete',
+                        uri: operation.uri,
+                        recursive: operation.recursive,
+                        overwrite: false
+                    });
+                } else {
+                    ops.rename({
+                        op: 'rename',
+                        uri: operation.uri,
+                        target: operation.to,
+                        recursive: false,
+                        overwrite: operation.overwrite
+                    });
+                }
+            }
+            return { applied: true };
+        },
+        'oculus/workspace/watch': (params) => {
+            const app = host.app();
+            const { id, glob } = parsed(
+                z.object({ id: z.string().min(1), glob: globShape.nullable() }),
+                params
+            );
+            if (glob === null || watchers.has(id)) throw new Refused('refused:params');
+            const entries: Watching[] = [];
+            for (const folder of scope.folders(app)) {
+                const prefix =
+                    glob.base === undefined ? null : (ToolsScope.pathOf(glob.base) ?? null);
+                if (
+                    prefix !== null &&
+                    prefix !== folder.real &&
+                    !prefix.startsWith(`${folder.real}/`)
+                ) {
+                    continue;
+                }
+                const under =
+                    prefix === null || prefix === folder.real
+                        ? ''
+                        : `${prefix.slice(folder.real.length + 1)}/`;
+                const match = (relative: string): boolean => {
+                    if (under !== '' && !relative.startsWith(under)) return false;
+                    try {
+                        return matchesGlob(relative.slice(under.length), glob.pattern);
+                    } catch {
+                        return false;
+                    }
+                };
+                entries.push({ root: folder.real, match });
+                watchOf(folder.real).registerMatch(id, (relative) =>
+                    entries.some((one) => one.root === folder.real && one.match(relative))
+                );
+            }
+            watchers.set(id, entries);
+            return null;
+        },
+        'oculus/workspace/unwatch': (params) => {
+            const { id } = parsed(z.object({ id: z.string().min(1) }), params);
+            const list = watchers.get(id);
+            watchers.delete(id);
+            for (const one of list ?? []) rootWatches.get(one.root)?.unregister(id);
+            return null;
+        },
+        'oculus/workspace/content/register': (params) => {
+            const { scheme } = parsed(
+                z.object({ scheme: z.string().regex(/^[a-z][a-z0-9+.-]*$/) }),
+                params
+            );
+            if (scheme === 'file' || base.has(scheme)) throw new Refused('refused:registered');
+            base.add(scheme);
+            host.schemes(scheme, true);
+            return null;
+        },
+        'oculus/workspace/content/unregister': (params) => {
+            const { scheme } = parsed(z.object({ scheme: z.string() }), params);
+            base.delete(scheme);
+            host.schemes(scheme, false);
+            return null;
+        },
+        'oculus/workspace/saveAll': async () => {
+            host.app();
+            return host.saveAll();
+        }
+    };
+    return {
+        handlers,
+        stop: () => {
+            for (const watch of rootWatches.values()) watch.close();
+            rootWatches.clear();
+            watchers.clear();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/app/adapter.ts b/tools/oculus/src/lib/server/machine/debug/app/adapter.ts
new file mode 100644
index 000000000..ed004b287
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/app/adapter.ts
@@ -0,0 +1,67 @@
+// Layer 2, server. One debug adapter as the client holds it, whatever carries its messages: the
+// child process of the oculus adapter (`rite_dap`, its messages framed on the standard streams) or
+// the stream an app's host opened for its debugger's adapter (its messages as objects). The client
+// speaks the protocol to the `wire` and learns of the adapter's end, its error text and its
+// failure through the listeners; what ends the adapter (a signal to the child, the close of the
+// stream) is `kill`.
+
+import type { Child } from '../../lsp/held/process.ts';
+import { openCarrier, openWire, type Wire, type WireHandlers } from '../wire.ts';
+import type { AppCarrier } from './port.ts';
+
+/** One adapter. */
+export type Adapter = {
+    readonly kind: 'rite' | 'app';
+    /** The process id of the oculus adapter, 0 for an app's. */
+    readonly pid: number;
+    readonly wire: Wire;
+    /** Hear the text the adapter writes outside the protocol. */
+    onStderr(listener: (text: string) => void): void;
+    /** Hear the adapter end: its exit code and the signal that ended it. */
+    onExit(listener: (code: number | null, signal: NodeJS.Signals | null) => void): void;
+    /** Hear that the adapter could not be started or broke. */
+    onError(listener: (error: unknown) => void): void;
+    /** End the adapter: a signal to the child, or the close of the stream. */
+    kill(signal: 'SIGTERM' | 'SIGKILL'): void;
+};
+
+/** The oculus adapter as a spawned child. */
+export function childAdapter(child: Child, handlers: WireHandlers): Adapter {
+    child.stdin.on('error', () => undefined);
+    return {
+        kind: 'rite',
+        pid: child.pid ?? 0,
+        wire: openWire(child.stdout, child.stdin, handlers),
+        onStderr: (listener) =>
+            child.stderr.on('data', (chunk: Buffer | string) => listener(String(chunk))),
+        onExit: (listener) => child.on('exit', listener),
+        onError: (listener) => child.on('error', listener),
+        kill: (signal) => void child.kill(signal)
+    };
+}
+
+/** An app's adapter as the stream its host opened. */
+export function carrierAdapter(carrier: AppCarrier, handlers: WireHandlers): Adapter {
+    return {
+        kind: 'app',
+        pid: 0,
+        wire: openCarrier(
+            {
+                write: (message) => {
+                    carrier.send(message);
+                    return Promise.resolve();
+                },
+                listen: (listener) =>
+                    carrier.onMessage((message) => listener(message as unknown as never)),
+                onError: () => undefined,
+                onPartial: () => undefined,
+                dispose: () => undefined
+            },
+            handlers
+        ),
+        onStderr: (listener) => carrier.onStderr(listener),
+        onExit: (listener) => carrier.onClose((code) => listener(code, null)),
+        onError: () => undefined,
+        kill: () => carrier.close()
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/app/capabilities.ts b/tools/oculus/src/lib/server/machine/debug/app/capabilities.ts
new file mode 100644
index 000000000..060083188
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/app/capabilities.ts
@@ -0,0 +1,93 @@
+// Layer 2, server. What an adapter declares in its answer to `initialize`, read through a shape
+// and turned into the capabilities the controls follow (`DebugCapabilities`). The oculus adapter's
+// capabilities are fixed: it offers function breakpoints and the evaluation of an expression on
+// hover, and none of the rest. An adapter that sends a body that does not read declares nothing.
+
+import { z } from 'zod';
+import type { DebugCapabilities } from '../../../../data/model/index.ts';
+
+const filterShape = z.object({
+    filter: z.string(),
+    label: z.string().default(''),
+    default: z.boolean().optional(),
+    supportsCondition: z.boolean().optional()
+});
+
+/** The body of the `initialize` response, with the fields the client reads. */
+const capabilitiesShape = z
+    .object({
+        supportsConfigurationDoneRequest: z.boolean().optional(),
+        supportsFunctionBreakpoints: z.boolean().optional(),
+        supportsConditionalBreakpoints: z.boolean().optional(),
+        supportsHitConditionalBreakpoints: z.boolean().optional(),
+        supportsLogPoints: z.boolean().optional(),
+        supportsEvaluateForHovers: z.boolean().optional(),
+        supportsSetVariable: z.boolean().optional(),
+        supportsRestartRequest: z.boolean().optional(),
+        supportsTerminateRequest: z.boolean().optional(),
+        supportsCompletionsRequest: z.boolean().optional(),
+        supportsLoadedSourcesRequest: z.boolean().optional(),
+        supportsPauseRequest: z.boolean().optional(),
+        exceptionBreakpointFilters: z.array(filterShape).optional()
+    })
+    .loose();
+
+/** What the client needs of the answer beyond the controls: whether `configurationDone` is sent. */
+export type Declared = DebugCapabilities & { configurationDone: boolean };
+
+/** The type name the oculus adapter's capabilities are held under. */
+export const RITE = 'rite';
+
+/** The capabilities of the oculus adapter. */
+export const RITE_CAPABILITIES: Declared = {
+    pause: false,
+    conditions: false,
+    hitConditions: false,
+    logpoints: false,
+    functions: true,
+    functionConditions: false,
+    setVariable: false,
+    restart: false,
+    terminate: false,
+    hover: true,
+    completions: false,
+    loadedSources: false,
+    exceptionFilters: [],
+    configurationDone: true
+};
+
+/** The capabilities an adapter's body declares; none when the body does not read. */
+export function declaredBy(body: unknown): Declared {
+    const read = capabilitiesShape.safeParse(body ?? {});
+    const caps = read.success ? read.data : {};
+    return {
+        pause: caps.supportsPauseRequest === true,
+        conditions: caps.supportsConditionalBreakpoints === true,
+        hitConditions: caps.supportsHitConditionalBreakpoints === true,
+        logpoints: caps.supportsLogPoints === true,
+        functions: caps.supportsFunctionBreakpoints === true,
+        functionConditions:
+            caps.supportsFunctionBreakpoints === true &&
+            caps.supportsConditionalBreakpoints === true,
+        setVariable: caps.supportsSetVariable === true,
+        restart: caps.supportsRestartRequest === true,
+        terminate: caps.supportsTerminateRequest === true,
+        hover: caps.supportsEvaluateForHovers === true,
+        completions: caps.supportsCompletionsRequest === true,
+        loadedSources: caps.supportsLoadedSourcesRequest === true,
+        exceptionFilters: (caps.exceptionBreakpointFilters ?? []).map((one) => ({
+            filter: one.filter,
+            label: one.label === '' ? one.filter : one.label,
+            enabled: one.default === true,
+            supportsCondition: one.supportsCondition === true
+        })),
+        configurationDone: caps.supportsConfigurationDoneRequest === true
+    };
+}
+
+/** The capabilities as published, without the field only the client reads. */
+export function shown(declared: Declared): DebugCapabilities {
+    return Object.fromEntries(
+        Object.entries(declared).filter(([key]) => key !== 'configurationDone')
+    ) as unknown as DebugCapabilities;
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/app/ends.ts b/tools/oculus/src/lib/server/machine/debug/app/ends.ts
new file mode 100644
index 000000000..86289dbd1
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/app/ends.ts
@@ -0,0 +1,50 @@
+// Layer 2, server. The sentences a session ends with, from what is known when it does: the
+// adapter's messages did not read, a request failed, the adapter exited with a code or a signal,
+// the reader stopped it, or an app's adapter lost its stream.
+
+import { words } from '../../../core/words.ts';
+import type { WireFailure } from '../wire.ts';
+
+/** How a session's end is worded in the console: as news or as an error. */
+export type EndKind = 'console' | 'error';
+
+/** The sentence for bytes of the adapter that did not read. */
+export function failureText(catalog: Record<string, string>, failure: WireFailure): string {
+    return {
+        'bad-header': words(catalog, 'server.debug.bad_header'),
+        'not-json': words(catalog, 'server.debug.not_json'),
+        'not-message': words(catalog, 'server.debug.not_message'),
+        partial: words(catalog, 'server.debug.partial')
+    }[failure];
+}
+
+/** What is known of an adapter that ended. */
+export type Exit = {
+    failure: string | null;
+    stopping: boolean;
+    /** Whether the adapter itself said the program ended. */
+    ended: boolean;
+    /** Whether the adapter is an app's, whose stream reports no exit status. */
+    app: boolean;
+    code: number | null;
+    signal: NodeJS.Signals | null;
+};
+
+/** The sentence an exit ends the session with, and how it is worded. */
+export function exitText(
+    catalog: Record<string, string>,
+    exit: Exit
+): { text: string; kind: EndKind } {
+    if (exit.failure !== null) return { text: exit.failure, kind: 'error' };
+    if (exit.stopping) return { text: words(catalog, 'server.debug.stopped'), kind: 'console' };
+    if (exit.signal !== null) {
+        return { text: words(catalog, 'server.debug.signal', exit.signal), kind: 'error' };
+    }
+    if (exit.code !== null && exit.code !== 0) {
+        return { text: words(catalog, 'server.debug.exit_code', exit.code), kind: 'error' };
+    }
+    if (exit.app && exit.code === null && !exit.ended) {
+        return { text: words(catalog, 'server.debug.adapter_lost'), kind: 'error' };
+    }
+    return { text: words(catalog, 'server.debug.finished'), kind: 'console' };
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/app/filters.ts b/tools/oculus/src/lib/server/machine/debug/app/filters.ts
new file mode 100644
index 000000000..ef69f1f84
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/app/filters.ts
@@ -0,0 +1,58 @@
+// Layer 2, server. The exception breakpoint filters of a session and what the reader switched on.
+// An adapter declares its filters in its answer to `initialize` (a label, whether one is on by
+// default, whether it takes a condition). The reader's choice is kept for the next session of the
+// same debugger type, so a filter switched on stays on; before any choice the adapter's defaults
+// stand.
+
+import type { DebugCapabilities, DebugExceptionFilter } from '../../../../data/model/index.ts';
+
+/** The filters of the current session and the choice per debugger type. */
+export class Filters {
+    #list: DebugExceptionFilter[] = [];
+    readonly #chosen = new Map<string, Map<string, string>>();
+
+    /** The filters as published. */
+    list(): DebugExceptionFilter[] {
+        return this.#list;
+    }
+
+    /** The session ended or a new one starts: no filters until an adapter declares some. */
+    clear(): void {
+        this.#list = [];
+    }
+
+    /**
+     * An adapter of a type declared its filters: the reader's earlier choice, else the defaults.
+     */
+    declare(type: string, declared: DebugCapabilities): void {
+        const chosen = this.#chosen.get(type);
+        this.#list = declared.exceptionFilters.map((one) => ({
+            ...one,
+            condition: chosen?.get(one.filter) ?? '',
+            enabled: chosen === undefined ? one.enabled : chosen.has(one.filter)
+        }));
+    }
+
+    /** The reader switched the filters named on, each with its condition, and the rest off. */
+    choose(type: string, on: { filter: string; condition?: string }[]): void {
+        const chosen = new Map(on.map((one) => [one.filter, one.condition ?? '']));
+        this.#chosen.set(type, chosen);
