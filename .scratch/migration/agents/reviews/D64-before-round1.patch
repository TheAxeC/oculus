+        this.from = item;
+        this.fromRanges = fromRanges;
+    }
+}
+
+export class CallHierarchyOutgoingCall {
+    constructor(item, fromRanges) {
+        this.to = item;
+        this.fromRanges = fromRanges;
+    }
+}
+
+export class TypeHierarchyItem {
+    constructor(kind, name, detail, uri, range, selectionRange) {
+        this.kind = kind;
+        this.name = name;
