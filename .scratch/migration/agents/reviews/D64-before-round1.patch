index 000000000..94d7e14ce
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/run/stream-terminals.ts
@@ -0,0 +1,318 @@
+// Layer 2, server. The terminals whose bytes are a `terminal` stream to an app's host: the
+// `{ name, pty }` terminals of `window.createTerminal` and the custom executions of tasks. They are
+// listed beside tmux's terminals and attach to the same `pty:<id>` channels (pty/channel.ts takes
+// this module as its `StreamTerminals`), so a page draws, moves, splits and closes them as any
+// terminal.
+//
+// The server keeps the last `RING_BYTES` the stream wrote, which a page that attaches or reloads is
+// painted from, as a tmux pane's capture is. What the pages type is written to the stream as bytes
+// (the host's `Pseudoterminal.handleInput`), and the terminal's size is the smallest of the sizes
+// the pages that show it reported, sent as the stream's control message. The bytes of a stream
+// are taken by the listeners one chunk at a time, and the credit for a chunk goes back to the host
+// when they settle, so a page that does not read holds the host and not the server's memory.
+//
+// A terminal ends when the host ends its stream or the host stops. It stays in the list with the
+// code it ended with and a line saying so in its output, until a reader closes it.
+
+import { randomBytes } from 'node:crypto';
+import type { Terminal, TerminalJob } from '../../../../../data/model/index.ts';
+import type { StreamTerminals } from '../../../pty/channel.ts';
+import type { AppStream } from '../streams.ts';
+
+/** The most bytes of a terminal's output the server keeps. */
+const RING_BYTES = 1024 * 1024;
+
+/** What a terminal needs to be made. */
+export type StreamTerminalInit = {
+    app: string;
+    name: string;
+    cwd: string;
+    stream: AppStream;
+    /** The task it runs, when a task made it. */
+    job?: TerminalJob;
+    /** The line written when it ends: the sentence for a code. */
+    ended: (code: number) => string;
+};
+
+type Entry = {
+    record: Terminal;
+    stream: AppStream;
+    chunks: Buffer[];
+    bytes: number;
+    sizes: Map<object, { cols: number; rows: number }>;
+    sent: { cols: number; rows: number } | null;
+    ended: (code: number) => string;
+    over: boolean;
+};
+
+/** What a task run has promised the terminal its host is about to open under a token. */
+export type Claim = {
+    /** The view id of the app whose host opens it. */
+    app: string;
+    /** The job the terminal is the run of. */
+    job: TerminalJob;
+    /** The row of an ended terminal the new stream takes over, for a run again. */
+    rebind?: string;
+    /** Called with the terminal's id once the stream is held. */
+    taken: (id: string) => void;
+};
+
+/** The stream terminals of every host. */
+export class StreamTerminalSet implements StreamTerminals {
+    readonly #entries = new Map<string, Entry>();
+    readonly #claims = new Map<string, Claim>();
+    readonly #changed: (() => void)[] = [];
+    readonly #output: ((id: string, bytes: Buffer) => void | Promise<void>)[] = [];
+    readonly #ringBytes: number;
+    readonly #now: () => Date;
+
+    constructor(ringBytes: number = RING_BYTES, now: () => Date = () => new Date()) {
+        this.#ringBytes = ringBytes;
+        this.#now = now;
+    }
+
+    list(): Terminal[] {
+        return [...this.#entries.values()].map((entry) => entry.record);
+    }
+
+    has(id: string): boolean {
+        return this.#entries.has(id);
+    }
+
+    onChange(listener: () => void): void {
+        this.#changed.push(listener);
+    }
+
+    onOutput(listener: (id: string, bytes: Buffer) => void | Promise<void>): void {
+        this.#output.push(listener);
+    }
+
+    /** The terminals of one app. */
+    ofApp(app: string): Terminal[] {
+        return this.list().filter((one) => one.app === app);
+    }
+
+    /** The record of a terminal, or undefined. */
+    record(id: string): Terminal | undefined {
+        return this.#entries.get(id)?.record;
+    }
+
+    /** Promise the terminal a host opens under this token to a task run. */
+    expect(token: string, claim: Claim): void {
+        this.#claims.set(token, claim);
+    }
+
+    /** Take the promise made under a token, or undefined. */
+    claim(token: string, app: string): Claim | undefined {
+        const found = this.#claims.get(token);
+        if (found?.app !== app) return undefined;
+        this.#claims.delete(token);
+        return found;
+    }
+
+    /** Forget a promise whose terminal never opened. */
+    forget(token: string): void {
+        this.#claims.delete(token);
+    }
+
+    /** End the terminal as the host's own end does: the row stays with the code. */
+    end(id: string, code: number): boolean {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return false;
+        this.#end(id, entry, code);
+        return true;
+    }
+
+    /** Hold the terminal a stream opened; its row. */
+    add(init: StreamTerminalInit): Terminal {
+        let id: string;
+        do {
+            id = `${randomBytes(3).toString('hex')}-app`;
+        } while (this.#entries.has(id));
+        const record: Terminal = {
+            id,
+            name: init.name === '' ? id : init.name,
+            title: '',
+            icon: '',
+            color: '',
+            kind: 'app',
+            app: init.app,
+            cwd: init.cwd,
+            command: '',
+            pid: 0,
+            created: this.#now().toISOString(),
+            attached: false,
+            resumes: null,
+            task: init.job !== undefined,
+            exit: null,
+            job: init.job ?? null
+        };
+        const entry: Entry = {
+            record,
+            stream: init.stream,
+            chunks: [],
+            bytes: 0,
+            sizes: new Map(),
+            sent: null,
+            ended: init.ended,
+            over: false
+        };
+        this.#entries.set(id, entry);
+        this.#wire(id, entry);
+        this.#tell();
+        return record;
+    }
+
+    /** Bind a new stream to the row of a terminal that ended, as a task run again does. */
+    rebind(id: string, stream: AppStream, job?: TerminalJob): boolean {
+        const entry = this.#entries.get(id);
+        if (!entry?.over) return false;
+        entry.stream = stream;
+        entry.over = false;
+        entry.chunks = [];
+        entry.bytes = 0;
+        entry.sent = null;
+        entry.record = { ...entry.record, exit: null, ...(job === undefined ? {} : { job }) };
+        this.#wire(id, entry);
+        this.#tell();
+        return true;
+    }
+
+    /** Rename the row; the host's `onDidChangeName`. */
+    rename(id: string, name: string): void {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return;
+        entry.record = { ...entry.record, name };
+        this.#tell();
+    }
+
+    /** Give the row a title, icon or colour. */
+    style(id: string, change: Partial<Pick<Terminal, 'title' | 'icon' | 'color'>>): boolean {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return false;
+        entry.record = { ...entry.record, ...change };
+        this.#tell();
+        return true;
+    }
+
+    /**
+     * Empty what the server keeps of the terminal's output, so a page that attaches next is painted
+     * blank.
+     */
+    clear(id: string): boolean {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return false;
+        entry.chunks = [];
+        entry.bytes = 0;
+        return true;
+    }
+
+    /** Close the terminal: its stream ends and the row goes. */
+    close(id: string): boolean {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return false;
+        this.#entries.delete(id);
+        if (!entry.stream.closed) entry.stream.close();
+        this.#tell();
+        return true;
+    }
+
+    /** The host of an app stopped: its terminals end. */
+    endApp(app: string, code: number): void {
+        for (const [id, entry] of this.#entries) {
+            if (entry.record.app === app) this.#end(id, entry, code);
+        }
+    }
+
+    replay(id: string): Buffer {
+        const entry = this.#entries.get(id);
+        return entry === undefined ? Buffer.alloc(0) : Buffer.concat(entry.chunks);
+    }
+
+    input(id: string, bytes: Buffer): void {
+        const entry = this.#entries.get(id);
+        if (entry === undefined || entry.over || entry.stream.closed) return;
+        entry.stream.sendBytes(bytes);
+    }
+
+    size(id: string, page: object, cols: number, rows: number): void {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return;
+        entry.sizes.set(page, { cols, rows });
+        this.#follow(entry);
+    }
+
+    release(id: string, page: object): void {
+        const entry = this.#entries.get(id);
+        if (!entry?.sizes.delete(page)) return;
+        this.#follow(entry);
+    }
+
+    /** Write the stream's output into the ring and to the listeners; the credit returns after. */
+    #wire(id: string, entry: Entry): void {
+        const stream = entry.stream;
+        stream.onBytes(async (bytes) => {
+            if (entry.stream !== stream) return;
+            this.#keep(entry, bytes);
+            await Promise.all(
+                this.#output.map(async (listener) => {
+                    await listener(id, bytes);
+                })
+            );
+        });
+        stream.onControl((body) => {
+            if (entry.stream === stream && body.end === true) this.#end(id, entry, body.code ?? 0);
+        });
+        stream.onClose(() => {
+            if (entry.stream === stream && this.#entries.get(id) === entry) {
+                this.#end(id, entry, entry.record.exit ?? 0);
+            }
+        });
+    }
+
+    #keep(entry: Entry, bytes: Buffer): void {
+        entry.chunks.push(bytes);
+        entry.bytes += bytes.length;
+        while (entry.bytes > this.#ringBytes && entry.chunks.length > 0) {
+            const first = entry.chunks[0];
+            const over = entry.bytes - this.#ringBytes;
+            if (first.length <= over) {
+                entry.chunks.shift();
+                entry.bytes -= first.length;
+            } else {
+                entry.chunks[0] = first.subarray(over);
+                entry.bytes -= over;
+            }
+        }
+    }
+
+    /** The terminal ended: its exit and the line saying so, and the row stays. */
+    #end(id: string, entry: Entry, code: number): void {
+        if (entry.over) return;
+        entry.over = true;
+        entry.record = { ...entry.record, exit: code };
+        const line = Buffer.from(`\r\n${entry.ended(code)}\r\n`, 'utf8');
+        this.#keep(entry, line);
+        for (const listener of this.#output) void listener(id, line);
+        if (!entry.stream.closed) entry.stream.close();
+        this.#tell();
+    }
+
+    /** Send the smallest size of the pages that show the terminal, when it changed. */
+    #follow(entry: Entry): void {
+        if (entry.over || entry.sizes.size === 0) return;
+        let cols = Infinity;
+        let rows = Infinity;
+        for (const size of entry.sizes.values()) {
+            cols = Math.min(cols, size.cols);
+            rows = Math.min(rows, size.rows);
+        }
+        if (entry.sent?.cols === cols && entry.sent.rows === rows) return;
+        entry.sent = { cols, rows };
+        entry.stream.sendControl({ columns: cols, rows });
+    }
+
+    #tell(): void {
+        for (const listener of this.#changed) listener();
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/run/tasks.ts b/tools/oculus/src/lib/server/machine/apps/tools/run/tasks.ts
new file mode 100644
index 000000000..a0b36d131
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/run/tasks.ts
@@ -0,0 +1,668 @@
+// Layer 2, server. The tasks of the apps' hosts: the task providers they register
+// (`oculus.tasks.registerTaskProvider`), the commands those tasks are listed as, and the runs of
+// them. A task an app gives is a project command of the source `app` named `<source>: <name>`; a
+// `commands.yml` entry with a `type` is a command of the source `file` that the app which defines
+// the type resolves (`oculus/tasks/resolve`). Neither takes an approval of its text: the app is
+// approved, and what it runs is its own.
+//
+// A run asks the host to prepare the task (`oculus/tasks/prepare`). A shell or process execution
+// comes back as a program and its arguments, which oculus runs in a tmux terminal of the kind
+// `app` that prints the marker the page reads the output by; a custom execution comes back as the
+// `terminal` stream its pseudoterminal opened, which is a stream terminal (stream-terminals.ts).
+// Rerun and Restart prepare the task again, so a host that was restarted since, and a task whose
+// definition changed, run as they are now. The host is told when each run starts, when its
+// process starts and when each ends (`oculus/tasks/event`), and `TaskExecution.terminate()` ends
+// the run (`oculus/tasks/terminate`).
+//
+// A task runs only in a repository inside the folders of its app's scope. A task whose scope is a
+// folder runs in that folder; a workspace or global task runs in the repository that lists it.
+
+import { randomBytes } from 'node:crypto';
+import { realpathSync } from 'node:fs';
+import { relative, isAbsolute } from 'node:path';
+import { z } from 'zod';
+import { chainMarker } from '../../../../../data/helpers/run/marker.ts';
+import type {
+    AppTaskDescription,
+    CommandFinding,
+    CommandsAnswer,
+    ProjectCommand,
+    Terminal,
+    TerminalJob,
+    TerminalRefusal
+} from '../../../../../data/model/index.ts';
+import { Refused, parsed, type HostHandler } from '../../host/connection.ts';
+import { TASKS_COMMAND, type ActivationEvent } from '../../read/activation.ts';
+import type { HeldApp } from '../../read/held.ts';
+import { shellWord } from '../../../pty/shell-word.ts';
+import type { HostTools } from '../registry.ts';
+import { ToolsScope } from '../scope.ts';
+import type { TerminalsEnv } from './terminals.ts';
+import { words } from '../../../../core/words.ts';
+
+/** The event a listing and a run of tasks raises for the hosts of apps that name it. */
+const RUN_TASK_EVENT: ActivationEvent = {
+    kind: 'onCommand',
+    id: TASKS_COMMAND
+};
+
+/** How long a provider may take to give its tasks before the listing goes on without them. */
+const PROVIDE_MS = 5000;
+
+/** How long a custom execution may take to open its pseudoterminal's stream. */
+const OPEN_MS = 5000;
+
+/** The most tasks one provider is listed with. */
+const TASKS_MAX = 500;
+
+const typeShape = z.object({ type: z.string().min(1).max(200) });
+
+const describedShape: z.ZodType<AppTaskDescription> = z.object({
+    key: z.string().min(1).max(100),
+    name: z.string().max(500),
+    source: z.string().max(500),
+    type: z.string().max(200),
+    definition: z.record(z.string(), z.unknown()),
+    scope: z.string().max(4096),
+    kind: z.enum(['shell', 'process', 'custom', 'none']),
+    group: z.object({ kind: z.enum(['build', 'test']), isDefault: z.boolean() }).nullable(),
+    isBackground: z.boolean(),
+    detail: z.string().max(2000),
+    problemMatchers: z.array(z.string().max(200)).max(32)
+});
+
+const preparedShape = z.union([
+    z.object({
+        kind: z.literal('argv'),
+        argv: z.array(z.string().max(100_000)).min(1).max(1000),
+        cwd: z.string().max(4096),
+        env: z.record(z.string(), z.string())
+    }),
+    z.object({ kind: z.literal('terminal') })
+]);
+
+const NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+/** The line that prints the marker the page reads a task's output by, then runs the program. */
+const MARKED = 'printf "%s\\n" "$1"; shift; exec "$@"';
+
+/** The refusal of a run, and the names its sentence is about. */
+export type TaskRefusal = { refused: TerminalRefusal; names: string[] };
+
+/** What a run answers. */
+export type TaskStart = { terminal: Terminal } | TaskRefusal;
+
+/** The tasks part of one host. */
+export type TaskHost = {
+    handlers: Record<string, HostHandler>;
+    /** The task types the host registered a provider for. */
+    types(): string[];
+    stop(): void;
+};
+
+/** What the tasks need of the registry. */
+export type TasksPorts = {
+    /** The approved, enabled apps in the Views list's order. */
+    actives(): HeldApp[];
+    /** The tools of the running host of an app, or undefined. */
+    host(app: string): { tools: HostTools; tasks: TaskHost } | undefined;
+    /** Start the host of an app for an activation event; whether it runs. */
+    activate(app: string, event: ActivationEvent): Promise<boolean>;
+    terminals(): TerminalsEnv;
+    scope: ToolsScope;
+    catalog(): Record<string, string>;
+};
+
+/** One run of a task. */
+type Run = {
+    id: string;
+    app: string;
+    key: string;
+    terminal: string;
+    stream: boolean;
+    ended: boolean;
+    /** Whether a list of the terminals has held the run's terminal. */
+    seen: boolean;
+    /** When the run began, in milliseconds. */
+    since: number;
+};
+
+/** How long a terminal may stay out of the list after its run began before the run is over. */
+const UNLISTED_MS = 10_000;
+
+/** The real path of a path, or null. */
+function real(path: string): string | null {
+    try {
+        return realpathSync.native(path);
+    } catch {
+        return null;
+    }
+}
+
+/** Whether a path lies in a folder or is it. */
+function within(path: string, folder: string): boolean {
+    const way = relative(folder, path);
+    return way === '' || (!way.startsWith('..') && !isAbsolute(way));
+}
+
+/** The tasks part of one host: its provider registrations and what it asks of oculus. */
+export function taskHost(host: HostTools, service: () => AppTasks): TaskHost {
+    const types = new Set<string>();
+    const handlers: Record<string, HostHandler> = {
+        'oculus/tasks/register': (params) => {
+            const app = host.app();
+            const { type } = parsed(typeShape, params);
+            if (!app.row.contributes.taskDefinitions.some((one) => one.type === type)) {
+                throw new Refused('not_declared');
+            }
+            if (types.has(type)) throw new Refused('refused:registered');
+            types.add(type);
+            host.changed();
+            return null;
+        },
+        'oculus/tasks/unregister': (params) => {
+            host.app();
+            types.delete(parsed(typeShape, params).type);
+            host.changed();
+            return null;
+        },
+        'oculus/tasks/execute': async (params) => {
+            const task = parsed(z.object({ task: describedShape }), params).task;
+            const started = await service().executeFor(host.id, task);
+            if ('refused' in started) throw new Refused(`refused:${started.refused}`);
+            return { execution: started.execution };
+        },
+        'oculus/tasks/terminate': async (params) => {
+            host.app();
+            const { execution } = parsed(z.object({ execution: z.string().max(100) }), params);
+            await service().terminate(host.id, execution);
+            return null;
+        }
+    };
+    return {
+        handlers,
+        types: () => [...types],
+        stop() {
+            types.clear();
+            service().hostStopped(host.id);
+        }
+    };
+}
+
+/** The tasks of every host. */
+export class AppTasks {
+    readonly #ports: TasksPorts;
+    readonly #runs = new Map<string, Run>();
+    #counter = 0;
+
+    constructor(ports: TasksPorts) {
+        this.#ports = ports;
+        ports.terminals().onChange(() => this.#watch());
+    }
+
+    /**
+     * The commands of a repository with the tasks of the apps added: the typed entries of
+     * `commands.yml` resolved by the app that defines the type (or left out with a finding), and
+     * the tasks every provider gives, after the commands of the other sources.
+     */
+    async commands(repo: string, base: CommandsAnswer): Promise<CommandsAnswer> {
+        const findings: CommandFinding[] = [...base.findings];
+        const commands: ProjectCommand[] = [];
+        for (const command of base.commands) {
+            if (command.task?.key !== '') {
+                commands.push(command);
+                continue;
+            }
+            const resolved = await this.#resolve(command, repo, findings);
+            if (resolved !== null) commands.push(resolved);
+        }
+        const taken = new Set(
+            commands.flatMap((one) => (one.default === undefined ? [] : [one.default]))
+        );
+        const given = await this.#provided(repo, findings);
+        const names = new Set(commands.map((one) => one.name));
+        const counts = new Map<string, number>();
+        for (const one of given) counts.set(one.name, (counts.get(one.name) ?? 0) + 1);
+        for (const one of given) {
+            const clash = names.has(one.name) || (counts.get(one.name) ?? 0) > 1;
+            const name = clash ? `${one.name} (${one.task?.appTitle ?? ''})` : one.name;
+            let role = one.default;
+            if (role !== undefined && taken.has(role)) role = undefined;
+            if (role !== undefined) taken.add(role);
+            names.add(name);
+            const rest = Object.fromEntries(
+                Object.entries(one).filter(([key]) => key !== 'default')
+            ) as ProjectCommand;
+            commands.push({ ...rest, name, ...(role === undefined ? {} : { default: role }) });
+        }
+        return { commands, findings };
+    }
+
+    /** A typed `commands.yml` entry as the app that defines its type resolves it, or null. */
+    async #resolve(
+        command: ProjectCommand,
+        repo: string,
+        findings: CommandFinding[]
+    ): Promise<ProjectCommand | null> {
+        const task = command.task;
+        const file = command.entry?.file ?? '';
+        const field = `commands[${command.name}].type`;
+        if (task === undefined) return command;
+        const app = this.#ports
+            .actives()
+            .find((one) => one.row.contributes.taskDefinitions.some((d) => d.type === task.type));
+        if (app === undefined) {
+            findings.push({
+                file,
+                field,
+                message: words(
+                    this.#ports.catalog(),
+                    'server.commands.task_type_unknown',
+                    task.type
+                )
+            });
+            return null;
+        }
+        const definition = app.row.contributes.taskDefinitions.find((d) => d.type === task.type);
+        const missing = (definition?.required ?? []).find(
+            (one) => !Object.hasOwn(task.definition, one)
+        );
+        if (missing !== undefined) {
+            findings.push({
+                file,
+                field: `commands[${command.name}].${missing}`,
+                message: words(
+                    this.#ports.catalog(),
+                    'server.commands.task_required',
+                    task.type,
+                    missing
+                )
+            });
+            return null;
+        }
+        if (!(await this.#ports.activate(app.id, RUN_TASK_EVENT)))
+            return this.#dropped(file, field, task.type, findings);
+        const held = this.#ports.host(app.id);
+        if (held === undefined) return this.#dropped(file, field, task.type, findings);
+        try {
+            const answer = await held.tools.request('oculus/tasks/resolve', {
+                type: task.type,
+                definition: task.definition
+            });
+            const resolved = answer === null ? null : describedShape.safeParse(answer);
+            if (!resolved?.success) {
+                return this.#dropped(file, field, task.type, findings);
+            }
+            const description = resolved.data;
+            return {
+                ...command,
+                run: description.detail,
+                matchers: command.matchers ?? description.problemMatchers,
+                task: {
+                    ...task,
+                    app: app.id,
+                    appTitle: app.row.title,
+                    key: description.key,
+                    label: '',
+                    background: description.isBackground,
+                    group: description.group?.kind ?? null,
+                    isDefault: description.group?.isDefault === true,
+                    folder: this.#folderOf(description.scope)
+                }
+            };
+        } catch {
+            return this.#dropped(file, field, task.type, findings);
+        }
+    }
+
+    #dropped(file: string, field: string, type: string, findings: CommandFinding[]): null {
+        findings.push({
+            file,
+            field,
+            message: words(this.#ports.catalog(), 'server.commands.task_not_resolved', type)
+        });
+        return null;
+    }
+
+    /** The tasks every provider of an acting app gives for the repository. */
+    async #provided(repo: string, findings: CommandFinding[]): Promise<ProjectCommand[]> {
+        const out: ProjectCommand[] = [];
+        const repoReal = real(repo);
+        if (repoReal === null) return out;
+        for (const app of this.#ports.actives()) {
+            const folders = this.#ports.scope.folders(app).map((one) => one.real);
+            if (!folders.some((folder) => within(repoReal, folder))) continue;
+            const declared = app.row.contributes.taskDefinitions.length > 0;
+            if (!declared) continue;
+            if (!(await this.#ports.activate(app.id, RUN_TASK_EVENT))) continue;
+            const held = this.#ports.host(app.id);
+            if (held === undefined) continue;
+            for (const type of held.tasks.types()) {
+                const given = await this.#give(held.tools, type);
+                if (given === null) {
+                    findings.push({
+                        file: app.row.name,
+                        field: `tasks.${type}`,
+                        message: words(
+                            this.#ports.catalog(),
+                            'server.commands.task_provider_failed',
+                            type
+                        )
+                    });
+                    continue;
+                }
+                for (const one of given.slice(0, TASKS_MAX)) {
+                    const folder = this.#folderOf(one.scope);
+                    if (folder !== '' && !within(repoReal, ToolsScope.pathOf(folder) ?? ''))
+                        continue;
+                    out.push(this.#commandOf(app, one, repoReal, folder));
+                }
+            }
+        }
+        return out;
+    }
+
+    /** A provider's tasks, or null when it failed or took too long. */
+    async #give(tools: HostTools, type: string): Promise<AppTaskDescription[] | null> {
+        try {
+            const timeout = new Promise<null>((resolve) => {
+                const timer = setTimeout(() => resolve(null), PROVIDE_MS);
+                timer.unref();
+            });
+            const answer = await Promise.race([
+                tools.request('oculus/tasks/provide', { type }),
+                timeout
+            ]);
+            if (!Array.isArray(answer)) return null;
+            return answer.flatMap((one) => {
+                const read = describedShape.safeParse(one);
+                return read.success ? [read.data] : [];
+            });
+        } catch {
+            return null;
+        }
+    }
+
+    /** The folder a task's scope names as a file URI, or the empty text for the whole workspace. */
+    #folderOf(scope: string): string {
+        return scope === 'global' || scope === 'workspace' ? '' : scope;
+    }
+
+    #commandOf(
+        app: HeldApp,
+        one: AppTaskDescription,
+        repo: string,
+        folder: string
+    ): ProjectCommand {
+        const role = one.group?.isDefault === true ? one.group.kind : undefined;
+        return {
+            name: `${one.source}: ${one.name}`,
+            run: one.detail,
+            cwd: repo,
+            depends_on: [],
+            ...(role === undefined ? {} : { default: role }),
+            source: 'app',
+            matchers: one.problemMatchers,
+            task: {
+                app: app.id,
+                appTitle: app.row.title,
+                type: one.type,
+                key: one.key,
+                label: one.source,
+                definition: one.definition,
+                background: one.isBackground,
+                group: one.group?.kind ?? null,
+                isDefault: one.group?.isDefault === true,
+                folder
+            }
+        };
+    }
+
+    /**
+     * Run a command that an app's host runs in a terminal of the given grid. With `again` the row
+     * of that ended terminal runs it once more.
+     */
+    async run(
+        command: ProjectCommand,
+        repo: string,
+        size: { cols: unknown; rows: unknown },
+        again?: Terminal
+    ): Promise<TaskStart> {
+        const ref = command.task;
+        if (ref === undefined) return { refused: 'task-gone', names: [command.name] };
+        const app = this.#ports.actives().find((one) => one.id === ref.app);
+        const gone: TaskRefusal = { refused: 'task-gone', names: [command.name] };
+        if (app === undefined) return gone;
+        if (!(await this.#ports.activate(app.id, RUN_TASK_EVENT))) return gone;
+        const held = this.#ports.host(app.id);
+        if (held === undefined) return gone;
+        return this.#launch(app, held.tools, command, repo, size, again);
+    }
+
+    async #launch(
+        app: HeldApp,
+        tools: HostTools,
+        command: ProjectCommand,
+        repo: string,
+        size: { cols: unknown; rows: unknown },
+        again?: Terminal
+    ): Promise<TaskStart> {
+        const ref = command.task;
+        if (ref === undefined) return { refused: 'task-gone', names: [command.name] };
+        const env = this.#ports.terminals();
+        const token = randomBytes(6).toString('hex');
+        const job: TerminalJob = {
+            repo,
+            name: command.name,
+            source: 'app',
+            token,
+            chain: [{ name: command.name, cwd: repo }],
+            app: {
+                app: app.id,
+                title: app.row.title,
+                type: ref.type,
+                background: ref.background
+            },
+            matchers: command.matchers ?? []
+        };
+        const opened = new Promise<string>((resolve) => {
+            env.streams.expect(token, {
+                app: app.id,
+                job,
+                ...(again === undefined ? {} : { rebind: again.id }),
+                taken: resolve
+            });
+        });
+        if (again !== undefined && env.streams.has(again.id)) env.streams.end(again.id, 0);
+        let prepared: z.infer<typeof preparedShape>;
+        try {
+            const answer = await tools.request('oculus/tasks/prepare', {
+                key: ref.key,
+                token,
+                cwd: repo
+            });
+            const read = preparedShape.safeParse(answer);
+            if (!read.success) throw new Error('shape');
+            prepared = read.data;
+        } catch {
+            env.streams.forget(token);
+            return { refused: 'task-gone', names: [command.name] };
+        }
+        let terminal: Terminal | undefined;
+        if (prepared.kind === 'terminal') {
+            const timeout = new Promise<string>((resolve) => {
+                const timer = setTimeout(() => resolve(''), OPEN_MS);
+                timer.unref();
+            });
+            const id = await Promise.race([opened, timeout]);
+            env.streams.forget(token);
+            terminal = env.list().find((one) => one.id === id);
+        } else {
+            env.streams.forget(token);
+            const folder = this.#folderFor(app, prepared.cwd, repo);
+            if (folder === null) return { refused: 'bad-repo', names: [command.name] };
+            const variables = Object.entries(prepared.env).flatMap(([name, value]) => {
+                if (!NAME.test(name)) return [];
+                return [`${name}=${value}`];
+            });
+            const argv = [
+                'env',
+                ...variables,
+                'sh',
+                '-c',
+                MARKED,
+                'sh',
+                chainMarker(token, command.name),
+                ...prepared.argv
+            ];
+            if (again === undefined) {
+                terminal = await env.start({
+                    app: app.id,
+                    name: command.name,
+                    cwd: folder,
+                    argv,
+                    job,
+                    size
+                });
+            } else {
+                await env.respawn(again.id, argv.map(shellWord).join(' '), job);
+                terminal = env.list().find((one) => one.id === again.id);
+            }
+        }
+        if (terminal === undefined) return { refused: 'terminal-not-started', names: [] };
+        this.#begin(app.id, tools, ref.key, terminal);
+        return { terminal };
+    }
+
+    /**
+     * The folder a task's program runs in: its own when it lies in the app's scope, else the
+     * repository.
+     */
+    #folderFor(app: HeldApp, cwd: string, repo: string): string | null {
+        if (cwd === '') return repo;
+        const found = this.#ports.scope.resolve(app, ToolsScope.uriOf(cwd), true);
+        if (found.ok) return found.file.real;
+        const asPath = real(cwd);
+        if (asPath === null) return repo;
+        const inScope = this.#ports.scope.folders(app).some((one) => within(asPath, one.real));
+        return inScope ? asPath : null;
+    }
+
+    /** Record the run and tell the host it started. */
+    #begin(app: string, tools: HostTools, key: string, terminal: Terminal): void {
+        this.#counter += 1;
+        const id = `x${this.#counter}`;
+        const run: Run = {
+            id,
+            app,
+            key,
+            terminal: terminal.id,
+            stream: this.#ports.terminals().streams.has(terminal.id),
+            ended: false,
+            seen: false,
+            since: Date.now()
+        };
+        for (const [other, one] of this.#runs) {
+            if (one.terminal === terminal.id) this.#finish(other, one, null);
+        }
+        this.#runs.set(id, run);
+        tools.notify('oculus/tasks/event', { kind: 'start', execution: id, key });
+        if (terminal.pid > 0) {
+            tools.notify('oculus/tasks/event', {
+                kind: 'processStart',
+                execution: id,
+                key,
+                pid: terminal.pid
+            });
+        }
+    }
+
+    /** A run of the host's own asking: the repository is the folder of the task's scope. */
+    async executeFor(
+        app: string,
+        task: AppTaskDescription
+    ): Promise<{ execution: string } | TaskRefusal> {
+        const held = this.#ports.host(app);
+        const acting = this.#ports.actives().find((one) => one.id === app);
+        if (held === undefined || acting === undefined) {
+            return { refused: 'task-gone', names: [task.name] };
+        }
+        const folders = this.#ports.scope.folders(acting);
+        const scoped = task.scope === 'global' || task.scope === 'workspace' ? '' : task.scope;
+        const path = scoped === '' ? (folders.at(0)?.real ?? null) : ToolsScope.pathOf(scoped);
+        const found =
+            path === null
+                ? undefined
+                : this.#ports.scope.resolve(acting, ToolsScope.uriOf(path), true);
+        if (!found?.ok) return { refused: 'bad-repo', names: [task.name] };
+        const command = this.#commandOf(acting, task, found.file.real, scoped);
+        const before = new Set(this.#runs.keys());
+        const started = await this.#launch(
+            acting,
+            held.tools,
+            command,
+            found.file.real,
+            { cols: 120, rows: 30 },
+            undefined
+        );
+        if ('refused' in started) return started;
+        const made = [...this.#runs.keys()].find((id) => !before.has(id));
+        return { execution: made ?? '' };
+    }
+
+    /** End the run an execution names, as `TaskExecution.terminate` asks. */
+    async terminate(app: string, execution: string): Promise<void> {
+        const run = this.#runs.get(execution);
+        if (run?.app !== app || run.ended) return;
+        const env = this.#ports.terminals();
+        if (run.stream) env.streams.end(run.terminal, 1);
+        else await env.interrupt(run.terminal).catch(() => undefined);
+    }
+
+    /** The host of an app stopped: its runs are forgotten, and the terminals stay. */
+    hostStopped(app: string): void {
+        for (const [id, run] of this.#runs) if (run.app === app) this.#runs.delete(id);
+    }
+
+    /** The terminals moved: each run whose terminal ended or went is told to its host. */
+    #watch(): void {
+        const listed = new Map(
+            this.#ports
+                .terminals()
+                .list()
+                .map((one) => [one.id, one])
+        );
+        for (const [id, run] of this.#runs) {
+            if (run.ended) continue;
+            const terminal = listed.get(run.terminal);
+            if (terminal === undefined) {
+                // A list taken before the terminal started does not hold it yet.
+                if (!run.seen && Date.now() - run.since < UNLISTED_MS) {
+                    const timer = setTimeout(() => this.#watch(), UNLISTED_MS);
+                    timer.unref();
+                    continue;
+                }
+                this.#finish(id, run, null);
+            } else {
+                run.seen = true;
+                if (terminal.exit !== null) this.#finish(id, run, terminal.exit);
+            }
+        }
+    }
+
+    #finish(id: string, run: Run, exit: number | null): void {
+        run.ended = true;
+        this.#runs.delete(id);
+        const held = this.#ports.host(run.app);
+        if (held === undefined) return;
+        if (exit !== null) {
+            held.tools.notify('oculus/tasks/event', {
+                kind: 'processEnd',
+                execution: id,
+                key: run.key,
+                exitCode: exit
+            });
+        }
+        held.tools.notify('oculus/tasks/event', { kind: 'end', execution: id, key: run.key });
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/run/terminals-env.ts b/tools/oculus/src/lib/server/machine/apps/tools/run/terminals-env.ts
new file mode 100644
index 000000000..3f05f660d
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/run/terminals-env.ts
@@ -0,0 +1,76 @@
+// Layer 2, server. What the terminals and tasks of the apps' hosts use of the process: the tmux
+// terminals the Terminal tab lists (pty/channel.ts), the stream terminals the apps hold
+// (stream-terminals.ts), and the starts, stops and re-runs of a tmux terminal of the kind `app`
+// (pty/sessions.ts). The list the terminals report is the Terminal tab's own, so a terminal an app
+// makes is listed, moved, split, renamed and closed as any terminal.
+
+import type { Terminal } from '../../../../../data/model/index.ts';
+import type { Terminals } from '../../../pty/channel.ts';
+import {
+    respawnTerminal,
+    startTerminal,
+    stopTerminal,
+    paneOutput,
+    type RunOptions
+} from '../../../pty/sessions.ts';
+import type { StreamTerminalSet } from './stream-terminals.ts';
+import type { TerminalsEnv } from './terminals.ts';
+
+/** The byte a terminal reads as an interrupt. */
+const ETX = 3;
+
+/** The grid a terminal starts with when nothing asked for one; the page sets its own at attach. */
+const COLS = 120;
+const ROWS = 30;
+
+/** What the env is made over. */
+export type TerminalsEnvOptions = {
+    terminals: Terminals;
+    streams: StreamTerminalSet;
+    /** The tmux options the process runs its terminals with. */
+    tmux?: RunOptions;
+    /** The user's shell, for a terminal that names none. */
+    shell: () => string;
+};
+
+/** The terminals env of a process. */
+export function terminalsEnv(options: TerminalsEnvOptions): TerminalsEnv {
+    const tmux = options.tmux ?? {};
+    const { terminals, streams } = options;
+    return {
+        streams,
+        async start(request) {
+            const terminal = await startTerminal(
+                {
+                    kind: 'app',
+                    app: request.app,
+                    cwd: request.cwd,
+                    cols: request.size?.cols ?? COLS,
+                    rows: request.size?.rows ?? ROWS,
+                    name: request.name
+                },
+                {
+                    ...tmux,
+                    argv: request.argv,
+                    ...(request.job === undefined ? {} : { task: request.job })
+                }
+            );
+            terminals.refresh();
+            return terminal;
+        },
+        list: (): Terminal[] => terminals.list() ?? [],
+        onChange: (listener) => terminals.onChange(listener),
+        send: (id, bytes) => terminals.type(id, bytes),
+        async stop(id) {
+            await stopTerminal(id, tmux);
+            terminals.refresh();
+        },
+        interrupt: (id) => terminals.type(id, Buffer.from([ETX])),
+        async respawn(id, command, job) {
+            await respawnTerminal(id, tmux, command, job);
+            terminals.refresh();
+        },
+        output: (id) => paneOutput(id, tmux),
+        shell: options.shell
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/run/terminals.ts b/tools/oculus/src/lib/server/machine/apps/tools/run/terminals.ts
new file mode 100644
index 000000000..05575c8db
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/run/terminals.ts
@@ -0,0 +1,265 @@
+// Layer 2, server. The terminals an app's host makes with `window.createTerminal`. One made with
+// `{ name, shellPath, shellArgs, cwd, env, message }` is a tmux terminal of the kind `app`
+// (`oculus/terminals/create`): oculus starts the program in the page's Terminal tab's own tmux and
+// records the app's view id in the session's `@oculus-app` option, so after a server restart the
+// terminal is still the app's and the host is told of it again (`oculus/terminals/list`). One made
+// with `{ name, pty }` is a `terminal` stream the host opens (stream-terminals.ts).
+//
+// A host reaches only the terminals its own app made. Its `cwd` must lie in the app's scope, the
+// environment names it sets are plain names, and a terminal that is not the app's is refused
+// `missing`. When the terminals oculus lists change, the host is told which of its terminals
+// closed (`oculus/terminals/event`). The pages' side is the Terminal tab: `show` and `hide` are
+// requests to a page (`showTerminal`, `hideTerminal`), and the page reports the terminal it shows
+// (`active`) for `window.activeTerminal`.
+//
+// A terminal of an app ends the moment the app stops acting (`endApp`): its tmux session is killed
+// and its streams are closed. A stop of the host alone ends its stream terminals and leaves its
+// tmux terminals running.
+
+import { statSync } from 'node:fs';
+import { z } from 'zod';
+import type { Terminal, TerminalJob } from '../../../../../data/model/index.ts';
+import { Refused, parsed, type HostHandler } from '../../host/connection.ts';
+import type { HostTools } from '../registry.ts';
+import { ToolsScope } from '../scope.ts';
+import type { StreamTerminalSet } from './stream-terminals.ts';
+import { words } from '../../../../core/words.ts';
+
+/** The most terminals one app holds at once. */
+const TERMINALS_MAX = 32;
+
+/** What the terminals of the hosts ask of the process. */
+export type TerminalsEnv = {
+    streams: StreamTerminalSet;
+    /** Start a tmux terminal of the kind `app`. */
+    start(request: {
+        app: string;
+        name: string;
+        cwd: string;
+        argv: string[];
+        job?: TerminalJob;
+        /** The grid asked for; the default grid when absent. */
+        size?: { cols: unknown; rows: unknown };
+    }): Promise<Terminal>;
+    /** Every terminal now listed, tmux's and the streams'. */
+    list(): Terminal[];
+    /** Hear the list change; the answer takes the listener off. */
+    onChange(listener: () => void): () => void;
+    /** Type bytes into a tmux terminal. */
+    send(id: string, bytes: Buffer): Promise<void>;
+    /** End a tmux terminal. */
+    stop(id: string): Promise<void>;
+    /** Interrupt the program a tmux terminal runs. */
+    interrupt(id: string): Promise<void>;
+    /** Run a task terminal's line again, with the line given when there is one. */
+    respawn(id: string, command?: string, job?: TerminalJob): Promise<void>;
+    /** All the text a terminal's pane holds. */
+    output(id: string): Promise<string>;
+    /** The shell a terminal runs when its host names none. */
+    shell(): string;
+};
+
+const createShape = z.object({
+    kind: z.literal('tmux'),
+    name: z.string().max(80),
+    shellPath: z.string().max(4096),
+    shellArgs: z.array(z.string().max(4096)).max(256),
+    cwd: z.string().max(4096),
+    env: z.record(z.string(), z.union([z.string(), z.null()])).default({}),
+    message: z.string().max(10_000)
+});
+
+const idShape = z.object({ id: z.string().min(1).max(100) });
+
+const textShape = idShape.extend({ text: z.string().max(1_000_000), execute: z.boolean() });
+
+const NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+/** What a host's terminals answer to the registry. */
+export type TerminalHost = {
+    handlers: Record<string, HostHandler>;
+    /** The terminals of the app now listed. */
+    terminals(): Terminal[];
+    /** A page shows this terminal. */
+    active(id: string): void;
+    /** End every terminal of the app. */
+    endAll(): Promise<void>;
+    /** The host stopped: stream terminals end, tmux terminals stay. */
+    stopped(): void;
+    stop(): void;
+};
+
+/** The terminals of one host. */
+export function terminalHost(host: HostTools, env: TerminalsEnv): TerminalHost {
+    const own = (): Terminal[] => env.list().filter((one) => one.app === host.id);
+    const owned = (id: string): Terminal => {
+        const found = own().find((one) => one.id === id);
+        if (found === undefined) throw new Refused('missing');
+        return found;
+    };
+
+    /**
+     * The folder a terminal starts in: the host's `cwd` when it is in the scope, else the first
+     * folder.
+     */
+    const folderOf = (cwd: string): string => {
+        const app = host.app();
+        const scope = host.scope;
+        if (cwd === '') {
+            const first = scope.folders(app).at(0);
+            if (first === undefined) throw new Refused('outside');
+            return first.real;
+        }
+        const found = scope.resolve(app, ToolsScope.uriOf(cwd), true);
+        if (!found.ok) throw new Refused(found.word);
+        if (!statSync(found.file.real).isDirectory()) throw new Refused('not_a_folder');
+        return found.file.real;
+    };
+
+    // A stream terminal the host opens is a row of the Terminal tab; one a task run promised under
+    // its token is the run's terminal, and takes over the row of a run again.
+    host.streams.onTerminal((stream) => {
+        const token = typeof stream.purpose.token === 'string' ? stream.purpose.token : '';
+        const claim = token === '' ? undefined : env.streams.claim(token, host.id);
+        if (claim?.rebind !== undefined && env.streams.rebind(claim.rebind, stream, claim.job)) {
+            claim.taken(claim.rebind);
+            return;
+        }
+        if (own().length >= TERMINALS_MAX) {
+            host.note(words(host.catalog(), 'server.apps.terminals_full', String(TERMINALS_MAX)));
+            stream.close();
+            claim?.taken('');
+            return;
+        }
+        const given = typeof stream.purpose.name === 'string' ? stream.purpose.name : '';
+        const name = claim?.job.name ?? given;
+        const first = host.scope.folders(host.app()).at(0);
+        const row = env.streams.add({
+            app: host.id,
+            name,
+            cwd: first?.real ?? '',
+            stream,
+            job: claim?.job,
+            ended: (code) => words(host.catalog(), 'server.apps.terminal_ended', String(code))
+        });
+        claim?.taken(row.id);
+    });
+
+    let known = new Set<string>();
+    const off = env.onChange(() => {
+        const now = new Set(own().map((one) => one.id));
+        for (const id of known) if (!now.has(id)) closed(id);
+        known = now;
+    });
+    const closed = (id: string): void => {
+        host.notify('oculus/terminals/event', { kind: 'closed', id, code: null });
+    };
+
+    const handlers: Record<string, HostHandler> = {
+        'oculus/terminals/create': async (params) => {
+            const app = host.app();
+            const body = parsed(createShape, params);
+            if (own().length >= TERMINALS_MAX) throw new Refused('refused:full');
+            const cwd = folderOf(body.cwd);
+            const program = body.shellPath === '' ? env.shell() : body.shellPath;
+            const variables = Object.entries(body.env).flatMap(([name, value]) => {
+                if (!NAME.test(name)) throw new Refused('refused:env');
+                return value === null ? [] : [`${name}=${value}`];
+            });
+            const line = [program, ...body.shellArgs];
+            const argv =
+                body.message === ''
+                    ? ['env', ...variables, ...line]
+                    : [
+                          'env',
+                          ...variables,
+                          'sh',
+                          '-c',
+                          'printf "%s\\r\\n" "$1"; shift; exec "$@"',
+                          'sh',
+                          body.message,
+                          ...line
+                      ];
+            const terminal = await env.start({
+                app: app.id,
+                name: body.name === '' ? app.row.title : body.name,
+                cwd,
+                argv
+            });
+            return { id: terminal.id };
+        },
+        'oculus/terminals/list': () => {
+            host.app();
+            return own()
+                .filter((one) => !env.streams.has(one.id))
+                .map((one) => ({ id: one.id, name: one.name }));
+        },
+        'oculus/terminals/pid': (params) => {
+            host.app();
+            const found = owned(parsed(idShape, params).id);
+            return found.pid === 0 ? null : found.pid;
+        },
+        'oculus/terminals/sendText': async (params) => {
+            host.app();
+            const body = parsed(textShape, params);
+            owned(body.id);
+            const text = body.execute ? `${body.text}\r` : body.text;
+            if (env.streams.has(body.id)) env.streams.input(body.id, Buffer.from(text, 'utf8'));
+            else await env.send(body.id, Buffer.from(text, 'utf8'));
+            return null;
+        },
+        'oculus/terminals/show': (params) => {
+            host.app();
+            const body = parsed(idShape.extend({ preserveFocus: z.boolean() }), params);
+            owned(body.id);
+            host.ask({
+                kind: 'showTerminal',
+                terminal: body.id,
+                preserveFocus: body.preserveFocus
+            }).answer.catch(() => undefined);
+            return null;
+        },
+        'oculus/terminals/hide': (params) => {
+            host.app();
+            const body = parsed(idShape, params);
+            owned(body.id);
+            host.ask({ kind: 'hideTerminal', terminal: body.id }).answer.catch(() => undefined);
+            return null;
+        },
+        'oculus/terminals/name': (params) => {
+            host.app();
+            const body = parsed(idShape.extend({ name: z.string().max(80) }), params);
+            owned(body.id);
+            env.streams.rename(body.id, body.name);
+            return null;
+        },
+        'oculus/terminals/dispose': async (params) => {
+            host.app();
+            const body = parsed(idShape, params);
+            owned(body.id);
+            if (!env.streams.close(body.id)) await env.stop(body.id);
+            return null;
+        }
+    };
+
+    return {
+        handlers,
+        terminals: own,
+        active(id) {
+            if (own().some((one) => one.id === id)) {
+                host.notify('oculus/terminals/event', { kind: 'active', id });
+            }
+        },
+        async endAll() {
+            for (const one of own()) {
+                if (!env.streams.close(one.id)) await env.stop(one.id).catch(() => undefined);
+            }
+        },
+        stopped() {
+            env.streams.endApp(host.id, 1);
+        },
+        stop() {
+            off();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/scm.ts b/tools/oculus/src/lib/server/machine/apps/tools/scm.ts
new file mode 100644
index 000000000..336d2c709
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/scm.ts
@@ -0,0 +1,278 @@
+// Layer 2, server. The source controls of an app's host (`oculus.scm.createSourceControl`), held
+// for the Repositories view. The host creates one with a request (`oculus/scm/create`) and sends
+// the whole of it again each time it changes (`oculus/scm/update`): the input box, the count, the
+// accept and status bar commands, and the groups with their resource states. Each resource's URI
+// is turned into a root and a path of the app's scope here, so a page opens it as any file of the
+// workspace; a resource outside every workspace folder, or in a closed or private place, carries
+// no root and no path and a page draws it by its URI and opens nothing.
+//
+// What the reader does is a call on the held control: typing in the input box (`input`), the accept
+// command (`accept`), a press on a row (`pressed`: the row's command runs in the host, or the page
+// is told to open the file), a menu command on the control, a group or rows (`execute`), and the
+// quick diff's original of a file named by its root and path (`original`: the host names a file of
+// the scope or a URI a content provider serves, and the answer is its text). A menu command on a
+// change (`scm/change/title`) takes the file's URI, the changes of its quick diff and the index of
+// the one it is run on, as VS Code's does. A control id starts with the app's name and a dot, and a
+// second control of one id is refused `refused:registered`.
+
+import { readFileSync, statSync } from 'node:fs';
+import { z } from 'zod';
+import { isWholeText } from '../../../../data/helpers/files/text-kind.ts';
+import type { AppScmState } from '../../../../data/model/index.ts';
+import { Refused, type HostHandler, type HostNotice } from '../host/connection.ts';
+import type { HostTools } from './registry.ts';
+
+/** The most resource states one group shows. */
+const RESOURCES_MAX = 10_000;
+
+const commandShape = z
+    .object({
+        command: z.string().max(500),
+        title: z.string().max(500).default(''),
+        tooltip: z.string().max(500).default('')
+    })
+    .nullable();
+
+const stateShape = z.object({
+    id: z.string(),
+    label: z.string().max(500),
+    rootUri: z.string(),
+    input: z.object({
+        value: z.string().max(1_000_000),
+        placeholder: z.string().max(500),
+        enabled: z.boolean(),
+        visible: z.boolean(),
+        writes: z.number().int().min(0)
+    }),
+    count: z.number().int().min(0).nullable(),
+    acceptCommand: commandShape,
+    statusCommands: z.array(commandShape.unwrap()).max(32),
+    commitTemplate: z.string().max(100_000),
+    quickDiff: z.boolean(),
+    groups: z
+        .array(
+            z.object({
+                id: z.string(),
+                label: z.string().max(500),
+                hideWhenEmpty: z.boolean(),
+                resources: z.array(
+                    z.object({
+                        uri: z.string().max(4000),
+                        command: commandShape,
+                        contextValue: z.string().max(200),
+                        strikeThrough: z.boolean(),
+                        faded: z.boolean(),
+                        tooltip: z.string().max(2000)
+                    })
+                )
+            })
+        )
+        .max(64)
+});
+
+const createShape = z.object({
+    id: z.string().min(1).max(200),
+    label: z.string().max(500),
+    rootUri: z.string()
+});
+
+/** A change of a file's quick diff a menu command is run on: the file and the diff's changes. */
+type ScmChange = {
+    root: string;
+    path: string;
+    changes: {
+        originalStartLineNumber: number;
+        originalEndLineNumber: number;
+        modifiedStartLineNumber: number;
+        modifiedEndLineNumber: number;
+    }[];
+    index: number;
+};
+
+/** What the source controls of one host answer to the registry and the routes. */
+export type ScmHost = {
+    handlers: Record<string, HostHandler>;
+    notices: Record<string, HostNotice>;
+    states(): AppScmState[];
+    has(id: string): boolean;
+    /** The box's text as the reader typed it. */
+    input(id: string, value: string): void;
+    accept(id: string): Promise<void>;
+    /** A press on a row: whether the page opens the file. */
+    pressed(id: string, group: string, uri: string): Promise<{ open: boolean }>;
+    execute(
+        id: string,
+        command: string,
+        scope: 'sourceControl' | 'group' | 'resource' | 'change',
+        group: string,
+        resources: string[],
+        change?: ScmChange
+    ): Promise<void>;
+    /** The text of the original of a file for the quick diff, or null when the app gives none. */
+    original(id: string, root: string, path: string): Promise<string | null>;
+    stop(): void;
+};
+
+/**
+ * The text a quick diff's original URI names: the file when it is in the app's scope and a whole
+ * text within the size the tools read, else the text the app's content provider serves for it.
+ * Null when neither gives one.
+ */
+async function originalText(host: HostTools, uri: string): Promise<string | null> {
+    const found = host.scope.resolve(host.app(), uri);
+    if (found.ok) {
+        try {
+            if (statSync(found.file.real).size > host.scope.env.maxBytes()) return null;
+            const bytes = readFileSync(found.file.real);
+            return isWholeText(bytes) ? bytes.toString('utf8') : null;
+        } catch {
+            return null;
+        }
+    }
+    try {
+        const text = await host.request('oculus/workspace/content/provide', { uri });
+        return typeof text === 'string' && text.length <= host.scope.env.maxBytes() ? text : null;
+    } catch {
+        return null;
+    }
+}
+
+/** The source controls of one host. */
+export function scmHost(host: HostTools): ScmHost {
+    const held = new Map<string, AppScmState>();
+
+    const known = (id: string): AppScmState => {
+        const found = held.get(id);
+        if (found === undefined) throw new Refused('missing');
+        return found;
+    };
+
+    const handlers: Record<string, HostHandler> = {
+        'oculus/scm/create': (params) => {
+            const app = host.app();
+            const read = createShape.safeParse(params);
+            if (!read.success) throw new Refused('refused:params');
+            const { id, label, rootUri } = read.data;
+            if (!id.startsWith(`${app.row.name}.`)) throw new Refused('not_declared');
+            if (held.has(id)) throw new Refused('refused:registered');
+            const placed = host.scope.place(app, rootUri);
+            held.set(id, {
+                app: app.id,
+                id,
+                label,
+                root: placed?.root ?? '',
+                rootUri,
+                input: { value: '', placeholder: '', enabled: true, visible: true, writes: 0 },
+                count: null,
+                acceptCommand: null,
+                statusCommands: [],
+                commitTemplate: '',
+                quickDiff: false,
+                groups: []
+            });
+            host.changed();
+            return null;
+        },
+        'oculus/scm/dispose': (params) => {
+            host.app();
+            const id = (params as { id?: unknown } | null)?.id;
+            if (typeof id === 'string' && held.delete(id)) host.changed();
+            return null;
+        }
+    };
+
+    const notices: Record<string, HostNotice> = {
+        'oculus/scm/update': (params) => {
+            const app = host.app();
+            const id = (params as { id?: unknown } | null)?.id;
+            const current = typeof id === 'string' ? held.get(id) : undefined;
+            if (current === undefined) return;
+            const read = stateShape.safeParse((params as { state?: unknown }).state);
+            if (!read.success || read.data.id !== current.id) return;
+            const state = read.data;
+            held.set(current.id, {
+                ...current,
+                label: state.label,
+                input: state.input,
+                count: state.count,
+                acceptCommand: state.acceptCommand,
+                statusCommands: state.statusCommands.map((one) => ({ ...one })),
+                commitTemplate: state.commitTemplate,
+                quickDiff: state.quickDiff,
+                groups: state.groups.map((group) => ({
+                    id: group.id,
+                    label: group.label,
+                    hideWhenEmpty: group.hideWhenEmpty,
+                    resources: group.resources.slice(0, RESOURCES_MAX).map((one) => {
+                        const placed = host.scope.place(app, one.uri);
+                        return {
+                            ...one,
+                            root: placed?.root ?? '',
+                            path: placed?.path ?? '',
+                            command:
+                                one.command === null
+                                    ? null
+                                    : { command: one.command.command, title: one.command.title }
+                        };
+                    })
+                }))
+            });
+            host.changed();
+        }
+    };
+
+    return {
+        handlers,
+        notices,
+        states: () => [...held.values()],
+        has: (id) => held.has(id),
+        input(id, value) {
+            const current = known(id);
+            held.set(id, { ...current, input: { ...current.input, value } });
+            host.notify('oculus/scm/input', { id, value });
+            host.changed();
+        },
+        async accept(id) {
+            known(id);
+            await host.request('oculus/scm/accept', { id });
+        },
+        async pressed(id, group, uri) {
+            known(id);
+            const answer = (await host.request('oculus/scm/pressed', { id, group, uri })) as {
+                open?: unknown;
+            } | null;
+            return { open: answer?.open === true };
+        },
+        async execute(id, command, scope, group, resources, change) {
+            known(id);
+            const uri =
+                change === undefined
+                    ? null
+                    : host.scope.uriFor(host.app(), change.root, change.path);
+            if (scope === 'change' && (change === undefined || uri === null)) {
+                throw new Refused('outside');
+            }
+            await host.request('oculus/scm/execute', {
+                id,
+                command,
+                scope,
+                group,
+                resources,
+                uri,
+                changes: change?.changes ?? [],
+                index: change?.index ?? 0
+            });
+        },
+        async original(id, root, path) {
+            const current = known(id);
+            if (!current.quickDiff) return null;
+            const uri = host.scope.uriFor(host.app(), root, path);
+            if (uri === null) return null;
+            const answer = await host.request('oculus/scm/original', { id, uri });
+            return typeof answer === 'string' ? originalText(host, answer) : null;
+        },
+        stop() {
+            held.clear();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/scope.ts b/tools/oculus/src/lib/server/machine/apps/tools/scope.ts
new file mode 100644
index 000000000..1c66cc16d
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/scope.ts
@@ -0,0 +1,224 @@
+// Layer 2, server. The files an app's host reaches, and where: the folders of the app's scope (a
+// machine app's are every folder of the open workspace, a root app's is its own root alone), a file
+// URI turned into a root and a path under it, and the checks that decide whether the host may have
+// the file. The checks are the ones `open({ file })` and the app files route make
+// (apps/reach/open.ts `locate`): the segment rule and `closed_paths`, a shown root, the real path
+// inside the root and outside oculus's config folder, and never a private folder, whichever root
+// covers it. A file that does not exist yet is allowed when the folder it would be created in is.
+//
+// A refusal is one of the words `outside` (a URI that names no file of the scope, or a scheme that
+// is not `file:`), `closed` and `missing`.
+
+import { realpathSync } from 'node:fs';
+import { basename, dirname, join, relative, sep } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import type { LspEditFile, OpsAnswer } from '../../../../data/file-ops.ts';
+import type { LanguageMap } from '../../../../data/helpers/files/languages.ts';
+import type { Root } from '../../../files/files.ts';
+import { locate, type OpenContext } from '../reach/open.ts';
+import type { HeldApp } from '../read/held.ts';
+import type { TerminalsEnv } from './run/terminals.ts';
+
+/** What the scope reads of the install. */
+export type ToolsEnv = {
+    /** The roots the file browser shows, with their directories written out. */
+    context: () => OpenContext;
+    /** The local history's folder. */
+    history: () => string;
+    /** The most bytes a file read or written whole may hold. */
+    maxBytes: () => number;
+    /** The most names a folder lists. */
+    scanEntries: () => number;
+    languages: () => LanguageMap;
+    /**
+     * Write the edits of files that no tab holds as `lsp-edit` does: in the write chain, recorded.
+     */
+    edit: (files: LspEditFile[]) => Promise<OpsAnswer>;
+    /** The terminals the hosts' terminals and tasks run in. */
+    terminals: TerminalsEnv;
+};
+
+/** A workspace folder as the host is told it. */
+export type ScopeFolder = { uri: string; name: string; root: string; real: string };
+
+/** A file of the scope. */
+export type ScopeFile = { root: Root; rootReal: string; path: string; real: string };
+
+/** The answer of a resolve. */
+export type Resolved =
+    { ok: true; file: ScopeFile } | { ok: false; word: 'outside' | 'closed' | 'missing' };
+
+/** The real path of a path, or null. */
+function real(path: string): string | null {
+    try {
+        return realpathSync.native(path);
+    } catch {
+        return null;
+    }
+}
+
+/** The scope of the apps' hosts. */
+export class ToolsScope {
+    readonly #env: ToolsEnv;
+
+    constructor(env: ToolsEnv) {
+        this.#env = env;
+    }
+
+    get env(): ToolsEnv {
+        return this.#env;
+    }
+
+    /** The roots of an app's scope. */
+    roots(app: HeldApp): Root[] {
+        const all = this.#env.context().roots;
+        return app.row.root === '' ? all : all.filter((root) => root.key === app.row.root);
+    }
+
+    /** The workspace folders of an app's scope, in the browser's order. */
+    folders(app: HeldApp): ScopeFolder[] {
+        const out: ScopeFolder[] = [];
+        for (const root of this.roots(app)) {
+            const at = real(root.dir);
+            if (at === null) continue;
+            out.push({
+                uri: pathToFileURL(at).toString(),
+                name: basename(at),
+                root: root.key,
+                real: at
+            });
+        }
+        return out;
+    }
+
+    /** The absolute path a `file:` URI names, or null for any other text. */
+    static pathOf(uri: unknown): string | null {
+        if (typeof uri !== 'string' || !uri.startsWith('file://')) return null;
+        try {
+            return fileURLToPath(uri);
+        } catch {
+            return null;
+        }
+    }
+
+    /** The URI of an absolute path. */
+    static uriOf(path: string): string {
+        return pathToFileURL(path).toString();
+    }
+
+    /** The root and path a real path lies at in the app's scope, the deepest root first. */
+    #placed(app: HeldApp, absolute: string): { root: Root; rootReal: string; path: string } | null {
+        let best: { root: Root; rootReal: string } | null = null;
+        for (const root of this.roots(app)) {
+            const rootReal = real(root.dir);
+            if (rootReal === null) continue;
+            const inside = absolute === rootReal || absolute.startsWith(rootReal + sep);
+            if (inside && (best === null || rootReal.length > best.rootReal.length)) {
+                best = { root, rootReal };
+            }
+        }
+        if (best === null) return null;
+        return {
+            ...best,
+            path: relative(best.rootReal, absolute).split(sep).join('/')
+        };
+    }
+
+    /**
+     * The root and path of a URI in the app's scope, the file existing or not, or null for a URI
+     * outside the scope or in a closed or private place.
+     */
+    place(app: HeldApp, uri: unknown): { root: string; path: string } | null {
+        const found = this.resolve(app, uri);
+        if (found.ok) return { root: found.file.root.key, path: found.file.path };
+        if (found.word !== 'missing') return null;
+        const absolute = ToolsScope.pathOf(uri);
+        if (absolute === null) return null;
+        const at = this.#nearest(absolute);
+        const placed = at === null ? null : this.#placed(app, at);
+        if (placed === null) return null;
+        const above = this.resolve(app, ToolsScope.uriOf(dirname(absolute)), true);
+        return above.ok ? { root: placed.root.key, path: placed.path } : null;
+    }
+
+    /** The file URI of a path of a root, or null when the root is not in the app's scope. */
+    uriFor(app: HeldApp, root: string, path: string): string | null {
+        const held = this.roots(app).find((one) => one.key === root);
+        if (held === undefined) return null;
+        const at = real(held.dir);
+        return at === null ? null : ToolsScope.uriOf(join(at, ...path.split('/')));
+    }
+
+    /** Resolve a URI of an existing file or folder. */
+    resolve(app: HeldApp, uri: unknown, folder = false): Resolved {
+        const absolute = ToolsScope.pathOf(uri);
+        if (absolute === null) return { ok: false, word: 'outside' };
+        // A path is judged at its real place, so a link out of the scope is never followed.
+        const at = real(absolute) ?? this.#nearest(absolute);
+        const placed = at === null ? null : this.#placed(app, at);
+        if (placed === null) return { ok: false, word: 'outside' };
+        const found = locate(
+            { app, root: placed.root.key, path: placed.path },
+            this.#env.context(),
+            folder
+        );
+        if (found.answer !== 'ok') return { ok: false, word: found.answer };
+        return { ok: true, file: { ...placed, real: found.real } };
+    }
+
+    /** Resolve a URI for a write: a file that exists, or one the folder above it allows. */
+    resolveForWrite(app: HeldApp, uri: unknown): Resolved {
+        const here = this.resolve(app, uri);
+        if (here.ok || here.word !== 'missing') return here;
+        const absolute = ToolsScope.pathOf(uri);
+        if (absolute === null) return { ok: false, word: 'outside' };
+        const above = this.resolve(app, ToolsScope.uriOf(dirname(absolute)), true);
+        if (!above.ok) return above;
+        const path = join(above.file.path, basename(absolute)).split(sep).join('/');
+        return {
+            ok: true,
+            file: { ...above.file, path, real: join(above.file.real, basename(absolute)) }
+        };
+    }
+
+    /**
+     * Resolve a URI for a folder to create with the folders above it: the deepest folder above it
+     * that exists must lie in the scope and be open, and the folders still to make are named under
+     * it.
+     */
+    resolveForCreate(app: HeldApp, uri: unknown): Resolved {
+        const absolute = ToolsScope.pathOf(uri);
+        if (absolute === null) return { ok: false, word: 'outside' };
+        const rest: string[] = [];
+        let probe = absolute;
+        for (;;) {
+            const found = this.resolve(app, ToolsScope.uriOf(probe), true);
+            if (found.ok) {
+                const path = [found.file.path, ...rest].filter((one) => one !== '').join('/');
+                return {
+                    ok: true,
+                    file: { ...found.file, path, real: join(found.file.real, ...rest) }
+                };
+            }
+            if (found.word !== 'missing') return found;
+            const up = dirname(probe);
+            if (up === probe) return { ok: false, word: 'outside' };
+            rest.unshift(basename(probe));
+            probe = up;
+        }
+    }
+
+    /** The deepest folder above a path that exists, with the rest after it. */
+    #nearest(absolute: string): string | null {
+        const rest: string[] = [];
+        let probe = absolute;
+        for (;;) {
+            const found = real(probe);
+            if (found !== null) return join(found, ...rest);
+            const up = dirname(probe);
+            if (up === probe) return null;
+            rest.unshift(basename(probe));
+            probe = up;
+        }
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/streams.ts b/tools/oculus/src/lib/server/machine/apps/tools/streams.ts
