+    const pick = (uri) => {
+        const all = [...instances.values()];
+        if (typeof uri === 'string') {
+            const path = Uri.parse(uri).path;
+            const found = all.find((one) => {
+                const base = Uri.parse(one.folder).path.replace(/\/$/, '');
+                return path === base || path.startsWith(`${base}/`);
