--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/children.mjs
@@ -0,0 +1,26 @@
+// Layer 2, server. The programs the host started for the app (a language server or a debug
+// adapter given as an executable). The runner ends them with SIGKILL when it exits for any reason,
+// so a host that stops, fails or is told to stop leaves none of them running.
+
+const held = new Set();
+let hooked = false;
+
+/**
+ * Hold a started program until it exits.
+ * @param {import('node:child_process').ChildProcess} child
+ */
+export function track(child) {
+    held.add(child);
+    child.once('exit', () => held.delete(child));
+    if (hooked) return;
+    hooked = true;
+    process.once('exit', () => {
+        for (const one of held) {
+            try {
+                one.kill('SIGKILL');
+            } catch {
+                // The program is already gone.
+            }
+        }
+    });
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/runner/tools/debug.mjs b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/debug.mjs
new file mode 100644
index 000000000..e267f5488
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/debug.mjs
@@ -0,0 +1,343 @@
+// Layer 2, server. `oculus.debug` of the host's object: debug adapter descriptor factories, debug
+// configuration providers, `startDebugging`, the active session with `customRequest`, the session
+// and breakpoint events, as VS Code's `debug` names them.
+//
+// oculus decides when a session runs. It asks the runner to start the adapter of a type
+// (`oculus/debug/start`): the runner asks the factory of the type for a descriptor (an executable
+// the runner starts as a child of the host, a port it connects to, or an adapter object inside the
+// host), opens a `debugAdapter` stream and bridges the adapter's messages to it. A type with no
+// factory runs the executable oculus read from the app's manifest, which the request carries.
+// `oculus/debug/configurations` and `oculus/debug/resolve` ask the configuration providers of a
+// type; `oculus/debug/event` tells the session, termination, custom-event and breakpoint events.
+
+import net from 'node:net';
+import { Disposable, EventEmitter } from '../values/events.mjs';
+import {
+    DebugAdapterExecutable,
+    DebugAdapterInlineImplementation,
+    DebugAdapterServer
+} from '../values/run.mjs';
+import { Uri } from '../values/uri.mjs';
+import { NO_CANCEL } from '../values/events.mjs';
+import { executableInstance, instanceEvents } from './languages/servers.mjs';
+
+/** An instance over an adapter that listens on a port. */
+function socketInstance(descriptor, where) {
+    const { StreamMessageReader, StreamMessageWriter } = where.rpc;
+    const socket = net.connect({ port: descriptor.port, host: descriptor.host });
+    const { events, finish } = instanceEvents();
+    socket.on('error', () => finish(-1));
+    socket.on('close', () => finish(0));
+    const reader = new StreamMessageReader(socket);
+    reader.onError(() => undefined);
+    reader.listen((message) => {
+        for (const listener of events.message) listener(message);
+    });
+    const writer = new StreamMessageWriter(socket);
+    return {
+        send: (message) => void writer.write(message).catch(() => undefined),
+        onMessage: (listener) => events.message.push(listener),
+        onClose: (listener) => events.close.push(listener),
+        onStderr: (listener) => events.stderr.push(listener),
+        pause: () => socket.pause(),
+        resume: () => socket.resume(),
+        kill() {
+            socket.destroy();
+        }
+    };
+}
+
+/** An instance over an adapter object that lives in the host. */
+function inlineInstance(descriptor) {
+    const adapter = descriptor.implementation;
+    const events = { message: [], close: [], stderr: [] };
+    let gone = false;
+    const listening = adapter.onDidSendMessage?.((message) => {
+        for (const listener of events.message) listener(message);
+    });
+    return {
+        send: (message) => adapter.handleMessage(message),
+        onMessage: (listener) => events.message.push(listener),
+        onClose: (listener) => events.close.push(listener),
+        onStderr: (listener) => events.stderr.push(listener),
+        pause: () => undefined,
+        resume: () => undefined,
+        kill() {
+            if (gone) return;
+            gone = true;
+            listening?.dispose?.();
+            adapter.dispose?.();
+            for (const listener of events.close) listener(0);
+        }
+    };
+}
+
+/** Connect an adapter instance to its stream, both ways. */
+function connect(stream, instance, report) {
+    stream.backpressure(
+        () => instance.pause(),
+        () => instance.resume()
+    );
+    instance.onMessage((message) => stream.sendMessage(message));
+    instance.onStderr((text) => stream.sendStderr(text));
+    instance.onClose((code) => {
+        if (stream.closed) return;
+        stream.sendControl({ end: true, code });
+        stream.close();
+    });
+    stream.onMessage((message) => {
+        try {
+            instance.send(message);
+        } catch (error) {
+            report(error);
+        }
+    });
+    stream.onClose(() => instance.kill());
+}
+
+/** A plain copy of a configuration, which crosses to oculus as data. */
+function plain(value) {
+    return JSON.parse(JSON.stringify(value ?? {}));
+}
+
+/**
+ * The debug part.
+ * @param {{
+ *   connection: import('vscode-jsonrpc').MessageConnection,
+ *   report: (error: unknown) => void,
+ *   streams: ReturnType<typeof import('../streams.mjs').createStreams>,
+ *   rpc: any,
+ * }} link
+ */
+export function createDebug(link) {
+    const { connection, report, streams } = link;
+    const factories = new Map();
+    const configurers = new Map();
+    const sessions = new Map();
+    const started = new EventEmitter(report);
+    const terminated = new EventEmitter(report);
+    const custom = new EventEmitter(report);
+    const activeChanged = new EventEmitter(report);
+    const breakpointsChanged = new EventEmitter(report);
+    let active;
+    let breakpoints = [];
+
+    /** The `DebugSession` object of the API for a session oculus told. */
+    function sessionOf(info) {
+        let held = sessions.get(info.id);
+        if (held !== undefined) return held;
+        held = {
+            id: info.id,
+            type: info.type,
+            name: info.name,
+            workspaceFolder: info.folder === '' ? undefined : folderOf(info.folder),
+            configuration: info.configuration ?? {},
+            customRequest: (command, args) =>
+                connection.sendRequest('oculus/debug/customRequest', {
+                    session: info.id,
+                    command,
+                    args: args ?? {}
+                }),
+            getDebugProtocolBreakpoint: async () => undefined
+        };
+        sessions.set(info.id, held);
+        return held;
+    }
+
+    function folderOf(uri) {
+        const parsed = Uri.parse(uri);
+        return { uri: parsed, name: parsed.path.split('/').filter(Boolean).at(-1) ?? '', index: 0 };
+    }
+
+    const folderArg = (folder) => (folder === undefined ? '' : folder.uri.toString());
+
+    /** The descriptor the factory of a type answers, or the manifest's executable. */
+    async function descriptorFor(params) {
+        const session = sessionOf(params.session);
+        const executable =
+            params.executable === null
+                ? undefined
+                : new DebugAdapterExecutable(
+                      params.executable.command,
+                      params.executable.args,
+                      params.executable.options
+                  );
+        const factory = factories.get(params.type);
+        if (factory !== undefined) {
+            const given = await factory.createDebugAdapterDescriptor(session, executable);
+            if (given !== undefined && given !== null) return given;
+        }
+        if (executable === undefined) throw new Error('refused:no_adapter');
+        return executable;
+    }
+
+    connection.onRequest('oculus/debug/start', async (params) => {
+        const descriptor = await descriptorFor(params);
+        const where = {
+            cwd: params.cwd,
+            rpc: link.rpc
+        };
+        let instance;
+        if (descriptor instanceof DebugAdapterServer) instance = socketInstance(descriptor, where);
+        else if (descriptor instanceof DebugAdapterInlineImplementation) {
+            instance = inlineInstance(descriptor);
+        } else if (descriptor instanceof DebugAdapterExecutable) {
+            instance = executableInstance(descriptor, where);
+        } else throw new Error('refused:descriptor');
+        const stream = await streams.make('debugAdapter', {
+            token: params.token,
+            type: params.type,
+            session: params.session.id
+        });
+        connect(stream, instance, report);
+        return { stream: stream.id };
+    });
+
+    connection.onRequest('oculus/debug/configurations', async (params) => {
+        const provider = configurers.get(params.type);
+        if (typeof provider?.provideDebugConfigurations !== 'function') return [];
+        const given = await provider.provideDebugConfigurations(
+            params.folder === '' ? undefined : folderOf(params.folder),
+            NO_CANCEL
+        );
+        return Array.isArray(given) ? given.map(plain) : [];
+    });
+
+    connection.onRequest('oculus/debug/resolve', async (params) => {
+        const provider = configurers.get(params.type);
+        const method =
+            params.stage === 'substituted'
+                ? 'resolveDebugConfigurationWithSubstitutedVariables'
+                : 'resolveDebugConfiguration';
+        if (typeof provider?.[method] !== 'function')
+            return { configuration: params.configuration };
+        const folder = params.folder === '' ? undefined : folderOf(params.folder);
+        const resolved = await provider[method](folder, plain(params.configuration), NO_CANCEL);
+        if (resolved === undefined || resolved === null) return { abort: true };
+        return { configuration: plain(resolved) };
+    });
+
+    connection.onNotification('oculus/debug/event', (params) => {
+        if (params.kind === 'started') {
+            const session = sessionOf(params.session);
+            active = session;
+            started.fire(session);
+            activeChanged.fire(session);
+        } else if (params.kind === 'terminated') {
+            const session = sessions.get(params.session.id) ?? sessionOf(params.session);
+            sessions.delete(params.session.id);
+            if (active === session) {
+                active = undefined;
+                activeChanged.fire(undefined);
+            }
+            terminated.fire(session);
+        } else if (params.kind === 'custom') {
+            const session = sessions.get(params.session);
+            if (session !== undefined) {
+                custom.fire({ session, event: params.event, body: params.body });
+            }
+        } else if (params.kind === 'breakpoints') {
+            const before = breakpoints;
+            breakpoints = params.breakpoints.map((one) =>
+                one.functionName === undefined
+                    ? Object.freeze({
+                          ...one,
+                          location: {
+                              uri: Uri.file(one.path),
+                              range: { start: { line: one.line - 1, character: 0 } }
+                          }
+                      })
+                    : Object.freeze(one)
+            );
+            const added = breakpoints.filter((one) => !before.some((old) => old.id === one.id));
+            const removed = before.filter((old) => !breakpoints.some((one) => one.id === old.id));
+            if (added.length > 0 || removed.length > 0) {
+                breakpointsChanged.fire({ added, removed, changed: [] });
+            }
+        }
+    });
+
+    const api = {
+        registerDebugAdapterDescriptorFactory(type, factory) {
+            if (factories.has(type)) throw new Error('refused:registered');
+            if (typeof factory?.createDebugAdapterDescriptor !== 'function') {
+                throw new TypeError('a factory has createDebugAdapterDescriptor');
+            }
+            factories.set(type, factory);
+            void connection
+                .sendRequest('oculus/debug/register', { kind: 'factory', type })
+                .catch((error) => {
+                    if (factories.get(type) === factory) factories.delete(type);
+                    report(error);
+                });
+            return new Disposable(() => {
+                if (factories.get(type) !== factory) return;
+                factories.delete(type);
+                void connection
+                    .sendRequest('oculus/debug/unregister', { kind: 'factory', type })
+                    .catch(report);
+            });
+        },
+        registerDebugConfigurationProvider(type, provider) {
+            if (configurers.has(type)) throw new Error('refused:registered');
+            configurers.set(type, provider);
+            void connection
+                .sendRequest('oculus/debug/register', {
+                    kind: 'configurations',
+                    type,
+                    provides: typeof provider.provideDebugConfigurations === 'function'
+                })
+                .catch((error) => {
+                    if (configurers.get(type) === provider) configurers.delete(type);
+                    report(error);
+                });
+            return new Disposable(() => {
+                if (configurers.get(type) !== provider) return;
+                configurers.delete(type);
+                void connection
+                    .sendRequest('oculus/debug/unregister', { kind: 'configurations', type })
+                    .catch(report);
+            });
+        },
+        async startDebugging(folder, nameOrConfiguration) {
+            const answer = await connection.sendRequest('oculus/debug/startDebugging', {
+                folder: folderArg(folder),
+                name: typeof nameOrConfiguration === 'string' ? nameOrConfiguration : '',
+                configuration:
+                    typeof nameOrConfiguration === 'string' ? null : plain(nameOrConfiguration)
+            });
+            return answer === true;
+        },
+        stopDebugging(session) {
+            return connection.sendRequest('oculus/debug/stopDebugging', {
+                session: session?.id ?? ''
+            });
+        },
+        get activeDebugSession() {
+            return active;
+        },
+        get breakpoints() {
+            return breakpoints;
+        },
+        onDidStartDebugSession: started.event,
+        onDidTerminateDebugSession: terminated.event,
+        onDidReceiveDebugSessionCustomEvent: custom.event,
+        onDidChangeActiveDebugSession: activeChanged.event,
+        onDidChangeBreakpoints: breakpointsChanged.event
+    };
+
+    return {
+        api,
+        /** The session a `{ $debugSession: id }` argument names; undefined for another value. */
+        revive(value) {
+            if (typeof value.$debugSession !== 'string') return undefined;
+            // A session of oculus's own adapter is no session of the host; its argument is null.
+            return sessions.get(value.$debugSession) ?? null;
+        },
+        stop() {
+            factories.clear();
+            configurers.clear();
+            sessions.clear();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/runner/tools/decorations.mjs b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/decorations.mjs
new file mode 100644
index 000000000..615b55d46
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/decorations.mjs
@@ -0,0 +1,130 @@
+// Layer 2, server. `oculus.window.registerFileDecorationProvider` of the host's object: the badge,
+// tooltip and colour a provider gives a file of the Files view. A provider is registered with
+// oculus once for the host (`oculus/decorations/register`); oculus asks for the decorations of the
+// files a page draws (`oculus/decorations/provide`, a list of URIs answered by a list of the
+// answers of every provider, in the order they were registered) and is told which files changed
+// (`oculus/decorations/changed`, a list of URIs, or none for every file).
+//
+// A provider that throws or answers nothing gives no decoration for that file; the answer of the
+// others stands. The URIs of one frame are sent as one message: a provider that fires a change per
+// file does not make a message per file.
+
+import { Disposable, NO_CANCEL } from '../values/events.mjs';
+import { Uri } from '../values/uri.mjs';
+
+/** The milliseconds changes are gathered for before they are sent: one animation frame. */
+const FRAME_MS = 16;
+
+/** The most URIs one change message holds; a larger set is told as a change of every file. */
+const CHANGES_MAX = 5000;
+
+/** A decoration as oculus is sent it, or null when the provider gave none. */
+function plain(value) {
+    if (value === null || value === undefined || typeof value !== 'object') return null;
+    const color = value.color;
+    return {
+        badge: typeof value.badge === 'string' ? value.badge : '',
+        tooltip: typeof value.tooltip === 'string' ? value.tooltip : '',
+        color: typeof color?.id === 'string' ? color.id : '',
+        propagate: value.propagate === true
+    };
+}
+
+/**
+ * The decorations part.
+ * @param {{
+ *   connection: import('vscode-jsonrpc').MessageConnection,
+ *   report: (error: unknown) => void,
+ * }} link
+ */
+export function createDecorations(link) {
+    const { connection, report } = link;
+    const providers = [];
+    let registered = false;
+    let queued = null;
+    let timer = null;
+
+    const flush = () => {
+        timer = null;
+        const uris = queued;
+        queued = null;
+        if (uris === null) return;
+        const all = uris === true;
+        void connection
+            .sendNotification('oculus/decorations/changed', { uris: all ? [] : [...uris], all })
+            .catch(report);
+    };
+
+    /** Gather a change for the next frame; `null` stands for every file. */
+    const changed = (uris) => {
+        if (uris === null || queued === true) queued = true;
+        else {
+            queued ??= new Set();
+            for (const one of uris) queued.add(one);
+            if (queued.size > CHANGES_MAX) queued = true;
+        }
+        if (timer !== null) return;
+        timer = setTimeout(flush, FRAME_MS);
+        timer.unref?.();
+    };
+
+    const urisOf = (value) => {
+        if (value === undefined || value === null) return null;
+        return (Array.isArray(value) ? value : [value]).map((one) => one.toString());
+    };
+
+    connection.onRequest('oculus/decorations/provide', async (params) => {
+        const out = [];
+        for (const uri of params.uris) {
+            const parsed = Uri.parse(uri);
+            const answers = [];
+            for (const entry of [...providers]) {
+                try {
+                    const given = await entry.provider.provideFileDecoration(parsed, NO_CANCEL);
+                    answers.push(plain(given));
+                } catch (error) {
+                    report(error);
+                    answers.push(null);
+                }
+            }
+            out.push(answers);
+        }
+        return out;
+    });
+
+    const api = {
+        registerFileDecorationProvider(provider) {
+            if (typeof provider?.provideFileDecoration !== 'function') {
+                throw new TypeError('a file decoration provider has provideFileDecoration');
+            }
+            const entry = { provider };
+            providers.push(entry);
+            if (!registered) {
+                registered = true;
+                void connection.sendRequest('oculus/decorations/register', {}).catch(report);
+            }
+            const listening = provider.onDidChangeFileDecorations?.((value) =>
+                changed(urisOf(value))
+            );
+            changed(null);
+            return new Disposable(() => {
+                listening?.dispose();
+                providers.splice(providers.indexOf(entry), 1);
+                if (providers.length === 0 && registered) {
+                    registered = false;
+                    void connection.sendRequest('oculus/decorations/unregister', {}).catch(report);
+                }
+                changed(null);
+            });
+        }
+    };
+
+    return {
+        api,
+        stop() {
+            if (timer !== null) clearTimeout(timer);
+            timer = null;
+            queued = null;
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/runner/tools/index.mjs b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/index.mjs
new file mode 100644
index 000000000..1c2f8d340
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/tools/index.mjs
@@ -0,0 +1,162 @@
+// Layer 2, server. The tools' part of the object a host's `activate(oculus)` receives: the value
+// classes of VS Code's API (`Uri`, `Range`, `Position`, `EventEmitter` and the rest), and the
+// namespaces `oculus.languages`, `oculus.debug`, `oculus.tasks`, `oculus.scm` and the additions to
+// `oculus.workspace` and `oculus.window` that reach the tools. The runner (host-runner.mjs) imports
+// it before it installs its import guard and merges what it returns with the shell part.
+//
+// Each namespace is its own module and registers its own requests on the connection; this module
+// makes the streams they share and hands each its parts.
+
+import { createStreams } from '../streams.mjs';
+import { TextDocument } from '../values/document.mjs';
+import * as events from '../values/events.mjs';
+import * as features from '../values/features.mjs';
+import * as ranges from '../values/position-range.mjs';
+import * as text from '../values/text.mjs';
+import { Uri } from '../values/uri.mjs';
+import { bridge, createServerClient } from './languages/servers.mjs';
+import { createProviders } from './languages/providers.mjs';
+import { createDebug } from './debug.mjs';
+import { createDecorations } from './decorations.mjs';
+import { createScm } from './scm.mjs';
+import { createTasks } from './tasks.mjs';
+import { createTerminals } from './terminals.mjs';
+import { createWorkspace, RelativePattern } from './workspace.mjs';
+import * as run from '../values/run.mjs';
+
+/**
+ * Objects joined with their getters kept as getters, so a member such as `terminals` reads the
+ * current value each time the app reads it.
+ */
+export function joined(...parts) {
+    const into = {};
+    for (const part of parts) Object.defineProperties(into, Object.getOwnPropertyDescriptors(part));
+    return into;
+}
+
+/** The value classes and enums every namespace uses, by the names VS Code gives them. */
+function values() {
+    return {
+        ...events,
+        ...features,
+        ...ranges,
+        ...text,
+        ...run,
+        Uri,
+        TextDocument,
+        RelativePattern
+    };
+}
+
+/**
+ * The tools part.
+ * @param {{
+ *   connection: any, report: (e: unknown) => void, note: (line: string) => void,
+ *   texts: () => Record<string, string>, rpc: any,
+ *   shell: { execute: (id: string, args: unknown[]) => Promise<unknown> },
+ * }} link
+ */
+export function createTools(link) {
+    const { connection, report, note } = link;
+    const streams = createStreams({ connection, note, texts: link.texts });
+    const sync = async (uri) => {
+        try {
+            const read = await connection.sendRequest('oculus/workspace/fs', {
+                op: 'readDocument',
+                uri: uri.toString()
+            });
+            return { languageId: read.languageId, text: read.text };
+        } catch {
+            return null;
+        }
+    };
+    const workspace = createWorkspace({ connection, report, rpc: link.rpc, sync });
+    const providers = createProviders({
+        connection,
+        report,
+        note,
+        documents: workspace.documents,
+        events: workspace.documentEvents,
+        sync
+    });
+    const terminals = createTerminals({ connection, report, streams });
+    const tasks = createTasks({ connection, report, terminals });
+    const debug = createDebug({ connection, report, streams, rpc: link.rpc });
+    const scm = createScm({ connection, report, shell: link.shell });
+    const decorations = createDecorations({ connection, report });
+    const clients = new Map();
+    const PROVIDERS = 'providers';
+
+    const languages = {
+        ...providers.api,
+        registerLanguageServer(id, options) {
+            if (clients.has(id)) throw new Error('refused:registered');
+            const made = createServerClient({
+                id,
+                options,
+                connection,
+                streams,
+                rpc: link.rpc,
+                report,
+                note
+            });
+            clients.set(id, made);
+            return made.client;
+        },
+        async getLanguages() {
+            return connection.sendRequest('oculus/languages/list', {});
+        }
+    };
+
+    connection.onRequest('oculus/languages/start', async (params) => {
+        if (params.server === PROVIDERS) {
+            const stream = await streams.make('languageServer', {
+                token: params.token,
+                server: PROVIDERS,
+                root: params.root
+            });
+            const entry = bridge(stream, providers.instance(), {
+                pending: new Map(),
+                requestHandlers: new Map(),
+                noticeHandlers: new Map(),
+                report,
+                gone: () => undefined
+            });
+            entry.folder = params.root;
+            return { stream: stream.id };
+        }
+        const made = clients.get(params.server);
+        if (made === undefined) throw new Error('missing');
+        return made.start(params);
+    });
+
+    return {
+        values: values(),
+        streams,
+        /** The object an argument names in the terminals or the debug sessions, or undefined. */
+        revive: (value) => terminals.revive(value) ?? debug.revive(value),
+        workspace,
+        api: {
+            languages,
+            workspace: workspace.api,
+            window: joined(terminals.api, decorations.api),
+            debug: debug.api,
+            tasks: tasks.api,
+            scm: scm.api
+        },
+        /** Hold what the first activation carried. */
+        start(folders) {
+            workspace.start(folders);
+            void terminals.start();
+        },
+        /** End everything the tools hold when the host stops. */
+        stop() {
+            decorations.stop();
+            tasks.stop();
+            debug.stop();
+            scm.stop();
+            terminals.stop();
+            streams.closeAll();
+        }
+    };
+}
