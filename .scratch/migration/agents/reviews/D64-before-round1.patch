+    for (let waited = 0; waited < 8000; waited += 50) {
+        if (w.hosts.tools.decorations.changes().epoch > epoch) return;
+        await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    throw new Error('no change was told');
+}
