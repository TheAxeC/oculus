+    /** The named patterns, then the matchers that may refer to them. */
+    matchers(patterns: unknown, matchers: unknown): void {
+        const defs = this.#h.parse('problemPatterns', patterns);
+        const known = new Map<string, AppProblemPattern[]>();
+        defs?.forEach((def, at) => {
