diff --git a/tools/oculus/src/lib/server/machine/debug/session/controls.ts b/tools/oculus/src/lib/server/machine/debug/session/controls.ts
new file mode 100644
index 000000000..7d0890ed4
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/session/controls.ts
@@ -0,0 +1,207 @@
+// Layer 2, server. The requests of a debug session that follow what the adapter declared: Pause,
+// setting a variable, restart, the Debug Console's completions and the loaded sources, and the two
+// ways an app's host reaches its own session, a custom request and the events it is told. Each
+// one is refused in words when the adapter did not declare it, so no control the adapter lacks
+// ever sends a request. The session (session.ts) gives this module the narrow `Core` it needs of
+// the run in progress.
+
+import type { DebugLoadedSource, DebugStatus } from '../../../../data/model/index.ts';
+import { words } from '../../../core/words.ts';
+import { RITE } from '../app/capabilities.ts';
+import type { AppDebugPort } from '../app/port.ts';
+import {
+    completionsIn,
+    loadedSourcesIn,
+    setVariableIn,
+    type Completion,
+    type Link
+} from '../inspect.ts';
+import type { Refusal, Run } from './types.ts';
+import type { Command, Requests } from '../wire.ts';
+
+/** What the controls need of the session that owns them. */
+export type Core = {
+    run(): Run | null;
+    status(): DebugStatus;
+    active(): boolean;
+    frame(): number | null;
+    catalog(): Record<string, string>;
+    port(): AppDebugPort | undefined;
+    sessionName(): string;
+    link(run: Run): Link;
+    ask<C extends Command>(run: Run, command: C, args: Requests[C]): Promise<unknown>;
+    attempt<T>(run: Run, work: () => Promise<T>): Promise<Refusal | T>;
+    /**
+     * Read the variables and the watch again in a frame, if the pause is still the one asked in.
+     */
+    refresh(run: Run, token: number, frame: number): Promise<void>;
+    clearPause(): void;
+    setRunning(): void;
+};
+
+/** The session id a host knows a run by. */
+export function sessionId(run: Run): string {
+    return `s${run.number}`;
+}
+
+/** The controls of a session. */
+export class Controls {
+    readonly #core: Core;
+
+    constructor(core: Core) {
+        this.#core = core;
+    }
+
+    #refuse(sentence: string): Refusal {
+        return { error: sentence };
+    }
+
+    /** The run when the program is paused, else the refusal. */
+    #paused(): Run | Refusal {
+        const run = this.#core.run();
+        return run === null || this.#core.status() !== 'paused'
+            ? this.#refuse(words(this.#core.catalog(), 'server.debug.not_paused'))
+            : run;
+    }
+
+    /** Pause the running program, when the adapter declared that it can. */
+    async pause(): Promise<Refusal | { ok: true }> {
+        const run = this.#core.run();
+        if (run === null || this.#core.status() !== 'running') {
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_running'));
+        }
+        if (!run.capabilities.pause)
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_declared'));
+        return this.#core.attempt(run, async () => {
+            await this.#core.ask(run, 'pause', { threadId: run.thread });
+            return { ok: true as const };
+        });
+    }
+
+    /** Set a variable of a scope of the selected frame, and read the scopes and the watch again. */
+    async setVariable(
+        reference: number,
+        name: string,
+        value: string
+    ): Promise<Refusal | { value: string }> {
+        const run = this.#paused();
+        if ('error' in run) return run;
+        if (!run.capabilities.setVariable)
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_declared'));
+        const frame = this.#core.frame();
+        const token = run.stop;
+        return this.#core.attempt(run, async () => {
+            const set = await setVariableIn(this.#core.link(run), reference, name, value);
+            if (frame !== null && run.stop === token) await this.#core.refresh(run, token, frame);
+            return { value: set };
+        });
+    }
+
+    /** Run the program again through the adapter's own `restart`, when it declared one. */
+    async restart(): Promise<Refusal | { ok: true }> {
+        const run = this.#core.run();
+        if (run === null || !this.#core.active())
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.no_session'));
+        if (!run.capabilities.restart)
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_declared'));
+        run.stop += 1;
+        this.#core.clearPause();
+        this.#core.setRunning();
+        return this.#core.attempt(run, async () => {
+            await this.#core.ask(run, 'restart', {});
+            return { ok: true as const };
+        });
+    }
+
+    /** The completions the adapter gives for a text of the Debug Console. */
+    async completions(text: string, column: number): Promise<Refusal | { items: Completion[] }> {
+        const run = this.#paused();
+        if ('error' in run) return run;
+        if (!run.capabilities.completions)
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_declared'));
+        return this.#core.attempt(run, async () => ({
+            items: await completionsIn(this.#core.link(run), text, column, this.#core.frame())
+        }));
+    }
+
+    /** The sources the adapter reports loaded. */
+    async loadedSources(): Promise<Refusal | { sources: DebugLoadedSource[] }> {
+        const run = this.#core.run();
+        if (run === null || !this.#core.active())
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.no_session'));
+        if (!run.capabilities.loadedSources)
+            return this.#refuse(words(this.#core.catalog(), 'server.debug.not_declared'));
+        return this.#core.attempt(run, async () => ({
+            sources: await loadedSourcesIn(this.#core.link(run))
+        }));
+    }
+
+    /** A request of the app's own to the adapter, as `customRequest` sends it. */
+    async custom(command: string, args: unknown): Promise<unknown> {
+        const run = this.#core.run();
+        if (run === null || !this.#core.active() || run.wire === null) {
+            throw new Error('refused:no_session');
+        }
+        return run.wire.named(command, args);
+    }
+
+    /** The session now running, as a host knows it. */
+    current(): { id: string; type: string } | null {
+        const run = this.#core.run();
+        return run === null || !this.#core.active() ? null : { id: sessionId(run), type: run.type };
+    }
+
+    /** Tell the host of the debugger what happened to its session. */
+    tell(run: Run, kind: string, more: Record<string, unknown> = {}): void {
+        const port = this.#core.port();
+        if (run.type === RITE || port === undefined) return;
+        if (kind === 'custom' || kind === 'sources') {
+            port.tell(run.type, { kind, session: sessionId(run), ...more });
+            return;
+        }
+        port.tell(run.type, {
+            kind,
+            session: {
+                id: sessionId(run),
+                type: run.type,
+                name: this.#core.sessionName(),
+                folder: run.app?.folder ?? '',
+                configuration: run.app?.configuration ?? {}
+            }
+        });
+    }
+}
+
+/** The breakpoints the page holds as the host's `debug.breakpoints` lists them. */
+export function breakpointsEvent(held: {
+    breakpoints: {
+        path: string;
+        lines: { line: number; condition?: string; hitCondition?: string; logMessage?: string }[];
+    }[];
+    functions: { name: string; condition?: string; hitCondition?: string }[];
+}): Record<string, unknown> {
+    return {
+        kind: 'breakpoints',
+        breakpoints: [
+            ...held.breakpoints.flatMap((file) =>
+                file.lines.map((one) => ({
+                    id: `${file.path}:${one.line}`,
+                    path: file.path,
+                    line: one.line,
+                    enabled: true,
+                    condition: one.condition ?? '',
+                    hitCondition: one.hitCondition ?? '',
+                    logMessage: one.logMessage ?? ''
+                }))
+            ),
+            ...held.functions.map((one) => ({
+                id: `fn:${one.name}`,
+                functionName: one.name,
+                enabled: true,
+                condition: one.condition ?? '',
+                hitCondition: one.hitCondition ?? '',
+                logMessage: ''
+            }))
+        ]
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/session/send.ts b/tools/oculus/src/lib/server/machine/debug/session/send.ts
new file mode 100644
index 000000000..b0ce6e81f
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/session/send.ts
@@ -0,0 +1,75 @@
+// Layer 2, server. What the debug client (session.ts) sends an adapter about breakpoints once the
+// handshake allows it: one file's breakpoints, the function breakpoints and the exception filters
+// that are on. A condition, a hit condition and a log message go to the adapter only for what it
+// declared, and an answer is dropped when the run it was asked in is no longer the current one.
+
+import type { ZodType } from 'zod';
+import type { DebugBreakpointSpec } from '../../../../data/model/index.ts';
+import { realPath } from '../../../core/paths.ts';
+import { RITE } from '../app/capabilities.ts';
+import type { Filters } from '../app/filters.ts';
+import type { Breakpoints } from '../breakpoints.ts';
+import { breakpointsShape } from '../shapes.ts';
+import type { Command, Requests } from '../wire.ts';
+import type { FunctionSpec, Run } from './types.ts';
+
+/** What the sends need of the client: the request, the shape reader and the stores they fill. */
+export type Sending = {
+    ask: <C extends Command>(run: Run, command: C, args: Requests[C]) => Promise<unknown>;
+    read: <T>(run: Run, shape: ZodType<T>, body: unknown) => T;
+    current: (run: Run) => boolean;
+    breakpoints: Breakpoints;
+    filters: Filters;
+};
+
+/**
+ * Set one file's breakpoints. A condition, a hit condition and a log message go to the adapter
+ * only for what it declared; a breakpoint that carries one the adapter did not declare is set
+ * as a plain breakpoint.
+ */
+export async function sendBreakpoints(
+    sending: Sending,
+    run: Run,
+    path: string,
+    specs: DebugBreakpointSpec[]
+): Promise<void> {
+    run.named.set(realPath(path) ?? path, path);
+    const caps = run.capabilities;
+    const kept = specs.map((spec) => ({
+        line: spec.line,
+        ...(caps.conditions && spec.condition ? { condition: spec.condition } : {}),
+        ...(caps.hitConditions && spec.hitCondition ? { hitCondition: spec.hitCondition } : {}),
+        ...(caps.logpoints && spec.logMessage ? { logMessage: spec.logMessage } : {})
+    }));
+    const body = await sending.ask(run, 'setBreakpoints', { source: { path }, breakpoints: kept });
+    const answers = sending.read(run, breakpointsShape, body).breakpoints;
+    if (!sending.current(run)) return;
+    sending.breakpoints.setFile(path, specs, answers);
+}
+
+/** Set the function breakpoints the page holds. */
+export async function sendFunctions(
+    sending: Sending,
+    run: Run,
+    specs: FunctionSpec[]
+): Promise<void> {
+    const caps = run.capabilities;
+    const body = await sending.ask(run, 'setFunctionBreakpoints', {
+        breakpoints: specs.map((spec) => ({
+            name: spec.name,
+            ...(caps.functionConditions && spec.condition ? { condition: spec.condition } : {}),
+            ...(caps.functionConditions && caps.hitConditions && spec.hitCondition
+                ? { hitCondition: spec.hitCondition }
+                : {})
+        }))
+    });
+    const answers = sending.read(run, breakpointsShape, body).breakpoints;
+    if (!sending.current(run)) return;
+    sending.breakpoints.setFunctions(specs, answers);
+}
+
+/** Send the exception filters that are on; the oculus adapter is sent none. */
+export async function sendExceptions(sending: Sending, run: Run): Promise<void> {
+    if (run.type !== RITE && sending.filters.list().length === 0) return;
+    await sending.ask(run, 'setExceptionBreakpoints', sending.filters.body());
+}
diff --git a/tools/oculus/src/lib/server/machine/debug/session/start.ts b/tools/oculus/src/lib/server/machine/debug/session/start.ts
new file mode 100644
index 000000000..53bff22bb
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/debug/session/start.ts
@@ -0,0 +1,321 @@
+// Layer 2, server. What a launch does before the client starts a session: the configuration is
+// found (a `launch.yml` entry by name, the default configuration, or one a host's
+// `startDebugging` gives), its program and folder are resolved, and the adapter it names is
+// chosen. A configuration of oculus's own adapter runs a `.rite` file that is approved by its text.
+// A configuration of an app's debugger asks no approval: the app is approved, and the adapter it
+// starts is its own. The app's providers resolve the configuration before and after its
+// placeholders are filled, and a provider that answers nothing aborts the launch. The same
+// function serves the `launch` action of POST /api/debug (routes.ts) and the `startDebugging` of
+// an app's host (`debugControl`), so both refuse the same things in the same order.
+
+import { statSync } from 'node:fs';
+import { isAbsolute, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import type {
+    DebugBreakpointSpec,
+    DebugConfiguration,
+    TerminalRefusal
+} from '../../../../data/model/index.ts';
+import { inside, realPath } from '../../../core/paths.ts';
+import { words } from '../../../core/words.ts';
+import { debugText, isApproved } from '../../approvals/approvals.ts';
+import { folderOf } from '../../runs/commands/files.ts';
+import { fillText } from '../../runs/commands/placeholders.ts';
+import { repositoryOf } from '../../runs/commands/repo.ts';
+import { fillConfiguration, isRefusal } from '../app/resolve.ts';
+import type { AppDebugPort, DebugControl } from '../app/port.ts';
+import { DEFAULT_CWD, DEFAULT_PROGRAM, RITE_TYPE, readLaunch } from '../launch/read.ts';
+import type { DebugClient, FunctionSpec } from '../session.ts';
+
+/** What a launch needs of the process. */
+export type StartDeps = {
+    /** The directories the file browser serves, from which a repository and a program are taken. */
+    rootsFor: () => string[];
+    /** The approvals file. */
+    approvalsFor: () => string;
+    /** The text catalog. */
+    catalog: () => Record<string, string>;
+    client: DebugClient;
+    port: () => AppDebugPort | undefined;
+};
+
+/** What a launch is asked for. */
+export type StartInput = {
+    repo: string;
+    /** The name of a `launch.yml` entry; null for the default configuration. */
+    name: string | null;
+    /** A configuration given whole, as `startDebugging` does; it takes the place of the name. */
+    configuration?: DebugConfiguration;
+    context: { file?: string };
+    breakpoints: { path: string; lines: DebugBreakpointSpec[] }[];
+    functions: FunctionSpec[];
+    watch: string[];
+};
+
+/** How a launch ended up. */
+export type Started =
+    | { ok: true }
+    | { approve: { name: string; cwd: string; program: string } }
+    | { error: string }
+    | { refusal: TerminalRefusal; names: string[] };
+
+/** The most line numbers one file's breakpoints may hold. */
+const LINES_MAX = 10_000;
+
+/** Whether a path lies under a root the file browser serves, as written and as it resolves. */
+function served(path: string, roots: string[]): boolean {
+    const real = realPath(path);
+    return roots.some((root) => {
+        const rootReal = realPath(root);
+        return (
+            inside(path, root) && (real === null || (rootReal !== null && inside(real, rootReal)))
+        );
+    });
+}
+
+/** The sentence refusing a file's breakpoints, or null when its path and lines are as asked. */
+export function fileRefusal(
+    file: { path: string; lines: { line: number }[] },
+    roots: string[],
+    catalog: Record<string, string>
+): string | null {
+    if (!isAbsolute(file.path) || !roots.some((root) => inside(file.path, root))) {
+        return words(catalog, 'server.debug.bad_path');
+    }
+    if (!file.lines.every((one) => Number.isInteger(one.line) && one.line >= 1)) {
+        return words(catalog, 'server.debug.bad_lines');
+    }
+    if (file.lines.length > LINES_MAX) return words(catalog, 'server.debug.too_many_lines');
+    return null;
+}
+
+/**
+ * The absolute path of the program a launch of the oculus adapter runs and the folder it runs in,
+ * or the refusal.
+ */
+function riteRun(
+    repo: string,
+    context: { file?: string },
+    program: string,
+    cwd: string,
+    deps: StartDeps
+): { program: string; cwd: string } | Exclude<Started, { ok: true } | { approve: object }> {
+    const catalog = deps.catalog();
+    const folder = folderOf(repo, cwd === DEFAULT_CWD ? undefined : cwd);
+    if (typeof folder !== 'string') {
+        return { error: words(catalog, 'server.debug.field_problem', 'cwd', folder.message) };
+    }
+    const filled = fillText(program, { file: context.file }, repo);
+    if (typeof filled !== 'string') return { refusal: filled.error, names: filled.names };
+    const path = isAbsolute(filled) ? filled : resolve(repo, filled);
+    if (!served(path, deps.rootsFor())) {
+        return { error: words(catalog, 'server.debug.unserved', path) };
+    }
+    const real = realPath(path);
+    if (real === null || !statSync(real).isFile() || !path.endsWith('.rite')) {
+        return { error: words(catalog, 'server.debug.not_rite', path) };
+    }
+    return { program: path, cwd: folder };
+}
+
+/**
+ * The configuration an app's providers resolve and the placeholders fill, ready for the adapter.
+ */
+async function appConfiguration(
+    input: StartInput,
+    configuration: DebugConfiguration,
+    folderUri: string,
+    deps: StartDeps
+): Promise<
+    | { configuration: Record<string, unknown> }
+    | Exclude<Started, { ok: true } | { approve: object }>
+> {
+    const port = deps.port();
+    const catalog = deps.catalog();
+    if (port === undefined) {
+        return { error: words(catalog, 'server.debug.no_debugger', configuration.type) };
+    }
+    if (!(await port.activate(configuration.type))) {
+        return { error: words(catalog, 'server.debug.host_down', configuration.type) };
+    }
+    const base: Record<string, unknown> = {
+        ...configuration.args,
+        type: configuration.type,
+        request: configuration.request,
+        name: configuration.name,
+        ...(configuration.program === '' ? {} : { program: configuration.program }),
+        ...(configuration.cwd === DEFAULT_CWD ? {} : { cwd: configuration.cwd })
+    };
+    let initial: Awaited<ReturnType<AppDebugPort['resolve']>>;
+    try {
+        initial = await port.resolve(configuration.type, folderUri, base, 'initial');
+    } catch (error) {
+        return { error: words(catalog, 'server.debug.resolve_failed', String(error)) };
+    }
+    if ('abort' in initial) return { error: words(catalog, 'server.debug.aborted') };
+    const filled = fillConfiguration(initial.configuration, input.context, input.repo);
+    if (isRefusal(filled)) return { refusal: filled.error, names: filled.names };
+    let substituted: Awaited<ReturnType<AppDebugPort['resolve']>>;
+    try {
+        substituted = await port.resolve(
+            configuration.type,
+            folderUri,
+            filled as Record<string, unknown>,
+            'substituted'
+        );
+    } catch (error) {
+        return { error: words(catalog, 'server.debug.resolve_failed', String(error)) };
+    }
+    if ('abort' in substituted) return { error: words(catalog, 'server.debug.aborted') };
+    return { configuration: substituted.configuration };
+}
+
+/** Start a session for a configuration: the oculus adapter's or an app debugger's. */
+export async function startSession(input: StartInput, deps: StartDeps): Promise<Started> {
+    const catalog = deps.catalog();
+    const roots = deps.rootsFor();
+    for (const file of input.breakpoints) {
+        const refused = fileRefusal(file, roots, catalog);
+        if (refused !== null) return { error: refused };
+    }
+    const debuggers = deps.client.debuggers();
+    const configuration: DebugConfiguration | undefined =
+        input.configuration ??
+        (input.name === null
+            ? {
+                  name: words(catalog, 'server.debug.default_name'),
+                  type: RITE_TYPE,
+                  request: 'launch',
+                  args: {},
+                  program: DEFAULT_PROGRAM,
+                  cwd: DEFAULT_CWD
+              }
+            : readLaunch(
+                  input.repo,
+                  debuggers.map((one) => one.debugger)
+              ).configurations.find((one) => one.name === input.name));
+    if (configuration === undefined) {
+        return { error: words(catalog, 'server.debug.no_configuration', input.name ?? '') };
+    }
+    if (configuration.type === RITE_TYPE) {
+        const run = riteRun(
+            input.repo,
+            input.context,
+            configuration.program,
+            configuration.cwd,
+            deps
+        );
+        if ('error' in run || 'refusal' in run) return run;
+        const text = debugText(input.repo, configuration.cwd, configuration.program);
+        if (!isApproved(deps.approvalsFor(), text)) {
+            const { name, cwd, program } = configuration;
+            return { approve: { name, cwd, program } };
+        }
+        const started = deps.client.launch({
+            repo: input.repo,
+            name: configuration.name,
+            program: run.program,
+            cwd: run.cwd,
+            breakpoints: input.breakpoints,
+            functions: input.functions,
+            watch: input.watch
+        });
+        return 'error' in started ? started : { ok: true };
+    }
+    const entry = debuggers.find((one) => one.debugger.type === configuration.type);
+    if (entry === undefined) {
+        return { error: words(catalog, 'server.debug.no_debugger', configuration.type) };
+    }
+    const folder = folderOf(
+        input.repo,
+        configuration.cwd === DEFAULT_CWD ? undefined : configuration.cwd
+    );
+    if (typeof folder !== 'string') {
+        return { error: words(catalog, 'server.debug.field_problem', 'cwd', folder.message) };
+    }
+    const folderUri = pathToFileURL(input.repo).toString();
+    const resolved = await appConfiguration(input, configuration, folderUri, deps);
+    if ('error' in resolved || 'refusal' in resolved) return resolved;
+    const program =
+        typeof resolved.configuration.program === 'string' ? resolved.configuration.program : '';
+    const started = deps.client.launch({
+        repo: input.repo,
+        name: configuration.name,
+        program,
+        cwd: folder,
+        breakpoints: input.breakpoints,
+        functions: input.functions,
+        watch: input.watch,
+        app: {
+            app: entry.app,
+            type: entry.debugger.type,
+            label: entry.debugger.label,
+            request: configuration.request,
+            configuration: resolved.configuration,
+            folder: folderUri
+        }
+    });
+    return 'error' in started ? started : { ok: true };
+}
+
+/** The control an app's host reaches its sessions through. */
+export function debugControl(deps: StartDeps): DebugControl {
+    return {
+        async start(request) {
+            const folder = new URL(request.folder === '' ? 'file:///' : request.folder).pathname;
+            const found = repositoryOf(decodeURIComponent(folder), deps.rootsFor());
+            if ('error' in found || deps.client.active) return false;
+            const held = deps.client.held();
+            const given = request.configuration;
+            const configuration: DebugConfiguration | undefined =
+                given === null
+                    ? undefined
+                    : {
+                          name: typeof given.name === 'string' ? given.name : request.name,
+                          type: typeof given.type === 'string' ? given.type : '',
+                          request: given.request === 'attach' ? 'attach' : 'launch',
+                          args: Object.fromEntries(
+                              Object.entries(given).filter(
+                                  ([key]) =>
+                                      ![
+                                          'name',
+                                          'type',
+                                          'request',
+                                          'program',
+                                          'cwd',
+                                          'before'
+                                      ].includes(key)
+                              )
+                          ),
+                          program: typeof given.program === 'string' ? given.program : '',
+                          cwd: typeof given.cwd === 'string' ? given.cwd : DEFAULT_CWD
+                      };
+            const started = await startSession(
+                {
+                    repo: found.repo,
+                    name: configuration === undefined ? request.name : null,
+                    ...(configuration === undefined ? {} : { configuration }),
+                    context: {},
+                    breakpoints: held.breakpoints,
+                    functions: held.functions,
+                    watch: held.watch
+                },
+                deps
+            );
+            return 'ok' in started;
+        },
+        stop: (session) => {
+            const current = deps.client.controls.current();
+            if (current?.id !== session) return Promise.resolve(false);
+            return Promise.resolve('ok' in deps.client.stop(true));
+        },
+        custom: (session, command, args) => {
+            const current = deps.client.controls.current();
+            if (current?.id !== session) {
+                return Promise.reject(new Error('refused:no_session'));
+            }
+            return deps.client.controls.custom(command, args);
+        },
+        current: () => deps.client.controls.current()
+    };
+}
