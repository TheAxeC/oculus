index 000000000..b6b47e6e9
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/relay/relay-route.ts
@@ -0,0 +1,554 @@
+// Layer 2, server. The routing of a page's messages: one text from a socket on an `lsp:` channel
+// is read as a frame, and its message is answered by the relay (`initialize`, `shutdown`),
+// applied to the page's documents (`didOpen`, `didChange`, `didClose`), turned into an answer of
+// the entry's own (`answers`), or routed by the document it names to the server that holds the
+// document, with the addresses turned into the server's and the id into one of the relay's. A
+// request about the workspace (its symbols) and a follow-up of a hierarchy item name a root and a
+// file that may be open in no tab, and go to the server of that root.
+
+import type { LspRpc } from '../../../../data/model/index.ts';
+import { WORKSPACE_LANGUAGE } from '../../../../data/prose/lsp-servers.ts';
+import type { Sink } from '../../../core/channels.ts';
+import { answerFor } from '../held/answers.ts';
+import { adoptHeld, changeDocument, closeDocument, openingTarget } from '../held/documents.ts';
+import { workspaceMessage } from '../held/elsewhere.ts';
+import { askLinks, type LinksContext } from '../held/requests/links.ts';
+import { handleOculus, heldOf, type OculusContext } from '../held/oculus.ts';
+import {
+    docKey,
+    heldKey,
+    type Doc,
+    type Held,
+    type Open,
+    type Page,
+    type Session
+} from '../held/held.ts';
+import { libraryFile } from '../library/pages.ts';
+import type { PageAnswer, ServerEntry } from '../servers.ts';
+import { appInfo, entriesFor, selects } from './relay-apps.ts';
+import { JOIN_MS, declaring, joinKind, resolveOf, untagged, type Join } from './relay-join.ts';
+import { normal, parsePageUri, toServer } from '../uris.ts';
+import { HIERARCHY, addressOf, isRecord, languageOf, readFrame, type Inbound } from '../wire.ts';
+import { configOf, envOf, makeHeld } from './relay-make.ts';
+import { replayCollections, settleJoin } from './relay-server.ts';
+import { fail, mapperOf, pageOf, publishState, reply, rootsOf, send } from './relay-pages.ts';
+import {
+    INVALID_PARAMS,
+    METHOD_NOT_FOUND,
+    REQUEST_CANCELLED,
+    type RelayState
+} from './relay-state.ts';
+
+/**
+ * One text from a socket. Answers whether it was a frame of an `lsp:` channel, which the
+ * terminals then leave alone; a frame from a socket that did not carry the token is read and
+ * dropped.
+ */
+export function inbound(state: RelayState, sink: Sink, data: string): boolean {
+    const frame = readFrame(data);
+    if (frame === null) return false;
+    if (!state.canWrite(sink) || frame.payload === null) return true;
+    const language = languageOf(frame.channel);
+    const entries = language === null ? [] : entriesFor(state, language);
+    if (language === null || (entries.length === 0 && language !== WORKSPACE_LANGUAGE)) {
+        return true;
+    }
+    const page = pageOf(state, sink);
+    let session = page.sessions.get(frame.channel);
+    if (session === undefined) {
+        session = { version: 0, capabilities: {} };
+        page.sessions.set(frame.channel, session);
+    }
+    if (entries.length === 0) {
+        workspaceMessage(state.pages.values(), page, rootsOf(state), frame.payload, (payload) =>
+            send(state, page, frame.channel, payload)
+        );
+        return true;
+    }
+    const payload: Inbound = frame.payload;
+    if (payload.kind === 'oculus' && payload.message.oculus === 'links') {
+        void askLinks(linksContext(state), page, frame.channel, entries[0], payload.message);
+    } else if (payload.kind === 'oculus') {
+        const server = 'server' in payload.message ? payload.message.server : undefined;
+        const entry = entries.find((one) => one.id === server) ?? entries[0];
+        handleOculus(oculusContext(state), page, frame.channel, entry, payload.message).catch(
+            () => undefined
+        );
+    } else {
+        rpc(state, page, frame.channel, language, entries, session, payload.message);
+    }
+    return true;
+}
+
+/** What the oculus messages of the page read of the relay. */
+function oculusContext(state: RelayState): OculusContext {
+    return {
+        roots: () => rootsOf(state),
+        config: () => configOf(state),
+        env: (root) => envOf(state, root),
+        changes: () => state.options.changes?.(),
+        send: (page, channel, payload) => send(state, page, channel, payload)
+    };
+}
+
+/** What the link rewrite of a move reads of the relay. */
+function linksContext(state: RelayState): LinksContext {
+    return {
+        ...oculusContext(state),
+        extensions: () => state.options.markdown?.() ?? ['md'],
+        orphans: state.orphans,
+        make: (page, entry, root, key) => makeHeld(state, page, entry, root, key),
+        mapper: (page, held) => mapperOf(state, page, held)
+    };
+}
+
+function rpc(
+    state: RelayState,
+    page: Page,
+    channel: string,
+    language: string,
+    entries: readonly ServerEntry[],
+    session: Session,
+    message: LspRpc
+): void {
+    const entry = entries[0];
+    const method = message.method;
+    if (method === undefined) {
+        answered(state, message);
+        return;
+    }
+    switch (method) {
+        // Each one is answered, a client the page makes again on the same socket included, and
+        // none reaches a server, which was initialized when it started.
+        case 'initialize':
+            session.capabilities = isRecord(message.params)
+                ? ((message.params.capabilities as Record<string, unknown> | undefined) ?? {})
+                : {};
+            reply(state, page, channel, message.id, {
+                capabilities: entry.capabilities(language),
+                serverInfo: { name: 'oculus' }
+            });
+            return;
+        case 'shutdown':
+            reply(state, page, channel, message.id, null);
+            return;
+        case 'initialized':
+        case 'exit':
+        case 'workspace/didChangeWorkspaceFolders':
+        case 'workspace/didChangeWatchedFiles':
+            return;
+        case '$/cancelRequest':
+            cancel(state, page, channel, message.params);
+            return;
+        case 'textDocument/didOpen':
+            didOpen(state, page, channel, language, entries, message.params);
+            return;
+        case 'textDocument/didChange':
+            changeDocument(page, message.params);
+            return;
+        case 'textDocument/didClose':
+            closeDocument(page, message.params);
+            return;
+        default:
+            route(state, page, channel, language, entries, message);
+    }
+}
+
+/** The page's answer to something a server asked it: sent on to the server it came from. */
+function answered(state: RelayState, message: LspRpc): void {
+    const key = String(message.id);
+    const ask = state.asks.get(key);
+    if (ask === undefined) return;
+    state.asks.delete(key);
+    if (ask.id === null) return;
+    const answer: LspRpc = { jsonrpc: '2.0', id: ask.id };
+    if (message.error !== undefined) answer.error = message.error;
+    else answer.result = message.result ?? null;
+    ask.held.notify(answer);
+}
+
+/** A page's `$/cancelRequest`: its id, turned into the one its server was given. */
+function cancel(state: RelayState, page: Page, channel: string, params: unknown): void {
+    const id = isRecord(params) ? params.id : undefined;
+    for (const [relayId, pending] of state.pending) {
+        if (pending.page === page && pending.channel === channel && pending.id === id) {
+            pending.held.notify({
+                jsonrpc: '2.0',
+                method: '$/cancelRequest',
+                params: { id: relayId }
+            });
+        }
+    }
+}
+
+/** A request or notification that names a document: routed to the servers the document is on. */
+function route(
+    state: RelayState,
+    page: Page,
+    channel: string,
+    language: string,
+    entries: readonly ServerEntry[],
+    message: LspRpc
+): void {
+    const method = message.method ?? '';
+    const isRequest = message.id !== undefined && message.id !== null;
+    const entry = entries[0];
+    const resolved = untagged(method, message.params);
+    const given =
+        isRequest && appInfo(entry) === undefined
+            ? givenBy(state, page, entry, method, resolved.params)
+            : undefined;
+    if (given !== undefined) {
+        if ('result' in given) reply(state, page, channel, message.id, given.result);
+        else fail(state, page, channel, message.id, given.error.code, given.error.message);
+        return;
+    }
+    const address = addressOf(method, resolved.params);
+    const open = address === null ? undefined : page.docs.get(address);
+    const targets = open === undefined ? [] : [open.held, ...open.also.map((one) => one.held)];
+    let held: Held | undefined;
+    let joinWith: Held[] = [];
+    if (open !== undefined) {
+        const asked = resolveOf(method) ?? method;
+        const offering = declaring(targets, asked, language);
+        if (resolved.entryId !== null) {
+            held = targets.find((one) => one.entry.id === resolved.entryId) ?? open.held;
+        } else if (resolveOf(method) !== undefined) {
+            held = targets[0];
+        } else if (offering.length === 0) {
+            held = open.held;
+        } else if (offering.length === 1 || joinKind(method) === 'first') {
+            held = offering[0];
+        } else {
+            held = offering[0];
+            joinWith = offering;
+        }
+    } else {
+        held = heldFor(state, page, entries, method, resolved.params, address);
+    }
+    if (held === undefined) {
+        if (isRequest) {
+            const text =
+                address === null ? `${method} names no document` : 'the document is not open';
+            fail(
+                state,
+                page,
+                channel,
+                message.id,
+                address === null ? METHOD_NOT_FOUND : INVALID_PARAMS,
+                text
+            );
+        }
+        return;
+    }
+    const sendTo = (to: Held): { value: unknown } | null =>
+        toServer(asked(method, resolved.params), rootsOf(state), (uri) =>
+            libraryFile(page, to, uri)
+        );
+    if (!isRequest) {
+        for (const to of joinWith.length > 1 ? joinWith : [held]) {
+            const params = sendTo(to);
+            if (params !== null) to.notify({ jsonrpc: '2.0', method, params: params.value });
+        }
+        return;
+    }
+    if (joinWith.length > 1) {
+        requestJoined(state, page, channel, message, joinWith, address ?? '', sendTo);
+        return;
+    }
+    const params = sendTo(held);
+    if (params === null) {
+        fail(state, page, channel, message.id, INVALID_PARAMS, 'an address is refused');
+        return;
+    }
+    state.next += 1;
+    const accepted = held.request({
+        jsonrpc: '2.0',
+        id: state.next,
+        method,
+        params: params.value
+    });
+    if (!accepted) {
+        fail(state, page, channel, message.id, REQUEST_CANCELLED, 'the server is not running');
+        return;
+    }
+    state.pending.set(state.next, {
+        page,
+        channel,
+        id: message.id ?? null,
+        held,
+        method,
+        address: address ?? ''
+    });
+}
+
+/**
+ * A request several servers answer: each is asked, and the page is answered once, when all have
+ * answered or when the bound has passed for the apps' servers (relay-join.ts).
+ */
+function requestJoined(
+    state: RelayState,
+    page: Page,
+    channel: string,
+    message: LspRpc,
+    helds: readonly Held[],
+    address: string,
+    sendTo: (held: Held) => { value: unknown } | null
+): void {
+    const method = message.method ?? '';
+    const join: Join = {
+        page,
+        channel,
+        id: message.id ?? null,
+        method,
+        parts: [],
+        timer: null,
+        replied: false,
+        errors: []
+    };
+    for (const held of helds) {
+        const params = sendTo(held);
+        if (params === null) continue;
+        state.next += 1;
+        const part = { held, relayId: state.next, answered: false, result: null as unknown };
+        join.parts.push(part);
+        const accepted = held.request({
+            jsonrpc: '2.0',
+            id: state.next,
+            method,
+            params: params.value
+        });
+        if (!accepted) {
+            part.answered = true;
+            continue;
+        }
+        state.pending.set(state.next, { page, channel, id: join.id, held, method, address, join });
+    }
+    if (join.parts.length === 0) {
+        fail(state, page, channel, message.id, INVALID_PARAMS, 'an address is refused');
+        return;
+    }
+    join.timer = setTimeout(() => {
+        join.timer = null;
+        for (const part of join.parts) {
+            if (part.answered || appInfo(part.held.entry) === undefined) continue;
+            part.held.notify({
+                jsonrpc: '2.0',
+                method: '$/cancelRequest',
+                params: { id: part.relayId }
+            });
+            part.answered = true;
+            state.pending.delete(part.relayId);
+        }
+        settleJoin(state, join, true);
+    }, JOIN_MS);
+    if (typeof join.timer === 'object' && typeof join.timer.unref === 'function')
+        join.timer.unref();
+    settleJoin(state, join, false);
+}
+
+/** What the entry answers to a request itself, from the latest build and the page's tabs. */
+function givenBy(
+    state: RelayState,
+    page: Page,
+    entry: ServerEntry,
+    method: string,
+    params: unknown
+): PageAnswer | undefined {
+    const answering = {
+        roots: rootsOf(state),
+        config: configOf(state),
+        feed: state.options.schemas,
+        catalog: state.options.catalog,
+        pages: () => state.pages.values()
+    };
+    return answerFor(entry, page, answering, { method, params });
+}
+
+/** The server of the root a page names by its key, if the page holds one of the entry. */
+function heldOfRoot(state: RelayState, page: Page, entry: ServerEntry, key: string) {
+    return heldOf(rootsOf(state), page, entry, key).held;
+}
+
+/**
+ * The server a request that names no open document is for: the one of the root a
+ * `workspace/symbol` names, or of the file a hierarchy follow-up's item names, the first entry's
+ * that has one; or the server that offers the command a `workspace/executeCommand` names.
+ */
+function heldFor(
+    state: RelayState,
+    page: Page,
+    entries: readonly ServerEntry[],
+    method: string,
+    params: unknown,
+    address: string | null
+): Held | undefined {
+    const ofRoot = (key: string): Held | undefined =>
+        entries
+            .map((entry) => heldOfRoot(state, page, entry, key))
+            .find((one) => one !== undefined);
+    if (method === 'workspace/symbol') {
+        const key = isRecord(params) && typeof params.root === 'string' ? params.root : null;
+        return key === null ? undefined : ofRoot(key);
+    }
+    if (method === 'workspace/executeCommand' && address === null && isRecord(params)) {
+        return [...page.helds.values()].find(
+            (held) =>
+                entries.includes(held.entry) &&
+                offeredCommands(held).includes(String(params.command))
+        );
+    }
+    if (!HIERARCHY.includes(method) || address === null) return undefined;
+    const named = parsePageUri(address);
+    return named === null ? undefined : ofRoot(named.root);
+}
+
+/** The commands a server can be asked to run: its entry's, or those its `initialize` declared. */
+function offeredCommands(held: Held): readonly string[] {
+    if (appInfo(held.entry) === undefined) return held.entry.commands;
+    const provider = held.capabilities.executeCommandProvider;
+    const list = isRecord(provider) ? provider.commands : undefined;
+    return Array.isArray(list) ? list.filter((one): one is string => typeof one === 'string') : [];
+}
+
+/** What a request carries to its server: `workspace/symbol` without the root that routed it. */
+function asked(method: string, params: unknown): unknown {
+    if (method !== 'workspace/symbol' || !isRecord(params)) return params;
+    const sent = { ...params };
+    delete sent.root;
+    return sent;
+}
+
+/**
+ * A document opened in a tab: resolved, put on the server of its root for each entry that serves
+ * the language and selects the file, and the servers are started. A library document is put on
+ * the server of the root that named it. An app's server takes only a document under a root of the
+ * app's scope.
+ */
+function didOpen(
+    state: RelayState,
+    page: Page,
+    channel: string,
+    language: string,
+    entries: readonly ServerEntry[],
+    params: unknown
+): void {
+    const document = isRecord(params) ? params.textDocument : null;
+    if (!isRecord(document) || typeof document.uri !== 'string') return;
+    const { uri, languageId, version, text } = document;
+    if (typeof languageId !== 'string' || typeof version !== 'number') return;
+    if (typeof text !== 'string' || page.docs.has(uri)) return;
+    const opens: { held: Held; existed: boolean; doc: Doc }[] = [];
+    for (const entry of entries) {
+        const placed = place(state, page, channel, language, entry, {
+            uri,
+            languageId,
+            version,
+            text
+        });
+        if (placed !== null) opens.push(placed);
+    }
+    if (opens.length === 0) return;
+    openOn(state, page, opens);
+    replayCollections(state, page);
+}
+
+/** The text a document is opened with on a server, as the page holds it. */
+type Opening = { uri: string; languageId: string; version: number; text: string };
+
+/**
+ * The server of an entry for a document, made or taken over, with the document as that server
+ * holds it; null when the entry does not take the file: it refuses it, the root is outside the
+ * app's scope or the app's selector does not select it.
+ */
+function place(
+    state: RelayState,
+    page: Page,
+    channel: string,
+    language: string,
+    entry: ServerEntry,
+    opening: Opening
+): { held: Held; existed: boolean; doc: Doc } | null {
+    const target = openingTarget(rootsOf(state), page, channel, entry, opening.uri);
+    if (target === null || entry.refuses?.(target.real, rootsOf(state)) === true) return null;
+    const info = appInfo(entry);
+    if (info !== undefined) {
+        if (info.root !== '' && info.root !== target.root.key) return null;
+        if (!selects(info, language, target.real)) return null;
+    }
+    const key = heldKey(entry, target.root);
+    const old = page.helds.get(key) ?? adoptHeld(page, key, state.orphans);
+    return {
+        held: old ?? makeHeld(state, page, entry, target.root, key),
+        existed: old !== null,
+        doc: {
+            real: target.real,
+            fileUri: target.fileUri,
+            pageRoot: target.pageRoot,
+            pageUri: opening.uri,
+            channel,
+            languageId: opening.languageId,
+            version: opening.version,
+            shift: 0,
+            text: opening.text
+        }
+    };
+}
+
+/**
+ * Open a document that is already open on some servers on the ones that serve it now and do not
+ * hold it: an app registered a server, or a host started, while the page held the document.
+ */
+export function attachMore(state: RelayState, page: Page, open: Open): void {
+    const language = languageOf(open.doc.channel);
+    if (language === null) return;
+    const have = new Set([open.held, ...open.also.map((one) => one.held)].map((one) => one.entry));
+    for (const entry of entriesFor(state, language)) {
+        if (have.has(entry)) continue;
+        const placed = place(state, page, open.doc.channel, language, entry, {
+            uri: open.doc.pageUri,
+            languageId: open.doc.languageId,
+            version: open.doc.version - open.doc.shift,
+            text: open.doc.text
+        });
+        if (placed === null || placed.held.docs.has(docKey(placed.doc.fileUri))) continue;
+        placed.held.keep();
+        placed.held.open(placed.doc);
+        open.also.push({ held: placed.held, doc: placed.doc, also: [] });
+        if (placed.existed) publishState(state, placed.held);
+    }
+}
+
+/**
+ * Put a document on its servers. `existed` is whether a server was there before this document:
+ * one that was says where it stands to the channel and root key the document opens on, and one
+ * made now announces its state as it starts.
+ */
+function openOn(
+    state: RelayState,
+    page: Page,
+    opens: { held: Held; existed: boolean; doc: Doc }[]
+): void {
+    const [first] = opens;
+    if (first.held.docs.has(docKey(first.doc.fileUri))) {
+        // The same file under another root key of an overlapping root: one document on the
+        // server, and this address is another name for it.
+        const known = page.opened.get(normal(first.doc.real));
+        const open = known === undefined ? undefined : page.docs.get(known);
+        if (open !== undefined) page.docs.set(first.doc.pageUri, open);
+        return;
+    }
+    const made: Open[] = opens.map(({ held, doc }) => ({ held, doc, also: [] }));
+    const open = made[0];
+    open.also = made.slice(1);
+    page.docs.set(first.doc.pageUri, open);
+    page.opened.set(normal(first.doc.real), first.doc.pageUri);
+    for (const { held, existed, doc } of opens) {
+        held.keep();
+        held.open(doc);
+        if (existed) {
+            held.legendDue = held.legend !== null;
+            publishState(state, held);
+        }
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/relay/relay-server.ts b/tools/oculus/src/lib/server/machine/lsp/relay/relay-server.ts
new file mode 100644
index 000000000..abe31c9da
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/relay/relay-server.ts
@@ -0,0 +1,340 @@
+// Layer 2, server. What the relay does with the messages a language server sends: the answer to a
+// page's request, with the page's id put back and the addresses turned into the page's; a request
+// of the server to its client, which is answered here and not forwarded (`workspace/configuration`
+// from the registry, `client/registerCapability` as file watchers, progress as `state` messages),
+// except `workspace/applyEdit` and the two refreshes, which reach the page; and the diagnostics a
+// server publishes.
+
+import type { LspRpc } from '../../../../data/model/index.ts';
+import { PUBLISHED, publish, type Publishing } from '../held/diagnostics/published.ts';
+import { docKey, type Held, type Page, type Pending } from '../held/held.ts';
+import { normal, toPage } from '../uris.ts';
+import { editAddress, isRecord, languageOf } from '../wire.ts';
+import { fileURLToPath } from 'node:url';
+import { joinedDiagnostics, remainingDiagnostics } from '../held/diagnostics/published.ts';
+import { appInfo, type CollectionHeard } from './relay-apps.ts';
+import {
+    complete,
+    joinKind,
+    joined,
+    registrationsFor,
+    tagged as tagItems,
+    type Join
+} from './relay-join.ts';
+import { configOf } from './relay-make.ts';
+import { channelsOf, mapperOf, reply, rootsOf, send } from './relay-pages.ts';
+import { METHOD_NOT_FOUND, type RelayState } from './relay-state.ts';
+
+/** A message of a server, by what it is: an answer, a request of the client or a notification. */
+export function fromServer(state: RelayState, held: Held, message: LspRpc): void {
+    if (message.method === undefined) response(state, held, message);
+    else if (message.id !== undefined && message.id !== null) serverRequest(state, held, message);
+    else serverNotification(state, held, message);
+}
+
+/** What a server answered to a request, mapped to the page's addresses. */
+function mappedResult(state: RelayState, held: Held, pending: Pending, answer: unknown): unknown {
+    const shaped = held.pageVersions(
+        held.entry.results === undefined
+            ? answer
+            : held.entry.results(pending.method, answer, held.root)
+    );
+    const tagged = appInfo(held.entry) !== undefined && joinKind(pending.method) === 'list';
+    const result = toPage(
+        tagged ? tagItems(shaped, held.entry.id) : shaped,
+        mapperOf(state, pending.page, held, pending)
+    );
+    return result === null ? null : result.value;
+}
+
+/** A server's answer to one of the page's requests, with the page's id put back. */
+function response(state: RelayState, held: Held, message: LspRpc): void {
+    const pending = state.pending.get(Number(message.id));
+    if (pending?.held !== held) return;
+    state.pending.delete(Number(message.id));
+    const join = pending.join;
+    if (join !== undefined) {
+        const part = join.parts.find((one) => one.relayId === Number(message.id));
+        if (part === undefined) return;
+        part.answered = true;
+        if (message.error !== undefined) join.errors.push(message.error);
+        else part.result = mappedResult(state, held, pending, message.result ?? null);
+        settleJoin(state, join, join.timer === null);
+        return;
+    }
+    if (message.error !== undefined) {
+        send(state, pending.page, pending.channel, {
+            jsonrpc: '2.0',
+            id: pending.id,
+            error: message.error
+        });
+        return;
+    }
+    reply(
+        state,
+        pending.page,
+        pending.channel,
+        pending.id,
+        mappedResult(state, held, pending, message.result ?? null)
+    );
+}
+
+/**
+ * Answer a joined request when it can be answered: every server answered, or the bound passed and
+ * the servers of oculus answered. Only errors from every server is an error.
+ */
+export function settleJoin(state: RelayState, join: Join, late: boolean): void {
+    if (join.replied || !complete(join, late)) return;
+    join.replied = true;
+    if (join.timer !== null) clearTimeout(join.timer);
+    join.timer = null;
+    for (const part of join.parts) state.pending.delete(part.relayId);
+    const answered = join.parts.some((part) => part.result !== null && part.result !== undefined);
+    if (!answered && join.errors.length === join.parts.length && join.errors.length > 0) {
+        const error = join.errors[0] as { code: number; message: string };
+        send(state, join.page, join.channel, { jsonrpc: '2.0', id: join.id, error });
+        return;
+    }
+    reply(state, join.page, join.channel, join.id, joined(join));
+}
+
+/** The page's channel for a document a server names, or its first channel of the entry. */
+function channelFor(state: RelayState, held: Held, uri: unknown): string | null {
+    const doc = typeof uri === 'string' ? held.docs.get(docKey(uri)) : undefined;
+    const page = held.owner as Page | null;
+    return doc?.channel ?? (page === null ? null : (channelsOf(page, held.entry)[0] ?? null));
+}
+
+function serverRequest(state: RelayState, held: Held, message: LspRpc): void {
+    if (held.answer(message)) return;
+    const params = isRecord(message.params) ? message.params : {};
+    const page = held.owner as Page | null;
+    const answer = (result: unknown): void =>
+        held.notify({ jsonrpc: '2.0', id: message.id, result });
+    switch (message.method) {
+        case 'workspace/inlayHint/refresh':
+        case 'workspace/semanticTokens/refresh':
+            answer(null);
+            toPageRequest(state, held, message, { value: message.params }, null);
+            return;
+        case 'workspace/applyEdit': {
+            const edit = toPage(
+                held.pageVersions(message.params),
+                page === null
+                    ? { roots: [], opened: () => undefined, alias: (root) => root.key }
+                    : mapperOf(state, page, held)
+            );
+            if (
+                edit === null ||
+                !toPageRequest(state, held, message, edit, editAddress(params.edit))
+            ) {
+                answer({
+                    applied: false,
+                    failureReason: 'the edit names a file the page lacks'
+                });
+            }
+            return;
+        }
+        default:
+            held.notify({
+                jsonrpc: '2.0',
+                id: message.id,
+                error: { code: METHOD_NOT_FOUND, message: `${message.method} is not handled` }
+            });
+    }
+}
+
+/**
+ * Send a server's request to its page under an id of this relay's. `waits` is the server's id
+ * when its answer is the page's, null for a refresh nobody waits on. False when there is no
+ * channel to send it on.
+ */
+function toPageRequest(
+    state: RelayState,
+    held: Held,
+    message: LspRpc,
+    params: { value: unknown },
+    uri: unknown
+): boolean {
+    const page = held.owner as Page | null;
+    const channel = channelFor(state, held, uri);
+    if (page === null || channel === null) return false;
+    const waits = message.method === 'workspace/applyEdit' ? (message.id ?? null) : null;
+    state.next += 1;
+    const id = `oculus:${state.next}`;
+    state.asks.set(id, { held, id: waits });
+    send(state, page, channel, {
+        jsonrpc: '2.0',
+        id,
+        method: message.method,
+        params: params.value
+    });
+    return true;
+}
+
+function serverNotification(state: RelayState, held: Held, message: LspRpc): void {
+    if (held.notice(message) || !PUBLISHED.includes(message.method ?? '')) return;
+    publish(publishing(state), held, message);
+}
+
+function publishing(state: RelayState): Publishing {
+    return {
+        roots: () => rootsOf(state),
+        config: () => configOf(state),
+        catalog: () => state.options.catalog?.() ?? {},
+        mapper: (page, held) => mapperOf(state, page, held),
+        send: (page, channel, payload) => send(state, page, channel, payload)
+    };
+}
+
+/**
+ * A server answered `initialize`. When it is an app's, the features it declared that oculus's own
+ * server for the language does not are registered with the page's client for each language
+ * channel the server serves, once for each feature.
+ */
+export function ready(state: RelayState, held: Held): void {
+    if (appInfo(held.entry) === undefined) return;
+    const page = held.owner as Page | null;
+    if (page === null) return;
+    for (const channel of channelsOf(page, held.entry)) {
+        const language = languageOf(channel);
+        if (language === null) continue;
+        const own = state.servers.forLanguage(language);
+        const present = own === undefined ? {} : own.capabilities(language);
+        const done = page.registered.get(channel) ?? new Set<string>();
+        page.registered.set(channel, done);
+        const registrations = registrationsFor(held.capabilities, present, language).filter(
+            (one) => !done.has(one.id)
+        );
+        if (registrations.length === 0) continue;
+        for (const one of registrations) done.add(one.id);
+        state.next += 1;
+        const id = `oculus:${state.next}`;
+        state.asks.set(id, { held, id: null });
+        send(state, page, channel, {
+            jsonrpc: '2.0',
+            id,
+            method: 'client/registerCapability',
+            params: { registrations }
+        });
+    }
+}
+
+/**
+ * A server of an app is not registered any more, or its app stopped acting. Its page is told it is
+ * gone for each root and channel it was used under, the diagnostics of the documents it served
+ * are replaced by those of the servers and collections that remain, and the capabilities it had
+ * registered with the page's client are withdrawn unless another server of the page still
+ * declares them.
+ */
+export function retired(
+    state: RelayState,
+    held: Held,
+    roots: string[],
+    documents: { uri: string; channel: string }[]
+): void {
+    const page = held.owner as Page | null;
+    const info = appInfo(held.entry);
+    if (page === null || info === undefined) return;
+    for (const channel of channelsOf(page, held.entry)) {
+        for (const root of roots) {
+            send(state, page, channel, { oculus: 'gone', root, server: held.entry.id });
+        }
+        const language = languageOf(channel);
+        if (language === null) continue;
+        const own = state.servers.forLanguage(language);
+        const present = own === undefined ? {} : own.capabilities(language);
+        const needed = new Set(
+            [...page.helds.values()]
+                .filter((one) => one !== held && appInfo(one.entry) !== undefined)
+                .filter((one) => one.entry.languages.includes(language))
+                .flatMap((one) => registrationsFor(one.capabilities, present, language))
+                .map((one) => one.id)
+        );
+        const done = page.registered.get(channel);
+        const withdrawn = registrationsFor(held.capabilities, present, language).filter(
+            (one) => done?.has(one.id) === true && !needed.has(one.id)
+        );
+        if (withdrawn.length === 0) continue;
+        for (const one of withdrawn) done?.delete(one.id);
+        state.next += 1;
+        send(state, page, channel, {
+            jsonrpc: '2.0',
+            id: `oculus:${state.next}`,
+            method: 'client/unregisterCapability',
+            params: {
+                unregisterations: withdrawn.map((one) => ({ id: one.id, method: one.method }))
+            }
+        });
+    }
+    for (const { uri, channel } of documents) {
+        const diagnostics = remainingDiagnostics(page, uri);
+        if (diagnostics === null) continue;
+        send(state, page, channel, {
+            jsonrpc: '2.0',
+            method: 'textDocument/publishDiagnostics',
+            params: { uri, diagnostics }
+        });
+    }
+}
+
+/** The key a collection's diagnostics are kept under in a page's joined diagnostics. */
+function collectionKey(heard: Pick<CollectionHeard, 'app' | 'collection'>): string {
+    return `collection:${heard.app}:${heard.collection}`;
+}
+
+/** The diagnostics of a collection, sent to a page that holds the file open. */
+function sendCollection(state: RelayState, page: Page, heard: CollectionHeard): void {
+    let real: string;
+    try {
+        real = fileURLToPath(heard.uri);
+    } catch {
+        return;
+    }
+    const uri = page.opened.get(normal(real));
+    const open = uri === undefined ? undefined : page.docs.get(uri);
+    if (uri === undefined || open === undefined) return;
+    const params = joinedDiagnostics(page, collectionKey(heard), {
+        uri,
+        diagnostics: heard.diagnostics.map((one) =>
+            typeof one.source === 'string' ? one : { ...one, source: heard.collection }
+        )
+    });
+    send(state, page, open.doc.channel, {
+        jsonrpc: '2.0',
+        method: 'textDocument/publishDiagnostics',
+        params
+    });
+}
+
+/** An app's collection was given diagnostics for a file: every page that holds it is told. */
+export function collectionHeard(state: RelayState, heard: CollectionHeard): void {
+    for (const page of state.pages.values()) sendCollection(state, page, heard);
+}
+
+/** A page opened a document: the diagnostics the collections hold for it are sent. */
+export function replayCollections(state: RelayState, page: Page): void {
+    for (const heard of state.appFeed?.collections() ?? []) sendCollection(state, page, heard);
+}
+
+/** A collection or a host went: the diagnostics of the ones that are gone leave the pages. */
+export function refreshCollections(state: RelayState): void {
+    const now = new Set((state.appFeed?.collections() ?? []).map(collectionKey));
+    for (const page of state.pages.values()) {
+        for (const [uri, kept] of page.joined) {
+            const gone = [...kept.keys()].filter((key) => typeof key === 'string' && !now.has(key));
+            if (gone.length === 0) continue;
+            for (const key of gone) kept.delete(key);
+            const open = page.docs.get(uri);
+            if (open === undefined) continue;
+            const params = joinedDiagnostics(page, gone[0], { uri, diagnostics: [] });
+            kept.delete(gone[0]);
+            const union = isRecord(params) ? params.diagnostics : [];
+            send(state, page, open.doc.channel, {
+                jsonrpc: '2.0',
+                method: 'textDocument/publishDiagnostics',
+                params: { uri, diagnostics: union }
+            });
+        }
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/relay/relay-state.ts b/tools/oculus/src/lib/server/machine/lsp/relay/relay-state.ts
new file mode 100644
index 000000000..967e6f85e
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/relay/relay-state.ts
@@ -0,0 +1,69 @@
+// Layer 2, server. What one relay holds, in a single object that the relay's modules each read and
+// change: the pages (one per socket) and, below them, the language servers there are, the requests
+// of pages and of servers that wait for an answer, the served roots remembered for a second, and
+// the host a held server calls back into. The modules are split by what they do with it: the page
+// sessions (relay-pages.ts), the routing of a page's messages (relay-route.ts), the making of a
+// held server (relay-make.ts), the messages of a server to its page (relay-server.ts) and the life
+// of a held server (relay-life.ts). The state is made once per relay, so two relays share nothing.
+
+import type { Sink } from '../../../core/channels.ts';
+import type { LibraryContext } from '../library/pages.ts';
+import { Library } from '../library/tokens.ts';
+import type { Held, HeldHost, Page, Pending, Ask } from '../held/held.ts';
+import type { Spawn } from '../held/process.ts';
+import type { Servers } from '../servers.ts';
+import type { ServedRoot } from '../uris.ts';
+import type { AppEntries, AppServersFeed } from './relay-apps.ts';
+import type { RelayOptions } from './relay-options.ts';
+
+/** JSON-RPC error codes the relay answers with. */
+export const METHOD_NOT_FOUND = -32601;
+export const INVALID_PARAMS = -32602;
+export const REQUEST_CANCELLED = -32800;
+
+/** How long the served roots are remembered between two messages. */
+export const ROOTS_MS = 1000;
+
+/** The state of one relay. */
+export type RelayState = {
+    options: RelayOptions;
+    servers: Servers;
+    /** The entries of the servers apps registered, when the apps' hosts feed any. */
+    apps: AppEntries | undefined;
+    appFeed: AppServersFeed | undefined;
+    spawn: Spawn;
+    now: () => number;
+    pages: Map<Sink, Page>;
+    /** Every server there is, whoever holds it. */
+    helds: Set<Held>;
+    /** The servers whose page closed and that wait to be taken over or to end. */
+    orphans: Set<Held>;
+    pending: Map<number, Pending>;
+    asks: Map<string, Ask>;
+    /** The last id this relay gave a request it made of a server or of a page. */
+    next: number;
+    served: { at: number; roots: ServedRoot[] } | null;
+    /** What a held server calls back into; set once the relay has made it. */
+    host: HeldHost;
+    library: LibraryContext;
+    /** Whether a sink carried the write token; until the socket gives it, none did. */
+    canWrite: (sink: Sink) => boolean;
+    unsubscribe: (() => void) | undefined;
+};
+
+/** A new empty page for a socket. */
+export function emptyPage(sink: Sink): Page {
+    return {
+        sink,
+        sessions: new Map(),
+        helds: new Map(),
+        docs: new Map(),
+        opened: new Map(),
+        outputs: new Map(),
+        stranded: new Map(),
+        library: new Library(),
+        tabs: new Set(),
+        joined: new Map(),
+        registered: new Map()
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/relay/relay.ts b/tools/oculus/src/lib/server/machine/lsp/relay/relay.ts
new file mode 100644
index 000000000..b7a1fc1c0
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/lsp/relay/relay.ts
@@ -0,0 +1,115 @@
+// Layer 2, server. The language server relay: the page talks LSP over its one socket on the channel
+// `lsp:<language>`, and this holds the servers behind those channels. It is what
+// server/root/socket.ts hands every frame of an `lsp:` channel to, and it is made once per server
+// context. The class is the relay's public face; the work is in the modules beside it, each over
+// the one `RelayState` (relay-state.ts):
+//
+// - relay-pages.ts: the page sessions, the frames sent to a page, the mapper that turns a server's
+//   addresses into the page's, and what a closed socket leaves behind.
+// - relay-route.ts: the routing of a page's messages to the server that holds the document they
+//   name, and the answers the relay and the entries give themselves.
+// - relay-make.ts: the state of a new relay, the preparation of a server for a root and the held
+//   server itself.
+// - relay-server.ts: the messages a server sends, answered here or forwarded to the page.
+// - relay-life.ts: a root no longer served, a changed `lsp` folder, changed settings, and a server
+//   that stopped or is gone.
+//
+// A frame is read only from a socket whose subscription carried the write token, and every frame
+// goes to the one socket it is for, in order, never merged. Ids are remapped, so a page's ids and
+// each server's own never meet.
+
+import {
+    appsChanged,
+    reconcile,
+    reload,
+    schemasChanged,
+    settingsChanged,
+    stopped,
+    gone
+} from './relay-life.ts';
+import { createState } from './relay-make.ts';
+import { removePage } from './relay-pages.ts';
+import { inbound } from './relay-route.ts';
+import { collectionHeard, fromServer, ready } from './relay-server.ts';
+import type { RelayOptions } from './relay-options.ts';
+import type { RelayState } from './relay-state.ts';
+import type { Sink } from '../../../core/channels.ts';
+
+/** The language server relay of one server context. */
+export class Relay {
+    readonly #state: RelayState;
+    readonly #offApps: ((() => void) | undefined)[];
+
+    constructor(options: RelayOptions) {
+        this.#state = createState(options, {
+            message: fromServer,
+            ready,
+            stopped,
+            gone,
+            schemasChanged
+        });
+        const feed = options.appServers;
+        this.#offApps = [
+            feed?.onChange(() => appsChanged(this.#state)),
+            feed?.onDiagnostics((heard) => collectionHeard(this.#state, heard))
+        ];
+    }
+
+    /**
+     * The shipped settings changed: a running server that follows a section of them, and would now
+     * be answered differently, is told its settings changed and asks again.
+     */
+    settingsChanged(): void {
+        settingsChanged(this.#state);
+    }
+
+    /**
+     * The socket's answer to whether a sink carried the write token, asked at each message. Until
+     * the socket gives it, no sink may write.
+     */
+    gate(canWrite: (sink: Sink) => boolean): void {
+        this.#state.canWrite = canWrite;
+    }
+
+    /**
+     * One text from a socket. Answers whether it was a frame of an `lsp:` channel, which the
+     * terminals then leave alone; a frame from a socket that did not carry the token is read and
+     * dropped.
+     */
+    inbound(sink: Sink, data: string): boolean {
+        return inbound(this.#state, sink, data);
+    }
+
+    /** A socket closed: its servers wait 60 s for another page to take them over. */
+    remove(sink: Sink): void {
+        removePage(this.#state, sink);
+    }
+
+    /** The served roots changed: the server of a root no longer served ends. */
+    reconcile(): void {
+        reconcile(this.#state);
+    }
+
+    /** A changed `lsp` folder ends every server; one a page has documents open in starts again. */
+    reload(): void {
+        reload(this.#state);
+    }
+
+    /** End every server and wait for them to be gone. */
+    async close(): Promise<void> {
+        this.#state.unsubscribe?.();
+        for (const off of this.#offApps) off?.();
+        await Promise.all([...this.#state.helds].map((held) => held.close()));
+        this.#state.pages.clear();
+    }
+
+    /** The processes of the servers that are running, for a caller that counts them. */
+    pids(): number[] {
+        return [...this.#state.helds].flatMap((held) => (held.pid === undefined ? [] : [held.pid]));
+    }
+}
+
+/** Make the relay of one server context. */
+export function createRelay(options: RelayOptions): Relay {
+    return new Relay(options);
+}
diff --git a/tools/oculus/src/lib/server/machine/lsp/schema-feed.ts b/tools/oculus/src/lib/server/machine/lsp/schema-feed.ts
index b05a81afa..16212af0d 100644
--- a/tools/oculus/src/lib/server/machine/lsp/schema-feed.ts
+++ b/tools/oculus/src/lib/server/machine/lsp/schema-feed.ts
@@ -1,26 +1,56 @@
 // Layer 2, server. The latest generated schemas and the reference index of the hub's keys, handed
 // from the snapshot build to the language server relay. The portfolio watcher publishes both after
-// each rebuild. The relay reads the current schemas when a server asks for one and the current
-// index when the YAML entry answers a hub key. It is told when a set of schemas differs from the
-// one before, so it asks its YAML servers for their settings again only then: an `editor.autosave`
