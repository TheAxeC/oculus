+// Layer 2, server. A glob over a path as VS Code's document selectors and file system watchers
+// write it: `*` within a segment, `**` across segments, `?`, `{a,b}` and `[abc]`. The runner reads
+// it with no package, since it imports before its import guard and needs nothing of the app.
+
+/** The regular expression a glob stands for. */
+export function globToRegExp(glob) {
+    let out = '';
+    let depth = 0;
+    for (let at = 0; at < glob.length; at += 1) {
+        const char = glob[at];
+        if (char === '*') {
+            if (glob[at + 1] === '*') {
+                at += 1;
+                if (glob[at + 1] === '/') {
+                    at += 1;
+                    out += '(?:.*/)?';
+                } else {
+                    out += '.*';
+                }
+            } else {
+                out += '[^/]*';
+            }
+        } else if (char === '?') {
+            out += '[^/]';
+        } else if (char === '{') {
+            depth += 1;
+            out += '(?:';
+        } else if (char === '}' && depth > 0) {
+            depth -= 1;
+            out += ')';
+        } else if (char === ',' && depth > 0) {
+            out += '|';
+        } else if (char === '[') {
+            const end = glob.indexOf(']', at + 1);
+            if (end === -1) {
+                out += '\\[';
+            } else {
+                out += `[${glob.slice(at + 1, end).replace(/^!/, '^')}]`;
+                at = end;
+            }
+        } else {
+            out += char.replace(/[.+^$()|\\]/g, '\\$&');
+        }
+    }
+    return new RegExp(`^${out}$`);
+}
+
+/** Whether a glob matches a path; a glob without a slash is tried on the name as well. */
+export function globMatches(glob, path) {
+    const regexp = globToRegExp(glob);
+    if (regexp.test(path)) return true;
+    if (!glob.includes('/')) return regexp.test(path.slice(path.lastIndexOf('/') + 1));
+    return globToRegExp(`**/${glob}`).test(path);
+}
