diff --git a/tools/oculus/src/lib/ui/controls/editor/kit/languages/app-grammars.ts b/tools/oculus/src/lib/ui/controls/editor/kit/languages/app-grammars.ts
new file mode 100644
index 000000000..fdd631080
--- /dev/null
+++ b/tools/oculus/src/lib/ui/controls/editor/kit/languages/app-grammars.ts
@@ -0,0 +1,79 @@
+// Layer 3, primitive. The TextMate grammars of the acting apps, as the registrations Shiki loads. A
+// grammar that names a language is that language's grammar, registered under the language's id so
+// the tokens provider Shiki's bridge sets lands on the language Monaco has. The grammars its
+// `embeddedLanguages` name come with it, loaded first in the same call: another app's grammar by
+// its registration, a shipped language by its Shiki id. A grammar that names no language, with
+// `injectTo`, is loaded on its own into every highlighter (`injectionsOf`), and a failure of one
+// leaves the others. A grammar that names a language oculus ships a grammar for is not used: the
+// shipped grammar is kept for it, and its `injectTo` grammar still injects. The grammar's own
+// `name` is the human name TextMate files carry; Shiki's name for it is the language id (or the
+// scope name for an injection).
+
+import type { LanguageRegistration } from 'shiki';
+import type {
+    AppEditorGrammar,
+    AppLanguageKit
+} from '$lib/data/helpers/files/apps/tools/language-kit';
+import { PLAINTEXT, bundledId } from './grammars';
+
+/** What Shiki loads a grammar from: a bundled id, or a registration. */
+export type Loadable = string | LanguageRegistration;
+
+/** The registration of a grammar under a name. */
+function registration(grammar: AppEditorGrammar, name: string): LanguageRegistration {
+    return {
+        ...(grammar.grammar as Record<string, unknown>),
+        name,
+        scopeName: grammar.scopeName,
+        ...(grammar.injectTo.length === 0 ? {} : { injectTo: grammar.injectTo })
+    } as LanguageRegistration;
+}
+
+/** The grammar an app brings for a language no shipped grammar covers. */
+function ownGrammar(kit: AppLanguageKit, id: string): AppEditorGrammar | undefined {
+    if (bundledId(id) !== null || id === PLAINTEXT) return undefined;
+    return kit.grammars.find((one) => one.language === id);
+}
+
+/**
+ * What a language's grammar is loaded from: the grammars it embeds and then its own, or nothing
+ * when no app brings a grammar for the language.
+ */
+export function grammarsOf(kit: AppLanguageKit, id: string): Loadable[] {
+    const own = ownGrammar(kit, id);
+    if (own === undefined) return [];
+    const out: Loadable[] = [];
+    const seen = new Set<string>([id]);
+    const visit = (grammar: AppEditorGrammar): void => {
+        for (const target of Object.values(grammar.embeddedLanguages)) {
+            if (seen.has(target)) continue;
+            seen.add(target);
+            const app = ownGrammar(kit, target);
+            if (app !== undefined) {
+                visit(app);
+                out.push(registration(app, target));
+                continue;
+            }
+            const bundled = bundledId(target);
+            if (bundled !== null) out.push(bundled);
+        }
+    };
+    visit(own);
+    out.push(registration(own, id));
+    return out;
+}
+
+/** The grammars that only inject into others, each as the list it is loaded from. */
+export function injectionsOf(kit: AppLanguageKit): LanguageRegistration[] {
+    return kit.grammars
+        .filter(
+            (one) =>
+                one.injectTo.length > 0 && (one.language === '' || bundledId(one.language) !== null)
+        )
+        .map((one) => registration(one, one.scopeName));
+}
+
+/** Whether an app brings a grammar for this language id. */
+export function hasGrammar(kit: AppLanguageKit, id: string): boolean {
+    return ownGrammar(kit, id) !== undefined;
+}
diff --git a/tools/oculus/src/lib/ui/controls/editor/kit/languages/apps.svelte.ts b/tools/oculus/src/lib/ui/controls/editor/kit/languages/apps.svelte.ts
new file mode 100644
index 000000000..1986001c8
--- /dev/null
+++ b/tools/oculus/src/lib/ui/controls/editor/kit/languages/apps.svelte.ts
@@ -0,0 +1,64 @@
+// Layer 3, primitive. What the acting apps give the editor, held for the kit: the page hands it the
+// value state computes (`set`, from the shell), and the kit reads it where it registers languages,
+// grammars, snippets and schemas, and where it asks which languages a server serves. The editor
+// holds no state, so the value arrives as a parameter of the kit and not as a read of the stores.
+//
+// A change is announced to the listeners the kit registers (`onChange`), once for each `set` that
+// changes the value. `version` is a reactive counter that grows with each change, which an effect
+// that asks for a language's id (`shikiId`) reads, so a model's language is set again when an app
+// adds the language it is drawn in.
+
+import { SERVED_LANGUAGES } from '$lib/data/prose/lsp-servers';
+import type { AppLanguageKit } from '$lib/data/helpers/files/apps/tools/language-kit';
+import { Signal } from '../lsp/signal';
+
+/** The kit before any app gave anything: the languages the shipped servers serve. */
+const NONE: AppLanguageKit = {
+    languages: [],
+    grammars: [],
+    snippets: [],
+    semantic: { types: [], modifiers: [], scopes: [] },
+    schemas: [],
+    served: [...SERVED_LANGUAGES]
+};
+
+let held: AppLanguageKit = NONE;
+let signature = JSON.stringify(NONE);
+let version = $state(0);
+const changed = new Signal();
+
+/** What the acting apps give the editor now. */
+export function appKit(): AppLanguageKit {
+    return held;
+}
+
+/** Hear every change of it; the call it answers stops hearing. */
+export function onAppKit(listener: () => void): { dispose(): void } {
+    return changed.event(listener);
+}
+
+/** The reactive counter of changes. */
+export function appKitVersion(): number {
+    return version;
+}
+
+/** Take a new value, doing nothing when it equals the one held. */
+export function setAppKit(next: AppLanguageKit): void {
+    const text = JSON.stringify(next);
+    if (text === signature) return;
+    signature = text;
+    held = next;
+    version += 1;
+    changed.fire();
+}
+
+/** Whether an app added a language of this id. */
+export function appLanguage(id: string): boolean {
+    void appKitVersion();
+    return held.languages.some((one) => one.id === id);
+}
+
+/** The ids of the languages a language server serves. */
+export function servedLanguages(): readonly string[] {
+    return held.served;
+}
diff --git a/tools/oculus/src/lib/ui/controls/editor/kit/languages/configuration.ts b/tools/oculus/src/lib/ui/controls/editor/kit/languages/configuration.ts
new file mode 100644
index 000000000..bae31a748
--- /dev/null
+++ b/tools/oculus/src/lib/ui/controls/editor/kit/languages/configuration.ts
@@ -0,0 +1,190 @@
+// Layer 3, primitive. A language configuration file of an app, as Monaco takes it. The file is
+// VS Code's: comments, brackets, auto-closing and surrounding pairs, folding markers, the word
+// pattern, indentation rules and `onEnterRules`. A pattern is a string or `{ pattern, flags }`; a
+// pattern that does not compile, and a part of the wrong shape, is left out and the rest applies.
+// The function builds the object without Monaco (the indent actions are its enum's numbers), so the
+// reading is the same wherever it runs.
+
+import type * as Monaco from 'monaco-editor';
+
+type Configuration = Monaco.languages.LanguageConfiguration;
+
+/** A value that is a plain object. */
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** A regular expression from a string or a `{ pattern, flags }`, or undefined when it has none. */
+function expression(value: unknown): RegExp | undefined {
+    const source = typeof value === 'string' ? value : isRecord(value) ? value.pattern : undefined;
+    if (typeof source !== 'string' || source === '') return undefined;
+    const flags = isRecord(value) && typeof value.flags === 'string' ? value.flags : '';
+    try {
+        return new RegExp(source, flags);
+    } catch {
+        return undefined;
+    }
+}
+
+/** A pair of strings, or undefined. */
+function pairOf(value: unknown): Monaco.languages.CharacterPair | undefined {
+    if (!Array.isArray(value) || value.length !== 2) return undefined;
+    const [open, close] = value as unknown[];
+    return typeof open === 'string' && typeof close === 'string' ? [open, close] : undefined;
+}
+
+/** The brackets, each a two-string list. */
+function bracketsOf(value: unknown): Monaco.languages.CharacterPair[] | undefined {
+    if (!Array.isArray(value)) return undefined;
+    return value.flatMap((one) => {
+        const pair = pairOf(one);
+        return pair === undefined ? [] : [pair];
+    });
+}
+
+/** The pairs of auto-closing: `[open, close]` or `{ open, close, notIn }`. */
+function closingOf(value: unknown): Monaco.languages.IAutoClosingPairConditional[] | undefined {
+    if (!Array.isArray(value)) return undefined;
+    return value.flatMap((one) => {
+        const pair = pairOf(one);
+        if (pair !== undefined) return [{ open: pair[0], close: pair[1] }];
+        if (!isRecord(one) || typeof one.open !== 'string' || typeof one.close !== 'string') {
+            return [];
+        }
+        const notIn = Array.isArray(one.notIn)
+            ? one.notIn.filter((place): place is string => typeof place === 'string')
+            : undefined;
+        return [
+            {
+                open: one.open,
+                close: one.close,
+                ...(notIn === undefined ? {} : { notIn })
+            }
+        ];
+    });
+}
+
+/** The pairs of surrounding: `[open, close]` or `{ open, close }`. */
+function surroundingOf(value: unknown): Monaco.languages.IAutoClosingPair[] | undefined {
+    if (!Array.isArray(value)) return undefined;
+    return value.flatMap((one) => {
+        const pair = pairOf(one);
+        if (pair !== undefined) return [{ open: pair[0], close: pair[1] }];
+        if (isRecord(one) && typeof one.open === 'string' && typeof one.close === 'string') {
+            return [{ open: one.open, close: one.close }];
+        }
+        return [];
+    });
+}
+
+/** The comment markers: a line comment (a string or `{ comment }`) and a block comment pair. */
+function commentsOf(value: unknown): Monaco.languages.CommentRule | undefined {
+    if (!isRecord(value)) return undefined;
+    const line = value.lineComment;
+    const lineComment =
+        typeof line === 'string'
+            ? line
+            : isRecord(line) && typeof line.comment === 'string'
+              ? line.comment
+              : undefined;
+    const blockComment = pairOf(value.blockComment);
+    if (lineComment === undefined && blockComment === undefined) return undefined;
+    return {
+        ...(lineComment === undefined ? {} : { lineComment }),
+        ...(blockComment === undefined ? {} : { blockComment })
+    };
+}
+
+/** The folding markers and the off-side flag. */
+function foldingOf(value: unknown): Monaco.languages.FoldingRules | undefined {
+    if (!isRecord(value)) return undefined;
+    const offSide = typeof value.offSide === 'boolean' ? value.offSide : undefined;
+    const markers = isRecord(value.markers) ? value.markers : undefined;
+    const start = expression(markers?.start);
+    const end = expression(markers?.end);
+    if (offSide === undefined && (start === undefined || end === undefined)) return undefined;
+    return {
+        ...(offSide === undefined ? {} : { offSide }),
