index 000000000..5e4e96dee
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/values/text.mjs
@@ -0,0 +1,241 @@
+// Layer 2, server. The value classes of VS Code's API that carry text and edits: `TextEdit`,
+// `WorkspaceEdit`, `SnippetString`, `MarkdownString`, `ThemeColor`, `ThemeIcon`, `FileType`,
+// `FileSystemError`, `Diagnostic` and the enums around them. The numbers of the enums are VS
+// Code's, which differ from the protocol's for severities and kinds; `languages/convert.mjs`
+// converts. The runner imports it before it installs its import guard.
+
+import { Position, Range } from './position-range.mjs';
+
+export const EndOfLine = Object.freeze({ LF: 1, CRLF: 2 });
+
+export const FileType = Object.freeze({ Unknown: 0, File: 1, Directory: 2, SymbolicLink: 64 });
+
+export const DiagnosticSeverity = Object.freeze({ Error: 0, Warning: 1, Information: 2, Hint: 3 });
+
+export const DiagnosticTag = Object.freeze({ Unnecessary: 1, Deprecated: 2 });
+
+export class TextEdit {
+    constructor(range, newText) {
+        this.range = range;
+        this.newText = newText;
+    }
+
+    static replace(range, newText) {
+        return new TextEdit(range, newText);
+    }
+
+    static insert(position, newText) {
+        return new TextEdit(new Range(position, position), newText);
+    }
+
+    static delete(range) {
+        return new TextEdit(range, '');
+    }
+
+    static setEndOfLine(eol) {
+        const edit = new TextEdit(new Range(new Position(0, 0), new Position(0, 0)), '');
+        edit.newEol = eol;
+        return edit;
+    }
+}
+
+export class WorkspaceEdit {
+    /**
+     * The entries in the order made: `{ uri, edit }` for a text edit, `{ kind, ... }` for a file.
+     */
+    #entries = [];
+
+    get size() {
+        return new Set(this.#entries.filter((one) => one.edit).map((one) => one.uri.toString()))
+            .size;
+    }
+
+    replace(uri, range, newText) {
+        this.#entries.push({ uri, edit: new TextEdit(range, newText) });
+    }
+
+    insert(uri, position, newText) {
+        this.#entries.push({ uri, edit: TextEdit.insert(position, newText) });
+    }
+
+    delete(uri, range) {
+        this.#entries.push({ uri, edit: TextEdit.delete(range) });
+    }
+
+    has(uri) {
+        return this.#entries.some((one) => one.edit && one.uri.toString() === uri.toString());
+    }
+
+    set(uri, edits) {
+        this.#entries = this.#entries.filter(
+            (one) => !(one.edit && one.uri.toString() === uri.toString())
+        );
+        for (const edit of edits ?? []) this.#entries.push({ uri, edit });
+    }
+
+    get(uri) {
+        return this.#entries
+            .filter((one) => one.edit && one.uri.toString() === uri.toString())
+            .map((one) => one.edit);
+    }
+
+    createFile(uri, options) {
+        this.#entries.push({ kind: 'create', uri, options });
+    }
+
+    deleteFile(uri, options) {
+        this.#entries.push({ kind: 'delete', uri, options });
+    }
+
+    renameFile(from, to, options) {
+        this.#entries.push({ kind: 'rename', uri: from, to, options });
+    }
+
+    /** The text edits as [uri, edits] pairs, in the order each file was first edited. */
+    entries() {
+        const byFile = new Map();
+        for (const one of this.#entries) {
+            if (!one.edit) continue;
+            const key = one.uri.toString();
+            const held = byFile.get(key) ?? [one.uri, []];
+            held[1].push(one.edit);
+            byFile.set(key, held);
+        }
+        return [...byFile.values()];
+    }
+
+    /** The file operations in the order made. */
+    fileOperations() {
+        return this.#entries.filter((one) => one.kind !== undefined);
+    }
+}
+
+export class SnippetString {
+    constructor(value = '') {
+        this.value = value;
+    }
+
+    appendText(text) {
+        this.value += String(text).replace(/[$}\\]/g, '\\$&');
+        return this;
+    }
+
+    appendTabstop(number = 1) {
+        this.value += `$${number}`;
+        return this;
+    }
+
+    appendPlaceholder(value, number = 1) {
+        const text =
+            typeof value === 'function' ? nested(value) : String(value).replace(/[$}\\]/g, '\\$&');
+        this.value += `\${${number}:${text}}`;
+        return this;
+    }
+
+    appendChoice(values, number = 1) {
+        const list = values.map((one) => String(one).replace(/[$}\\,|]/g, '\\$&')).join(',');
+        this.value += `\${${number}|${list}|}`;
+        return this;
+    }
+
+    appendVariable(name, defaultValue) {
+        const fallback =
+            typeof defaultValue === 'function'
+                ? nested(defaultValue)
+                : defaultValue === undefined
+                  ? undefined
+                  : String(defaultValue).replace(/[$}\\]/g, '\\$&');
+        this.value += fallback === undefined ? `\${${name}}` : `\${${name}:${fallback}}`;
+        return this;
+    }
+}
+
+/** The text a callback builds on a fresh snippet string. */
+function nested(build) {
+    const inner = new SnippetString();
+    build(inner);
+    return inner.value;
+}
+
+export class MarkdownString {
+    constructor(value = '', supportThemeIcons = false) {
+        this.value = value;
+        this.supportThemeIcons = supportThemeIcons;
+        this.isTrusted = false;
+        this.supportHtml = false;
+    }
+
+    appendText(text) {
+        this.value += String(text).replace(/[\\`*_{}[\]()#+\-.!]/g, '\\$&');
+        return this;
+    }
+
+    appendMarkdown(text) {
+        this.value += text;
+        return this;
+    }
+
+    appendCodeblock(code, language = '') {
+        this.value += `\n\`\`\`${language}\n${code}\n\`\`\`\n`;
+        return this;
+    }
+}
+
+export class ThemeColor {
+    constructor(id) {
+        this.id = id;
+    }
+}
+
+export class ThemeIcon {
+    constructor(id, color) {
+        this.id = id;
+        this.color = color;
+    }
+}
+
+export class FileSystemError extends Error {
+    constructor(messageOrUri) {
+        super(typeof messageOrUri === 'string' ? messageOrUri : String(messageOrUri));
+        this.name = 'FileSystemError';
+    }
+
+    static FileNotFound(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'FileNotFound' });
+    }
+
+    static FileExists(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'FileExists' });
+    }
+
+    static FileNotADirectory(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'FileNotADirectory' });
+    }
+
+    static FileIsADirectory(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'FileIsADirectory' });
+    }
+
+    static NoPermissions(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'NoPermissions' });
+    }
+
+    static Unavailable(messageOrUri) {
+        return Object.assign(new FileSystemError(messageOrUri), { code: 'Unavailable' });
+    }
+}
+
+export class DiagnosticRelatedInformation {
+    constructor(location, message) {
+        this.location = location;
+        this.message = message;
+    }
+}
+
+export class Diagnostic {
+    constructor(range, message, severity = DiagnosticSeverity.Error) {
+        this.range = range;
+        this.message = message;
+        this.severity = severity;
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/runner/values/uri.mjs b/tools/oculus/src/lib/server/machine/apps/host/runner/values/uri.mjs
new file mode 100644
index 000000000..2f5b3e521
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/runner/values/uri.mjs
@@ -0,0 +1,152 @@
+// Layer 2, server. VS Code's `Uri` as the host's object offers it: `Uri.file`, `Uri.parse`,
+// `Uri.joinPath` and `uri.with`, the components `scheme`, `authority`, `path`, `query` and
+// `fragment`, `fsPath` and `toString`. A path in the API is a `Uri` of the `file:` scheme with a
+// real absolute path; oculus turns it into a root and a path where it crosses to a page. It is
+// plain JavaScript that the runner imports before it installs its import guard.
+
+const PATTERN = /^(([^:/?#]+?):)?(\/\/([^/?#]*))?([^?#]*)(\?([^#]*))?(#(.*))?/;
+
+/** The path with each segment percent-encoded and the slashes kept. */
+function encodePath(path) {
+    return path
+        .split('/')
+        .map((segment) => encodeURIComponent(segment).replace(/%3A/gi, ':'))
+        .join('/');
+}
+
+/** A component percent-decoded; a value that is not valid encoding stays as it is. */
+function decode(value) {
+    try {
+        return decodeURIComponent(value);
+    } catch {
+        return value;
+    }
+}
+
+export class Uri {
+    #scheme;
+    #authority;
+    #path;
+    #query;
+    #fragment;
+
+    constructor(scheme, authority = '', path = '', query = '', fragment = '') {
+        this.#scheme = scheme || 'file';
+        this.#authority = authority;
+        this.#path =
+            path.length > 0 && !path.startsWith('/') && authority !== '' ? `/${path}` : path;
+        this.#query = query;
+        this.#fragment = fragment;
+    }
+
+    get scheme() {
+        return this.#scheme;
+    }
+
+    get authority() {
+        return this.#authority;
+    }
+
+    get path() {
+        return this.#path;
+    }
+
+    get query() {
+        return this.#query;
+    }
+
+    get fragment() {
+        return this.#fragment;
+    }
+
+    /** The path as a file system path: the path itself, since oculus runs on POSIX paths. */
+    get fsPath() {
+        return this.#authority !== '' && this.#path.length > 1 && this.#scheme === 'file'
+            ? `//${this.#authority}${this.#path}`
+            : this.#path;
+    }
+
+    /** A `file:` Uri of a path. */
+    static file(path) {
+        let value = String(path);
+        let authority = '';
+        if (value.startsWith('//')) {
+            const end = value.indexOf('/', 2);
+            authority = end === -1 ? value.slice(2) : value.slice(2, end);
+            value = end === -1 ? '/' : value.slice(end);
+        }
+        return new Uri('file', authority, value.startsWith('/') ? value : `/${value}`);
+    }
+
+    /** The Uri a text names; a text with no scheme is read as a file path. */
+    static parse(value) {
+        const found = PATTERN.exec(String(value));
+        if (found === null || found[2] === undefined) return Uri.file(String(value));
+        return new Uri(
+            found[2],
+            decode(found[4] ?? ''),
+            decode(found[5] ?? ''),
+            decode(found[7] ?? ''),
+            decode(found[9] ?? '')
+        );
+    }
+
+    /** A Uri whose path is the base's with these segments joined on. */
+    static joinPath(base, ...parts) {
+        const joined = [base.path, ...parts]
+            .join('/')
+            .split('/')
+            .reduce((kept, segment) => {
+                if (segment === '..') kept.pop();
+                else if (segment !== '.' && segment !== '') kept.push(segment);
+                return kept;
+            }, []);
+        return base.with({ path: `/${joined.join('/')}` });
+    }
+
+    /** A Uri with some components replaced. */
+    with(change) {
+        const has = (key) => change !== null && typeof change === 'object' && key in change;
+        return new Uri(
+            has('scheme') ? change.scheme : this.#scheme,
+            has('authority') ? change.authority : this.#authority,
+            has('path') ? change.path : this.#path,
+            has('query') ? change.query : this.#query,
+            has('fragment') ? change.fragment : this.#fragment
+        );
+    }
+
+    /** The Uri as text, its components percent-encoded unless `skipEncoding`. */
+    toString(skipEncoding = false) {
+        const path = skipEncoding ? this.#path : encodePath(this.#path);
+        const authority = skipEncoding ? this.#authority : encodeURIComponent(this.#authority);
+        let text = `${this.#scheme}:`;
+        if (this.#authority !== '' || this.#scheme === 'file') text += `//${authority}`;
+        text += path;
+        if (this.#query !== '')
+            text += `?${skipEncoding ? this.#query : encodeURIComponent(this.#query)}`;
+        if (this.#fragment !== '') {
+            text += `#${skipEncoding ? this.#fragment : encodeURIComponent(this.#fragment)}`;
+        }
+        return text;
+    }
+
+    toJSON() {
+        return {
+            $mid: 1,
+            scheme: this.#scheme,
+            authority: this.#authority,
+            path: this.#path,
+            query: this.#query,
+            fragment: this.#fragment,
+            fsPath: this.fsPath,
+            external: this.toString()
+        };
+    }
+
+    /** The Uri a JSON form (`toJSON`'s or any object with these components) stands for. */
+    static from(value) {
+        if (value instanceof Uri) return value;
+        return new Uri(value.scheme, value.authority, value.path, value.query, value.fragment);
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/read/across/languages.ts b/tools/oculus/src/lib/server/machine/apps/read/across/languages.ts
new file mode 100644
index 000000000..425a40a80
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/read/across/languages.ts
@@ -0,0 +1,95 @@
+// Layer 2, server. The languages two apps may both name. A language id is shared on purpose: an app
+// that names an id that exists adds its extensions, file names and globs to it. What is not shared
+// is an ending or a glob that two languages claim, a language configuration file for an id that
+// already has one, and a grammar scope name another app already registered. The app that comes
+// later in the Views list's order loses the rule, with a finding that names the language it lost
+// it to, and the rule is taken out of its row, so the server's `onLanguage:` events and the page
+// read the same join (`joinLanguages`). Only an app that is approved, enabled and unchanged adds
+// a rule, since a rule of an app that does not act is not in force.
+
+import { join } from 'node:path';
+import { appActive } from '../../../../../data/helpers/files/apps/apps.ts';
+import { joinLanguages } from '../../../../../data/helpers/files/apps/tools/languages.ts';
+import { findingText, type TextCatalog } from '../../../../../data/helpers/finding-text.ts';
+import type { LanguageMap } from '../../../../../data/helpers/files/languages.ts';
+import type { Finding } from '../../../../../data/model/index.ts';
+import { findingKey } from '../manifest.ts';
+import type { AppsHeld } from '../held.ts';
+
+/**
+ * Take, in place, the rules that lost out of the rows of the acting apps, and add a finding for
+ * each. `base` is the map of `config/sources.yml`.
+ */
+export function dropTakenLanguages(held: AppsHeld, base: LanguageMap, catalog: TextCatalog): void {
+    const acting = held.apps.filter((app) => appActive(app.row));
+    const say = (id: string, message: string): void => {
+        const app = held.apps.find((one) => one.id === id);
+        if (app === undefined) return;
+        held.findings.push({
+            file: join(app.row.folder, 'app.yml'),
+            key: findingKey(app.row.root, app.row.name),
+            message
+        } satisfies Finding);
+    };
+    const { lost } = joinLanguages(
+        base,
+        acting.map((app) => ({ app: app.id, languages: app.row.contributes.languages }))
+    );
+    const lostBy = new Map<string, Set<string>>();
+    for (const one of lost) {
+        say(
+            one.app,
+            findingText(
+                catalog,
+                'findings.apps.language_taken',
+                one.app,
+                one.language,
+                one.rule,
+                one.first
+            )
+        );
+        const rules = lostBy.get(`${one.app}\n${one.language}`) ?? new Set<string>();
+        rules.add(one.rule);
+        lostBy.set(`${one.app}\n${one.language}`, rules);
+    }
+    const configured = new Set<string>();
+    const scopes = new Set<string>();
+    for (const app of acting) {
+        const contributes = app.row.contributes;
+        contributes.languages = contributes.languages.map((language) => {
+            const gone = lostBy.get(`${app.id}\n${language.id}`);
+            const kept = {
+                ...language,
+                extensions: language.extensions.filter((one) => !gone?.has(one)),
+                filenames: language.filenames.filter((one) => !gone?.has(one)),
+                filenamePatterns: language.filenamePatterns.filter((one) => !gone?.has(one))
+            };
+            if (language.configuration === '') return kept;
+            if (configured.has(language.id)) {
+                say(
+                    app.id,
+                    findingText(
+                        catalog,
+                        'findings.apps.language_configuration_taken',
+                        language.id,
+                        language.configuration
+                    )
+                );
+                return { ...kept, configuration: '' };
+            }
+            configured.add(language.id);
+            return kept;
+        });
+        contributes.grammars = contributes.grammars.filter((grammar) => {
+            if (!scopes.has(grammar.scopeName)) {
+                scopes.add(grammar.scopeName);
+                return true;
+            }
+            say(
+                app.id,
+                findingText(catalog, 'findings.apps.grammar_taken', grammar.path, grammar.scopeName)
+            );
+            return false;
+        });
+    }
+}
