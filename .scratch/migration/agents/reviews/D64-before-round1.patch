diff --git a/tools/oculus/src/lib/server/machine/apps/tools/debug.ts b/tools/oculus/src/lib/server/machine/apps/tools/debug.ts
new file mode 100644
index 000000000..0d043122b
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/debug.ts
@@ -0,0 +1,194 @@
+// Layer 2, server. The debugger registrations of an app's host and the requests that start and
+// reach its adapters. The host registers a descriptor factory and a configuration provider for each
+// debugger type its manifest declares (`oculus/debug/register`); oculus asks the host to start the
+// adapter of a type for a session (`oculus/debug/start`, answered by the `debugAdapter` stream the
+// host opens), asks the provider for the configurations Add Configuration lists
+// (`oculus/debug/configurations`) and for a configuration resolved before and after its
+// placeholders are filled (`oculus/debug/resolve`), and tells the host of a session's start, end,
+// custom events and the breakpoints (`oculus/debug/event`).
+//
+// A host reaches its sessions with `startDebugging`, `stopDebugging` and `customRequest`, which are
+// answered by the control the debug client gives (machine/debug/start.ts). A type a host registers
+// must be one its manifest declares, and a session of a type is reached only by the host that
+// registered it.
+
+import { z } from 'zod';
+import type { AppDebugPort, AppSessionInfo, DebugControl } from '../../debug/app/port.ts';
+import { Refused, parsed, type HostHandler } from '../host/connection.ts';
+import type { HostTools } from './registry.ts';
+import type { AppStream } from './streams.ts';
+
+/** The milliseconds the host has to open the stream of an adapter it was asked to start. */
+const START_MS = 15_000;
+
+/** The milliseconds a provider has to answer a request for configurations. */
+const PROVIDE_MS = 10_000;
+
+const registerShape = z.object({
+    kind: z.enum(['factory', 'configurations']),
+    type: z.string().min(1).max(200),
+    provides: z.boolean().optional()
+});
+
+const startShape = z.object({
+    folder: z.string().max(4096),
+    name: z.string().max(500),
+    configuration: z.record(z.string(), z.unknown()).nullable()
+});
+
+/** What a host registered for one debugger type. */
+type DebugRegistration = { type: string; factory: boolean; configurations: boolean };
+
+/** The executable a debugger's manifest names, as the host's `DebugAdapterExecutable` takes it. */
+type AdapterExecutable = { command: string; args: string[]; options: { cwd: string } };
+
+/** The debug part of one host. */
+export type DebugHost = {
+    handlers: Record<string, HostHandler>;
+    registrations(): DebugRegistration[];
+    /** Whether the host registered a descriptor factory or a provider for the type. */
+    holds(type: string): boolean;
+    /** Ask the host to start the adapter of a type; the stream it opens. */
+    open(
+        type: string,
+        session: AppSessionInfo,
+        executable: AdapterExecutable | null,
+        cwd: string
+    ): Promise<AppStream>;
+    tell(event: Record<string, unknown>): void;
+    stop(): void;
+} & Pick<AppDebugPort, 'configurations' | 'resolve'>;
+
+/** The debug part of one host. `control` is read at each request. */
+export function debugHost(host: HostTools, control: () => DebugControl | undefined): DebugHost {
+    const factories = new Set<string>();
+    const providers = new Map<string, boolean>();
+    const declared = (type: string): boolean =>
+        host.app().row.contributes.debuggers.some((one) => one.type === type);
+    const handlers: Record<string, HostHandler> = {
+        'oculus/debug/register': (params) => {
+            host.app();
+            const body = parsed(registerShape, params);
+            if (!declared(body.type)) throw new Refused('not_declared');
+            if (body.kind === 'factory') {
+                if (factories.has(body.type)) throw new Refused('refused:registered');
+                factories.add(body.type);
+            } else {
+                if (providers.has(body.type)) throw new Refused('refused:registered');
+                providers.set(body.type, body.provides === true);
+            }
+            host.changed();
+            return null;
+        },
+        'oculus/debug/unregister': (params) => {
+            host.app();
+            const body = parsed(registerShape, params);
+            if (body.kind === 'factory') factories.delete(body.type);
+            else providers.delete(body.type);
+            host.changed();
+            return null;
+        },
+        'oculus/debug/startDebugging': async (params) => {
+            const app = host.app();
+            const body = parsed(startShape, params);
+            const given = control();
+            if (given === undefined) return false;
+            return given.start({ app: app.id, ...body });
+        },
+        'oculus/debug/stopDebugging': async (params) => {
+            host.app();
+            const body = parsed(z.object({ session: z.string().max(100) }), params);
+            const given = control();
+            const current = given?.current() ?? null;
+            if (given === undefined || current === null) return null;
+            if (body.session !== '' && body.session !== current.id) return null;
+            await given.stop(current.id);
+            return null;
+        },
+        'oculus/debug/customRequest': async (params) => {
+            host.app();
+            const body = parsed(
+                z.object({
+                    session: z.string().max(100),
+                    command: z.string().min(1).max(200),
+                    args: z.unknown()
+                }),
+                params
+            );
+            const given = control();
+            if (given === undefined) throw new Refused('refused:no_session');
+            try {
+                return await given.custom(body.session, body.command, body.args);
+            } catch (error) {
+                throw new Refused(
+                    error instanceof Error && error.message.startsWith('refused:')
+                        ? error.message
+                        : `refused:${error instanceof Error ? error.message : 'failed'}`
+                );
+            }
+        }
+    };
+    return {
+        handlers,
+        registrations: () => {
+            const types = new Set([...factories, ...providers.keys()]);
+            return [...types].map((type) => ({
+                type,
+                factory: factories.has(type),
+                configurations: providers.get(type) === true
+            }));
+        },
+        holds: (type) => factories.has(type) || providers.has(type),
+        async open(type, session, executable, cwd) {
+            const wanted = host.streams.expect(START_MS);
+            try {
+                await host.request('oculus/debug/start', {
+                    type,
+                    token: wanted.token,
+                    session,
+                    executable,
+                    cwd
+                });
+                return await wanted.stream;
+            } catch (error) {
+                wanted.cancel();
+                throw error;
+            }
+        },
+        async configurations(type, folder) {
+            if (providers.get(type) !== true) return [];
+            const timeout = new Promise<never>((_, reject) => {
+                const timer = setTimeout(() => reject(new Error('timeout')), PROVIDE_MS);
+                timer.unref();
+            });
+            const answer = await Promise.race([
+                host.request('oculus/debug/configurations', { type, folder }),
+                timeout
+            ]);
+            return Array.isArray(answer)
+                ? answer.filter(
+                      (one): one is Record<string, unknown> =>
+                          typeof one === 'object' && one !== null
+                  )
+                : [];
+        },
+        async resolve(type, folder, configuration, stage) {
+            if (!providers.has(type)) return { configuration };
+            const answer = (await host.request('oculus/debug/resolve', {
+                type,
+                folder,
+                configuration,
+                stage
+            })) as { abort?: unknown; configuration?: unknown } | null;
+            if (answer?.abort === true) return { abort: true };
+            const given = answer?.configuration;
+            if (typeof given !== 'object' || given === null) return { abort: true };
+            return { configuration: given as Record<string, unknown> };
+        },
+        tell: (event) => host.notify('oculus/debug/event', event),
+        stop() {
+            factories.clear();
+            providers.clear();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/decorations.ts b/tools/oculus/src/lib/server/machine/apps/tools/decorations.ts
new file mode 100644
index 000000000..0502c7293
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/decorations.ts
@@ -0,0 +1,325 @@
+// Layer 2, server. The file decorations of the apps' hosts, joined for the Files view. A host that
+// registers a provider (`oculus/decorations/register`) is asked for the files a page draws
+// (`oculus/decorations/provide`, one list of URIs, answered with the answer of each of its
+// providers for each URI) and tells which files changed (`oculus/decorations/changed`).
+//
+// The answers of every acting app's host are joined for a file: the badges one after another in the
+// Views list's order (a badge of more than two characters is dropped with a line in its host's
+// output, and two characters are kept in all), the tooltips one to a line, the colour of the first
+// provider that gave one, and `propagate` when a provider that gave the colour asked for it. A
+// joined answer is kept until a change names the file; a provider that has not answered after
+// `LATE_MS` leaves the rest of the request to be answered and the file is named as changed when it
+// does, so a late answer decorates the row when it comes. A URI outside the folders of the app's
+// scope is not asked of that app, and a provider that throws or answers nothing gives nothing.
+//
+// The changes are held for a page to read in the `app-tools` payload as the files changed lately,
+// each with the epoch of its change (`AppDecorationChanges`). They are not messages of the host's
+// the limits count.
+
+import type { AppDecoration, AppDecorationChanges } from '../../../../data/model/index.ts';
+import { Refused, type HostHandler, type HostNotice } from '../host/connection.ts';
+import type { HostTools } from './registry.ts';
+import { words } from '../../../core/words.ts';
+
+/** The most characters of badge a file shows. */
+const BADGE_MAX = 2;
+
+/** How long a request waits for the providers before it answers what it has. */
+const LATE_MS = 1000;
+
+/** How long a changed file stays in the payload. */
+const KEEP_MS = 10_000;
+
+/** The most files the payload names before every file is told as changed. */
+const FILES_MAX = 2000;
+
+/**
+ * The decorations of one file, one entry per provider of a host, nothing for a provider with none.
+ */
+type Given = (AppDecoration | null)[];
+
+/** One host's provider side. */
+export type DecorationHost = {
+    handlers: Record<string, HostHandler>;
+    notices: Record<string, HostNotice>;
+    /** Whether a provider is registered. */
+    registered(): boolean;
+    /** Ask for the decorations of file URIs; one list of answers per URI. */
+    provide(uris: string[]): Promise<Given[]>;
+    stop(): void;
+};
+
+/** What the hub asks of the registry: the acting hosts' order and the scope of each. */
+export type DecorationSources = {
+    /** The hosts that can decorate, apps in the Views list's order. */
+    hosts(): { app: string; host: DecorationHost; tools: HostTools }[];
+    /** The root and path of a file URI in the scope of an app, or null. */
+    place(app: string, uri: string): { root: string; path: string } | null;
+    /** The file URI of a root and path in the scope of an app. */
+    uriOf(app: string, root: string, path: string): string | null;
+    /** A change was taken: publish the payload. */
+    changed(): void;
+};
+
+/** The decorations part of one host. */
+export function decorationHost(
+    host: HostTools,
+    heard: (uris: string[], all: boolean) => void
+): DecorationHost {
+    let registered = false;
+    const handlers: Record<string, HostHandler> = {
+        'oculus/decorations/register': () => {
+            host.app();
+            registered = true;
+            host.changed();
+            return null;
+        },
+        'oculus/decorations/unregister': () => {
+            host.app();
+            registered = false;
+            host.changed();
+            return null;
+        }
+    };
+    const notices: Record<string, HostNotice> = {
+        'oculus/decorations/changed': (params) => {
+            host.app();
+            const body = (typeof params === 'object' && params !== null ? params : {}) as {
+                uris?: unknown;
+                all?: unknown;
+            };
+            const uris = Array.isArray(body.uris)
+                ? body.uris.filter((one): one is string => typeof one === 'string')
+                : [];
+            heard(uris, body.all === true);
+        }
+    };
+    return {
+        handlers,
+        notices,
+        registered: () => registered,
+        async provide(uris) {
+            const answer = await host.request('oculus/decorations/provide', { uris });
+            if (!Array.isArray(answer)) throw new Refused('refused:answer');
+            return answer.map((one) =>
+                Array.isArray(one) ? one.map((given) => plain(given as unknown)) : []
+            );
+        },
+        stop() {
+            registered = false;
+        }
+    };
+}
+
+/** A decoration read from the host's answer, or null for none. */
+function plain(value: unknown): AppDecoration | null {
+    if (typeof value !== 'object' || value === null) return null;
+    const one = value as Record<string, unknown>;
+    return {
+        badge: typeof one.badge === 'string' ? one.badge : '',
+        tooltip: typeof one.tooltip === 'string' ? one.tooltip : '',
+        color: typeof one.color === 'string' ? one.color : '',
+        propagate: one.propagate === true
+    };
+}
+
+/** The decorations of the files a page draws, joined across the apps, with their changes. */
+export class Decorations {
+    readonly #sources: DecorationSources;
+    readonly #cache = new Map<string, AppDecoration | null>();
+    readonly #waiting = new Map<string, Promise<void>>();
+    readonly #recent = new Map<string, { root: string; path: string; epoch: number; at: number }>();
+    readonly #now: () => number;
+    #epoch = 0;
+    #allAt = 0;
+
+    constructor(sources: DecorationSources, now: () => number = Date.now) {
+        this.#sources = sources;
+        this.#now = now;
+    }
+
+    /** The changes a page reads. */
+    changes(): AppDecorationChanges {
+        this.#prune();
+        return {
+            epoch: this.#epoch,
+            allAt: this.#allAt,
+            files: [...this.#recent.values()].map(({ root, path, epoch }) => ({
+                root,
+                path,
+                epoch
+            }))
+        };
+    }
+
+    /** A host told that files changed (`all` for every file). */
+    changed(app: string, uris: string[], all: boolean): void {
+        if (all) {
+            this.#cache.clear();
+            this.#epoch += 1;
+            this.#allAt = this.#epoch;
+            this.#recent.clear();
+        } else {
+            for (const uri of uris) {
+                const placed = this.#sources.place(app, uri);
+                if (placed === null) continue;
+                this.#cache.delete(`${placed.root}\u0000${placed.path}`);
+                this.#epoch += 1;
+                this.#recent.set(`${placed.root}\u0000${placed.path}`, {
+                    ...placed,
+                    epoch: this.#epoch,
+                    at: this.#now()
+                });
+            }
+            if (this.#recent.size > FILES_MAX) {
+                this.#epoch += 1;
+                this.#allAt = this.#epoch;
+                this.#recent.clear();
+                this.#cache.clear();
+            }
+        }
+        this.#sources.changed();
+    }
+
+    /** Forget what was joined for a host that stopped or changed what it registers. */
+    reset(): void {
+        this.#cache.clear();
+        this.#epoch += 1;
+        this.#allAt = this.#epoch;
+        this.#recent.clear();
+    }
+
+    /**
+     * The joined decorations of files of a root. A path whose providers have not all answered after
+     * `LATE_MS` is left out of `decorations` and named in `pending`; it is named as changed when
+     * the last provider answers.
+     */
+    async decorate(
+        root: string,
+        paths: string[]
+    ): Promise<{ decorations: Record<string, AppDecoration | null>; pending: string[] }> {
+        const decorations: Record<string, AppDecoration | null> = {};
+        const pending: string[] = [];
+        const wanted: string[] = [];
+        for (const path of paths) {
+            const key = `${root}\u0000${path}`;
+            if (this.#cache.has(key)) decorations[path] = this.#cache.get(key) ?? null;
+            else wanted.push(path);
+        }
+        if (wanted.length > 0 && this.#sources.hosts().some((one) => one.host.registered())) {
+            const asked = this.#ask(root, wanted);
+            const late = new Promise<'late'>((resolve) => {
+                const timer = setTimeout(() => resolve('late'), LATE_MS);
+                timer.unref();
+                void asked.then(() => clearTimeout(timer));
+            });
+            await Promise.race([asked, late]);
+            for (const path of wanted) {
+                const key = `${root}\u0000${path}`;
+                if (this.#cache.has(key)) decorations[path] = this.#cache.get(key) ?? null;
+                else pending.push(path);
+            }
+            if (pending.length > 0) void asked.then(() => this.#late(root, pending));
+        } else for (const path of wanted) decorations[path] = null;
+        return { decorations, pending };
+    }
+
+    /** Ask every host for the files, join the answers and keep them. */
+    #ask(root: string, paths: string[]): Promise<void> {
+        const key = `${root}\u0000${paths.join('\u0000')}`;
+        const running = this.#waiting.get(key);
+        if (running !== undefined) return running;
+        const work = this.#join(root, paths).finally(() => this.#waiting.delete(key));
+        this.#waiting.set(key, work);
+        return work;
+    }
+
+    async #join(root: string, paths: string[]): Promise<void> {
+        const answers = new Map<string, AppDecoration[]>();
+        for (const path of paths) answers.set(path, []);
+        const hosts = this.#sources.hosts();
+        const given = await Promise.all(
+            hosts.map(async ({ app, host, tools }) => {
+                if (!host.registered()) return [];
+                const places: { path: string; uri: string }[] = [];
+                for (const path of paths) {
+                    const uri = this.#sources.uriOf(app, root, path);
+                    if (uri !== null && this.#sources.place(app, uri) !== null) {
+                        places.push({ path, uri });
+                    }
+                }
+                if (places.length === 0) return [];
+                try {
+                    const lists = await host.provide(places.map((one) => one.uri));
+                    return places.map((one, at) => ({
+                        path: one.path,
+                        tools,
+                        list: lists[at] ?? []
+                    }));
+                } catch {
+                    return [];
+                }
+            })
+        );
+        for (const host of given) {
+            for (const { path, tools, list } of host) {
+                for (const one of list) {
+                    if (one === null) continue;
+                    const kept = this.#checked(tools, one);
+                    if (kept !== null) answers.get(path)?.push(kept);
+                }
+            }
+        }
+        for (const path of paths) {
+            this.#cache.set(`${root}\u0000${path}`, joinedOf(answers.get(path) ?? []));
+        }
+    }
+
+    /** Files whose answer came after the request was answered are named as changed. */
+    #late(root: string, paths: string[]): void {
+        for (const path of paths) {
+            this.#epoch += 1;
+            this.#recent.set(`${root}\u0000${path}`, {
+                root,
+                path,
+                epoch: this.#epoch,
+                at: this.#now()
+            });
+        }
+        this.#sources.changed();
+    }
+
+    /**
+     * A decoration with a badge of more than two characters loses it, with a line in the host's
+     * output.
+     */
+    #checked(tools: HostTools, one: AppDecoration): AppDecoration | null {
+        let badge = one.badge;
+        if (Array.from(badge).length > BADGE_MAX) {
+            tools.note(words(tools.catalog(), 'server.apps.decoration_badge', badge));
+            badge = '';
+        }
+        if (badge === '' && one.tooltip === '' && one.color === '') return null;
+        return { ...one, badge };
+    }
+
+    #prune(): void {
+        const cutoff = this.#now() - KEEP_MS;
+        for (const [key, one] of this.#recent) if (one.at < cutoff) this.#recent.delete(key);
+    }
+}
+
+/** The answers of the providers for one file as one decoration, or null when they give nothing. */
+function joinedOf(answers: readonly AppDecoration[]): AppDecoration | null {
+    if (answers.length === 0) return null;
+    let badge = '';
+    for (const one of answers) badge += one.badge;
+    const color = answers.find((one) => one.color !== '');
+    const tooltips = answers.map((one) => one.tooltip).filter((one) => one !== '');
+    return {
+        badge: Array.from(badge).slice(0, BADGE_MAX).join(''),
+        tooltip: tooltips.join('\n'),
+        color: color?.color ?? '',
+        propagate: color?.propagate === true
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/languages.ts b/tools/oculus/src/lib/server/machine/apps/tools/languages.ts
new file mode 100644
index 000000000..f0cf3de70
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/tools/languages.ts
@@ -0,0 +1,224 @@
+// Layer 2, server. What an app's host registers with the language tools: the servers it created
+// with `oculus.languages.registerLanguageServer`, the one in-host server that serves every
+// `register*Provider` call, the diagnostic collections and the languages it asks for.
+//
+// A server is held as the options the app gave: a `documentSelector`, the settings sections it is
+// asked for and its `initializationOptions`. It is not started here. The language server relay
+// (lsp/relay/) starts one server for each folder of the app's scope with the first document of a
+// selected language, through `open`, which asks the host to make the server
+// (`oculus/languages/start`) and gives back the `languageServer` stream the host opens for it.
+//
+// The providers an app registers are one server too, named `providers`. Its selector and the
+// capabilities its providers answer are told by the host (`oculus/languages/providers`) whenever a
+// provider is added or removed.
+
+import { z } from 'zod';
+import type { AppToolsHost, AppToolsServer } from '../../../../data/model/index.ts';
+import { Refused, parsed, type HostHandler, type HostNotice } from '../host/connection.ts';
+import type { HostTools } from './registry.ts';
+import type { AppStream } from './streams.ts';
+
+/** The id of the server that serves the providers of an app. */
+const PROVIDERS = 'providers';
+
+/** The milliseconds the host has to open the stream of a server it was asked to start. */
+const START_MS = 10_000;
+
+const selectorShape = z
+    .array(
+        z.object({
+            language: z.string().default(''),
+            pattern: z.string().default('')
+        })
+    )
+    .max(64);
+
+const registerShape = z.discriminatedUnion('kind', [
+    z.object({
+        kind: z.literal('server'),
+        id: z.string().regex(/^[A-Za-z0-9._-]{1,64}$/),
+        options: z.object({
+            selector: selectorShape,
+            output: z.string().max(200).default(''),
+            sections: z.array(z.string().max(200)).max(64).default([]),
+            initializationOptions: z.unknown().default(null)
+        })
+    }),
+    z.object({
+        kind: z.literal('collection'),
+        id: z.string().min(1).max(200),
+        options: z.unknown().optional()
+    })
+]);
+
+const unregisterShape = z.object({
+    kind: z.enum(['server', 'collection']),
+    id: z.string().min(1)
+});
+
+const providersShape = z.object({
+    selector: selectorShape,
+    capabilities: z.record(z.string(), z.unknown())
+});
+
+const diagnosticsShape = z.object({
+    collection: z.string().min(1),
+    uri: z.string().min(1),
+    diagnostics: z.array(z.record(z.string(), z.unknown())).max(10_000)
+});
+
+/** A server of an app as the relay reads it. */
+export type AppServerReg = {
+    /** The view id of the app. */
+    app: string;
+    /** The root key the app is confined to; empty for a machine app. */
+    root: string;
+    id: string;
+    /** The name the status item and the diagnostics' source show. */
+    name: string;
+    selector: readonly { language: string; pattern: string }[];
+    sections: readonly string[];
+    initializationOptions: unknown;
+    /** The capabilities of the in-host providers; null for a server the app made itself. */
+    capabilities: Record<string, unknown> | null;
+};
+
+/** The diagnostics an app's collection holds for a file, as the host last set them. */
+export type CollectionDiagnostics = {
+    app: string;
+    collection: string;
+    uri: string;
+    diagnostics: Record<string, unknown>[];
+};
+
+/** What the language tools of one host hold, and what the relay asks of them. */
+export type LanguageTools = {
+    handlers: Record<string, HostHandler>;
+    notices: Record<string, HostNotice>;
+    /** The servers registered, the providers' first. */
+    servers(): AppServerReg[];
+    /** The diagnostics each collection holds, by file URI. */
+    collections(): Map<string, Map<string, Record<string, unknown>[]>>;
+    /** Ask the host to start the server for a folder; the stream it opens. */
+    open(server: string, root: string): Promise<AppStream>;
+    fill(into: AppToolsHost): void;
+    stop(): void;
+};
+
+/** The language tools of one host. */
+export function languageTools(
+    host: HostTools,
+    heard: (diagnostics: CollectionDiagnostics) => void
+): LanguageTools {
+    const servers = new Map<string, AppServerReg>();
+    const collections = new Map<string, Map<string, Record<string, unknown>[]>>();
+    let providers: AppServerReg | null = null;
+
+    const handlers: Record<string, HostHandler> = {
+        'oculus/languages/register': (params) => {
+            const app = host.app();
+            const body = parsed(registerShape, params);
+            if (body.kind === 'collection') {
+                if (collections.has(body.id)) throw new Refused('refused:registered');
+                collections.set(body.id, new Map());
+            } else {
+                if (servers.has(body.id) || body.id === PROVIDERS) {
+                    throw new Refused('refused:registered');
+                }
+                servers.set(body.id, {
+                    app: app.id,
+                    root: app.row.root,
+                    id: body.id,
+                    name: body.options.output === '' ? body.id : body.options.output,
+                    selector: body.options.selector,
+                    sections: body.options.sections,
+                    initializationOptions: body.options.initializationOptions,
+                    capabilities: null
+                });
+            }
+            host.changed();
+            return null;
+        },
+        'oculus/languages/unregister': (params) => {
+            host.app();
+            const body = parsed(unregisterShape, params);
+            if (body.kind === 'server') servers.delete(body.id);
+            else if (collections.delete(body.id)) {
+                host.notify('oculus/languages/cleared', { collection: body.id });
+            }
+            host.changed();
+            return null;
+        },
+        'oculus/languages/providers': (params) => {
+            const app = host.app();
+            const body = parsed(providersShape, params);
+            providers =
+                Object.keys(body.capabilities).length === 0
+                    ? null
+                    : {
+                          app: app.id,
+                          root: app.row.root,
+                          id: PROVIDERS,
+                          name: app.row.title,
+                          selector: body.selector,
+                          sections: [],
+                          initializationOptions: null,
+                          capabilities: body.capabilities
+                      };
+            host.changed();
+            return null;
+        },
+        'oculus/languages/list': () => [...host.scope.env.languages().values()]
+    };
+
+    const notices: Record<string, HostNotice> = {
+        'oculus/languages/diagnostics': (params) => {
+            const app = host.app();
+            const body = parsed(diagnosticsShape, params);
+            const own = collections.get(body.collection);
+            if (own === undefined) return;
+            if (body.diagnostics.length === 0) own.delete(body.uri);
+            else own.set(body.uri, body.diagnostics);
+            heard({ app: app.id, ...body });
+        }
+    };
+
+    return {
+        handlers,
+        notices,
+        servers: () => [...(providers === null ? [] : [providers]), ...servers.values()],
+        collections: () => collections,
+        async open(server, root) {
+            const wanted = host.streams.expect(START_MS);
+            try {
+                await host.request('oculus/languages/start', { server, root, token: wanted.token });
+                return await wanted.stream;
+            } catch (error) {
+                wanted.cancel();
+                throw error;
+            }
+        },
+        fill(into) {
+            const shown = (one: AppServerReg): AppToolsServer => ({
+                id: one.id,
+                selector: [...one.selector],
+                output: one.name,
+                sections: [...one.sections]
+            });
+            into.servers = [...servers.values()].map(shown);
+            into.providers =
+                providers === null
+                    ? null
+                    : {
+                          selector: [...providers.selector],
+                          capabilities: providers.capabilities ?? {}
+                      };
+            into.collections = [...collections.keys()];
+        },
+        stop() {
+            servers.clear();
+            collections.clear();
+            providers = null;
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/tools/registry.ts b/tools/oculus/src/lib/server/machine/apps/tools/registry.ts
