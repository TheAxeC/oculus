diff --git a/tools/oculus/tests/ui/controls/editor/zones.test.ts b/tools/oculus/tests/ui/controls/editor/zones.test.ts
new file mode 100644
index 00000000..5cf05e91
--- /dev/null
+++ b/tools/oculus/tests/ui/controls/editor/zones.test.ts
@@ -0,0 +1,121 @@
+// The bars an editor draws above its lines keep their room when the editor is given a model: an
+// editor drops its view zones with its model and keeps its overlay widgets, so a bar placed before
+// the model came would stay out of sight, and with it the merge editor's Accept buttons.
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type * as Monaco from 'monaco-editor';
+import { lineBars } from '../../../../src/lib/ui/controls/editor/zones.ts';
+
+type Zone = Monaco.editor.IViewZone;
+
+/** An editor that keeps its zones until its model changes, as Monaco does, and its widgets. */
+function fakeEditor(): {
+    editor: Monaco.editor.ICodeEditor;
+    zones: Map<string, Zone>;
+    widgets: Set<Monaco.editor.IOverlayWidget>;
+    model(next: object | null): void;
+    draw(top: number): void;
+} {
+    const zones = new Map<string, Zone>();
+    const widgets = new Set<Monaco.editor.IOverlayWidget>();
+    let model: object | null = null;
+    let changed: () => void = () => undefined;
+    let made = 0;
+    const editor = {
+        getModel: () => model,
+        getLayoutInfo: () => ({
+            width: 400,
+            minimap: { minimapWidth: 40 },
+            verticalScrollbarWidth: 10
+        }),
+        addOverlayWidget: (widget: Monaco.editor.IOverlayWidget) => widgets.add(widget),
+        removeOverlayWidget: (widget: Monaco.editor.IOverlayWidget) => widgets.delete(widget),
+        changeViewZones: (change: (accessor: Monaco.editor.IViewZoneChangeAccessor) => void) => {
+            change({
+                addZone: (zone: Zone) => {
+                    made += 1;
+                    zones.set(String(made), zone);
+                    return String(made);
+                },
+                removeZone: (id: string) => zones.delete(id),
+                layoutZone: () => undefined
+            });
+        },
+        onDidLayoutChange: () => ({ dispose: () => undefined }),
+        onDidChangeModel: (listener: () => void) => {
+            changed = listener;
+            return { dispose: () => (changed = () => undefined) };
+        }
+    } as unknown as Monaco.editor.ICodeEditor;
+    return {
+        editor,
+        zones,
+        widgets,
+        model(next) {
+            model = next;
+            zones.clear();
+            changed();
+        },
+        draw(top) {
+            for (const zone of zones.values()) zone.onDomNodeTop?.(top);
+        }
+    };
+}
+
+/** A bar's element as far as zones.ts reads and writes it. */
+function bar(): HTMLElement {
+    return { style: {}, offsetHeight: 28 } as unknown as HTMLElement;
+}
+
+describe('the bars above the lines of an editor', () => {
+    beforeEach(() => {
+        vi.stubGlobal('document', { createElement: () => ({}) });
+    });
+    afterEach(() => {
+        vi.unstubAllGlobals();
+    });
+
+    it('keeps a bar out of sight and asks for no room while the editor holds no model', () => {
+        const fake = fakeEditor();
+        const bars = lineBars();
+        bars.mount(fake.editor, 18);
+        const node = bar();
+        bars.above(1)(node);
+        expect(fake.widgets.size).toBe(1);
+        expect(fake.zones.size).toBe(0);
+        expect(node.style.top).toBe('-1000px');
+    });
+
+    it('makes the room of a bar placed before the model once the model is set', () => {
+        const fake = fakeEditor();
+        const bars = lineBars();
+        bars.mount(fake.editor, 18);
+        const node = bar();
+        bars.above(1)(node);
+        fake.model({});
+        expect(fake.widgets.size).toBe(1);
+        expect(
+            [...fake.zones.values()].map((zone) => [zone.afterLineNumber, zone.heightInPx])
+        ).toEqual([[1, 28]]);
+        fake.draw(36);
+        expect(node.style.top).toBe('36px');
+    });
+
+    it('makes the room again on every model and takes the last one away with the bar', () => {
+        const fake = fakeEditor();
+        const bars = lineBars();
+        fake.model({});
+        bars.mount(fake.editor, 18);
+        const node = bar();
+        const off = bars.above(3)(node);
+        expect(fake.zones.size).toBe(1);
+        fake.model({});
+        expect(fake.zones.size).toBe(1);
+        expect(node.style.top).toBe('-1000px');
+        fake.draw(54);
+        expect(node.style.top).toBe('54px');
+        if (typeof off === 'function') off();
+        expect(fake.zones.size).toBe(0);
+        expect(fake.widgets.size).toBe(0);
+    });
+});
