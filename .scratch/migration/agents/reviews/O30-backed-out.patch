+        const first = placeWindow(saved?.bounds ?? null, areas, primary);
+        const rect =
+            count === 0
+                ? first
+                : placeWindow(
+                      { ...first, x: first.x + CASCADE * count, y: first.y + CASCADE * count },
+                      areas,
+                      primary
+                  );
