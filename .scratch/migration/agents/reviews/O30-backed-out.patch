+// Layer 2, server (the desktop host). The application menu, the macOS one: oculus, File, Edit,
+// View, Window and Help. Every label is a catalog word. Cmd+W is on no item, so it reaches the
+// page, which closes the active tab; the Edit items keep their roles and their labels but do not
+// register their accelerators, so Cmd+Z, Cmd+C and the others reach the page, where Monaco and the
+// terminal answer them themselves, and a text field answers them as Chromium does. The menu's own
+// commands that the page answers (Settings, Help) are sent to a main window over the bridge.
+
+import { Menu, type MenuItemConstructorOptions } from 'electron';
+import type { Words } from '../../lib/server/root/process/words.ts';
+
+/** What the menu's items ask of the app. */
+export type MenuActions = {
+    newWindow: () => void;
+    closeWindow: () => void;
+    command: (name: 'settings' | 'help') => void;
+    zoom: (step: 'in' | 'out' | 'reset') => void;
+    switchToMain: () => void;
+};
+
+/** The application menu, made from the catalog's words. */
+export function buildMenu(t: Words, actions: MenuActions): Menu {
+    const separator: MenuItemConstructorOptions = { type: 'separator' };
+    const template: MenuItemConstructorOptions[] = [
+        {
+            label: t('desktop.menu.app'),
+            submenu: [
+                { role: 'about', label: t('desktop.menu.about') },
+                separator,
+                {
+                    label: t('desktop.menu.settings'),
+                    accelerator: 'Cmd+,',
+                    click: () => actions.command('settings')
+                },
+                separator,
+                { role: 'hide', label: t('desktop.menu.hide') },
+                { role: 'hideOthers', label: t('desktop.menu.hide_others') },
+                { role: 'unhide', label: t('desktop.menu.show_all') },
+                separator,
+                { role: 'quit', label: t('desktop.menu.quit') }
+            ]
+        },
+        {
+            label: t('desktop.menu.file'),
+            submenu: [
+                {
+                    label: t('desktop.menu.new_window'),
+                    accelerator: 'Cmd+Shift+N',
+                    click: actions.newWindow
+                },
+                {
+                    label: t('desktop.menu.close_window'),
+                    accelerator: 'Cmd+Shift+W',
+                    click: actions.closeWindow
+                }
+            ]
+        },
+        {
+            label: t('desktop.menu.edit'),
+            submenu: [
+                { role: 'undo', label: t('desktop.menu.undo'), registerAccelerator: false },
+                { role: 'redo', label: t('desktop.menu.redo'), registerAccelerator: false },
+                separator,
+                { role: 'cut', label: t('desktop.menu.cut'), registerAccelerator: false },
+                { role: 'copy', label: t('desktop.menu.copy'), registerAccelerator: false },
+                { role: 'paste', label: t('desktop.menu.paste'), registerAccelerator: false },
+                {
+                    role: 'selectAll',
+                    label: t('desktop.menu.select_all'),
+                    registerAccelerator: false
+                }
+            ]
+        },
+        {
+            label: t('desktop.menu.view'),
+            submenu: [
+                { role: 'reload', label: t('desktop.menu.reload'), accelerator: 'Cmd+R' },
+                {
+                    role: 'togglefullscreen',
+                    label: t('desktop.menu.full_screen'),
+                    accelerator: 'Ctrl+Cmd+F'
+                },
+                separator,
+                {
+                    label: t('desktop.menu.zoom_in'),
+                    accelerator: 'Cmd+=',
+                    click: () => actions.zoom('in')
+                },
+                {
+                    label: t('desktop.menu.zoom_out'),
+                    accelerator: 'Cmd+-',
+                    click: () => actions.zoom('out')
+                },
+                {
+                    label: t('desktop.menu.zoom_reset'),
+                    accelerator: 'Cmd+0',
+                    click: () => actions.zoom('reset')
+                },
+                separator,
+                {
+                    role: 'toggleDevTools',
+                    label: t('desktop.menu.devtools'),
+                    accelerator: 'Alt+Cmd+I'
+                }
+            ]
+        },
+        {
+            label: t('desktop.menu.window'),
+            role: 'window',
+            submenu: [
+                { role: 'minimize', label: t('desktop.menu.minimize') },
+                { role: 'zoom', label: t('desktop.menu.zoom') },
+                { role: 'front', label: t('desktop.menu.front') },
+                separator,
+                { label: t('desktop.menu.switch_main'), click: actions.switchToMain }
+            ]
+        },
+        {
+            label: t('desktop.menu.help'),
+            role: 'help',
+            submenu: [{ label: t('desktop.menu.help_item'), click: () => actions.command('help') }]
+        }
+    ];
+    return Menu.buildFromTemplate(template);
+}
diff --git a/tools/oculus/src/desktop/windows/pick.ts b/tools/oculus/src/desktop/windows/pick.ts
new file mode 100644
index 000000000..345b25f6f
--- /dev/null
+++ b/tools/oculus/src/desktop/windows/pick.ts
@@ -0,0 +1,61 @@
+// Layer 2, server (the desktop host). The folder panel in the app. The server asks for it
+// (`pick-folders`); the host shows Electron's open dialog as a sheet on the window the reader is in
+// and answers with the paths, `cancelled`, or `failed`. The sheet cannot be taken down from here,
+// so a pick is tied to the page it was shown on: when that page goes (it reloads, navigates or
+// crashes, or its window closes) before the sheet answers, the pick is answered `cancelled` at once
+// and the sheet's later answer is dropped. The server's panel is then free, nothing is added and
+// no failure is said; a sheet left on screen is cancelled by the reader and its answer ignored.
+
+import { dialog } from 'electron';
+import { homedir } from 'node:os';
+import type { MainMessage } from '../../lib/server/root/process/parent.ts';
+import type { Words } from '../../lib/server/root/process/words.ts';
+import type { Entry, Windows } from './windows.ts';
+
+/** Answer the pick `id` of the server with the folders chosen, if any. */
+export type PickAnswer = (message: MainMessage) => void;
+
+/** The picks in flight are told apart by the id the server gave them. */
+export function createPicker(windows: Windows, t: Words, answer: PickAnswer) {
+    return function pick(id: number): void {
+        const entry: Entry | null = windows.focused();
+        if (entry === null) {
+            answer({ kind: 'picked', id, cancelled: true });
+            return;
+        }
+        let answered = false;
+        const contents = entry.win.webContents;
+        const settle = (message: MainMessage): void => {
+            if (answered) return;
+            answered = true;
+            if (!contents.isDestroyed()) {
+                contents.off('did-start-navigation', navigated);
+                contents.off('render-process-gone', gone);
+            }
+            if (!entry.win.isDestroyed()) entry.win.off('closed', gone);
+            answer(message);
+        };
+        const gone = (): void => settle({ kind: 'picked', id, cancelled: true });
+        const navigated = (details: { isMainFrame: boolean; isSameDocument: boolean }): void => {
+            if (details.isMainFrame && !details.isSameDocument) gone();
+        };
+        contents.on('did-start-navigation', navigated);
+        contents.on('render-process-gone', gone);
+        entry.win.on('closed', gone);
+        dialog
+            .showOpenDialog(entry.win, {
+                properties: ['openDirectory', 'multiSelections', 'createDirectory'],
+                buttonLabel: t('desktop.pick.add'),
+                defaultPath: homedir()
+            })
+            .then(
+                (result) =>
+                    settle(
+                        result.canceled
+                            ? { kind: 'picked', id, cancelled: true }
+                            : { kind: 'picked', id, paths: result.filePaths }
+                    ),
+                () => settle({ kind: 'picked', id, failed: true })
+            );
+    };
+}
diff --git a/tools/oculus/src/desktop/windows/window-state.ts b/tools/oculus/src/desktop/windows/window-state.ts
new file mode 100644
index 000000000..a54cf6ebe
--- /dev/null
+++ b/tools/oculus/src/desktop/windows/window-state.ts
@@ -0,0 +1,59 @@
+// Layer 2, server (the desktop host). Where ~/.oculus/window.json is read and written. The main
+// window's state is read before the window is made and written when the window moves, resizes,
+// changes state or closes: a change is held for the wait and the latest one is written, through a
+// temporary file and a rename so a reader never meets half a file. `flush` writes what is held at
+// once, for the close and the quit. A file that cannot be read is no state (decide/window-file.ts).
+
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { parseWindowFile, windowFileText, type WindowState } from '../decide/window-file.ts';
+
+/** The wait between a change and its write, in milliseconds. */
+const WRITE_WAIT_MS = 500;
+
+/** The kept state of the main window. */
+export type WindowStore = {
+    /** The state the file holds, or null when it holds none. */
+    read: () => WindowState | null;
+    /** Keep a state; it is written after the wait unless a later one replaces it. */
+    keep: (state: WindowState) => void;
+    /** Write the state held now, if any. */
+    flush: () => void;
+};
+
+export function createWindowStore(file: string, wait: number = WRITE_WAIT_MS): WindowStore {
+    let held: WindowState | null = null;
+    let timer: NodeJS.Timeout | undefined;
+
+    function write(): void {
+        clearTimeout(timer);
+        timer = undefined;
+        if (held === null) return;
+        const text = windowFileText(held);
+        held = null;
+        const temporary = `${file}.${process.pid}.tmp`;
+        try {
+            mkdirSync(dirname(file), { recursive: true });
+            writeFileSync(temporary, text);
+            renameSync(temporary, file);
+        } catch (error) {
+            console.error(`window.json was not written: ${(error as Error).message}`);
+        }
+    }
+
+    return {
+        read: () => {
+            try {
+                return parseWindowFile(readFileSync(file, 'utf8'));
+            } catch {
+                return null;
+            }
+        },
+        keep: (state) => {
+            held = state;
+            clearTimeout(timer);
+            timer = setTimeout(write, wait);
+        },
+        flush: write
+    };
+}
diff --git a/tools/oculus/src/desktop/windows/windows.ts b/tools/oculus/src/desktop/windows/windows.ts
new file mode 100644
index 000000000..15b37c05a
--- /dev/null
+++ b/tools/oculus/src/desktop/windows/windows.ts
@@ -0,0 +1,395 @@
+// Layer 2, server (the desktop host). The app's windows: the main windows, each on a server's page,
+// and the windows of popped-out floats, each on the same page with `?float=<id>`. This module makes
+// them, keeps them, and decides what each does with an address, a crash and a close; what a page
+// may ask of the host over the bridge is bridge.ts, and the menu is menu.ts.
+//
+// A main window closed leaves the app and the server running; the popped-out windows close with
+// the last main window and keep their places in the arrangement, so they open again with the next
+// main window. A popped-out window closed by the reader is asked to put its tabs back in the main
+// window first (its page does that and closes the window); a window the app closes itself (a quit,
+// the last main window) closes at once.
+
+import { BrowserWindow, screen, shell, type WebContents } from 'electron';
+import { linkDecision, movedPort } from '../decide/links.ts';
+import { placeWindow, rectOf, type Rect } from '../decide/place.ts';
+import { WINDOW_BACKGROUND, windowPreferences } from '../decide/window-options.ts';
+import { NO_ZOOM, type WindowState } from '../decide/window-file.ts';
+import { EVENT } from '../decide/channels.ts';
+import { oculusAnswers } from '../server/health.ts';
+import { createFindBar, type FindBar } from './find-bar.ts';
+import type { WindowStore } from './window-state.ts';
+
+/** How far each further main window is moved from the one before, in points. */
+const CASCADE = 28;
+
+/** How long the host waits to learn that a server answers on a port a window is moving to. */
+const MOVE_WAIT_MS = 5000;
+
+/** How long a popped-out window waits for its page to put its tabs back before it closes. */
+const RESTORE_WAIT_MS = 2000;
+
+/** The width and height a popped-out window opens at when its float was docked. */
+const FLOAT_SIZE = { w: 600, h: 400 } as const;
+
+/** One window the app made. */
+export type Entry = {
+    win: BrowserWindow;
+    kind: 'main' | 'float';
+    /** The float this window draws, null for a main window. */
+    float: string | null;
+    /** The origin of the server the page was loaded from; it follows a port move. */
+    origin: string;
+    focusedAt: number;
+    bar: FindBar;
+    /** Whether the close that is under way is one the app asked for. */
+    allowClose: boolean;
+};
+
+/** What the windows need of the rest of the app. */
+export type WindowsDeps = {
+    preload: string;
+    store: WindowStore;
+    log: (line: string) => void;
+    /** Whether this app's own server last reported `port`, so a window may follow it there. */
+    ownPort: (port: number) => boolean;
+    /** Hear each port this app's own server reports listening on. */
+    onListening: (listener: (port: number) => void) => () => void;
+    /** A main window followed a port move of a server this app did not start, to `origin`. */
+    followed: (origin: string) => void;
+};
+
+/** The windows. */
+export type Windows = {
+    openMain: (origin: string) => Entry;
+    /** The window of a float; one already open is left as it is. */
+    openFloat: (id: string, bounds: Rect | null, origin: string) => Entry;
+    entries: () => Entry[];
+    /**
+     * The window a web contents belongs to, and whether it is the window's page or its find bar.
+     */
+    entryOf: (contents: WebContents) => { entry: Entry; who: 'page' | 'find-bar' } | null;
+    /** Load the page of every window whose server is not at `origin` from `origin` instead. */
+    moveTo: (origin: string) => void;
+    /** The main window focused last, or null with none open. */
+    lastMain: () => Entry | null;
+    /** The window the reader is in, or the main window focused last. */
+    focused: () => Entry | null;
+    /** Close every window without the popped-out windows asking their pages first. */
+    closeAll: () => void;
+    /** Mark the app as quitting, so no window asks anything on its way out; keep the state. */
+    quitting: () => void;
+    /** Hear a main window's state change, for the zoom the menu sets. */
+    remember: (entry: Entry) => void;
+};
+
+/** The work areas of the attached displays and the primary display's. */
+function displays(): { areas: Rect[]; primary: Rect } {
+    return {
+        areas: screen.getAllDisplays().map((one) => rectOf(one.workArea)),
+        primary: rectOf(screen.getPrimaryDisplay().workArea)
+    };
+}
+
+export function createWindows(deps: WindowsDeps): Windows {
+    const list: Entry[] = [];
+    let clock = 0;
+    let quit = false;
+
+    /** Print the refusal of an address and do nothing else with it. */
+    function refuse(url: string): void {
+        deps.log(`refused an address: ${url}`);
+    }
+
+    /** Send an address to where the decision says. */
+    function route(from: Entry, url: string): void {
+        const where = linkDecision(url, from.origin);
+        if (where.kind === 'main') openMain(from.origin);
+        else if (where.kind === 'float') openFloat(where.id, null, from.origin);
+        else if (where.kind === 'browser') void shell.openExternal(url);
+        else refuse(url);
+    }
+
+    /**
+     * Whether a window may follow a navigation to `port`: it is the port this app's server last
+     * reported, or the server reports it, or an oculus answers on it, within the wait.
+     */
+    function admitsPort(port: number): Promise<boolean> {
+        if (deps.ownPort(port)) return Promise.resolve(true);
+        return new Promise((resolve) => {
+            const settle = (admitted: boolean): void => {
+                clearTimeout(timer);
+                stop();
+                resolve(admitted);
+            };
+            const timer = setTimeout(() => settle(false), MOVE_WAIT_MS);
+            const stop = deps.onListening((heard) => {
+                if (heard === port) settle(true);
+            });
+            void oculusAnswers(port, MOVE_WAIT_MS).then((answers) => {
+                if (answers) settle(true);
+            });
+        });
+    }
+
+    /** A navigation of a window to the page of the same server at another port. */
+    async function follow(entry: Entry, url: string, port: number): Promise<void> {
+        if (!(await admitsPort(port))) {
+            route(entry, url);
+            return;
+        }
+        if (entry.win.isDestroyed()) return;
+        entry.origin = new URL(url).origin;
+        if (entry.kind === 'main') deps.followed(entry.origin);
+        await entry.win.webContents.loadURL(url);
+    }
+
+    function moveTo(origin: string): void {
+        for (const entry of list) {
+            if (entry.origin === origin || entry.win.isDestroyed()) continue;
+            entry.origin = origin;
+            void entry.win.webContents.loadURL(`${origin}/${searchOf(entry)}`);
+        }
+    }
+
+    /** The search a window's own page carries, which a navigation in place keeps. */
+    function searchOf(entry: Entry): string {
+        return entry.float === null ? '' : `?float=${encodeURIComponent(entry.float)}`;
+    }
+
+    /** Whether a navigation is the window's own page loading again, which is let through. */
+    function inPlace(entry: Entry, url: string): boolean {
+        try {
+            const target = new URL(url);
+            return (
+                target.origin === entry.origin &&
+                target.pathname === '/' &&
+                target.search === searchOf(entry)
+            );
+        } catch {
+            return false;
+        }
+    }
+
+    /** Wire what every window does with an address, a crash and a permission. */
+    function guard(entry: Entry): void {
+        const contents = entry.win.webContents;
+        contents.setWindowOpenHandler(({ url }) => {
+            route(entry, url);
+            return { action: 'deny' };
+        });
+        contents.on('will-frame-navigate', (event) => {
+            if (!event.isMainFrame || inPlace(entry, event.url)) return;
+            event.preventDefault();
+            const port = movedPort(event.url, entry.origin);
+            if (port === null) route(entry, event.url);
+            else void follow(entry, event.url, port);
+        });
+        contents.on('render-process-gone', (_event, details) => {
+            deps.log(`a window's page went: ${details.reason}`);
+            if (!quit && details.reason !== 'clean-exit') contents.reload();
+        });
+    }
+
+    /** The state of a main window, kept for window.json. */
+    function stateOf(entry: Entry): WindowState {
+        const { win } = entry;
+        return {
+            bounds: rectOf(win.getNormalBounds()),
+            maximised: win.isMaximized(),
+            fullScreen: win.isFullScreen(),
+            zoom: win.webContents.getZoomFactor()
+        };
+    }
+
+    function remember(entry: Entry): void {
+        if (entry.kind === 'main' && !entry.win.isDestroyed()) deps.store.keep(stateOf(entry));
+    }
+
+    /** Keep a main window's state when it moves, resizes, changes state or closes. */
+    function keepState(entry: Entry): void {
+        for (const event of [
+            'moved',
+            'resized',
+            'maximize',
+            'unmaximize',
+            'enter-full-screen',
+            'leave-full-screen'
+        ] as const) {
+            entry.win.on(event as 'moved', () => remember(entry));
+        }
+        entry.win.on('close', () => {
+            remember(entry);
+            deps.store.flush();
+        });
+    }
