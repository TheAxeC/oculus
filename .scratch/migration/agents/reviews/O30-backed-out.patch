 // Nothing here touches localStorage or the DOM: every case reads a hand-built envelope.
 
 import { describe, expect, it } from 'vitest';
-import { PAGES_VERSION, parseLayout } from '../../../../../src/lib/state/workbench/layout/index.ts';
