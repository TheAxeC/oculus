diff --git a/tools/oculus/src/desktop/package.ts b/tools/oculus/src/desktop/package.ts
new file mode 100644
index 000000000..06100bff3
--- /dev/null
+++ b/tools/oculus/src/desktop/package.ts
@@ -0,0 +1,104 @@
+// Layer 2, server (the desktop host). `npm run app:package`: builds oculus.app with
+// @electron/packager. The bundle is a stub: a package.json and a main.cjs that imports this
+// checkout's src/desktop/main.ts by its absolute path, written when the app is packaged, so the
+// app runs the checkout's code and is packaged again only when Electron's version changes. The
+// icon is assets/app-icon.png made into an .icns with sips and iconutil, and the bundle is signed
+// ad hoc so `codesign --verify --deep --strict` passes on Apple silicon.
+//
+// Usage: node src/desktop/package.ts [--out <dir>]
+// The app goes to <dir>/oculus.app (replacing one there); the default is ~/Applications.
+
+import { packager } from '@electron/packager';
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { homedir, tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const NAME = 'oculus';
+const BUNDLE_ID = 'local.research.oculus';
+
+/** The checkout this script lives in: the folder holding package.json, two levels above. */
+const checkout = resolve(import.meta.dirname, '..', '..');
+
+/** The folder the app is written to: the value of `--out`, else ~/Applications. */
+function outOf(argv: readonly string[]): string {
+    const at = argv.indexOf('--out');
+    if (at < 0) return join(homedir(), 'Applications');
+    const given = argv.at(at + 1);
+    if (given === undefined || given.startsWith('--')) {
+        throw new Error('--out names the folder the app goes to');
+    }
+    return resolve(given);
+}
+
+/** The version of the Electron package installed in the checkout. */
+function electronVersion(): string {
+    const text = readFileSync(join(checkout, 'node_modules', 'electron', 'package.json'), 'utf8');
+    const { version } = JSON.parse(text) as { version: string };
+    return version;
+}
+
+/** The stub the bundle holds: its package.json, and its main.cjs importing the checkout's main. */
+function writeStub(dir: string): void {
+    const manifest = { name: NAME, productName: NAME, version: '1.0.0', main: 'main.cjs' };
+    writeFileSync(join(dir, 'package.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+    const entry = pathToFileURL(join(checkout, 'src', 'desktop', 'main.ts')).href;
+    writeFileSync(join(dir, 'main.cjs'), `import(${JSON.stringify(entry)});\n`);
+}
+
+/** assets/app-icon.png as an .icns in `dir`, at the sizes macOS asks for. */
+function writeIcon(dir: string): string {
+    const set = join(dir, `${NAME}.iconset`);
+    mkdirSync(set);
+    const source = join(checkout, 'assets', 'app-icon.png');
+    for (const size of [16, 32, 128, 256, 512]) {
+        for (const scale of [1, 2]) {
+            const pixels = String(size * scale);
+            const file = scale === 1 ? `icon_${size}x${size}.png` : `icon_${size}x${size}@2x.png`;
+            execFileSync('sips', ['-z', pixels, pixels, source, '--out', join(set, file)], {
+                stdio: 'ignore'
+            });
+        }
+    }
+    const icns = join(dir, `${NAME}.icns`);
+    execFileSync('iconutil', ['-c', 'icns', '-o', icns, set]);
+    return icns;
+}
+
+async function main(): Promise<void> {
+    const out = outOf(process.argv.slice(2));
+    const work = mkdtempSync(join(tmpdir(), 'oculus-package-'));
+    try {
+        const stub = join(work, 'stub');
+        mkdirSync(stub);
+        writeStub(stub);
+        const built = await packager({
+            dir: stub,
+            out: join(work, 'out'),
+            name: NAME,
+            appBundleId: BUNDLE_ID,
+            icon: writeIcon(work),
+            platform: 'darwin',
+            arch: process.arch as 'arm64' | 'x64',
+            electronVersion: electronVersion(),
+            darwinDarkModeSupport: true,
+            asar: false,
+            overwrite: true,
+            quiet: true
+        });
+        const made = built.at(0);
+        if (made === undefined) throw new Error('the packager made no app');
+        mkdirSync(out, { recursive: true });
+        const target = join(out, `${NAME}.app`);
+        rmSync(target, { recursive: true, force: true });
+        execFileSync('ditto', [join(made, `${NAME}.app`), target]);
+        execFileSync('codesign', ['--force', '--deep', '--sign', '-', target], { stdio: 'ignore' });
+        execFileSync('codesign', ['--verify', '--deep', '--strict', target]);
+        process.stdout.write(`${target}\n`);
+    } finally {
+        rmSync(work, { recursive: true, force: true });
+    }
+}
+
+await main();
diff --git a/tools/oculus/src/desktop/preload.cjs b/tools/oculus/src/desktop/preload.cjs
new file mode 100644
index 000000000..30cdb6035
--- /dev/null
+++ b/tools/oculus/src/desktop/preload.cjs
@@ -0,0 +1,50 @@
+// Layer 2, server (the desktop host). The preload of every window and of the find bar's view. It is
+// CommonJS because a sandboxed preload cannot be a module, and one file because a sandboxed preload
+// can require nothing but Electron: the channel names below are the ones decide/channels.ts lists,
+// and the type of the object is state/shared/stores/desktop.ts's. It exposes one object,
+// `oculusDesktop`, to the page; the host answers a call only from the top frame of the server's
+// page (decide/sender.ts), so the object is the whole of what the page can ask of the host. A save
+// the host does not answer is a refusal that holds no envelope, so it writes nothing.
+//
+// The spell checker's facts come from here, since Electron emits no `context-menu` event for a
+// right-click the page cancels, and oculus's text menu cancels it. The spell server of macOS can
+// time out on the first lookup after a start, so one word is looked up as the preload loads.
+
+'use strict';
+
+const { contextBridge, ipcRenderer, webFrame } = require('electron');
+
+/** @typedef {import('../lib/state/shared/stores/desktop.ts').DesktopBridge} DesktopBridge */
+
+webFrame.isWordMisspelled('oculus');
+
+/** @type {DesktopBridge} */
+const bridge = {
+    openFloatWindow: (id, bounds) => ipcRenderer.send('oculus:open-float-window', id, bounds),
+    closeSelf: () => ipcRenderer.send('oculus:close-self'),
+    focusMain: () => ipcRenderer.send('oculus:focus-main'),
+    dropOutside: (drop) => ipcRenderer.invoke('oculus:drop-outside', drop),
+    answerDrop: (request, taken) => ipcRenderer.send('oculus:drop-taken', request, taken),
+    saveLayout: (next, from) => {
+        const answer = ipcRenderer.sendSync('oculus:save-layout', next, from);
+        return answer ?? { admitted: false, held: null };
+    },
+    showFind: () => ipcRenderer.send('oculus:show-find'),
+    find: (query, options) => ipcRenderer.send('oculus:find', query, options),
+    stopFind: () => ipcRenderer.send('oculus:stop-find'),
+    closeFind: () => ipcRenderer.send('oculus:close-find'),
+    spelling: (word) =>
+        Promise.resolve({
+            misspelled: webFrame.isWordMisspelled(word),
+            suggestions: webFrame.getWordSuggestions(word)
+        }),
+    on: (event, listener) => {
+        const heard = (_event, name, payload) => {
+            if (name === event) listener(payload);
+        };
+        ipcRenderer.on('oculus:event', heard);
+        return () => ipcRenderer.off('oculus:event', heard);
+    }
+};
+
+contextBridge.exposeInMainWorld('oculusDesktop', bridge);
diff --git a/tools/oculus/src/desktop/server/build.ts b/tools/oculus/src/desktop/server/build.ts
new file mode 100644
index 000000000..fe6e2ed5d
--- /dev/null
+++ b/tools/oculus/src/desktop/server/build.ts
@@ -0,0 +1,48 @@
+// Layer 2, server (the desktop host). The build of the checkout's server, which `npm run app` runs
+// once it holds the single-instance lock and before it starts the server, so the app from the
+// checkout always serves the checkout's code. The build is `vite build`, run by Electron's own
+// Node (ELECTRON_RUN_AS_NODE) in the checkout, its output printed on the app's output under the
+// prefix the caller names. A packaged app runs no build.
+
+import { spawn, type ChildProcess } from 'node:child_process';
+import { join } from 'node:path';
+
+/** What a build came to: it built, or it failed with the last line of its error output. */
+type BuildResult = { ok: true } | { ok: false; last: string };
+
+/** A build in progress and the way to end it. */
+export type Build = { done: Promise<BuildResult>; abort: () => void };
+
+/** Run `vite build` in `root`, handing each output line to `say`. */
+export function buildServer(root: string, say: (line: string, error: boolean) => void): Build {
+    const vite = join(root, 'node_modules', 'vite', 'bin', 'vite.js');
+    const child: ChildProcess = spawn(process.execPath, [vite, 'build'], {
+        cwd: root,
+        env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' },
+        stdio: ['ignore', 'pipe', 'pipe']
+    });
+    let last = '';
+    const lines = (stream: NodeJS.ReadableStream | null, error: boolean): void => {
+        let rest = '';
+        stream?.on('data', (chunk: Buffer) => {
+            const parts = (rest + chunk.toString()).split('\n');
+            rest = parts.pop() ?? '';
+            for (const line of parts) {
+                if (line.trim() === '') continue;
+                if (error) last = line;
+                say(line, error);
+            }
+        });
+    };
+    lines(child.stdout, false);
+    lines(child.stderr, true);
+    const done = new Promise<BuildResult>((resolve) => {
+        child.once('error', (error) => resolve({ ok: false, last: error.message }));
+        child.once('exit', (code, signal) => {
+            resolve(
+                code === 0 ? { ok: true } : { ok: false, last: last || String(signal ?? code) }
+            );
+        });
+    });
+    return { done, abort: () => void child.kill() };
+}
diff --git a/tools/oculus/src/desktop/server/health.ts b/tools/oculus/src/desktop/server/health.ts
