+            const held = access.held();
+            const next = copyTabIn(held, id, windowed(bounds), ids);
+            if (next === held) return null;
+            const state = access.ui.instanceState(id);
+            if (state !== undefined) {
+                access.ui.setInstanceState(ids.tab, JSON.parse(JSON.stringify(state)));
+            }
+            access.save(next);
+            return ids.float;
+        }
+    };
+}
