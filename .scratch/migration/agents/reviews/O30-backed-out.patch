@@ -0,0 +1,24 @@
+// Layer 2, server (the desktop host). Whether an oculus answers on a port. A port that refused the
+// server this app started is asked `GET /api/health`: the answer `{ "app": "oculus" }` within the
+// limit is an oculus, and no answer, another status or another body is another program. Node's
+// fetch sends neither `Origin` nor `Sec-Fetch-Site`, which the route admits (src/hooks.server.ts).
+
+import { LISTEN_HOST } from '../../lib/server/root/mover.ts';
+import { HEALTH_BODY } from '../../lib/server/root/process/parent.ts';
+
+/** Whether the body read is the one an oculus answers. */
+function isHealth(body: unknown): boolean {
+    return JSON.stringify(body) === JSON.stringify(HEALTH_BODY);
+}
+
+/** Whether an oculus answers `GET /api/health` on `port` within `limitMs`. */
+export async function oculusAnswers(port: number, limitMs: number): Promise<boolean> {
+    try {
+        const response = await fetch(`http://${LISTEN_HOST}:${port}/api/health`, {
+            signal: AbortSignal.timeout(limitMs)
+        });
+        return response.status === 200 && isHealth(await response.json());
+    } catch {
+        return false;
+    }
+}
diff --git a/tools/oculus/src/desktop/server/login-env.ts b/tools/oculus/src/desktop/server/login-env.ts
new file mode 100644
index 000000000..ab023ff2f
--- /dev/null
+++ b/tools/oculus/src/desktop/server/login-env.ts
@@ -0,0 +1,27 @@
+// Layer 2, server (the desktop host). The login shell's environment for an app started from the
+// Dock. launchd gives such an app a bare PATH, so the server it runs would find no tmux, no
+// Homebrew git and no claude. `shell-env` asks the user's login shell for its whole environment;
+// the answer is merged over the inherited one. A shell that takes longer than the limit, or fails,
+// answers null and the server starts on the inherited environment.
+
+import { shellEnv } from 'shell-env';
+
+/** How long the login shell may take, in milliseconds. */
+const LOGIN_SHELL_LIMIT_MS = 10_000;
+
+/** The login shell's environment, or null when it did not answer in time or failed. */
+export async function loginEnvironment(
+    limitMs: number = LOGIN_SHELL_LIMIT_MS
+): Promise<Record<string, string> | null> {
+    let timer: NodeJS.Timeout | undefined;
+    const slow = new Promise<null>((resolve) => {
+        timer = setTimeout(() => resolve(null), limitMs);
+    });
+    try {
+        return await Promise.race([shellEnv(), slow]);
+    } catch {
+        return null;
+    } finally {
+        clearTimeout(timer);
+    }
+}
diff --git a/tools/oculus/src/desktop/server/process.ts b/tools/oculus/src/desktop/server/process.ts
new file mode 100644
index 000000000..27031f6fd
--- /dev/null
+++ b/tools/oculus/src/desktop/server/process.ts
@@ -0,0 +1,140 @@
+// Layer 2, server (the desktop host). The oculus server as a utility process of the app. It is
+// `src/server.ts` forked with the engine and the default port, never run in the main process, so a
+// long read of the config never stops the window's menus or its move. The process tells the app
+// each port it listens on and a first listen that failed (lib/server/root/process/parent.ts), and
+// asks it for the folder panel. Its output is printed on the app's own, under a prefix.
+
+import { utilityProcess, type UtilityProcess } from 'electron';
+import {
+    readServerMessage,
+    type MainMessage,
+    type ServerMessage
+} from '../../lib/server/root/process/parent.ts';
+
+/** How the first listen came out. */
+type ServerStart =
+    | { kind: 'listening'; port: number }
+    | { kind: 'failed'; reason: string; port: number }
+    | { kind: 'exited'; code: number; last: string };
+
+/** What a fork needs. */
+export type ForkOptions = {
+    /** The server's entry, `src/server.ts` of the checkout. */
+    entry: string;
+    engine: string;
+    /** The port a missing local.yml means. */
+    defaultPort: number;
+    env: NodeJS.ProcessEnv;
+    /** The name the process appears under in Activity Monitor. */
+    name: string;
+    /** Called with each output line of the process. */
+    say: (line: string, error: boolean) => void;
+    /** Called when the process asks for the folder panel. */
+    onPick: (id: number) => void;
+};
+
+/** A server process. */
+export type ServerProcess = {
+    /** The first thing that happens to it: it listens, its listen fails, or it exits. */
+    started: Promise<ServerStart>;
+    /** The port it last reported listening on, or null before the first. */
+    port: () => number | null;
+    /** Called with each port it reports listening on, the first and each move. */
+    onListening: (listener: (port: number) => void) => () => void;
+    /** Called when it exits without being stopped, after its first listen. */
+    onLost: (listener: (code: number, last: string) => void) => void;
+    /** Send it a message. */
+    send: (message: MainMessage) => void;
+    /** End it with SIGTERM and wait for its exit, at most `limitMs`. */
+    stop: (limitMs: number) => Promise<void>;
+};
+
+/** Print each line a stream holds under the caller's `say`, and keep the last error line. */
+function relay(
+    stream: NodeJS.ReadableStream | null | undefined,
+    error: boolean,
+    say: ForkOptions['say'],
+    remember: (line: string) => void
+): void {
+    let rest = '';
+    stream?.on('data', (chunk: Buffer) => {
+        const parts = (rest + chunk.toString()).split('\n');
+        rest = parts.pop() ?? '';
+        for (const line of parts) {
+            if (line.trim() === '') continue;
+            if (error) remember(line);
+            say(line, error);
+        }
+    });
+}
+
+/** Fork the server. */
+export function forkServer(options: ForkOptions): ServerProcess {
+    const child: UtilityProcess = utilityProcess.fork(
+        options.entry,
+        ['--engine', options.engine, '--default-port', String(options.defaultPort)],
+        { env: options.env, stdio: 'pipe', serviceName: options.name }
+    );
+    let port: number | null = null;
+    let last = '';
+    let stopping = false;
+    let first = false;
+    let exited = false;
+    const listeners = new Set<(port: number) => void>();
+    const lost: ((code: number, last: string) => void)[] = [];
+    let settle: (start: ServerStart) => void = () => undefined;
+    const started = new Promise<ServerStart>((resolve) => {
+        settle = (start) => {
+            if (first) return;
+            first = true;
+            resolve(start);
+        };
+    });
+    relay(child.stdout, false, options.say, () => undefined);
+    relay(child.stderr, true, options.say, (line) => (last = line));
+    child.on('message', (raw: unknown) => {
+        const message: ServerMessage | null = readServerMessage(raw);
+        if (message === null) {
+            options.say(`ignored a message of no known kind: ${JSON.stringify(raw)}`, true);
+            return;
+        }
+        if (message.kind === 'listening') {
+            port = message.port;
+            settle({ kind: 'listening', port: message.port });
+            for (const listener of listeners) listener(message.port);
+        } else if (message.kind === 'failed') {
+            settle({ kind: 'failed', reason: message.reason, port: message.port });
+        } else {
+            options.onPick(message.id);
+        }
+    });
+    const gone = new Promise<void>((resolve) => {
+        child.once('exit', (code) => {
+            exited = true;
+            if (!first) settle({ kind: 'exited', code, last });
+            else if (!stopping && port !== null) for (const listener of lost) listener(code, last);
+            resolve();
+        });
+    });
+    return {
+        started,
+        port: () => port,
+        onListening: (listener) => {
+            listeners.add(listener);
+            return () => void listeners.delete(listener);
+        },
+        onLost: (listener) => void lost.push(listener),
+        send: (message) => {
+            if (!exited) child.postMessage(message);
+        },
+        stop: async (limitMs) => {
+            stopping = true;
+            if (exited) return;
+            child.kill();
+            await Promise.race([
+                gone,
+                new Promise<void>((resolve) => setTimeout(resolve, limitMs))
+            ]);
+        }
+    };
+}
diff --git a/tools/oculus/src/desktop/windows/bridge.ts b/tools/oculus/src/desktop/windows/bridge.ts
new file mode 100644
index 000000000..8a3d4c828
--- /dev/null
+++ b/tools/oculus/src/desktop/windows/bridge.ts
@@ -0,0 +1,193 @@
+// Layer 2, server (the desktop host). What a page may ask of the host over the bridge the preload
+// exposes (preload.cjs). Every handler first finds who sent the call: the top frame of a window's
+// page or of its find bar's view, on the origin of the server the window shows
+// (decide/sender.ts); any other call does nothing, and a save it does not answer is refused. The
+// arguments are read before they are used, since a page is not trusted with the shape of what it
+// sends.
+
+import { ipcMain, type IpcMainEvent, type IpcMainInvokeEvent, type WebContents } from 'electron';
+import {
+    CLOSE_FIND,
+    CLOSE_SELF,
+    DROP_OUTSIDE,
+    DROP_TAKEN,
+    EVENT,
+    FIND,
+    FOCUS_MAIN,
+    OPEN_FLOAT_WINDOW,
+    SAVE_LAYOUT,
+    SHOW_FIND,
+    STOP_FIND
+} from '../decide/channels.ts';
+import { windowAt } from '../decide/drop.ts';
+import { rectOf, type Rect } from '../decide/place.ts';
+import type { SaveTurn } from '../decide/save-turn.ts';
+import { mayCall, senderOf, type Sender } from '../decide/sender.ts';
+import type { FindOptions, SaveAnswer } from '../../lib/state/shared/stores/desktop.ts';
+import type { Entry, Windows } from './windows.ts';
+
+/** The answer to a save the bridge does not answer: refused, with no envelope to take. */
+const REFUSED: SaveAnswer = { admitted: false, held: null };
+
+/** The window a call came from and who in it sent the call. */
+type Caller = { entry: Entry; who: Exclude<Sender, null> };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === 'object' && value !== null;
+}
+
+function finite(value: unknown): value is number {
+    return typeof value === 'number' && Number.isFinite(value);
+}
+
+/** The screen bounds one value is, or null. */
+function boundsOf(value: unknown): Rect | null {
+    if (!isRecord(value)) return null;
+    const { x, y, w, h } = value;
+    return finite(x) && finite(y) && finite(w) && finite(h) && w >= 1 && h >= 1
+        ? { x, y, w, h }
+        : null;
+}
+
+/** The find options one value is, or null. */
+function findOptionsOf(value: unknown): FindOptions | null {
+    if (!isRecord(value)) return null;
+    const { forward, matchCase, fresh } = value;
+    return typeof forward === 'boolean' &&
+        typeof matchCase === 'boolean' &&
+        typeof fresh === 'boolean'
+        ? { forward, matchCase, fresh }
+        : null;
+}
+
+/** The drop one value is, or null. */
+function dropOf(value: unknown): { tab: string; at: { x: number; y: number } } | null {
+    if (!isRecord(value) || typeof value.tab !== 'string' || value.tab === '') return null;
+    const at = value.at;
+    if (!isRecord(at) || !finite(at.x) || !finite(at.y)) return null;
+    return { tab: value.tab, at: { x: at.x, y: at.y } };
+}
+
+/** The origin and path of an address, or null for one that is none. */
+function addressOf(url: string): { origin: string; pathname: string } | null {
+    try {
+        const { origin, pathname } = new URL(url);
+        return { origin, pathname };
+    } catch {
+        return null;
+    }
+}
+
+/** Register the bridge's handlers over the app's windows. */
+export function registerBridge(windows: Windows, turn: SaveTurn): void {
+    /** The tabs handed to a window that has not answered yet, by request number. */
+    const waiting = new Map<number, { contents: WebContents; settle: (taken: boolean) => void }>();
+    let requests = 0;
+
+    /** Who sent a call on `channel`, or null when the bridge does not answer it. */
+    function callerOf(event: IpcMainEvent | IpcMainInvokeEvent, channel: string): Caller | null {
+        const frame = event.senderFrame;
+        const found = windows.entryOf(event.sender);
+        if (frame === null || found === null) return null;
+        const where = addressOf(frame.url);
+        if (where === null) return null;
+        const who = senderOf(
+            { origin: where.origin, isTop: frame.parent === null, pathname: where.pathname },
+            found.entry.origin
+        );
+        if (who === null || who !== found.who || !mayCall(who, channel)) return null;
+        return { entry: found.entry, who };
+    }
+
+    ipcMain.on(SAVE_LAYOUT, (event, next: unknown, from: unknown) => {
+        const caller = callerOf(event, SAVE_LAYOUT);
+        const valid = typeof next === 'string' && (from === null || typeof from === 'string');
+        // A call the bridge does not answer, or one with invalid arguments, is refused: the page
+        // writes only with the turn.
+        event.returnValue = caller !== null && valid ? turn(next, from) : REFUSED;
+    });
+
+    ipcMain.on(OPEN_FLOAT_WINDOW, (event, id: unknown, bounds: unknown) => {
+        const caller = callerOf(event, OPEN_FLOAT_WINDOW);
+        const rect = boundsOf(bounds);
+        if (caller === null || typeof id !== 'string' || id === '' || rect === null) return;
+        windows.openFloat(id, rect, caller.entry.origin);
+    });
+
+    ipcMain.on(CLOSE_SELF, (event) => {
+        const caller = callerOf(event, CLOSE_SELF);
+        if (caller === null) return;
+        caller.entry.allowClose = true;
+        caller.entry.win.close();
+    });
+
+    ipcMain.on(FOCUS_MAIN, (event) => {
+        if (callerOf(event, FOCUS_MAIN) === null) return;
+        const main = windows.lastMain();
+        if (main !== null) {
+            main.win.show();
+            main.win.focus();
+        }
+    });
+
+    ipcMain.handle(DROP_OUTSIDE, (event, value: unknown) => {
+        const caller = callerOf(event, DROP_OUTSIDE);
+        const drop = dropOf(value);
+        if (caller === null || drop === null) return false;
+        const all = windows.entries();
+        const id = windowAt(
+            drop.at,
+            all.map((one) => ({
+                id: one.win.id,
+                bounds: rectOf(one.win.getContentBounds()),
+                focusedAt: one.focusedAt
+            }))
+        );
+        const target = all.find((one) => one.win.id === id);
+        if (target === undefined) return false;
+        // Let go over its own window's content: nothing is moved.
+        if (target === caller.entry) return true;
+        const request = (requests += 1);
+        const { webContents } = target.win;
+        return new Promise<boolean>((resolve) => {
+            const settle = (taken: boolean): void => {
+                waiting.delete(request);
+                target.win.off('closed', gone);
+                if (taken && !target.win.isDestroyed()) target.win.show();
+                resolve(taken);
+            };
+            const gone = (): void => settle(false);
+            waiting.set(request, { contents: webContents, settle });
+            target.win.once('closed', gone);
+            webContents.send(EVENT, 'drop-here', { ...drop, request });
+        });
+    });
+
+    ipcMain.on(DROP_TAKEN, (event, request: unknown, taken: unknown) => {
+        if (callerOf(event, DROP_TAKEN) === null || typeof taken !== 'boolean') return;
+        const asked = typeof request === 'number' ? waiting.get(request) : undefined;
+        if (asked?.contents === event.sender) asked.settle(taken);
+    });
+
+    ipcMain.on(SHOW_FIND, (event) => {
+        callerOf(event, SHOW_FIND)?.entry.bar.show();
+    });
+
+    ipcMain.on(FIND, (event, query: unknown, options: unknown) => {
+        const how = findOptionsOf(options);
+        if (typeof query === 'string' && how !== null)
+            callerOf(event, FIND)?.entry.bar.find(query, how);
+    });
+
+    ipcMain.on(STOP_FIND, (event) => {
+        callerOf(event, STOP_FIND)?.entry.bar.find('', {
+            forward: true,
+            matchCase: false,
+            fresh: true
+        });
+    });
+
+    ipcMain.on(CLOSE_FIND, (event) => {
+        callerOf(event, CLOSE_FIND)?.entry.bar.hide();
+    });
+}
diff --git a/tools/oculus/src/desktop/windows/find-bar.ts b/tools/oculus/src/desktop/windows/find-bar.ts
new file mode 100644
index 000000000..d3b8a7de1
--- /dev/null
+++ b/tools/oculus/src/desktop/windows/find-bar.ts
@@ -0,0 +1,116 @@
+// Layer 2, server (the desktop host). Find in the page. Electron draws no find bar, and a bar in
+// the page's own document would be counted as a match of the query it holds (`findInPage` counts a
+// text box), so the bar is a view of its own: a `WebContentsView` laid over the window's top right,
+// loading the server's `/find` route. The host runs `findInPage` and `stopFindInPage` on the
+// window's page and sends the bar's page the count each time Chromium reports one.
+
+import { WebContentsView, type BrowserWindow, type WebContents } from 'electron';
+import type { FindOptions } from '../../lib/state/shared/stores/desktop.ts';
+import { WINDOW_BACKGROUND, windowPreferences } from '../decide/window-options.ts';
+import { FIND_PATH } from '../decide/sender.ts';
+import { EVENT } from '../decide/channels.ts';
+
+/** The bar's width and height, and its distance from the window's top and right, in points. */
+const WIDTH = 400;
+const HEIGHT = 48;
+const INSET = 8;
+
+/** One window's find bar. */
+export type FindBar = {
+    /** Lay the bar over the window and give it the keyboard. */
+    show: () => void;
+    /** Take the bar away, clear the find's marks and give the page the keyboard. */
+    hide: () => void;
+    /** Run a find of the window's page, or step the one under way. */
+    find: (query: string, options: FindOptions) => void;
+    /** The bar's page, to tell the bar's messages from the window's. */
+    contents: () => WebContents;
+    /** End the find and let the bar go with its window. */
+    dispose: () => void;
+};
+
+/** What a bar needs of its window. */
+export type FindBarOptions = {
+    window: BrowserWindow;
+    /** The origin of the server the window shows, read each time the bar is shown. */
+    origin: () => string;
+    preload: string;
+};
+
+export function createFindBar(options: FindBarOptions): FindBar {
+    const { window: win } = options;
+    const view = new WebContentsView({ webPreferences: windowPreferences(options.preload) });
+    view.setBackgroundColor(WINDOW_BACKGROUND);
+    let shown = false;
+    let address = '';
+
+    function place(): void {
+        const { width } = win.getContentBounds();
+        view.setBounds({
+            x: Math.max(0, width - WIDTH - INSET),
+            y: INSET,
+            width: WIDTH,
+            height: HEIGHT
+        });
+    }
+
+    function tell(active: number, matches: number): void {
+        if (!view.webContents.isDestroyed()) {
+            view.webContents.send(EVENT, 'found', { active, matches });
+        }
+    }
+
+    win.webContents.on('found-in-page', (_event, result) => {
+        tell(result.activeMatchOrdinal, result.matches);
+    });
+    win.on('resize', () => {
+        if (shown) place();
+    });
+
+    function show(): void {
+        const wanted = `${options.origin()}${FIND_PATH}`;
+        if (address !== wanted) {
+            address = wanted;
+            void view.webContents.loadURL(wanted);
+        }
+        if (!shown) {
+            shown = true;
+            win.contentView.addChildView(view);
+        }
+        place();
+        view.webContents.focus();
+        view.webContents.send(EVENT, 'shown', null);
+    }
+
+    function hide(): void {
+        win.webContents.stopFindInPage('clearSelection');
+        if (shown) {
+            shown = false;
+            win.contentView.removeChildView(view);
+        }
+        win.webContents.focus();
+    }
+
+    function find(query: string, how: FindOptions): void {
+        if (query === '') {
+            win.webContents.stopFindInPage('clearSelection');
+            tell(0, 0);
+            return;
+        }
+        win.webContents.findInPage(query, {
+            forward: how.forward,
+            matchCase: how.matchCase,
+            findNext: how.fresh
+        });
+    }
+
+    return {
+        show,
+        hide,
+        find,
+        contents: () => view.webContents,
+        dispose: () => {
+            if (!view.webContents.isDestroyed()) view.webContents.close();
+        }
+    };
+}
