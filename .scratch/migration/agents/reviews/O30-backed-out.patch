+            clearTimeout(timer);
+            timer = setTimeout(() => {
+                if (entry.win.isDestroyed()) return;
+                entry.win.webContents.send(EVENT, 'bounds', rectOf(entry.win.getContentBounds()));
+            }, 500);
+        };
