diff --git a/tools/oculus/tests/state/forms/entry-save.test.ts b/tools/oculus/tests/state/forms/entry-save.test.ts
new file mode 100644
index 000000000..741138506
--- /dev/null
+++ b/tools/oculus/tests/state/forms/entry-save.test.ts
@@ -0,0 +1,185 @@
+// Layer 2, client-state tests. What a save of an entry form posts and where: the changed fields of
+// a page entry as the one `entry` write of a collection entry, one `feed-field` write per field of
+// a feed entry, or the one `career` write; and the delete of an entry. The writes are stubs that
+// record their calls.
+
+import { describe, expect, it } from 'vitest';
+import {
+    deletePage,
+    pagePayload,
+    savePage,
+    type SaveWrites
+} from '../../../src/lib/state/forms/entry-save.ts';
+import type { PageEntry } from '../../../src/lib/state/forms/page-entry.ts';
+import type { FormField } from '../../../src/lib/state/forms/schema.ts';
+import type { WriteAnswer, WritesStore } from '../../../src/lib/state/shared/stores/shapes.ts';
+import { engineDir, loadConfig, textCatalog } from '../../../src/lib/data/sources/config.ts';
+import { setCatalog, t } from '../../../src/lib/state/shared/words/text.ts';
+
+setCatalog(textCatalog(loadConfig(engineDir()).config));
+
+/** A schema field as a schema file declares it, with a label and section nothing here reads. */
+function form(field: Pick<FormField, 'field' | 'type'> & Partial<FormField>): FormField {
+    return { label: field.field, section: 'main', ...field };
+}
+
+const FIELDS: FormField[] = [
+    form({ field: 'key', type: 'text' }),
+    form({ field: 'title', type: 'text' }),
+    form({ field: 'short', type: 'text' }),
+    form({ field: 'tier', type: 'text' })
+];
+
+function page(kind: PageEntry['kind'], over: Partial<PageEntry> = {}): PageEntry {
+    return {
+        kind,
+        collection: 'venues',
+        key: 'jbhi',
+        name: 'venues:jbhi',
+        writeId: 'jbhi',
+        root: '',
+        title: 'JBHI',
+        schema: [],
+        values: { key: 'jbhi', title: 'JBHI', short: 'J', tier: 'a' },
+        fixed: ['key'],
+        peers: [],
+        ...over
+    };
+}
+
+function ok(changed: string[], refused: WriteAnswer['refused'] = []): WriteAnswer {
+    return { ok: true, changed, refused };
+}
+
+type Call = [string, ...unknown[]];
+
+type Stub = SaveWrites & Pick<WritesStore, 'deleteEntry' | 'deleteFeedEntry'>;
+
+function writes(calls: Call[], answer: (field: string) => WriteAnswer): Stub {
+    return {
+        writeEntry: (collection, id, fields) => {
+            calls.push(['entry', collection, id, fields]);
+            return Promise.resolve(ok(Object.keys(fields)));
+        },
+        writeFeedField: (feed, id, field, value, root) => {
+            calls.push(['feed-field', feed, id, field, value, root]);
+            return Promise.resolve(answer(field));
+        },
+        writeCareer: (fields) => {
+            calls.push(['career', fields]);
+            return Promise.resolve(ok(Object.keys(fields)));
+        },
+        deleteEntry: (collection, id) => {
+            calls.push(['delete-entry', collection, id]);
+            return Promise.resolve(ok([id]));
+        },
+        deleteFeedEntry: (feed, id, root) => {
+            calls.push(['feed-delete', feed, id, root]);
+            return Promise.resolve(ok([id]));
+        }
+    };
+}
+
+describe('pagePayload', () => {
+    it('posts the fields whose payload differs, in the schema order', () => {
+        const edits = { tier: 'b', short: 'J-BHI', title: ' JBHI ' };
+        const made = pagePayload(page('collection'), FIELDS, edits);
+        expect(Object.keys(made.body)).toEqual(['short', 'tier']);
+        expect(made.body).toEqual({ short: 'J-BHI', tier: 'b' });
+        expect(made.taken).toEqual({ short: 'J-BHI', tier: 'b' });
+    });
+
+    it('never posts a fixed field, and posts a cleared field as null', () => {
+        const made = pagePayload(page('collection'), FIELDS, { key: 'other', short: '  ' });
+        expect(made.body).toEqual({ short: null });
+    });
+
+    it('posts a venue name and never its id', () => {
+        const venue = page('collection', {
+            values: { name: 'JBHI', id: 'jbhi' },
+            fixed: ['id']
+        });
+        const fields = [form({ field: 'name', type: 'text' }), form({ field: 'id', type: 'text' })];
+        const made = pagePayload(venue, fields, { name: 'IEEE JBHI', id: 'other' });
+        expect(made.body).toEqual({ name: 'IEEE JBHI' });
+    });
+
+    it('posts nothing for an edit that says what the file says', () => {
+        expect(pagePayload(page('collection'), FIELDS, { short: 'J' }).body).toEqual({});
+    });
+});
+
+describe('savePage', () => {
+    it('posts a collection entry as the one entry write', async () => {
+        const calls: Call[] = [];
+        await savePage(
+            page('collection'),
+            { short: 'x', tier: 'b' },
+            writes(calls, () => ok([]))
+        );
+        expect(calls).toEqual([['entry', 'venues', 'jbhi', { short: 'x', tier: 'b' }]]);
+    });
+
+    it('posts the career file as the one career write', async () => {
+        const calls: Call[] = [];
+        await savePage(
+            page('career'),
+            { milestone: 'Veni' },
+            writes(calls, () => ok([]))
+        );
+        expect(calls).toEqual([['career', { milestone: 'Veni' }]]);
+    });
+
+    it('posts a feed entry one field at a time in its hub and refuses a field that is no single value', async () => {
+        const calls: Call[] = [];
+        const feed = page('feed', { collection: 'leads', writeId: 'Postdoc A', root: 'second' });
+        const answer = await savePage(
+            feed,
+            { fit: 'good', country: 'NL', odd: { a: 1 } },
+            writes(calls, (field) =>
+                field === 'country'
+                    ? ok([], [{ field, reason: 'country takes text' }])
+                    : ok([field])
+            )
+        );
+        expect(calls).toEqual([
+            ['feed-field', 'leads', 'Postdoc A', 'fit', 'good', 'second'],
+            ['feed-field', 'leads', 'Postdoc A', 'country', 'NL', 'second']
+        ]);
+        expect(answer.changed).toEqual(['fit']);
+        expect(answer.refused.map((one) => one.field)).toEqual(['country', 'odd']);
+        expect(answer.refused[1].reason).toBe(t('entry_form.feed_scalar', 'odd'));
+        expect(answer.ok).toBe(true);
+    });
+
+    it('is not ok when a write of a feed field is refused as a whole', async () => {
+        const feed = page('feed', { collection: 'leads', writeId: 'Postdoc A' });
+        const answer = await savePage(
+            feed,
+            { fit: 'good' },
+            writes([], () => ({ ok: false, changed: [], refused: [], error: 'not found' }))
+        );
+        expect(answer).toMatchObject({ ok: false, error: 'not found' });
+    });
+});
+
+describe('deletePage', () => {
+    it('deletes a collection entry with delete-entry', async () => {
+        const calls: Call[] = [];
+        await deletePage(
+            page('collection'),
+            writes(calls, () => ok([]))
+        );
+        expect(calls).toEqual([['delete-entry', 'venues', 'jbhi']]);
+    });
+
+    it('deletes a feed entry with feed-delete in the hub that holds it', async () => {
+        const calls: Call[] = [];
+        const feed = page('feed', { collection: 'radar', writeId: 'A paper', root: 'second' });
+        await deletePage(
+            feed,
+            writes(calls, () => ok([]))
+        );
+        expect(calls).toEqual([['feed-delete', 'radar', 'A paper', 'second']]);
+    });
+});
diff --git a/tools/oculus/tests/state/forms/form-draft.test.ts b/tools/oculus/tests/state/forms/form-draft.test.ts
new file mode 100644
index 000000000..7a374d582
--- /dev/null
+++ b/tools/oculus/tests/state/forms/form-draft.test.ts
@@ -0,0 +1,149 @@
+// Layer 2, client-state tests. The draft of a form: the edits kept in the editor instance's ui
+// record under the kind of form and the thing they were typed for, compared against the saved
+// value now, settled after a save, and read back after a reload through a fake storage.
+//
+// The project is synthetic and handed to the project target through its projectOf argument, and
+// the page kind is judged by a table of saved values, so what is checked is the draft. Typing into
+// the form and pressing Save are DOM events no case here fires.
+
+import { beforeEach, describe, expect, it } from 'vitest';
+import type { Project } from '../../../src/lib/data/model/index.ts';
+import {
+    createFormDraft,
+    type DraftTarget,
+    type FormDraftStore
+} from '../../../src/lib/state/forms/form-draft.ts';
+import { projectDraftTarget } from '../../../src/lib/state/forms/schema.ts';
+import { createClientState, type ClientState } from '../../fixtures/client.ts';
+import { fakeStorage } from '../workbench/layout/layout-fixture.ts';
+
+let client: ClientState;
+let projects: Record<string, Project>;
+let saved: Record<string, Record<string, unknown>>;
+let drafts: FormDraftStore;
+
+function project(id: string, statusLine: string): Project {
+    const fields: Partial<Project> = {
+        id,
+        title: `The ${id} project`,
+        statusLine,
+        authors: ['Faes'],
+        pillarIds: [],
+        domainIds: [],
+        fundingIds: [],
+        datasetIds: [],
+        relatedIds: [],
+        results: [],
+        ideas: [],
+        collaborators: [],
+        waitingOn: [],
+        followups: [],
+        subtasks: []
+    };
+    return fields as Project;
+}
+
+/** A page entry judged by the table of its saved values; `key` is not written by a save. */
+function pageTarget(): DraftTarget {
+    return {
+        values: (name) => saved[name] ?? null,
+        differs: (_name, _field, edit, value) => JSON.stringify(edit) !== JSON.stringify(value),
+        writable: (_name, field) => field !== 'key'
+    };
+}
+
+function build(storeOf: ClientState): FormDraftStore {
+    return createFormDraft(storeOf.ui, {
+        project: projectDraftTarget((id) => projects[id] ?? null),
+        page: pageTarget()
+    });
+}
+
+beforeEach(() => {
+    client = createClientState();
+    client.ui.loadUi(fakeStorage());
+    projects = { alpha: project('alpha', 'drafting'), beta: project('beta', 'submitted') };
+    saved = { 'venues:jbhi': { short: 'JBHI', tier: 'a' } };
+    drafts = build(client);
+});
+
+describe('the edits', () => {
+    it('keeps an edit per instance and reports it unsaved while it differs', () => {
+        drafts.editDraft('ed-1', 'project', 'alpha', 'status.line', 'under review');
+        expect(drafts.draftEdits('ed-1', 'project', 'alpha')).toEqual({
+            'status.line': 'under review'
+        });
+        expect(drafts.draftDirty('ed-1')).toBe(true);
+        expect(drafts.draftDirty('ed-2')).toBe(false);
+    });
+
+    it('reads the edits typed for another thing as none', () => {
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'short', 'J-BHI');
+        expect(drafts.draftEdits('ed-1', 'page', 'venues:other')).toEqual({});
+        expect(drafts.draftEdits('ed-1', 'project', 'alpha')).toEqual({});
+    });
+
+    it('does not count an edit equal to the saved value, nor one the save does not write', () => {
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'short', 'JBHI');
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'key', 'changed');
+        expect(drafts.draftDirty('ed-1')).toBe(false);
+    });
+
+    it('counts any edit of a thing the snapshot does not hold', () => {
+        drafts.editDraft('ed-1', 'page', 'venues:gone', 'short', 'words');
+        expect(drafts.draftDirty('ed-1')).toBe(true);
+    });
+});
+
+describe('a save', () => {
+    it('keeps a refused field and a field typed again, and drops the rest', () => {
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'short', 'J-BHI');
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'tier', 'b');
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'note', 'first');
+        saved['venues:jbhi'] = { short: 'J-BHI', tier: 'a' };
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'note', 'second');
+
+        drafts.settleDraft('ed-1', { short: 'J-BHI', tier: 'b', note: 'first' }, ['tier']);
+
+        expect(drafts.draftEdits('ed-1', 'page', 'venues:jbhi')).toEqual({
+            tier: 'b',
+            note: 'second'
+        });
+    });
+});
+
+describe('a revert', () => {
+    it('drops every edit and the unsaved mark with them', () => {
+        drafts.editDraft('ed-1', 'page', 'venues:jbhi', 'short', 'J-BHI');
+        drafts.revertDraft('ed-1');
+        expect(drafts.draftEdits('ed-1', 'page', 'venues:jbhi')).toEqual({});
+        expect(drafts.draftDirty('ed-1')).toBe(false);
+    });
+});
+
+describe('a reload', () => {
+    it('reads the edits back out of the storage the ui store saved them to', () => {
+        const storage = fakeStorage();
+        client.ui.loadUi(storage);
+        drafts.editDraft('ed-1', 'project', 'alpha', 'authors', ['Faes', 'Another']);
+
+        const next = createClientState();
+        next.ui.loadUi(storage);
+        const again = build(next);
+        expect(again.draftEdits('ed-1', 'project', 'alpha')).toEqual({
+            authors: ['Faes', 'Another']
+        });
+        expect(again.draftDirty('ed-1')).toBe(true);
+    });
+});
+
+describe('the wiring', () => {
+    it("registers the client's own form draft with the close guard", () => {
+        const wired = createClientState();
+        wired.ui.loadUi(fakeStorage());
+        wired.formDraft.editDraft('ed-1', 'project', 'not-in-any-snapshot', 'title', 'words');
+        expect(wired.ui.unsaved('ed-1')).toBe(true);
+        wired.formDraft.revertDraft('ed-1');
+        expect(wired.ui.unsaved('ed-1')).toBe(false);
+    });
+});
