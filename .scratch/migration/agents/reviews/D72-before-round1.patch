index 000000000..d558c4432
--- /dev/null
+++ b/tools/oculus/src/lib/state/forms/page-entry.ts
@@ -0,0 +1,237 @@
+// Layer 2, client state. The thing an entry form edits, whichever kind it is: an entry of a
+// collection file, an entry of a generated feed (a lead, a Lit Watch paper) or the career file. The
+// page of an entry, the person page and the Career panel each hold one, and the form draft judges
+// the unsaved edits of all three through it.
+//
+// A page entry names its schema, its saved values by field, the fields the form never writes and
+// the id a write names it by. The three kinds are written by different endpoints (`entry`,
+// `feed-field` one field at a time, `career`), which entry-save.ts picks by `kind`.
+//
+// A page is found again from its name: `<collection>:<key>` for an entry of a collection or a feed
+// (the key a feed entry has is the identity the feed views give it, state/shared/page/idents.ts),
+// and `career` for the career file. That is what lets the draft of a tab that is not on screen be
+// judged against the snapshot now.
+
+import { scalar } from '../../data/helpers/guards.ts';
+import { collectionsOf } from '../../data/helpers/hub-names.ts';
+import type {
+    Career,
+    Entry,
+    FeedData,
+    FeedKind,
+    FeedsPayload,
+    SchemaField,
+    Snapshot
+} from '../../data/model/index.ts';
+import { feedIdents, feedRoot } from '../shared/page/idents.ts';
+import type { DraftTarget } from './form-draft.ts';
+import { fixedFields, formFieldsOf, identityField } from './record-fields.ts';
+import { fieldDiffers, hasWords } from './record-values.ts';
+import type { FormField } from './schema.ts';
+
+/** The name of the career file's page and of its draft. */
+export const CAREER = 'career';
+
+/** The feeds whose entries have a page of their own. */
+export const PAGE_FEEDS: FeedKind[] = ['leads', 'radar'];
+
+export type PageEntry = {
+    kind: 'collection' | 'feed' | 'career';
+    /** The collection key, the feed kind, or `career`. */
+    collection: string;
+    /** The key the page is opened with: an entry's id, a feed entry's identity. */
+    key: string;
+    /** What the page is for: `<collection>:<key>`, and `career` for the career file. */
+    name: string;
+    /** The id a write names the entry by; a feed entry's title. */
+    writeId: string;
+    /** The key of the hub the entry is of; the empty text for the primary's. */
+    root: string;
+    title: string;
+    schema: SchemaField[];
+    /** The saved values by field name. */
+    values: Record<string, unknown>;
+    /** The fields the form shows and never writes. */
+    fixed: string[];
+    /** The other entries' values, whose shape a field this entry lacks follows. */
+    peers: Record<string, unknown>[];
+};
+
+/** The name of the page of the entry `key` of `collection`. */
+function pageName(collection: string, key: string): string {
+    return `${collection}:${key}`;
+}
+
+/**
+ * The state an entry's page is opened with. Its `id` is what makes one entry one tab: the same
+ * entry asked for again activates its tab, another entry of the collection gets its own, and the
+ * same key in another collection is another entry.
+ */
+export function entryPageState(
+    collection: string,
+    key: string,
+    label: string
+): { id: string; collection: string; key: string; label: string } {
+    return { id: pageName(collection, key), collection, key, label };
+}
+
+/**
+ * The state a collection or feed view is given to reveal one entry: the key, and the disclosure
+ * the entry may sit behind opened, since a card that is not mounted cannot be scrolled to.
+ */
+export function revealState(collection: string, key: string): Record<string, unknown> {
+    if (collection === 'leads') return { reveal: key, expiredOpen: true };
+    if (collection === 'radar') return { reveal: key, dismissedOpen: true };
+    return { reveal: key };
+}
+
+/** The collection whose entries are people, whose page is the Person view. */
+export const PEOPLE = 'people';
+
+/**
+ * The view that is the page of an entry and the state it is opened with: the Person view for a
+ * person, the `entry` view for every other entry of a collection or a feed.
+ */
+export function pageView(
+    collection: string,
+    key: string,
+    label: string
+): { view: string; state: Record<string, string> } {
+    return collection === PEOPLE
+        ? { view: 'person', state: { key, label } }
+        : { view: 'entry', state: entryPageState(collection, key, label) };
+}
+
+/** The page of an entry of a collection file. */
+function collectionPage(
+    key: string,
+    schema: SchemaField[],
+    entry: Entry,
+    others: readonly Entry[]
+): PageEntry {
+    return {
+        kind: 'collection',
+        collection: key,
+        key: entry.id,
+        name: pageName(key, entry.id),
+        writeId: entry.id,
+        root: entry.root ?? '',
+        title: entry.title === '' ? entry.id : entry.title,
+        schema,
+        values: entry.fields,
+        fixed: fixedFields(key, schema),
+        peers: others.filter((one) => one !== entry).map((one) => one.fields)
+    };
+}
+
+/** The page of a feed entry, `ident` being the identity the feed views give it. */
+function feedPage(
+    kind: FeedKind,
+    feed: Pick<FeedData, 'entries' | 'schema'>,
+    ident: string
+): PageEntry | null {
+    const identOf = feedIdents(kind, feed.entries);
+    const entry = feed.entries.find((one) => identOf(one) === ident);
+    const schema = feed.schema;
+    if (entry === undefined || schema === undefined) return null;
+    const title = scalar(entry.title);
+    return {
+        kind: 'feed',
+        collection: kind,
+        key: ident,
+        name: pageName(kind, ident),
+        writeId: title,
+        root: feedRoot(entry),
+        title: title === '' ? ident : title,
+        schema,
+        values: entry,
+        fixed: [identityField(schema)],
+        peers: feed.entries.filter((one) => one !== entry)
+    };
+}
+
+/** The page of the career file; null while the hub holds none or the file has no schema. */
+function careerPage(career: Career | null): PageEntry | null {
+    if (career?.schema === undefined) return null;
+    return {
+        kind: 'career',
+        collection: CAREER,
+        key: CAREER,
+        name: CAREER,
+        writeId: '',
+        root: '',
+        title: career.title,
+        schema: career.schema,
+        values: career.sections,
+        fixed: [],
+        peers: []
+    };
+}
+
+/** The form fields of a page, for the values it has now (a field's choices may depend on them). */
+export function pageFields(page: PageEntry): FormField[] {
+    return formFieldsOf(page.schema, page.values);
+}
+
+/** The first value of a field among the other entries, which decides a `records` shape. */
+export function sampleOf(page: PageEntry, field: string): unknown {
+    return page.peers.map((one) => one[field]).find((one) => one !== undefined && one !== null);
+}
+
+/** Where pages are found: the snapshot and the feeds as they stand now. */
+export type PageSources = {
+    snapshot: () => Snapshot | null;
+    feeds: () => FeedsPayload | null;
+};
+
+/** The pages, found by name or by collection and key. */
+export type Pages = {
+    pageOf: (collection: string, key: string) => PageEntry | null;
+    pageNamed: (name: string) => PageEntry | null;
+};
+
+export function createPages(sources: PageSources): Pages {
+    function pageOf(collection: string, key: string): PageEntry | null {
+        const feed = PAGE_FEEDS.find((kind) => kind === collection);
+        if (feed !== undefined) {
+            const held = sources.feeds()?.[feed];
+            return held === undefined ? null : feedPage(feed, held, key);
+        }
+        const snapshot = sources.snapshot();
+        if (snapshot === null) return null;
+        for (const held of collectionsOf(snapshot.entities.collections, collection)) {
+            const entry = held.entries.find((one) => one.id === key);
+            if (entry !== undefined && held.schema !== undefined) {
+                return collectionPage(collection, held.schema, entry, held.entries);
+            }
+        }
+        return null;
+    }
+
+    function pageNamed(name: string): PageEntry | null {
+        if (name === CAREER) return careerPage(sources.snapshot()?.entities.career ?? null);
+        const at = name.indexOf(':');
+        return at < 1 ? null : pageOf(name.slice(0, at), name.slice(at + 1));
+    }
+
+    return { pageOf, pageNamed };
+}
+
+/**
+ * What the draft of an entry form is judged by: the page's saved values now, the payload rule of
+ * the field's type (record-values.ts), and the fields the form writes. A page the snapshot no
+ * longer holds is compared with nothing, so any edit with words in it is unsaved.
+ */
+export function pageDraftTarget(pages: Pages): DraftTarget {
+    return {
+        values: (name) => pages.pageNamed(name)?.values ?? null,
+        differs: (name, field, edit, value) => {
+            const page = pages.pageNamed(name);
+            const form =
+                page === null ? undefined : pageFields(page).find((one) => one.field === field);
+            if (page === null || form === undefined) return hasWords(edit);
+            return fieldDiffers(form, edit, value, sampleOf(page, field));
+        },
+        writable: (name, field) => !(pages.pageNamed(name)?.fixed ?? []).includes(field)
+    };
+}
diff --git a/tools/oculus/src/lib/state/forms/record-fields.ts b/tools/oculus/src/lib/state/forms/record-fields.ts
new file mode 100644
index 000000000..6faf4c8b7
--- /dev/null
+++ b/tools/oculus/src/lib/state/forms/record-fields.ts
@@ -0,0 +1,68 @@
+// Layer 2, client state. A file's own `schema:` as the fields of the entry form: the collection
+// files, the two generated feeds and the career file all declare one, and the form is drawn from it
+// with the same field type the project editor's form is drawn from (state/forms/schema.ts), so one
+// set of controls draws both. Pure.
+//
+// The first field of a schema is the entry's identity: it addresses the entry in the file, so the
+// form shows it and never writes it. A registry whose entities are keyed by another field (the
+// venues by `id`) shows that field read-only instead and writes the identity: a rename of the
+// identity is written through the `entry` write's `was` record and leaves the key, which every
+// manifest names the entry by, as it is.
+
+import type { SchemaField } from '../../data/model/index.ts';
+import { KEYED_FIELDS } from '../../data/helpers/files/yaml/collection-text.ts';
+import { byKey, scalar } from '../../data/helpers/guards.ts';
+import type { FormField } from './schema.ts';
+
+/** The field a file without a schema is addressed by, and the card's own heading. */
+export const TITLE_FIELD = 'title';
+
+/** The field an entry is addressed by: the file's own schema's first field, `title` without one. */
+export function identityField(schema: SchemaField[] | undefined): string {
+    const first = (schema ?? []).at(0);
+    return first === undefined ? TITLE_FIELD : first.field;
+}
+
+/**
+ * The fields of an entry the form shows and never writes: the field the collection's registry keys
+ * its entities by when it has one (a venue's `id`), else the identity.
+ */
+export function fixedFields(collection: string, schema: SchemaField[] | undefined): string[] {
+    return [byKey(KEYED_FIELDS, collection) ?? identityField(schema)];
+}
+
+/** The source of a field's choices: its list, or the one the record's other field picks. */
+function fromOf(from: SchemaField['from'], record: Record<string, unknown>): FormField['from'] {
+    if (from === undefined || Array.isArray(from)) return from;
+    return byKey(from.sources, scalar(record[from.field]));
+}
+
+/**
+ * One schema field as a form field. `record` is the record the field is in, which a field whose
+ * choices depend on another field of its record reads that field of.
+ */
+function formFieldOf(one: SchemaField, record: Record<string, unknown>): FormField {
+    const field: FormField = {
+        field: one.field,
+        label: one.label ?? one.field,
+        type: one.type,
+        section: ''
+    };
+    if (one.help !== undefined) field.help = one.help;
+    if (one.options !== undefined) field.options = one.options;
+    const from = fromOf(one.from, record);
+    if (from !== undefined) field.from = from;
+    if (one.fields !== undefined) field.fields = one.fields.map((sub) => formFieldOf(sub, {}));
+    if (one.open === true) field.open = true;
+    if (one.map === true) field.map = true;
+    if (one.required === true) field.required = true;
+    return field;
+}
+
+/** The form fields of a schema, in its order, for the entry whose values are `record`. */
+export function formFieldsOf(
+    schema: SchemaField[] | undefined,
+    record: Record<string, unknown>
+): FormField[] {
+    return (schema ?? []).map((one) => formFieldOf(one, record));
+}
diff --git a/tools/oculus/src/lib/state/forms/record-values.ts b/tools/oculus/src/lib/state/forms/record-values.ts
new file mode 100644
index 000000000..4cc157519
--- /dev/null
+++ b/tools/oculus/src/lib/state/forms/record-values.ts
@@ -0,0 +1,288 @@
+// Layer 2, client state. The values of an entry form: what a saved value of a schema field becomes
+// while it is edited, what an edit becomes when it is saved, and whether the two differ. Pure, so
+// the editor of a collection entry, a feed entry, a person and the career file is tested without a
+// browser.
+//
+// An edit is plain JSON, so the draft in the ui store (form-draft.ts) can keep it across a reload:
+//   text, textarea, select, date  a string
+//   tags                          a list of strings
+//   checkbox                      a boolean
+//   metalist                      a list of { label, value } rows
+//   records                       a RecordsEdit, in one of the four shapes below
+//
+// A `records` field holds a list of records, one record, a map from a name to one record, or a map
+// of label-value rows. The saved value decides which (a list is a list, a map with the fields
+// declared is one record, a map with none is rows, and a field marked `map` is named records); a
+// field the entry has no value for takes the shape of another entry's value, and then the schema's.
+//
+// A record draws the fields its schema declares and, when the schema says it is `open`, one row
+// per key it does not declare. A key whose value is no text, number or boolean is kept as it is
+// and not drawn.
+//
+// What a save writes is the payload of an edit: text trimmed and empty text as null (which clears
+// the field), the saved value itself when the edit says the same words (so a number stays a
+// number), empty records and rows left out. Whether a field is changed is whether its payload
+// differs from the payload of the untouched edit, so a field the form cannot say differently from
+// the file is never a change.
+
+import { isMap, scalar } from '../../data/helpers/guards.ts';
+import { asList, asText, type FormField } from './schema.ts';
+
+/** One label-value row: a metalist item, an unnamed key of a record, or a fact of a strip. */
+export type Row = { label: string; value: string };
+
+/** One record being edited: its declared fields, its unnamed keys as rows, and what is kept. */
+export type RecordEdit = {
+    fields: Record<string, unknown>;
+    rows: Row[];
+    /** The keys of the saved record that are neither declared nor text, written back unchanged. */
+    kept: Record<string, unknown>;
+    /** Where the record was in the saved value: its place in a list or its name in a map. */
+    src?: string | number;
+};
+
+/** One record of a map from a name to one record. */
+export type NamedEdit = { label: string; record: RecordEdit; src?: string };
+
+/** The four shapes of a `records` field. */
+export type RecordsEdit =
+    | { shape: 'list'; items: RecordEdit[] }
+    | { shape: 'one'; item: RecordEdit }
+    | { shape: 'labels'; rows: Row[] }
+    | { shape: 'named'; items: NamedEdit[] };
+
+/** Whether a value is text, a number or a boolean, which a row can hold. */
+function isPlain(value: unknown): value is string | number | boolean {
+    return typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean';
+}
+
+/** The saved value when it says the words typed (so a number stays a number), else the words. */
+function keepType(saved: unknown, words: string): unknown {
+    return isPlain(saved) && String(saved).trim() === words ? saved : words;
+}
+
+/** The sub-fields a `records` field declares. */
+function declared(field: FormField): FormField[] {
+    return field.fields ?? [];
+}
+
+/** A value that stands for nothing: absent, null, empty text, an empty list or an empty map. */
+function nothing(value: unknown): boolean {
+    if (value === undefined || value === null || value === '') return true;
+    if (Array.isArray(value)) return value.length === 0;
+    return isMap(value) && Object.keys(value).length === 0;
+}
+
+/**
+ * The shape a `records` field is edited in: the one its saved value has, else the one of the
+ * `sample` (another entry's value of the field), else the one its schema says.
+ */
+function shapeOf(field: FormField, saved: unknown, sample?: unknown): RecordsEdit['shape'] {
+    const held = nothing(saved) ? sample : saved;
+    if (Array.isArray(held)) return 'list';
+    const plain = declared(field).length === 0;
+    if (isMap(held)) return field.map === true ? 'named' : plain ? 'labels' : 'one';
+    if (field.map === true) return 'named';
+    return field.open === true && plain ? 'labels' : 'list';
+}
+
+/** The rows of a metalist: one per item, a bare word standing as the value of an unlabelled row. */
+function rowsOf(saved: unknown): Row[] {
+    const items = Array.isArray(saved) ? saved : nothing(saved) ? [] : [saved];
+    return items.map((item) =>
+        isMap(item)
+            ? { label: scalar(item.label), value: scalar(item.value) }
+            : { label: '', value: asText(item) }
+    );
+}
+
+/** The rows of a map of facts: one per key, in the map's order. */
+function factRows(saved: unknown): Row[] {
+    return isMap(saved)
+        ? Object.entries(saved).map(([label, value]) => ({ label, value: asText(value) }))
+        : [];
+}
+
+/** One record as an edit; `src` says where in the saved value it was. */
+function recordEdit(field: FormField, item: unknown, src?: string | number): RecordEdit {
+    const saved = isMap(item) ? item : {};
+    const names = declared(field).map((sub) => sub.field);
+    const others = Object.entries(saved).filter(([key]) => !names.includes(key));
+    const edit: RecordEdit = {
+        fields: Object.fromEntries(
+            declared(field).map((sub) => [sub.field, toEdit(sub, saved[sub.field])])
+        ),
+        rows: others
+            .filter(([, value]) => isPlain(value))
+            .map(([label, value]) => ({ label, value: scalar(value) })),
+        kept: Object.fromEntries(others.filter(([, value]) => !isPlain(value)))
+    };
+    if (src !== undefined) edit.src = src;
+    return edit;
+}
+
+/** A record with nothing in it yet, for the control that adds one. */
+export function blankRecord(field: FormField): RecordEdit {
+    return recordEdit(field, undefined);
+}
+
+/** A row with nothing in it yet. */
+export function blankRow(): Row {
+    return { label: '', value: '' };
+}
+
+/** The edit of a `records` field in the shape its value, a peer's value or its schema gives. */
+function recordsEdit(field: FormField, saved: unknown, sample: unknown): RecordsEdit {
+    const shape = shapeOf(field, saved, sample);
+    if (shape === 'one') return { shape, item: recordEdit(field, saved) };
+    if (shape === 'labels') return { shape, rows: factRows(saved) };
+    if (shape === 'named') {
+        const held = isMap(saved) ? Object.entries(saved) : [];
+        return {
+            shape,
+            items: held.map(([label, item]) => ({
+                label,
+                record: recordEdit(field, item, label),
+                src: label
+            }))
+        };
+    }
+    const items = Array.isArray(saved) ? saved : [];
+    return { shape, items: items.map((item, at) => recordEdit(field, item, at)) };
+}
+
+/**
+ * What a saved value of a field becomes while it is edited. `sample` is another entry's value of
+ * the same field, which decides the shape of a `records` field this entry has no value for.
+ */
+export function toEdit(field: FormField, saved: unknown, sample?: unknown): unknown {
+    if (field.type === 'checkbox') return saved === true;
+    if (field.type === 'tags') return asList(saved);
+    if (field.type === 'metalist') return rowsOf(saved);
+    if (field.type === 'records') return recordsEdit(field, saved, sample);
+    return asText(saved);
+}
+
+/** The text of an edit as the value it stands for: trimmed, nothing for empty text. */
+function textPayload(edit: unknown, saved: unknown): unknown {
+    const words = (typeof edit === 'string' ? edit : asText(edit)).trim();
+    return words === '' ? null : keepType(saved, words);
+}
+
+/** The tags of an edit: the non-empty ones, trimmed; the saved list when it says the same. */
+function tagsPayload(edit: unknown, saved: unknown): unknown {
+    const list = asList(edit)
+        .map((one) => one.trim())
+        .filter((one) => one !== '');
+    if (list.length === 0) return null;
+    const was = asList(saved);
+    const same = list.length === was.length && list.every((one, at) => one === was[at]);
+    return same && Array.isArray(saved) ? saved : list;
+}
+
+/** The rows of a metalist: those with a label or a value. */
+function metalistPayload(edit: unknown): unknown {
+    const rows = (Array.isArray(edit) ? edit : []).filter(
+        (row): row is Row =>
+            isMap(row) && (scalar(row.label).trim() !== '' || scalar(row.value).trim() !== '')
+    );
+    return rows.length === 0
+        ? null
+        : rows.map((row) => ({ label: row.label.trim(), value: row.value.trim() }));
+}
+
+/** One record as the map it is written as, or null when it holds nothing. */
+function recordPayload(
+    field: FormField,
+    edit: RecordEdit,
+    saved: unknown
+): Record<string, unknown> | null {
+    const was = isMap(saved) ? saved : {};
+    const out: Record<string, unknown> = {};
+    for (const sub of declared(field)) {
+        const one = payloadOf(sub, edit.fields[sub.field], was[sub.field]);
+        if (!nothing(one)) out[sub.field] = one;
+    }
+    for (const row of edit.rows) {
+        const label = row.label.trim();
+        if (label !== '') out[label] = keepType(was[label], row.value.trim());
+    }
+    Object.assign(out, edit.kept);
+    return Object.keys(out).length === 0 ? null : out;
+}
+
+/** The record of the saved value an edited record came from. */
+function savedRecord(saved: unknown, src: string | number | undefined): unknown {
+    if (src === undefined) return undefined;
+    if (typeof src === 'number') return Array.isArray(saved) ? saved[src] : undefined;
+    return isMap(saved) ? saved[src] : undefined;
+}
+
+/** The payload of a `records` edit in its own shape; null when it holds nothing. */
+function recordsPayload(field: FormField, edit: unknown, saved: unknown): unknown {
+    if (!isMap(edit)) return null;
+    const records = edit as RecordsEdit;
+    if (records.shape === 'one') return recordPayload(field, records.item, saved);
+    if (records.shape === 'labels') {
+        const facts: Record<string, unknown> = {};
+        const was = isMap(saved) ? saved : {};
+        for (const row of records.rows) {
+            const label = row.label.trim();
+            if (label !== '') facts[label] = keepType(was[label], row.value.trim());
+        }
+        return Object.keys(facts).length === 0 ? null : facts;
+    }
+    if (records.shape === 'named') {
+        const named: Record<string, unknown> = {};
+        for (const item of records.items) {
+            const label = item.label.trim();
+            const one = recordPayload(field, item.record, savedRecord(saved, item.src));
+            if (label !== '' && one !== null) named[label] = one;
+        }
+        return Object.keys(named).length === 0 ? null : named;
+    }
+    const listed = records.items
+        .map((item) => recordPayload(field, item, savedRecord(saved, item.src)))
+        .filter((one): one is Record<string, unknown> => one !== null);
+    return listed.length === 0 ? null : listed;
+}
+
+/**
+ * What a save writes for one field: the value the edit stands for, and null for an edit that
+ * clears the field. `saved` is the field's value in the file, which an edit that says the same
+ * words keeps the type of.
+ */
+export function payloadOf(field: FormField, edit: unknown, saved: unknown): unknown {
+    if (field.type === 'checkbox') return edit === true ? true : saved === true ? false : null;
+    if (field.type === 'tags') return tagsPayload(edit, saved);
+    if (field.type === 'metalist') return metalistPayload(edit);
+    if (field.type === 'records') return recordsPayload(field, edit, saved);
+    return textPayload(edit, saved);
+}
+
+/**
+ * Whether an edit changes the field: its payload differs from the payload of the field untouched.
+ * A field the form cannot say differently from the file (a trailing space, an empty row) is not
+ * changed.
+ */
+export function fieldDiffers(
+    field: FormField,
+    edit: unknown,
+    saved: unknown,
+    sample?: unknown
+): boolean {
+    const untouched = payloadOf(field, toEdit(field, saved, sample), saved);
+    return JSON.stringify(payloadOf(field, edit, saved)) !== JSON.stringify(untouched);
+}
+
+/** The keys of an edit that name its shape and its place, which are no words of the reader's. */
+const STRUCTURE = ['shape', 'src'];
+
+/** Whether an edit holds any words, tick or row, for a draft of a field the schema lacks. */
+export function hasWords(edit: unknown): boolean {
+    if (typeof edit === 'string') return edit.trim() !== '';
+    if (typeof edit === 'boolean') return edit;
+    if (Array.isArray(edit)) return edit.some(hasWords);
+    if (!isMap(edit)) return false;
+    return Object.entries(edit).some(([key, held]) => !STRUCTURE.includes(key) && hasWords(held));
+}
diff --git a/tools/oculus/src/lib/state/forms/referrers.ts b/tools/oculus/src/lib/state/forms/referrers.ts
new file mode 100644
index 000000000..6c276935c
--- /dev/null
+++ b/tools/oculus/src/lib/state/forms/referrers.ts
@@ -0,0 +1,127 @@
+// Layer 2, client state. What refers to a record: the projects whose manifest names a pillar, a
+// domain, a venue, a dataset, a funding scheme or a resource; the people and funding schemes that
+// name an organisation; the projects and joint work that name a person; and the `slurm.resource`
+// setting that names a resource. A record's page lists them and the question that asks before a
+// delete names them, so both read this one answer.
+//
+// Pure over the snapshot and the merged configuration it is given. Every join goes through the ids
+// of the merged portfolio, which carry the key of a hub other than the primary, so a record of one
+// hub is never named by a reference of another. A collection whose entries nothing refers to (a
+// statement, an event) has no referrers.
+
+import { byKey, isMap } from '../../data/helpers/guards.ts';
+import { joinedEntries } from '../../data/helpers/hub-names.ts';
+import type { Project, Snapshot } from '../../data/model/index.ts';
+
+/** The collection key of the joint work, whose entries each name one person. */
+export const JOINT_WORK = 'joint-work';
+
+/** The settings of behavior.yml that name a resource. */
+const RESOURCE_SETTINGS: { key: string; field: string }[] = [{ key: 'slurm', field: 'resource' }];
+
+/** The collections whose entries other records refer to, so their pages list the referrers. */
+export const REFERRED = [
+    'pillars',
+    'domains',
+    'venues',
+    'data',
+    'funding',
+    'people',
+    'organisations',
+    'resources'
+];
+
+/** One thing that refers to a record, and what opens it. */
+export type Referrer = {
+    kind: 'project' | 'person' | 'funding' | 'entry' | 'setting';
+    /** The project, person, funding scheme or entry id, or the dotted setting. */
+    id: string;
+    label: string;
+    /** The collection of an `entry` referrer. */
+    collection?: string;
+};
+
+/** The words a project is named by: its short name, else its title. */
+function projectLabel(project: Project): string {
+    return project.short === undefined || project.short === '' ? project.title : project.short;
+}
+
+/** The projects of the snapshot that satisfy a test, as referrers. */
+function projectsWhere(snapshot: Snapshot, test: (project: Project) => boolean): Referrer[] {
+    return Object.values(snapshot.entities.projects)
+        .filter(test)
+        .map((project) => ({ kind: 'project', id: project.id, label: projectLabel(project) }));
+}
+
+/** The setting of the configuration at `key.field`, as text, or the empty text. */
+function settingOf(config: Record<string, unknown>, key: string, field: string): string {
+    const section = config[key];
+    const value = isMap(section) ? section[field] : undefined;
+    return typeof value === 'string' ? value : '';
+}
+
+/** The referrers a person has: their projects, their joint work and the projects waiting. */
+function personReferrers(snapshot: Snapshot, id: string): Referrer[] {
+    const person = byKey(snapshot.entities.people, id);
+    const joint = new Set(person?.jointWorkIds ?? []);
+    const entries = joinedEntries(snapshot.entities.collections, JOINT_WORK)
+        .filter((entry) => joint.has(entry.id))
+        .map((entry): Referrer => ({
+            kind: 'entry',
+            id: entry.id,
+            label: entry.title === '' ? entry.id : entry.title,
+            collection: JOINT_WORK
+        }));
+    const projects = projectsWhere(
+        snapshot,
+        (project) => project.collaborators.includes(id) || project.waitingOn.includes(id)
+    );
+    return [...projects, ...entries];
+}
+
+/** The referrers an organisation has: the people affiliated to it and the schemes it funds. */
+function organisationReferrers(snapshot: Snapshot, id: string): Referrer[] {
+    const people = Object.values(snapshot.entities.people)
+        .filter((person) => person.affiliations.includes(id))
+        .map((person): Referrer => ({
+            kind: 'person',
+            id: person.id,
+            label: person.name === '' ? person.id : person.name
+        }));
+    const schemes = Object.values(snapshot.entities.funding)
+        .filter((scheme) => scheme.funder === id)
+        .map((scheme): Referrer => ({
+            kind: 'funding',
+            id: scheme.id,
+            label: scheme.title === '' ? scheme.id : scheme.title
+        }));
+    return [...people, ...schemes];
+}
+
+/**
+ * What refers to the entry `id` of the collection `collection`. `config` is the merged
+ * configuration, whose settings can name a resource.
+ */
+export function referrersOf(
+    snapshot: Snapshot,
+    config: Record<string, unknown>,
+    collection: string,
+    id: string
+): Referrer[] {
+    if (collection === 'pillars') return projectsWhere(snapshot, (p) => p.pillarIds.includes(id));
+    if (collection === 'domains') return projectsWhere(snapshot, (p) => p.domainIds.includes(id));
+    if (collection === 'venues') return projectsWhere(snapshot, (p) => p.venueId === id);
+    if (collection === 'data') return projectsWhere(snapshot, (p) => p.datasetIds.includes(id));
+    if (collection === 'funding') return projectsWhere(snapshot, (p) => p.fundingIds.includes(id));
+    if (collection === 'people') return personReferrers(snapshot, id);
+    if (collection === 'organisations') return organisationReferrers(snapshot, id);
+    if (collection !== 'resources') return [];
