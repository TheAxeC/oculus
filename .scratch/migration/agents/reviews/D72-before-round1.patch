diff --git a/tools/oculus/tests/state/forms/new-entry.test.ts b/tools/oculus/tests/state/forms/new-entry.test.ts
new file mode 100644
index 000000000..ff8f168e7
--- /dev/null
+++ b/tools/oculus/tests/state/forms/new-entry.test.ts
@@ -0,0 +1,175 @@
+// Layer 2, client-state tests. What a new entry is made of: the fields the Add box asks, the
+// collection Add writes to, the task `:task-add` makes of a title, and what `addTask` says when the
+// title, the key, the collection or the write refuses. The write is a stub that records the call.
+
+import { describe, expect, it } from 'vitest';
+import type { Collection, Entry, SchemaField } from '../../../src/lib/data/model/index.ts';
+import { engineDir, loadConfig, textCatalog } from '../../../src/lib/data/sources/config.ts';
+import { addTask, askFields } from '../../../src/lib/state/forms/new-entry.ts';
+import type { WriteAnswer } from '../../../src/lib/state/shared/stores/shapes.ts';
+import { setCatalog, t } from '../../../src/lib/state/shared/words/text.ts';
+
+setCatalog(textCatalog(loadConfig(engineDir()).config));
+
+const TASK_SCHEMA: SchemaField[] = [
+    { field: 'key', type: 'text' },
+    { field: 'title', type: 'text' },
+    { field: 'status', type: 'select' }
+];
+
+function entry(key: string, root?: string): Entry {
+    return {
+        id: key,
+        title: key,
+        fields: { key },
+        file: '/hub/tasks/tasks.yml',
+        index: 0,
+        ...(root === undefined ? {} : { root })
+    };
+}
+
+function tasks(keys: string[], root?: string): Collection {
+    return {
+        id: 'tasks',
+        title: 'Tasks',
+        file: '/hub/tasks/tasks.yml',
+        schema: TASK_SCHEMA,
+        entries: keys.map((one) => entry(one, root)),
+        ...(root === undefined ? {} : { root })
+    };
+}
+
+describe('askFields', () => {
+    it.each([
+        ['a collection keyed by its first field', 'tasks', TASK_SCHEMA, ['key']],
+        [
+            'venues, whose entities are keyed by id',
+            'venues',
+            [{ field: 'name', type: 'text' }],
+            ['name', 'id']
+        ],
+        ['a file with no schema', 'tasks', undefined, ['title']]
+    ])('%s', (_name, collection, schema, fields) => {
+        expect(askFields(collection, schema).map((one) => one.field)).toEqual(fields);
+    });
+});
+
+/** The fields `addTask` hands the write for a title, or the sentence it says instead. */
+async function made(
+    title: string,
+    collections: Collection[],
+    primary: string | null = null
+): Promise<Record<string, unknown> | string> {
+    const written: Record<string, unknown>[] = [];
+    const added = await addTask(title, collections, primary, (_collection, one) => {
+        written.push(one);
+        return Promise.resolve({ ok: true, changed: [], refused: [], id: String(one.key) });
+    });
+    return written.at(0) ?? added.said;
+}
+
+describe('the hub a task is added to', () => {
+    const own = tasks([], 'research');
+    const other = tasks(['review'], 'second');
+
+    it.each([
+        ['the primary hub when there is one', [other, own], 'research', 'review'],
+        ['the first hub when there is no primary', [other, own], null, 'review-2']
+    ])('is %s', async (_name, collections, primary, key) => {
+        expect(await made('Review', collections, primary)).toMatchObject({ key });
+    });
+
+    it('is none when the primary hub holds no tasks collection', async () => {
+        expect(await made('Review', [other], 'research')).toBe(
+            t('app.palette.task_add_collection')
+        );
+    });
+});
+
+describe('the task a title makes', () => {
+    it.each([
+        [
+            'words joined by hyphens',
+            'Review the RAW-PLS rebuttal',
+            [],
+            'review-the-raw-pls-rebuttal'
+        ],
+        ['accents taken off', 'Caf\u00e9 meeting', [], 'cafe-meeting'],
+        [
+            'a held key gets -2',
+            'Review the RAW-PLS rebuttal',
+            ['review-the-raw-pls-rebuttal'],
+            'review-the-raw-pls-rebuttal-2'
+        ],
+        ['a key held twice gets -3', 'Review', ['review', 'review-2'], 'review-3']
+    ])('%s', async (_name, title, held, key) => {
+        expect(await made(title, [tasks(held)])).toEqual({ key, title, status: 'todo' });
+    });
+
+    it('is cut to 80 characters with no trailing hyphen', async () => {
+        const key = ((await made(`${'word '.repeat(60)}end`, [tasks([])])) as { key: string }).key;
+        expect(key.length).toBeLessThanOrEqual(80);
+        expect(key.endsWith('-')).toBe(false);
+    });
+
+    it('keeps a clashing key inside 80 characters with its suffix', async () => {
+        const long = 'a'.repeat(200);
+        const first = ((await made(long, [tasks([])])) as { key: string }).key;
+        const second = ((await made(long, [tasks([first])])) as { key: string }).key;
+        expect(second.length).toBeLessThanOrEqual(80);
+        expect(second.endsWith('-2')).toBe(true);
+    });
+});
+
+describe('addTask', () => {
+    const answered = (over: Partial<WriteAnswer>): WriteAnswer => ({
+        ok: true,
+        changed: [],
+        refused: [],
+        ...over
+    });
+
+    it('writes the task to the tasks collection and gives back its id and title', async () => {
+        const calls: [string, Record<string, unknown>][] = [];
+        const added = await addTask('Review it', [tasks([])], null, (collection, fields) => {
+            calls.push([collection, fields]);
+            return Promise.resolve(answered({ id: 'review-it' }));
+        });
+        expect(calls).toEqual([
+            ['tasks', { key: 'review-it', title: 'Review it', status: 'todo' }]
+        ]);
+        expect(added).toEqual({ id: 'review-it', label: 'Review it', said: '' });
+    });
+
+    it.each([
+        ['an empty title', '', [tasks([])], 'app.palette.task_add_title'],
+        ['no key', '\u65e5\u672c', [tasks([])], 'app.palette.task_add_key'],
+        ['no tasks collection', 'Review', [], 'app.palette.task_add_collection']
+    ])('says why it writes nothing for %s', async (_name, title, collections, words) => {
+        const calls: string[] = [];
+        const added = await addTask(title, collections, null, (collection) => {
+            calls.push(collection);
+            return Promise.resolve(answered({}));
+        });
+        expect(calls).toEqual([]);
+        expect(added).toEqual({ id: '', label: '', said: t(words) });
+    });
+
+    it('says the refusal of the write', async () => {
+        const added = await addTask('Review it', [tasks([])], null, () =>
+            Promise.resolve(answered({ ok: false, error: 'the file does not parse' }))
+        );
+        expect(added).toEqual({ id: '', label: '', said: 'the file does not parse' });
+    });
+
+    it('says the reason of a refused field', async () => {
+        const added = await addTask('Review it', [tasks([])], null, () =>
+            Promise.resolve(
+                answered({
+                    refused: [{ field: 'key', reason: 'an entry with that key is in the file' }]
+                })
+            )
+        );
+        expect(added.said).toBe('an entry with that key is in the file');
+    });
+});
diff --git a/tools/oculus/tests/state/forms/page-entry.test.ts b/tools/oculus/tests/state/forms/page-entry.test.ts
new file mode 100644
index 000000000..0a0e3de8f
--- /dev/null
+++ b/tools/oculus/tests/state/forms/page-entry.test.ts
@@ -0,0 +1,192 @@
+// Layer 2, client-state tests. The page of an entry: which view opens it and with what state, how a
+// page is found again from its name in the snapshot and the feeds as they stand now, and how the
+// draft of a page is judged against it. The snapshot and the feeds are synthetic and hold only
+// what the page reads.
+
+import { describe, expect, it } from 'vitest';
+import type {
+    Career,
+    Collection,
+    FeedsPayload,
+    SchemaField,
+    Snapshot
+} from '../../../src/lib/data/model/index.ts';
+import {
+    createPages,
+    pageDraftTarget,
+    pageView,
+    revealState
+} from '../../../src/lib/state/forms/page-entry.ts';
+
+const SCHEMA: SchemaField[] = [
+    { field: 'key', type: 'text' },
+    { field: 'title', type: 'text' },
+    { field: 'status', type: 'select', options: ['todo', 'done'] }
+];
+
+function collection(root: string | undefined, keys: string[]): Collection {
+    return {
+        id: root === undefined ? 'tasks' : `${root}:tasks`,
+        title: 'Tasks',
+        file: `/${root ?? 'hub'}/tasks.yml`,
+        schema: SCHEMA,
+        entries: keys.map((key, index) => ({
+            id: root === undefined ? key : `${root}:${key}`,
+            title: `Title of ${key}`,
+            fields: { key, title: `Title of ${key}`, status: 'todo' },
+            file: `/${root ?? 'hub'}/tasks.yml`,
+            index,
+            ...(root === undefined ? {} : { root })
+        })),
+        ...(root === undefined ? {} : { root })
+    };
+}
+
+const CAREER: Career = {
+    title: 'Career strategy',
+    situation: [],
+    order: [],
+    hosts: [],
+    hostCriteria: [],
+    notHosts: [],
+    eligibility: null,
+    dropped: [],
+    sections: { milestone: 'Veni' },
+    schema: [{ field: 'milestone', type: 'text' }]
+};
+
+function snapshot(career: Career | null): Snapshot {
+    const held = [collection(undefined, ['a', 'b']), collection('second', ['c'])];
+    return {
+        entities: { collections: Object.fromEntries(held.map((one) => [one.id, one])), career }
+    } as unknown as Snapshot;
+}
+
+const FEEDS = {
+    leads: {
+        meta: {},
+        entries: [{ title: 'Postdoc A', status: 'open' }],
+        schema: [{ field: 'title', type: 'text' }]
+    },
+    radar: { meta: {}, entries: [{ title: 'A paper' }] }
+} as unknown as FeedsPayload;
+
+const pages = createPages({ snapshot: () => snapshot(CAREER), feeds: () => FEEDS });
+
+describe('pageView', () => {
+    it.each([
+        [
+            'a person opens the Person view',
+            'people',
+            'wim',
+            { view: 'person', state: { key: 'wim', label: 'Wim' } }
+        ],
+        [
+            'any other entry opens the entry view',
+            'venues',
+            'jbhi',
+            {
+                view: 'entry',
+                state: { id: 'venues:jbhi', collection: 'venues', key: 'jbhi', label: 'Wim' }
+            }
+        ]
+    ])('%s', (_name, collectionKey, key, opened) => {
+        expect(pageView(collectionKey, key, 'Wim')).toEqual(opened);
+    });
+});
+
+describe('revealState', () => {
+    it.each([
+        ['an entry of a collection', 'venues', { reveal: 'k' }],
+        ['a lead, whose expired disclosure opens', 'leads', { reveal: 'k', expiredOpen: true }],
+        ['a paper, whose dismissed disclosure opens', 'radar', { reveal: 'k', dismissedOpen: true }]
+    ])('%s', (_name, collectionKey, state) => {
+        expect(revealState(collectionKey, 'k')).toEqual(state);
+    });
+});
+
+describe('pageOf', () => {
+    it('finds a collection entry with the values, the fixed fields and the peers', () => {
+        const page = pages.pageOf('tasks', 'a');
+        expect(page).toMatchObject({
+            kind: 'collection',
+            name: 'tasks:a',
+            writeId: 'a',
+            root: '',
+            title: 'Title of a',
+            fixed: ['key']
+        });
+        expect(page?.peers).toEqual([{ key: 'b', title: 'Title of b', status: 'todo' }]);
+    });
+
+    it('finds an entry of another hub by the id the merged portfolio gives it', () => {
+        expect(pages.pageOf('tasks', 'second:c')).toMatchObject({
+            root: 'second',
+            writeId: 'second:c'
+        });
+    });
+
+    it('finds a feed entry by its identity and writes it by its title', () => {
+        expect(pages.pageOf('leads', 'Postdoc A')).toMatchObject({
+            kind: 'feed',
+            collection: 'leads',
+            writeId: 'Postdoc A',
+            fixed: ['title']
+        });
+    });
+
+    it.each([
+        ['an entry no file holds', 'tasks', 'missing'],
+        ['a collection no hub holds', 'nothing', 'a'],
+        ['a feed that has no schema', 'radar', 'A paper'],
+        ['a feed entry no file holds', 'leads', 'Postdoc B']
+    ])('finds none for %s', (_name, collectionKey, key) => {
+        expect(pages.pageOf(collectionKey, key)).toBeNull();
+    });
+});
+
+describe('pageNamed', () => {
+    it('finds the career file by its name and by no other', () => {
+        expect(pages.pageNamed('career')).toMatchObject({
+            kind: 'career',
+            title: 'Career strategy',
+            values: { milestone: 'Veni' }
+        });
+    });
+
+    it('finds a hub with no career file as none', () => {
+        const bare = createPages({ snapshot: () => snapshot(null), feeds: () => FEEDS });
+        expect(bare.pageNamed('career')).toBeNull();
+    });
+
+    it('splits a name at its first colon, so a key may hold more', () => {
+        expect(pages.pageNamed('tasks:second:c')?.writeId).toBe('second:c');
+        expect(pages.pageNamed('nocolon')).toBeNull();
+    });
+});
+
+describe('pageDraftTarget', () => {
+    const target = pageDraftTarget(pages);
+
+    it('reads the saved values of the page now, and none for a page that is gone', () => {
+        expect(target.values('tasks:a')).toEqual({ key: 'a', title: 'Title of a', status: 'todo' });
+        expect(target.values('tasks:gone')).toBeNull();
+    });
+
+    it.each([
+        ['the same words', 'todo', false],
+        ['other words', 'done', true]
+    ])('judges an edit of a field by its payload: %s', (_name, edit, differs) => {
+        expect(target.differs('tasks:a', 'status', edit, 'todo')).toBe(differs);
+    });
+
+    it('judges an edit of a page that is gone by whether it holds words', () => {
+        expect(target.differs('tasks:gone', 'status', 'done', undefined)).toBe(true);
+        expect(target.differs('tasks:gone', 'status', ' ', undefined)).toBe(false);
+    });
+
+    it('writes every field but the fixed ones', () => {
+        expect(target.writable('tasks:a', 'status', {})).toBe(true);
+        expect(target.writable('tasks:a', 'key', {})).toBe(false);
+    });
+});
diff --git a/tools/oculus/tests/state/forms/record-fields.test.ts b/tools/oculus/tests/state/forms/record-fields.test.ts
