@@ -0,0 +1,191 @@
+// Layer 2, server. The /api/clone endpoint. A route module may export only its verbs, so
+// everything the request does is here and src/routes/api/(git)/clone/+server.ts is the few lines
+// that join them, the pattern deposit/deposit-routes.ts holds.
+//
+// A POST carries the write token and one of three actions:
+//
+//     clone         { id }              clone the repository of the project `id`
+//     github-repos  {}                  list the repositories of the reader's GitHub account
+//     github-clone  { repo, parent }    make a project for one of them in `parent` and clone it
+//
+// There is no confirm: a clone adds files to a folder and refuses to overwrite one. The project a
+// `clone` names must be in the last published portfolio, have a repository `url`, a clone folder
+// inside the folder it belongs to, and no repository in it yet.
+//
+// After a clone a folder of a new project that lies under no scan folder of a hub is added to the
+// workspace as an entry of its own, and the portfolio is read again; that read rewrites the block
+// that hides the clone from the hub's git (exclude.ts).
+//
+// Every operation is an option with a real default, so tests/routes/git/clone.test.ts drives the
+// whole endpoint without running git or `gh` at all.
+
+import { json } from '@sveltejs/kit';
+import { z } from 'zod';
+import { gh as realGh, type GhRun, type GitRunner, type Outcome } from '../deposit/deposit-git.ts';
+import { failureLine } from '../../core/git/failure.ts';
+import { inside } from '../../core/paths.ts';
+import { words } from '../../core/words.ts';
+import type { RepositoryBlock } from '../../../data/model/index.ts';
+import { cloneRepository } from './clone.ts';
+import type { GithubRepo } from '../../../data/model/index.ts';
+import { cloneAsProject, listRepos } from './github.ts';
+import { shapedBody } from '../git-routes.ts';
+
+/** Every action POST /api/clone knows. */
+const ACTIONS = ['clone', 'github-repos', 'github-clone'] as const;
+
+/** What the endpoint needs to know of a project in the portfolio. */
+type CloneProject = { file: string; repository?: RepositoryBlock };
+
+export type CloneOptions = {
+    /** The text catalog the sentences are worded from. */
+    text: Record<string, string>;
+    /** How git and `gh` are run; the real ones when absent. */
+    git?: GitRunner;
+    gh?: GhRun;
+    /** The project `id` of the last published portfolio, or null. */
+    project: (id: string) => CloneProject | null;
+    /** The scan folders of those hubs, absolute. */
+    scanDirs: () => string[];
+    /** The names a project or a folder of the workspace holds. */
+    held: () => string[];
+    /** Add a folder to the workspace as an entry of its own; the refusal's word, or null. */
+    addFolder: (dir: string) => string | null;
+    /** Read the portfolio again. */
+    rescan: () => void;
+    /** The folders being cloned into now, so a second press on one is refused. */
+    busy?: Set<string>;
+};
+
+/** What every answer of this route carries besides its type: nothing of it is cached. */
+const NO_STORE = { 'cache-control': 'no-store' };
+
+const textShape = z.string().catch('');
+
+const repoShape = z.object({
+    name: textShape,
+    url: textShape,
+    visibility: textShape,
+    description: textShape,
+    homepage: textShape,
+    topics: z.array(z.string()).catch([]),
+    date: textShape
+});
+
+/** The body of POST /api/clone: the action among ACTIONS and the fields an action reads. */
+const bodyShape = z.looseObject({
+    action: z.enum(ACTIONS),
+    id: textShape,
+    parent: textShape,
+    repo: repoShape.catch({
+        name: '',
+        url: '',
+        visibility: '',
+        description: '',
+        homepage: '',
+        topics: [],
+        date: ''
+    })
+});
+
+function refused(error: string, status = 400): Response {
+    return json({ error }, { status, headers: NO_STORE });
+}
+
+/** The answer of an operation that did not go through. */
+function failed(outcome: Outcome, text: Record<string, string>): Response {
+    return refused(
+        outcome.failure === undefined ? outcome.error : failureLine(outcome.failure, text)
+    );
+}
+
+/** Run `work` unless a clone into `dir` is running, and hold the folder for as long as it runs. */
+async function exclusive(
+    options: CloneOptions,
+    dir: string,
+    work: () => Promise<Response>
+): Promise<Response> {
+    const busy = options.busy ?? new Set<string>();
+    if (busy.has(dir)) return refused(words(options.text, 'server.clone.busy', dir));
+    busy.add(dir);
+    try {
+        return await work();
+    } finally {
+        busy.delete(dir);
+    }
+}
+
+async function cloneProject(id: string, options: CloneOptions, signal?: AbortSignal) {
+    const { text } = options;
+    const found = options.project(id);
+    if (found === null) return refused(words(text, 'server.clone.no_such_project'), 404);
+    const site = found.repository;
+    if (site?.url === undefined) return refused(words(text, 'server.clone.no_url'));
+    if (site.clonePath === undefined) return refused(words(text, 'server.clone.not_clonable'));
+    const dir = site.clonePath;
+    return exclusive(options, dir, async () => {
+        const done = await cloneRepository({
+            dir,
+            url: site.url ?? '',
+            text,
+            git: options.git,
+            signal
+        });
+        if (!done.ok) return failed(done, text);
+        options.rescan();
+        return json({ ok: true, output: done.output }, { headers: NO_STORE });
+    });
+}
+
+async function cloneGithub(
+    repo: GithubRepo,
+    parent: string,
+    options: CloneOptions,
+    signal?: AbortSignal
+) {
+    const { text } = options;
+    return exclusive(options, parent, async () => {
+        const done = await cloneAsProject({
+            repo,
+            parent,
+            held: options.held(),
+            text,
+            git: options.git,
+            signal
+        });
+        if (!done.ok) return failed(done, text);
+        const dir = done.output;
+        const scanned = options.scanDirs().some((scan) => inside(dir, scan));
+        const added = scanned ? null : options.addFolder(dir);
+        options.rescan();
+        if (added !== null) return refused(words(text, 'server.clone.not_added', added));
+        return json({ ok: true, output: dir }, { headers: NO_STORE });
+    });
+}
+
+/**
+ * POST /api/clone: one action. The order is the order of the refusals: the token, the body, the
+ * action, and only then git or `gh`.
+ */
+export async function handleClone(
+    request: Request,
+    token: string,
+    options: CloneOptions
+): Promise<Response> {
+    const { text } = options;
+    const shaped = await shapedBody(request, token, bodyShape, text, () =>
+        refused(words(text, 'server.deposit.not_an_action'))
+    );
+    if (shaped instanceof Response) return shaped;
+    const { action, id, parent, repo } = shaped.read;
+    if (action === 'clone') return cloneProject(id, options);
+    if (action === 'github-repos') {
+        const listed = await listRepos(options.gh ?? realGh, text);
+        return listed.ok
+            ? json({ ok: true, repos: listed.repos }, { headers: NO_STORE })
+            : refused(listed.error);
+    }
+    if (repo.name === '' || repo.url === '')
+        return refused(words(text, 'server.clone.no_repository'));
+    return cloneGithub(repo, parent, options);
+}
