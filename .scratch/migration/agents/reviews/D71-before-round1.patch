+// The clone endpoint. A route module may export only its verbs, so everything it does lives in
+// lib/server/git/clone/clone-routes.ts and this is the few lines that join them: the POST carries
+// the token ServerContext minted, as with /api/write, /api/git and /api/deposit.
+
+import { join } from 'node:path';
+import { textCatalog } from '$lib/data/sources/config';
+import { addFolder } from '$lib/server/edit/writes/config/lists/folders';
+import { handleClone } from '$lib/server/git/clone/clone-routes';
+import { allHubs } from '$lib/server/files/roots';
+import { project, projectIds } from '$lib/server/sessions/stores/hooks';
+import type { RequestHandler } from './$types';
+
+export const POST: RequestHandler = ({ request, locals }) => {
+    const server = locals.server;
+    const config = locals.config().config;
+    const hubs = () => allHubs(server.engine, config, server.workspace.open());
+    return handleClone(request, server.token, {
+        text: textCatalog(config),
+        busy: server.cloning,
+        project: (id) => {
+            const found = project(server.hub, id);
+            return found === null ? null : { file: found.file, repository: found.repository };
+        },
+        scanDirs: () =>
+            hubs().flatMap((one) => one.config.scan.map((rule) => join(one.hub, rule.dir))),
+        held: () => [
+            ...projectIds(server.hub),
+            ...server.workspace.open().folders.map((one) => one.name)
+        ],
+        addFolder: (dir) => {
+            const done = addFolder(server.workspace.open(), dir);
+            return 'error' in done ? done.error : null;
+        },
+        rescan: () => server.rescan()
+    });
+};
