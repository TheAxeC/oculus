index 000000000..a65ca829d
--- /dev/null
+++ b/tools/oculus/tests/server/git/clone-exclude.test.ts
@@ -0,0 +1,310 @@
+// Layer 4, server test. The block of the hub's exclude file that hides the clones of the hub's
+// projects from the hub's git (server/git/clone/exclude.ts): the lines a clone gets, the file git
+// names for a hub that is a repository or a linked worktree, the block rewritten in place with the
+// lines around it kept, and the block rewritten from the manifests after a project folder is
+// renamed through the Explorer, moved by a shell or removed.
+//
+// Every directory is made under the system temporary directory by tests/fixtures/scratch.ts, and
+// the machine's git configuration is replaced by an empty file for the whole file.
+
+import { existsSync, readFileSync, realpathSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { describe, expect } from 'vitest';
+import { buildPortfolioWithSchemas, portfolioConfigFrom } from '../../../src/lib/data/index.ts';
+import { engineDir, loadConfig } from '../../../src/lib/data/sources/config.ts';
+import { cloneRepository } from '../../../src/lib/server/git/clone/clone.ts';
+import {
+    BLOCK_END,
+    BLOCK_START,
+    clonedOf,
+    escapedForIgnore,
+    excludeFileOf,
+    excludeLines,
+    syncExclude,
+    withBlock
+} from '../../../src/lib/server/git/clone/exclude.ts';
+import { plantFile, scratchDir, test } from '../../fixtures/scratch.ts';
+import { published } from '../../data/hubs/hubs-fixture.ts';
+import { plantHub } from '../../fixtures/hubs/workspace.ts';
+import { worldOver } from '../files/ops-fixture.ts';
+import { TEXT } from '../text.ts';
+import { git, isolateGit, put, remote } from './refs/repo.ts';
+
+isolateGit();
+
+const CONFIG = portfolioConfigFrom(loadConfig(engineDir()).config);
+
+describe('the lines the hub excludes a clone with', () => {
+    const HUB = '/hub';
+    const ROWS = [
+        {
+            name: 'a clone folder of the project with its project.yml at the top',
+            clone: '/hub/side-projects/p',
+            manifest: '/hub/side-projects/p/project.yml',
+            lines: ['/side-projects/p/*', '!/side-projects/p/project.yml']
+        },
+        {
+            name: 'a project.yml in the .oculus folder of the clone',
+            clone: '/hub/side-projects/p',
+            manifest: '/hub/side-projects/p/.oculus/project.yml',
+            lines: [
+                '/side-projects/p/*',
+                '!/side-projects/p/.oculus',
+                '!/side-projects/p/.oculus/project.yml'
+            ]
+        },
+        {
+            name: 'a clone folder away from the project folder',
+            clone: '/hub/site',
+            manifest: '/hub/side-projects/s/project.yml',
+            lines: ['/site/*']
+        },
+        {
+            name: 'a clone folder with characters gitignore reads as syntax',
+            clone: '/hub/side-projects/my #dir [a]',
+            manifest: '/hub/side-projects/my #dir [a]/project.yml',
+            lines: [
+                '/side-projects/my \\#dir \\[a\\]/*',
+                '!/side-projects/my \\#dir \\[a\\]/project.yml'
+            ]
+        },
+        {
+            name: 'a clone folder outside the hub',
+            clone: '/elsewhere/p',
+            manifest: '/hub/p.yml',
+            lines: null
+        },
+        { name: 'the hub itself', clone: '/hub', manifest: '/hub/project.yml', lines: null }
+    ];
+
+    test.for(ROWS)('are right for $name', ({ clone, manifest, lines }) => {
+        expect(excludeLines(HUB, clone, manifest)).toEqual(lines);
+    });
+
+    test('escape a name ending in spaces', () => {
+        expect(escapedForIgnore('a  ')).toBe('a\\ \\ ');
+    });
+});
+
+describe('the block of an exclude file', () => {
+    const BLOCK = (...lines: string[]) => [BLOCK_START, ...lines, BLOCK_END].join('\n');
+    const ROWS = [
+        {
+            name: 'a file with no block and lines to hold',
+            text: '*.log\n',
+            lines: ['/p/*'],
+            next: `*.log\n${BLOCK('/p/*')}\n`
+        },
+        {
+            name: 'a file with no block, without a final newline, and lines to hold',
+            text: '*.log',
+            lines: ['/p/*'],
+            next: `*.log\n${BLOCK('/p/*')}\n`
+        },
+        {
+            name: 'an empty file and lines to hold',
+            text: '',
+            lines: ['/p/*'],
+            next: `${BLOCK('/p/*')}\n`
+        },
+        {
+            name: 'a file with no block and nothing to hold',
+            text: '*.log\n',
+            lines: [],
+            next: null
+        },
+        {
+            name: 'a block holding other lines, with the user lines around it',
+            text: `above\n  # kept\n${BLOCK('/old/*')}\nbelow\n\nlast`,
+            lines: ['/new/*', '!/new/project.yml'],
+            next: `above\n  # kept\n${BLOCK('/new/*', '!/new/project.yml')}\nbelow\n\nlast\n`
+        },
+        {
+            name: 'a block holding the lines',
+            text: `a\n${BLOCK('/p/*')}\nb\n`,
+            lines: ['/p/*'],
+            next: null
+        },
+        {
+            name: 'a block with nothing left to hold',
+            text: `a\n${BLOCK('/p/*')}\nb\n`,
+            lines: [],
+            next: `a\n${BLOCK()}\nb\n`
+        },
+        {
+            name: 'an opening line with no closing line',
+            text: `a\n${BLOCK_START}\nb\n`,
+            lines: ['/p/*'],
+            next: `a\n${BLOCK('/p/*')}\nb\n`
+        }
+    ];
+
+    test.for(ROWS)('is written for $name', ({ text, lines, next }) => {
+        expect(withBlock(text, lines)).toBe(next);
+    });
+});
+
+describe('the exclude file of a hub', () => {
+    test('is the one git names for a repository and for a linked worktree', () => {
+        const hub = scratchDir('oculus-exclude-hub-');
+        git(hub, 'init', '-q', '-b', 'main');
+        git(hub, 'config', 'user.email', 'nobody@example.invalid');
+        git(hub, 'config', 'user.name', 'Nobody');
+        git(hub, 'config', 'commit.gpgsign', 'false');
+        put(hub, 'a.txt', 'a\n');
+        git(hub, 'add', '-A');
+        git(hub, 'commit', '-q', '-m', 'First');
+        const linked = join(scratchDir('oculus-exclude-worktree-'), 'linked');
+        git(hub, 'worktree', 'add', '-q', '-b', 'side', linked);
+        expect(readFileSync(join(linked, '.git'), 'utf8')).toContain('gitdir:');
+        for (const dir of [hub, linked]) {
+            const named = resolve(dir, git(dir, 'rev-parse', '--git-path', 'info/exclude').trim());
+            expect(realpathSync(excludeFileOf(dir) ?? '')).toBe(realpathSync(named));
+        }
+    });
+
+    test('is none for a folder that is no repository', () => {
+        const hub = scratchDir('oculus-exclude-plain-');
+        put(hub, 'p/project.yml', 'title: p\n');
+        expect(excludeFileOf(hub)).toBeNull();
+        expect(
+            syncExclude(hub, [{ clone: join(hub, 'p'), manifest: join(hub, 'p/project.yml') }])
+        ).toBe(false);
+        expect(existsSync(join(hub, '.git'))).toBe(false);
+    });
+});
+
+/** A hub that is a repository holding the project `side-projects/p` and the clone made in it. */
+async function hubWithClone(): Promise<string> {
+    const hub = scratchDir('oculus-exclude-world-');
+    git(hub, 'init', '-q', '-b', 'main');
+    git(hub, 'config', 'user.email', 'nobody@example.invalid');
+    git(hub, 'config', 'user.name', 'Nobody');
+    git(hub, 'config', 'commit.gpgsign', 'false');
+    put(
+        hub,
+        'side-projects/p/project.yml',
+        'tier: personal\ntype: active\ntitle: P\nrepository:\n  url: https://example.invalid/p.git\n'
+    );
+    git(hub, 'add', '-A');
+    git(hub, 'commit', '-q', '-m', 'First');
+    const url = remote({ 'a.txt': 'one\n', 'src/b.txt': 'two\n' });
+    const done = await cloneRepository({ dir: join(hub, 'side-projects', 'p'), url, text: TEXT });
+    expect(done.ok).toBe(true);
+    return hub;
+}
+
+/** Read the hub's projects and rewrite the block of its exclude file from them. */
+function read(hub: string): boolean {
+    const { snapshot } = buildPortfolioWithSchemas(hub, CONFIG);
+    return syncExclude(hub, clonedOf(Object.values(snapshot.entities.projects)));
+}
+
+/** The block of the hub's exclude file, the lines between its two markers. */
+function block(hub: string): string[] {
+    const lines = readFileSync(join(hub, '.git', 'info', 'exclude'), 'utf8').split('\n');
+    return lines.slice(lines.indexOf(BLOCK_START) + 1, lines.indexOf(BLOCK_END));
+}
+
+/** What the hub's git lists once everything it does not exclude is staged. */
+function staged(hub: string): string[] {
+    git(hub, 'add', '-A');
+    return git(hub, 'status', '--porcelain')
+        .split('\n')
+        .filter((line) => line !== '');
+}
+
+/** Whether the hub's git ignores a path, by the rules alone. */
+function ignored(hub: string, path: string): boolean {
+    try {
+        git(hub, 'check-ignore', '--no-index', '-q', path);
+        return true;
+    } catch {
+        return false;
+    }
+}
+
+const FIRST = ['/side-projects/p/*', '!/side-projects/p/project.yml'];
+const SECOND = ['/side-projects/q/*', '!/side-projects/q/project.yml'];
+
+describe('the block of a hub after its projects are read', () => {
+    test('hides a clone made in the hub and keeps the project.yml tracked', async () => {
+        const hub = await hubWithClone();
+        expect(read(hub)).toBe(true);
+        expect(block(hub)).toEqual(FIRST);
+        expect(staged(hub)).toEqual([]);
+        expect(read(hub)).toBe(false);
+        expect(existsSync(join(hub, '.gitignore'))).toBe(false);
+    });
+
+    test('moves the lines with a project folder renamed through the Explorer', async () => {
+        const hub = await hubWithClone();
+        read(hub);
+        const answer = await worldOver([{ key: 'hub', dir: hub }], hub).post({
+            op: 'rename',
+            root: 'hub',
+            path: 'side-projects/p',
+            name: 'q'
+        });
+        expect(answer.body).toMatchObject({ ok: true });
+        expect(read(hub)).toBe(true);
+        expect(block(hub)).toEqual(SECOND);
+        expect(ignored(hub, 'side-projects/q/a.txt')).toBe(true);
+        expect(ignored(hub, 'side-projects/q/src/b.txt')).toBe(true);
+        expect(ignored(hub, 'side-projects/q/project.yml')).toBe(false);
+    });
+
+    test('moves the lines with a project folder moved by a shell', async () => {
+        const hub = await hubWithClone();
+        read(hub);
+        renameSync(join(hub, 'side-projects', 'p'), join(hub, 'side-projects', 'q'));
+        expect(read(hub)).toBe(true);
+        expect(block(hub)).toEqual(SECOND);
+        expect(ignored(hub, 'side-projects/q/a.txt')).toBe(true);
+        expect(ignored(hub, 'side-projects/q/src/b.txt')).toBe(true);
+        expect(ignored(hub, 'side-projects/q/project.yml')).toBe(false);
+    });
+
+    test('is written by the build of the portfolio watcher', async () => {
+        const hub = plantHub(await hubWithClone());
+        expect(
+            published([{ name: 'hub', dir: hub }], 'hub').snapshot.entities.projects
+        ).toHaveProperty('p');
+        expect(block(hub)).toEqual(FIRST);
+    });
+
+    test('keeps the lines of the user above and below the block byte for byte', async () => {
+        const hub = await hubWithClone();
+        const file = join(hub, '.git', 'info', 'exclude');
+        const above = '# mine\n*.log\n\n';
+        const below = '\n!keep.log\nno newline at the end';
+        writeFileSync(file, `${above}${BLOCK_START}\n/old/*\n${BLOCK_END}${below}`);
+        expect(read(hub)).toBe(true);
+        expect(readFileSync(file, 'utf8')).toBe(
+            `${above}${BLOCK_START}\n${FIRST.join('\n')}\n${BLOCK_END}${below}\n`
+        );
+        renameSync(join(hub, 'side-projects', 'p'), join(hub, 'side-projects', 'q'));
+        read(hub);
+        expect(readFileSync(file, 'utf8')).toBe(
+            `${above}${BLOCK_START}\n${SECOND.join('\n')}\n${BLOCK_END}${below}\n`
+        );
+    });
+
+    test('loses the lines of a project folder that is removed', async () => {
+        const hub = await hubWithClone();
+        read(hub);
+        rmSync(join(hub, 'side-projects', 'p'), { recursive: true });
