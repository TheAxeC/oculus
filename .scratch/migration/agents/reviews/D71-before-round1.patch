-  - { field: sub,     type: text,     label: "Subtitle" }
-  - { field: status,  type: select,   options: [active, finished, archived], required: true }
-  - { field: meta,    type: metalist }
-  - { field: tags,    type: tags }
-  - { field: url,     type: text,     help: "Repo URL (http)" }
