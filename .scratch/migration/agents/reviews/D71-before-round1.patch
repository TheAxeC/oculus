diff --git a/tools/oculus/tests/state/sources/clone.test.ts b/tools/oculus/tests/state/sources/clone.test.ts
new file mode 100644
index 000000000..6552c2f23
--- /dev/null
+++ b/tools/oculus/tests/state/sources/clone.test.ts
@@ -0,0 +1,152 @@
+// Layer 4, test. The clone store: the request it sends for a project and for a repository of the
+// account, which controls it disables while a clone runs, what it says of a refusal, and that a
+// folder panel the reader cancels sends nothing.
+
+import { describe, expect, it } from 'vitest';
+import { engineDir, loadConfig, textCatalog } from '../../../src/lib/data/sources/config.ts';
+import { setCatalog, t } from '../../../src/lib/state/shared/words/text.ts';
+import { createClone } from '../../../src/lib/state/sources/clone.svelte.ts';
+import type { GithubRepo } from '../../../src/lib/data/model/index.ts';
+import type { Posted, WritesStore } from '../../../src/lib/state/shared/stores/shapes.ts';
+
+setCatalog(textCatalog(loadConfig(engineDir()).config));
+
+type Sent = { path: string; body: Record<string, unknown> };
+
+const REPO: GithubRepo = {
+    name: 'Tool',
+    url: 'https://github.com/me/Tool',
+    visibility: 'PUBLIC',
+    description: 'A tool',
+    homepage: '',
+    topics: ['a'],
+    date: '2024-01-02'
+};
+
+/** A store over a fake endpoint: `answer` makes the reply to each post, `sent` records them. */
+function setup(
+    answer: (path: string, body: Record<string, unknown>) => Promise<Posted> | Posted,
+    deps = { primaryDir: null as string | null, personalFolder: '' }
+) {
+    const sent: Sent[] = [];
+    const said: { message: string; tone?: string }[] = [];
+    const writes = {
+        postCommand: async (path: string, body: unknown) => {
+            const asked = body as Record<string, unknown>;
+            sent.push({ path, body: asked });
+            return answer(path, asked);
+        }
+    } as unknown as WritesStore;
+    const store = createClone(
+        writes,
+        {
+            post: (message, options) => {
+                said.push({
+                    message,
+                    ...(options?.tone === undefined ? {} : { tone: options.tone })
+                });
+                return 0;
+            }
+        },
+        { primaryDir: () => deps.primaryDir, personalFolder: () => deps.personalFolder }
+    );
+    return { store, sent, said };
+}
+
+const ok = (body: Record<string, unknown>): Posted => ({ ok: true, status: 200, body, failed: '' });
+const refused = (error: string): Posted => ({
+    ok: false,
+    status: 400,
+    body: { error },
+    failed: ''
+});
+
+describe('cloning the repository of a project', () => {
+    it('sends the project and says it was cloned', async () => {
+        const { store, sent, said } = setup(() => ok({ ok: true }));
+        expect(await store.cloneProject('p1', 'Tool')).toBe(true);
+        expect(sent).toEqual([{ path: '/api/clone', body: { action: 'clone', id: 'p1' } }]);
+        expect(said).toEqual([{ message: 'Cloned Tool' }]);
+    });
+
+    it("says the server's sentence when it refuses, and is free again", async () => {
+        const { store, said } = setup(() => refused('The remote has no commits.'));
+        expect(await store.cloneProject('p1', 'Tool')).toBe(false);
+        expect(said).toEqual([{ message: 'The remote has no commits.', tone: 'error' }]);
+        expect(store.cloning('p1')).toBe(false);
+    });
+
+    it('holds the project as cloning until the server answers and sends it once', async () => {
+        let release: (posted: Posted) => void = () => undefined;
+        const { store, sent } = setup(() => new Promise<Posted>((done) => (release = done)));
+        const first = store.cloneProject('p1', 'Tool');
+        expect(store.cloning('p1')).toBe(true);
+        expect(store.cloning('p2')).toBe(false);
+        expect(await store.cloneProject('p1', 'Tool')).toBe(false);
+        release(ok({ ok: true }));
+        expect(await first).toBe(true);
+        expect(store.cloning('p1')).toBe(false);
+        expect(sent).toHaveLength(1);
+    });
+});
+
+describe('listing the repositories of the account', () => {
+    it('reads the repositories the server lists', async () => {
+        const { store } = setup(() => ok({ repos: [REPO] }));
+        expect(await store.githubRepos()).toEqual({ ok: true, repos: [REPO] });
+    });
+
+    it('carries the sentence of a listing the server refused', async () => {
+        const { store } = setup(() => refused('Run gh auth login first.'));
+        expect(await store.githubRepos()).toEqual({ ok: false, error: 'Run gh auth login first.' });
+    });
+});
+
+describe('cloning a repository of the account as a project', () => {
+    it('opens the folder panel at the primary hub new-project folder and clones into the pick', async () => {
+        const { store, sent, said } = setup(
+            (path) =>
+                path === '/api/folders/pick' ? ok({ ok: true, paths: ['/work/side'] }) : ok({}),
+            { primaryDir: '/work/hub', personalFolder: 'side-projects' }
+        );
+        expect(await store.cloneRepo(REPO)).toBe(true);
+        expect(sent).toEqual([
+            { path: '/api/folders/pick', body: { single: true, start: '/work/hub/side-projects' } },
+            {
+                path: '/api/clone',
+                body: { action: 'github-clone', repo: REPO, parent: '/work/side' }
+            }
+        ]);
+        expect(said).toEqual([{ message: 'Cloned Tool' }]);
+    });
+
+    it('asks the panel for no start folder when the hub names none', async () => {
+        const { store, sent } = setup(() => ok({ ok: true, paths: [] }));
+        await store.cloneRepo(REPO);
+        expect(sent[0]?.body).toEqual({ single: true });
+    });
+
+    it('says why the folder panel gave no answer and sends nothing', async () => {
+        const { store, sent, said } = setup(() => refused('unsupported'));
+        expect(await store.cloneRepo(REPO)).toBe(false);
+        expect(sent.map((one) => one.path)).toEqual(['/api/folders/pick']);
+        expect(said).toEqual([{ message: t('files.picker_unsupported'), tone: 'error' }]);
+    });
+
+    it('sends nothing when the reader cancels the panel', async () => {
+        const { store, sent, said } = setup(() => ok({ ok: true, paths: [] }));
+        expect(await store.cloneRepo(REPO)).toBe(false);
+        expect(sent.map((one) => one.path)).toEqual(['/api/folders/pick']);
+        expect(said).toEqual([]);
+    });
+
+    it('says the sentence of a refused clone', async () => {
+        const { store, said } = setup((path) =>
+            path === '/api/folders/pick'
+                ? ok({ ok: true, paths: ['/work/side'] })
+                : refused('The folder exists.')
+        );
+        expect(await store.cloneRepo(REPO)).toBe(false);
+        expect(said).toEqual([{ message: 'The folder exists.', tone: 'error' }]);
+    });
+});
diff --git a/tools/oculus/tests/state/workbench/layout/folder-opener.test.ts b/tools/oculus/tests/state/workbench/layout/folder-opener.test.ts
