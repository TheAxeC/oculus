@@ -0,0 +1,155 @@
+// Layer 2, server. Cloning the repository of a project into its clone folder. The folder may exist
+// already and hold files, so the clone is not `git clone` (which needs an empty folder) but its
+// steps one by one:
+//
+//     git -C <dir> init -q
+//     git -C <dir> remote add origin <url>
+//     git -C <dir> ls-remote --symref origin HEAD       (the remote's default branch)
+//     git -C <dir> fetch origin
+//     git -C <dir> ls-tree -r --name-only -z origin/<branch>   (what the repository tracks)
+//     git -C <dir> checkout -t origin/<branch>
+//
+// A repository that tracks a file the folder already holds is refused after the fetch and before
+// the checkout, naming every such file, since the checkout would write over it. Every refusal, and
+// a failed command, leaves the folder as it was found: the `.git` made here is removed, and so is
+// the folder when this call made it.
+//
+// The hub's exclude file is not touched here: the block that hides a clone from the hub's git is
+// rewritten from the manifests by exclude.ts whenever the portfolio is read.
+//
+// A command runs through the `GitRunner` the caller gives, the real git when absent, so a test
+// drives the steps over scratch repositories or a runner of its own. Every operation answers
+// `{ ok, output, error }` and never throws. Nothing here is reachable from a watcher or a timer:
+// the callers are server/git/clone/clone-routes.ts, behind the write token.
+
+import { existsSync, lstatSync, mkdirSync, rmSync, rmdirSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import {
+    realGit,
+    NETWORK_TIMEOUT_MS,
+    TIMEOUT_MS,
+    type GitRunner,
+    type Outcome
+} from '../deposit/deposit-git.ts';
+import { words } from '../../core/words.ts';
+
+/** What the clone of one project needs to know. */
+export type CloneRequest = {
+    /** The folder to clone into: made when missing. */
+    dir: string;
+    /** The address of the remote. */
+    url: string;
+    text: Record<string, string>;
+    git?: GitRunner;
+    signal?: AbortSignal;
+};
+
+function refused(error: string): Outcome {
+    return { ok: false, output: '', error };
+}
+
+/** The branch a remote's HEAD names, from the output of `ls-remote --symref`, or null for none. */
+export function defaultBranchOf(output: string): string | null {
+    for (const line of output.split('\n')) {
+        const found = /^ref: refs\/heads\/(\S+)\s+HEAD$/.exec(line.trim());
+        if (found !== null) return found[1];
+    }
+    return null;
+}
+
+/** The files a folder holds among the paths a repository tracks, as the repository names them. */
+function held(dir: string, tracked: string[]): string[] {
+    return tracked.filter((path) => {
+        try {
+            lstatSync(join(dir, path));
+            return true;
+        } catch {
+            return false;
+        }
+    });
+}
+
+/** The folders of the path `dir` that do not exist yet, the deepest first. */
+function missingFolders(dir: string): string[] {
+    const missing: string[] = [];
+    for (let at = dir; !existsSync(at); at = dirname(at)) missing.push(at);
+    return missing;
+}
+
+/** Take away what the clone made: its `.git`, and the folders it made on the way to it. */
+function undo(dir: string, made: string[]): void {
+    rmSync(join(dir, '.git'), { recursive: true, force: true });
+    for (const folder of made) {
+        try {
+            rmdirSync(folder);
+        } catch {
+            // A folder that holds something else stays.
+        }
+    }
+}
+
+/**
+ * Clone `url` into `dir`, checking out the remote's default branch with a local branch that tracks
+ * it. Refused, with nothing left behind, when the folder already holds a `.git`, when the remote
+ * does not answer, has no branch, or tracks a file the folder holds.
+ */
+export async function cloneRepository(request: CloneRequest): Promise<Outcome> {
+    const { dir, url, text, signal } = request;
+    const git = request.git ?? realGit;
+    const at = (...args: string[]): string[] => ['-C', dir, ...args];
+    if (url.trim() === '') return refused(words(text, 'server.clone.no_url'));
+    if (existsSync(join(dir, '.git')))
+        return refused(words(text, 'server.clone.already_cloned', dir));
+    const made = missingFolders(dir);
+    try {
+        mkdirSync(dir, { recursive: true });
+    } catch {
+        return refused(words(text, 'server.clone.made_by_hand', dir));
+    }
+    const step = async (args: string[], timeout: number): Promise<Outcome | null> => {
+        const done = await git(at(...args), timeout, signal);
+        if (done.ok) return null;
+        undo(dir, made);
+        return done;
+    };
+    let failed = await step(['init', '-q'], TIMEOUT_MS);
+    if (failed !== null) return failed;
+    failed = await step(['remote', 'add', 'origin', url], TIMEOUT_MS);
+    if (failed !== null) return failed;
+    const heads = await git(
+        at('ls-remote', '--symref', 'origin', 'HEAD'),
+        NETWORK_TIMEOUT_MS,
+        signal
+    );
+    if (!heads.ok) {
+        undo(dir, made);
+        return heads;
+    }
+    const branch = defaultBranchOf(heads.output);
+    if (branch === null) {
+        undo(dir, made);
+        return refused(words(text, 'server.clone.empty_remote', url));
+    }
+    failed = await step(['fetch', 'origin'], NETWORK_TIMEOUT_MS);
+    if (failed !== null) return failed;
+    const tree = await git(
+        at('ls-tree', '-r', '--name-only', '-z', `origin/${branch}`),
+        TIMEOUT_MS,
+        signal
+    );
+    if (!tree.ok) {
+        undo(dir, made);
+        return tree;
+    }
+    const clash = held(
+        dir,
+        tree.output.split('\0').filter((one) => one !== '')
+    );
+    if (clash.length > 0) {
+        undo(dir, made);
+        return refused(words(text, 'server.clone.files_held', dir, clash.join(', ')));
+    }
+    failed = await step(['checkout', '-t', `origin/${branch}`], NETWORK_TIMEOUT_MS);
+    if (failed !== null) return failed;
+    return { ok: true, output: branch, error: '' };
+}
diff --git a/tools/oculus/src/lib/server/git/clone/exclude.ts b/tools/oculus/src/lib/server/git/clone/exclude.ts
new file mode 100644
index 000000000..59f26a4a2
--- /dev/null
+++ b/tools/oculus/src/lib/server/git/clone/exclude.ts
@@ -0,0 +1,153 @@
+// Layer 2, server. What the hub's repository is told about the clones of its projects. A project
+// cloned into a folder of the hub would otherwise list every file of the clone as the hub's own, so
+// the hub's exclude file (the file `git rev-parse --git-path info/exclude` names, never the
+// `.gitignore`, so the rule stays on this machine) carries one block that oculus owns:
+//
+//     # oculus: cloned projects, rewritten from the manifests
+//     /side-projects/p/*
+//     !/side-projects/p/project.yml
+//     # oculus: end
+//
+// The block is rewritten from the projects whenever the portfolio is read (`syncExclude`), so a
+// project folder that is moved, renamed or removed gets its lines at the new place and loses the
+// old ones, and a clone made by Clone is hidden by the read it triggers. Every line outside the
+// block is kept byte for byte; a missing block is added at the end of the file.
+//
+// The file is found without running git: the hub's `.git` is a folder, or a file naming the
+// folder of a linked worktree, whose `commondir` holds the `info/` folder. A hub with no `.git` of
+// its own gets no exclude, since there is no git listing to hide a clone from.
+
+import { mkdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
+import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
+import type { Project } from '../../../data/model/index.ts';
+
+/** The line that opens the block oculus owns in the exclude file. */
+export const BLOCK_START = '# oculus: cloned projects, rewritten from the manifests';
+
+/** The line that closes it. */
+export const BLOCK_END = '# oculus: end';
+
+/** A clone folder with the manifest of the project it belongs to, both absolute. */
+export type ClonedProject = { clone: string; manifest: string };
+
+/** A path segment as a gitignore pattern reads it literally: its special characters escaped. */
+export function escapedForIgnore(segment: string): string {
+    const escaped = segment.replace(/[\\*?[\]#!]/g, (one) => `\\${one}`);
+    return escaped.replace(/ +$/, (spaces) => spaces.replace(/ /g, '\\ '));
+}
+
+/** A hub-relative path as the pattern that names that path from the hub's top. */
+function patternOf(path: string): string {
+    return `/${path.split(sep).map(escapedForIgnore).join('/')}`;
+}
+
+/**
+ * The lines the hub's exclude file gets for a clone: everything inside the clone folder, and the
+ * project's manifest with the folders on the way to it when it lies inside the clone, so the
+ * manifest stays the hub's. Null when the clone folder is not inside the hub.
+ */
+export function excludeLines(hub: string, clone: string, manifest: string): string[] | null {
+    const folder = relative(hub, clone);
+    if (folder === '' || folder.startsWith('..') || isAbsolute(folder)) return null;
+    const lines = [`${patternOf(folder)}/*`];
+    const inside = relative(clone, manifest);
+    if (inside !== '' && !inside.startsWith('..') && !isAbsolute(inside)) {
+        const parts = inside.split(sep);
+        for (let at = 1; at <= parts.length; at += 1) {
+            lines.push(`!${patternOf(join(folder, ...parts.slice(0, at)))}`);
+        }
+    }
+    return lines;
+}
+
+/** The text of a file, or the empty text when it is not there. */
+function textOf(file: string): string {
+    try {
+        return readFileSync(file, 'utf8');
+    } catch {
+        return '';
+    }
+}
+
+/**
+ * The exclude file of a hub that is a git repository, or null for a hub that is none. A `.git` that
+ * is a file names the folder of a linked worktree, and the `info/` folder is the common folder's.
+ */
+export function excludeFileOf(hub: string): string | null {
+    const dot = join(hub, '.git');
+    let gitDir = dot;
+    try {
+        const info = statSync(dot);
+        if (info.isFile()) {
+            const named = /^gitdir:\s*(.+)$/m.exec(textOf(dot));
+            if (named === null) return null;
+            gitDir = resolve(hub, named[1].trim());
+        } else if (!info.isDirectory()) {
+            return null;
+        }
+    } catch {
+        return null;
+    }
+    const common = textOf(join(gitDir, 'commondir')).trim();
+    return join(common === '' ? gitDir : resolve(gitDir, common), 'info', 'exclude');
+}
+
+/** The lines of the block for these clones: each clone's lines, clones in path order, no repeat. */
+function blockLines(hub: string, clones: ClonedProject[]): string[] {
+    const lines: string[] = [];
+    const ordered = [...clones].sort((a, b) =>
+        a.clone < b.clone ? -1 : a.clone > b.clone ? 1 : 0
+    );
+    for (const one of ordered) {
+        for (const line of excludeLines(hub, one.clone, one.manifest) ?? []) {
+            if (!lines.includes(line)) lines.push(line);
+        }
+    }
+    return lines;
+}
+
+/**
+ * The text of an exclude file with its block holding `lines`, or null when it holds them already.
+ * A block is the run from its opening line to its closing line; an opening line with no closing
+ * line after it is the block's start alone, so no line of the user's after it is taken for the
+ * block's. A file with no block gets one at its end, unless there is nothing to put in it.
+ */
+export function withBlock(text: string, lines: string[]): string | null {
+    const all = text === '' ? [] : text.replace(/\n$/, '').split('\n');
+    const start = all.indexOf(BLOCK_START);
+    if (start < 0) {
+        if (lines.length === 0) return null;
+        return `${[...all, BLOCK_START, ...lines, BLOCK_END].join('\n')}\n`;
+    }
+    const end = all.indexOf(BLOCK_END, start + 1);
+    const held = end < 0 ? [] : all.slice(start + 1, end);
+    if (end >= 0 && held.length === lines.length && held.every((one, at) => one === lines[at])) {
+        return null;
+    }
+    const tail = end < 0 ? all.slice(start + 1) : all.slice(end + 1);
+    return `${[...all.slice(0, start), BLOCK_START, ...lines, BLOCK_END, ...tail].join('\n')}\n`;
+}
+
+/**
+ * Rewrite the block of a hub's exclude file from the clones of its projects, when the lines it
+ * should hold differ from the lines it holds. Answers whether the file was written.
+ */
+export function syncExclude(hub: string, clones: ClonedProject[]): boolean {
+    const file = excludeFileOf(hub);
+    if (file === null) return false;
+    const next = withBlock(textOf(file), blockLines(hub, clones));
+    if (next === null) return false;
+    mkdirSync(dirname(file), { recursive: true });
+    writeFileSync(file, next);
+    return true;
+}
+
+/** The cloned projects among a hub's projects: a clone folder that holds a `.git`, and the file. */
+export function clonedOf(projects: Project[]): ClonedProject[] {
+    return projects.flatMap((one) => {
+        const site = one.repository;
+        return site?.cloned === true && site.clonePath !== undefined && one.file !== ''
+            ? [{ clone: site.clonePath, manifest: one.file }]
+            : [];
+    });
+}
diff --git a/tools/oculus/src/lib/server/git/clone/github.ts b/tools/oculus/src/lib/server/git/clone/github.ts
new file mode 100644
index 000000000..858196d6c
--- /dev/null
+++ b/tools/oculus/src/lib/server/git/clone/github.ts
@@ -0,0 +1,193 @@
+// Layer 2, server. Cloning a repository of the reader's GitHub account as a new project. The list
+// of the account's repositories is read with the GitHub CLI,
+//
+//     gh repo list --limit 1000 --json name,url,visibility,description,homepageUrl,
+//         repositoryTopics,createdAt
+//
+// and a chosen repository becomes a folder named for it holding a `project.yml`, into which the
+// repository is cloned as clone.ts clones any project. `gh` is run through the `GhRun`
+// the caller gives, so a test never runs the real one; a `gh` that is not installed or not logged
+// in is answered with a sentence naming `gh auth login`, and nothing is written.
+//
+// The folder is named for the repository: lowercase, each character outside `a-z0-9.-` made `-`.
+// Nothing is written when that folder exists, when the name is held by a project or a folder of the
+// workspace, or when the clone fails (the folder made is taken away again).
+
+import { existsSync, mkdirSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { parse, stringify } from 'yaml';
+import { z } from 'zod';
+import { MANIFEST } from '../../../data/helpers/hub-names.ts';
+import type { GithubRepo } from '../../../data/model/index.ts';
+import { rowsShape } from '../../../data/shapes/shapes.ts';
+import { words } from '../../core/words.ts';
+import { cloneRepository } from './clone.ts';
+import {
+    NETWORK_TIMEOUT_MS,
+    type GhRun,
+    type GitRunner,
+    type Outcome
+} from '../deposit/deposit-git.ts';
+
+/** The arguments of the list. */
+const LIST_ARGS = [
+    'repo',
+    'list',
+    '--limit',
+    '1000',
+    '--json',
+    'name,url,visibility,description,homepageUrl,repositoryTopics,createdAt'
+];
+
+/** A topic as `gh` prints it: a name, or an object holding one. */
+const topicShape = z.union([
+    z.string(),
+    z.object({ name: z.string() }).transform((one) => one.name),
+    z.object({ topic: z.object({ name: z.string() }) }).transform((one) => one.topic.name)
+]);
+
+const rowShape = z.object({
+    name: z.string().min(1),
+    url: z.string().default(''),
+    visibility: z.string().default(''),
+    description: z.string().nullish().default(''),
+    homepageUrl: z.string().nullish().default(''),
+    repositoryTopics: z.array(topicShape).nullish().default([]),
+    createdAt: z.string().default('')
+});
+
+/** The list `gh` printed as repositories, or null when it is not the list. */
+function reposOf(output: string): GithubRepo[] | null {
+    let parsed: unknown;
+    try {
+        parsed = JSON.parse(output);
+    } catch {
+        return null;
+    }
+    const rows = rowsShape(rowShape).safeParse(parsed);
+    if (!rows.success || !Array.isArray(parsed) || rows.data.length !== parsed.length) return null;
+    return rows.data.map((row) => ({
+        name: row.name,
+        url: row.url,
+        visibility: row.visibility.toLowerCase(),
+        description: row.description ?? '',
+        homepage: row.homepageUrl ?? '',
+        topics: row.repositoryTopics ?? [],
+        date: row.createdAt.slice(0, 10)
+    }));
+}
+
+/** The repositories of the account, or the sentence that says `gh` cannot list them. */
+export async function listRepos(
+    gh: GhRun,
+    text: Record<string, string>,
+    signal?: AbortSignal
+): Promise<{ ok: true; repos: GithubRepo[] } | { ok: false; error: string }> {
+    const done = await gh(LIST_ARGS, NETWORK_TIMEOUT_MS, signal);
+    if (!done.ok)
+        return { ok: false, error: words(text, 'server.clone.gh_unavailable', done.error) };
+    const repos = reposOf(done.output);
+    if (repos === null) return { ok: false, error: words(text, 'server.clone.gh_unreadable') };
+    return { ok: true, repos };
+}
+
+/** The folder name of a repository: lowercase, each character outside `a-z0-9.-` made `-`. */
+function folderNameOf(name: string): string {
+    return name.toLowerCase().replace(/[^a-z0-9.-]/g, '-');
+}
+
+/**
+ * The `project.yml` of a repository cloned as a new project: a personal project that is being
+ * built, whose `repository:` block holds what the account says of it. Empty fields are left out of
+ * the block. The text is read back before it is returned, and null is answered for a text that does
+ * not read as the manifest it was made from.
+ */
+function projectTextOf(repo: GithubRepo): string | null {
+    const block = {
+        url: repo.url,
+        visibility: repo.visibility,
+        description: repo.description,
+        homepage: repo.homepage,
+        topics: repo.topics,
+        date: repo.date
+    };
+    const present = Object.fromEntries(
+        Object.entries(block).filter(([, value]) => value.length > 0)
+    );
+    const manifest = {
+        title: repo.name,
+        tier: 'personal',
+        type: 'active',
+        status: { chips: ['building'] },
+        eli5: repo.description,
+        next: '',
+        links: [],
+        repository: present
+    };
+    const text = stringify(manifest);
+    try {
+        return JSON.stringify(parse(text)) === JSON.stringify(manifest) ? text : null;
+    } catch {
+        return null;
+    }
+}
+
+/** What the clone of one repository needs from the server around it. */
+export type GithubClone = {
+    repo: GithubRepo;
+    /** The folder the project's folder is made in. */
+    parent: string;
+    /** The names a project or a folder of the workspace holds already. */
+    held: readonly string[];
+    text: Record<string, string>;
+    git?: GitRunner;
+    signal?: AbortSignal;
+};
+
+function refused(error: string): Outcome {
+    return { ok: false, output: '', error };
+}
+
+/**
+ * Make the project folder of a repository and clone it. On success the answer's `output` is the
+ * project's folder. Refused, with nothing written, when the parent is no folder, the name gives no
+ * folder name, the folder exists, or the name is held; a failed clone takes the folder away again.
+ */
+export async function cloneAsProject(request: GithubClone): Promise<Outcome> {
+    const { repo, parent, text } = request;
+    if (parent === '') return refused(words(text, 'server.clone.no_parent'));
+    let folderExists: boolean;
+    try {
+        folderExists = statSync(parent).isDirectory();
+    } catch {
+        folderExists = false;
+    }
+    if (!folderExists) return refused(words(text, 'server.clone.parent_gone', parent));
+    const name = folderNameOf(repo.name);
+    if (name.replace(/[-.]/g, '') === '')
+        return refused(words(text, 'server.clone.not_a_name', repo.name));
+    const dir = join(parent, name);
+    if (existsSync(dir)) return refused(words(text, 'server.clone.folder_held', dir));
+    if (request.held.includes(name)) return refused(words(text, 'server.clone.name_held', name));
+    const manifest = projectTextOf(repo);
+    if (manifest === null) return refused(words(text, 'server.clone.project_unwritten', dir));
+    try {
+        mkdirSync(dir);
+        writeFileSync(join(dir, MANIFEST), manifest);
+    } catch {
+        rmSync(dir, { recursive: true, force: true });
+        return refused(words(text, 'server.clone.project_unwritten', dir));
+    }
+    const done = await cloneRepository({
+        dir,
+        url: repo.url,
+        text,
+        git: request.git,
+        signal: request.signal
+    });
+    if (!done.ok) {
+        rmSync(dir, { recursive: true, force: true });
+        return done;
+    }
+    return { ok: true, output: dir, error: '' };
+}
diff --git a/tools/oculus/src/lib/server/git/deposit/deposit-compare.ts b/tools/oculus/src/lib/server/git/deposit/deposit-compare.ts
new file mode 100644
index 000000000..97e0c6bd8
--- /dev/null
+++ b/tools/oculus/src/lib/server/git/deposit/deposit-compare.ts
@@ -0,0 +1,137 @@
+// Layer 2, server. What the Deposit view shows of a mirror beside the plan: how far the current
+// branch is ahead of and behind `origin/main`, the files its commits differ from `origin/main` in,
+// Fetch, and the two texts of one file for the diff editor. A leaf over `Where`: it finds no
+// project and reads no manifest, so deposit.ts resolves the mirror and calls it.
+//
+// The comparison with `origin/main` is between commits: the files `git diff origin/main HEAD`
+// names, each shown as the text of `origin/main` against the text of `HEAD`. The sync plan's diff
+// of a changed file is the text of `HEAD` against the file the sync left in the mirror. Only a path
+// the caller names as listed is read, so a request cannot reach another file of the mirror.
+//
+// Nothing here moves the mirror's checkout or its current branch: `fetch origin` writes the
+// remote-tracking refs alone, and the rest reads.
+
+import { readFileSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+import { words } from '../../core/words.ts';
+import {
+    MAX_OUTPUT,
+    diffCmd,
+    fetchCmd,
+    logCmd,
+    revParse,
+    showCmd,
+    type Outcome,
+    type Where
+} from './deposit-git.ts';
+
+/** The remote branch the mirror is compared with. */
+const REMOTE_MAIN = 'origin/main';
+
+/** The mirror's branch against `origin/main`. */
+export type MainComparison = {
+    /** Whether `origin/main` and a commit of the mirror both exist to compare. */
+    known: boolean;
+    ahead: number;
+    behind: number;
+    /** The paths the mirror's commits and `origin/main` differ in, sorted. */
+    differ: string[];
+};
+
+/** What a mirror with nothing to compare reads as. */
+export const UNCOMPARED: MainComparison = { known: false, ahead: 0, behind: 0, differ: [] };
+
+/** The two texts of one file, the left side first. */
+type FileTexts = { original: string; modified: string };
+
+/** An answer of the texts, with the texts on success. */
+export type TextsOutcome = Outcome & { texts: FileTexts | null };
+
+function lines(output: string): string[] {
+    return output.split('\n').filter((one) => one !== '');
+}
+
+/** Fetch origin into the mirror's remote-tracking branches. */
+export function fetchOrigin(at: Where, text: Record<string, string>): Promise<Outcome> {
+    return fetchCmd(at, ['origin']).then((fetched) =>
+        fetched.ok
+            ? { ...fetched, output: words(text, 'server.deposit.fetched', 'origin') }
+            : fetched
+    );
+}
+
+/** How far the mirror's branch is ahead of and behind `origin/main`, and the files that differ. */
+export async function compareWithMain(at: Where): Promise<MainComparison> {
+    const there = await revParse(at, ['--verify', '--quiet', REMOTE_MAIN]);
+    if (!there.ok) return UNCOMPARED;
+    const here = await revParse(at, ['--verify', '--quiet', 'HEAD']);
+    if (!here.ok) return UNCOMPARED;
+    const ahead = await logCmd(at, ['--format=%H', `${REMOTE_MAIN}..HEAD`]);
+    const behind = await logCmd(at, ['--format=%H', `HEAD..${REMOTE_MAIN}`]);
+    const named = await diffCmd(at, ['--name-only', '--no-renames', '-z', REMOTE_MAIN, 'HEAD']);
+    if (!ahead.ok || !behind.ok || !named.ok) return UNCOMPARED;
+    return {
+        known: true,
+        ahead: lines(ahead.output).length,
+        behind: lines(behind.output).length,
+        differ: named.output
+            .split('\0')
+            .filter((one) => one !== '')
+            .sort()
+    };
+}
+
+/** The text of a path in a commit, empty when the commit holds no such path. */
+async function committed(at: Where, commit: string, path: string): Promise<string> {
+    const shown = await showCmd(at, [`${commit}:${path}`]);
+    return shown.ok ? shown.output : '';
+}
+
+/** The text of a path in the mirror's checkout, empty when the file is not there. */
+function onDisk(mirror: string, path: string): { text: string; size: number } {
+    const file = join(mirror, path);
+    try {
+        const size = statSync(file).size;
+        return { text: size > MAX_OUTPUT ? '' : readFileSync(file, 'utf8'), size };
+    } catch {
+        return { text: '', size: 0 };
+    }
+}
+
+/**
+ * The two texts of `path` for the diff editor, in the comparison `against` names. A path the
+ * comparison does not list is refused, as is a file past what one command may answer.
+ */
+export async function textsOf(
+    at: Where,
+    against: string,
+    path: string,
+    planned: { path: string }[],
+    text: Record<string, string>
+): Promise<TextsOutcome> {
+    const refused = (error: string): TextsOutcome => ({
+        ok: false,
+        output: '',
+        error,
+        texts: null
+    });
+    if (against !== 'plan' && against !== 'main') {
+        return refused(words(text, 'server.deposit.diff_unknown_side', against));
+    }
+    const listed =
+        against === 'main' ? (await compareWithMain(at)).differ : planned.map((one) => one.path);
+    if (!listed.includes(path)) {
+        return refused(words(text, 'server.deposit.diff_not_listed', path));
+    }
+    if (against === 'main') {
+        const original = await committed(at, REMOTE_MAIN, path);
+        const modified = await committed(at, 'HEAD', path);
