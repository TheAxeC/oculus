+// Layer 2, route tests. What /api/clone does (lib/server/git/clone/clone-routes.ts, which the route
+// joins to the token and the server): cloning the repository of a project into its clone folder,
+// listing the repositories of a GitHub account and cloning one of them as a new project. Git runs
+// for real over scratch repositories and a bare repository stands in for the remote; `gh` is the
+// test's own runner, so nothing reaches GitHub and nothing is written outside the system temporary
+// directory.
+
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect } from 'vitest';
+import { parse } from 'yaml';
+import { engineDir, loadConfig, textCatalog } from '../../../src/lib/data/sources/config.ts';
+import { mintToken } from '../../../src/lib/server/core/auth.ts';
+import { handleClone, type CloneOptions } from '../../../src/lib/server/git/clone/clone-routes.ts';
+import type { GhRun } from '../../../src/lib/server/git/deposit/deposit-git.ts';
+import { it, scratchDir } from '../../fixtures/scratch.ts';
+import { git, isolateGit, put } from '../../server/git/refs/repo.ts';
+
+isolateGit();
+
+const TOKEN = mintToken();
+const TEXT = textCatalog(loadConfig(engineDir()).config);
+const HOST = '127.0.0.1:8791';
+
+/** A bare repository on `main` holding these files in one commit. */
+function remote(files: Record<string, string>): string {
+    const work = scratchDir('oculus-clone-route-work-');
+    git(work, 'init', '-q', '-b', 'main');
+    git(work, 'config', 'user.email', 'nobody@example.invalid');
+    git(work, 'config', 'user.name', 'Nobody');
+    git(work, 'config', 'commit.gpgsign', 'false');
+    for (const [path, body] of Object.entries(files)) put(work, path, body);
+    git(work, 'add', '-A');
+    git(work, 'commit', '-q', '-m', 'First');
+    const bare = scratchDir('oculus-clone-route-bare-');
+    git(bare, 'clone', '-q', '--bare', work, '.');
+    return bare;
+}
+
+/** The hub of the cases: a repository holding a scan folder `side-projects`. */
+function hub(): { dir: string; scan: string } {
+    const dir = scratchDir('oculus-clone-route-hub-');
+    git(dir, 'init', '-q', '-b', 'main');
+    const scan = join(dir, 'side-projects');
+    put(dir, 'side-projects/.keep', '');
+    return { dir, scan };
+}
+
+type Seen = { rescans: number; added: string[] };
+
+/** The options of a case: one hub, one project, and the doubles of `gh` and the workspace. */
+function optionsFor(
+    world: { dir: string; scan: string },
+    over: Partial<CloneOptions> = {},
+    seen: Seen = { rescans: 0, added: [] }
+): CloneOptions {
+    return {
+        text: TEXT,
+        project: () => null,
+        scanDirs: () => [world.scan],
+        held: () => ['taken'],
+        addFolder: (dir) => {
+            seen.added.push(dir);
+            return null;
+        },
+        rescan: () => {
+            seen.rescans += 1;
+        },
+        ...over
+    };
+}
+
+/** A same-origin POST carrying the token. */
+async function post(options: CloneOptions, body: unknown) {
+    const response = await handleClone(
+        new Request(`http://${HOST}/api/clone`, {
+            method: 'POST',
+            headers: {
+                host: HOST,
+                origin: `http://${HOST}`,
+                'sec-fetch-site': 'same-origin',
+                'content-type': 'application/json',
+                'x-oculus-token': TOKEN
+            },
+            body: JSON.stringify(body)
+        }),
+        TOKEN,
+        options
+    );
+    return { status: response.status, body: (await response.json()) as Record<string, unknown> };
+}
+
+const REPO = {
+    name: 'My_Repo.Name x',
+    url: '',
+    visibility: 'public',
+    description: 'A thing: with "quotes"',
+    homepage: 'https://example.invalid/home',
+    topics: ['a', 'b'],
+    date: '2024-03-05'
+};
+
+/** A `gh` that prints this and exits with this code. */
+const printing =
+    (output: string, ok = true, error = ''): GhRun =>
+    () =>
+        Promise.resolve({ ok, output, error });
+
+describe('cloning the repository of a project', () => {
+    it('clones into the clone folder, writes no ignore file and reads the portfolio again', async () => {
+        const world = hub();
+        const clone = join(world.scan, 'p');
+        const manifest = join(clone, 'project.yml');
+        put(world.scan, 'p/project.yml', 'title: p\n');
+        const seen: Seen = { rescans: 0, added: [] };
+        const options = optionsFor(
+            world,
+            {
+                project: () => ({
+                    file: manifest,
+                    repository: {
+                        url: remote({ 'a.txt': 'one\n' }),
+                        clonePath: clone,
+                        cloned: false
+                    }
+                })
+            },
+            seen
+        );
+        const answer = await post(options, { action: 'clone', id: 'p' });
+        expect(answer).toMatchObject({ status: 200, body: { ok: true, output: 'main' } });
+        expect(existsSync(join(clone, '.git'))).toBe(true);
+        expect(seen.rescans).toBe(1);
+        expect(existsSync(join(world.dir, '.gitignore'))).toBe(false);
+    });
+
+    const REFUSED = [
+        {
+            name: 'a project the portfolio does not hold',
+            project: () => null,
+            status: 404,
+            says: 'not in the portfolio'
+        },
+        {
+            name: 'a project with no repository url',
+            project: () => ({ file: '/x/project.yml', repository: { cloned: false } }),
+            status: 400,
+            says: 'no repository url'
+        },
+        {
+            name: 'a project whose clone folder leaves the folder it belongs to',
+            project: () => ({
+                file: '/x/project.yml',
+                repository: { url: 'https://example.invalid/r.git', cloned: false }
+            }),
+            status: 400,
+            says: 'leaves the folder'
+        }
+    ];
+
+    it.each(REFUSED)('refuses $name and writes nothing', async (row) => {
+        const world = hub();
+        const seen: Seen = { rescans: 0, added: [] };
+        const answer = await post(optionsFor(world, { project: row.project }, seen), {
+            action: 'clone',
+            id: 'p'
+        });
+        expect(answer.status).toBe(row.status);
+        expect(String(answer.body.error)).toContain(row.says);
+        expect(seen.rescans).toBe(0);
+        expect(readdirSync(world.scan)).toEqual(['.keep']);
+    });
+
+    it('refuses a project already cloned', async () => {
+        const world = hub();
+        const clone = join(world.scan, 'p');
+        const options = optionsFor(world, {
+            project: () => ({
+                file: join(clone, 'project.yml'),
+                repository: { url: remote({ 'a.txt': 'one\n' }), clonePath: clone, cloned: false }
+            })
+        });
+        await post(options, { action: 'clone', id: 'p' });
+        const again = await post(options, { action: 'clone', id: 'p' });
+        expect(again.status).toBe(400);
+        expect(String(again.body.error)).toContain('already holds a repository');
+    });
+
+    it('refuses an address that does not answer with the sentence git gave and leaves the folder', async () => {
+        const world = hub();
+        const clone = join(world.scan, 'p');
+        const options = optionsFor(world, {
+            project: () => ({
+                file: join(clone, 'project.yml'),
+                repository: {
+                    url: join(world.dir, 'no-such-remote'),
+                    clonePath: clone,
+                    cloned: false
+                }
+            })
+        });
+        const answer = await post(options, { action: 'clone', id: 'p' });
+        expect(answer.status).toBe(400);
+        expect(String(answer.body.error)).toMatch(/repository/i);
+        expect(existsSync(clone)).toBe(false);
+    });
+});
+
+describe('the repositories of the account', () => {
+    it('lists them as the manifest block holds them', async () => {
+        const world = hub();
+        const listing = JSON.stringify([
+            {
+                name: 'one',
+                url: 'https://github.com/me/one',
+                visibility: 'PUBLIC',
+                description: 'First',
+                homepageUrl: 'https://one.example.invalid',
+                repositoryTopics: [{ name: 'python' }],
+                createdAt: '2023-01-02T03:04:05Z'
+            },
+            {
+                name: 'two',
+                url: 'https://github.com/me/two',
+                visibility: 'PRIVATE',
+                description: null,
+                homepageUrl: '',
+                repositoryTopics: null,
+                createdAt: '2024-05-06T00:00:00Z'
+            }
