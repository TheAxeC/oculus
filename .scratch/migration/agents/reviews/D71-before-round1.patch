+                url: 'https://github.com/me/two',
+                visibility: 'private',
+                description: '',
+                homepage: '',
+                topics: [],
+                date: '2024-05-06'
+            }
+        ]);
+    });
+
+    it.each([
+        { name: 'gh is not installed', run: printing('', false, 'spawn gh ENOENT') },
