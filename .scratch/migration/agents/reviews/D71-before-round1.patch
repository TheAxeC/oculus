+// Layer 2, server. Keeping `clone_dir` on the same folder when a project folder moves. A manifest's
+// `repository.clone_dir` is written relative to the folder of the project, so when the Explorer
+// moves or renames a folder holding a project whose `clone_dir` leaves that folder (`../../site`),
+// the same text from the new place names another folder. The move rewrites `clone_dir` so that it
+// names the same clone from the new place.
+//
+// It is two steps around the move, because the history copy that lets Undo write the old text
+// back must be taken while the manifest is still at its old path:
+//
+//     const planned = planFollow(from, to, history);   // copies the manifests, builds the new text
+//     await rename(from, to);
+//     const followed = applyFollow(planned, from, to);  // writes the new text at the new place
+//
+// A `clone_dir` that stays inside the moved folder (`.`, `clone`) is right from anywhere and is not
+// touched. Every project folder at or below the moved folder is followed, the walk stopping at a
+// folder holding a manifest, as the scan does. A move outside oculus leaves `clone_dir` as written.
+
+import { readFileSync, readdirSync } from 'node:fs';
+import { join, relative, resolve, sep } from 'node:path';
+import { isScalar, parse, parseDocument } from 'yaml';
+import type { FileStamp } from '../../../data/file-ops.ts';
+import { isMap } from '../../../data/helpers/guards.ts';
+import { entersFolder } from '../../../data/helpers/hub-names.ts';
+import { renderScalar } from '../../../data/helpers/files/yaml/collection-text.ts';
+import { CLONE_DIR, projectFileIn } from '../../../data/sources/manifests.ts';
+import { writeTextAtomic } from '../../core/json.ts';
+import { inside } from '../../core/paths.ts';
+import { stampOf } from '../fs/file-changes.ts';
+import { forgetCopy, keepCopy } from '../fs/history.ts';
+
+/** How many folders the walk for projects below a moved folder visits. */
+const WALK_LIMIT = 5000;
+
+/** One manifest to rewrite: where it is now, where it will be, and its text from the new place. */
+export type Pending = {
+    /** The manifest's path before the move, which the history copy is kept under. */
+    file: string;
+    /** The manifest's path from the moved folder. */
+    rel: string;
+    /** The manifest as it will be, with `clone_dir` naming the same folder. */
+    text: string;
+    /** The stamp of the manifest before the move, naming the copy that was kept. */
+    kept: FileStamp;
+};
+
+/** What a rewrite changed: the stamps before, naming the kept copies, and after. */
+export type Followed = { before: FileStamp[]; after: FileStamp[] };
+
+/** The folders at or below `dir` that hold a manifest; a manifest's folder is not entered. */
+function projectFolders(dir: string, seen: { count: number }): string[] {
+    if (projectFileIn(dir) !== null) return [dir];
+    if (seen.count >= WALK_LIMIT) return [];
+    seen.count += 1;
+    let names: string[];
+    try {
+        names = readdirSync(dir, { withFileTypes: true })
+            .filter((one) => one.isDirectory() && entersFolder(one.name))
+            .map((one) => one.name)
+            .sort();
+    } catch {
+        return [];
+    }
+    return names.flatMap((name) => projectFolders(join(dir, name), seen));
+}
+
+/** The `clone_dir` a manifest's text writes, or the empty text when it writes none. */
+function writtenIn(text: string): string {
+    try {
+        const data: unknown = parse(text);
+        const block = isMap(data) ? data.repository : undefined;
+        const written = isMap(block) ? block[CLONE_DIR] : undefined;
+        return typeof written === 'string' ? written : '';
+    } catch {
+        return '';
+    }
+}
+
+/**
+ * The manifest's text with its `repository.clone_dir` scalar replaced by `value`, in the quoting it
+ * had, and nothing else changed; null when the text has no such scalar or the result does not read
+ * as the same data with only that value changed.
+ */
+function withCloneDir(text: string, value: string): string | null {
+    const document = parseDocument(text);
+    const node = document.getIn(['repository', CLONE_DIR], true);
+    if (document.errors.length > 0 || !isScalar(node) || node.range == null) return null;
+    const [from, to] = node.range;
+    const next = `${text.slice(0, from)}${renderScalar(value, node.type)}${text.slice(to)}`;
+    const was: unknown = parse(text);
+    const now: unknown = parse(next);
+    const expected = structuredClone(was) as { repository: Record<string, unknown> };
+    expected.repository[CLONE_DIR] = value;
+    return JSON.stringify(now) === JSON.stringify(expected) ? next : null;
+}
+
+/** A relative path written with `/`, `.` for the folder itself. */
+function written(from: string, to: string): string {
+    const path = relative(from, to).split(sep).join('/');
+    return path === '' ? '.' : path;
+}
+
+/**
+ * The manifests below `from` whose `clone_dir` leaves their folder, each with its text as it must
+ * be once the folder is at `to`, and a copy of the manifest kept in the history for the Undo. A
+ * manifest whose copy cannot be kept is left as it is: its move could not be taken back whole.
+ */
+export function planFollow(from: string, to: string, history: string | undefined): Pending[] {
+    if (history === undefined) return [];
+    const pending: Pending[] = [];
+    for (const folder of projectFolders(from, { count: 0 })) {
+        const manifest = projectFileIn(folder);
+        if (manifest === null) continue;
+        let text: string;
+        try {
+            text = readFileSync(manifest.file, 'utf8');
+        } catch {
+            continue;
+        }
+        const was = writtenIn(text);
+        if (was === '') continue;
+        const target = resolve(folder, was);
+        if (inside(target, from)) continue;
+        const home = join(to, relative(from, folder));
+        const now = written(home, target);
+        if (now === was) continue;
+        const next = withCloneDir(text, now);
+        if (next === null) continue;
+        const stamp = stampOf(manifest.file);
+        const copy = keepCopy(history, manifest.file, 'replace');
+        const id = copy.ok ? copy.kept?.id : undefined;
+        if (stamp === null || id === undefined) continue;
+        pending.push({
+            file: manifest.file,
+            rel: relative(from, manifest.file),
+            text: next,
+            kept: { ...stamp, kept: id }
+        });
+    }
+    return pending;
+}
+
+/** Take back the copies `planFollow` kept, for a move that did not happen. */
+export function dropFollow(pending: Pending[], history: string | undefined): void {
+    if (history === undefined) return;
+    for (const one of pending) {
+        if (one.kept.kept !== undefined) forgetCopy(history, one.file, one.kept.kept);
+    }
+}
+
+/** Write the new text of each pending manifest at its place in the moved folder. */
+export function applyFollow(pending: Pending[], to: string): Followed {
+    const followed: Followed = { before: [], after: [] };
+    for (const one of pending) {
+        const file = join(to, one.rel);
+        try {
+            writeTextAtomic(file, one.text);
+        } catch {
+            continue;
+        }
+        const now = stampOf(file);
+        if (now === null) continue;
+        followed.before.push(one.kept);
+        followed.after.push(now);
+    }
+    return followed;
+}
