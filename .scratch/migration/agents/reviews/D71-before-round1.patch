diff --git a/tools/oculus/src/lib/state/sources/clone.svelte.ts b/tools/oculus/src/lib/state/sources/clone.svelte.ts
new file mode 100644
index 000000000..f4e298476
--- /dev/null
+++ b/tools/oculus/src/lib/state/sources/clone.svelte.ts
@@ -0,0 +1,122 @@
+// Layer 2, client state. Cloning a repository: the repository of a project into its clone folder,
+// and a repository of the reader's GitHub account as a new project. The server does the work
+// (POST /api/clone); this store sends it, holds which projects are being cloned so a control
+// disables itself, and says the outcome to the reader.
+//
+// A repository of the account is cloned into a folder the reader picks with the system's folder
+// panel, which opens at the primary hub's folder for new personal projects when that folder is
+// there. A panel the reader cancels sends nothing.
+
+import { z } from 'zod';
+import type { GithubListing, GithubRepo } from '../../data/model/index.ts';
+import { readAs } from '../../data/shapes/shapes.ts';
+import { t } from '../shared/words/text.ts';
+import type { NoticeSink, WritesStore } from '../shared/stores/shapes.ts';
+import { pickedOf, pickerLine } from './explorer/acts/folders.ts';
+
+/** The route the server clones through. */
+const CLONE_PATH = '/api/clone';
+
+/** The route of the system's folder panel. */
+const PICK_PATH = '/api/folders/pick';
+
+const repoShape = z.object({
+    name: z.string(),
+    url: z.string(),
+    visibility: z.string().catch(''),
+    description: z.string().catch(''),
+    homepage: z.string().catch(''),
+    topics: z.array(z.string()).catch([]),
+    date: z.string().catch('')
+});
+
+const listedShape = z.object({ repos: z.array(repoShape) });
+const errorShape = z.object({ error: z.string() });
+
+export type CloneStore = {
+    /** Whether the project is being cloned now. */
+    cloning: (id: string) => boolean;
+    /** Clone the repository of a project into its clone folder; false when it was refused. */
+    cloneProject: (id: string, title: string) => Promise<boolean>;
+    /** The repositories of the reader's GitHub account. */
+    githubRepos: () => Promise<GithubListing>;
+    /**
+     * Ask for the folder to put a repository's project in, then clone it as a new project there.
+     * A panel the reader cancels does nothing; a refusal is said to the reader. True when cloned.
+     */
+    cloneRepo: (repo: GithubRepo) => Promise<boolean>;
+};
+
+/** What the store reads of the rest of the client. */
+export type CloneDeps = {
+    /** The primary hub's folder, or null with none. */
+    primaryDir: () => string | null;
+    /** The hub-relative folder new personal projects are made in, empty when there is none. */
+    personalFolder: () => string;
+};
+
+export function createClone(
+    writes: WritesStore,
+    notices: Pick<NoticeSink, 'post'>,
+    deps: CloneDeps
+): CloneStore {
+    let running = $state<string[]>([]);
+
+    /** The sentence a failed post says: the server's own, else the transport's. */
+    function refusal(body: Record<string, unknown>, failed: string): string {
+        return readAs(errorShape, body)?.error ?? (failed === '' ? t('app.clone.failed') : failed);
+    }
+
+    async function cloneProject(id: string, title: string): Promise<boolean> {
+        if (running.includes(id)) return false;
+        running = [...running, id];
+        try {
+            const posted = await writes.postCommand(CLONE_PATH, { action: 'clone', id });
+            if (!posted.ok) {
+                notices.post(refusal(posted.body, posted.failed), { tone: 'error' });
+                return false;
+            }
+            notices.post(t('app.clone.done', title));
+            return true;
+        } finally {
+            running = running.filter((one) => one !== id);
+        }
+    }
+
+    async function githubRepos(): Promise<GithubListing> {
+        const posted = await writes.postCommand(CLONE_PATH, { action: 'github-repos' });
+        const listed = posted.ok ? readAs(listedShape, posted.body) : null;
+        if (listed === null) return { ok: false, error: refusal(posted.body, posted.failed) };
+        return { ok: true, repos: listed.repos };
+    }
+
+    async function cloneRepo(repo: GithubRepo): Promise<boolean> {
+        const root = deps.primaryDir();
+        const folder = deps.personalFolder();
+        const start = root === null || folder === '' ? undefined : `${root}/${folder}`;
+        const panel = await writes.postCommand(PICK_PATH, {
+            single: true,
+            ...(start === undefined ? {} : { start })
+        });
+        const picked = pickedOf(panel.body, panel.failed);
+        if (!picked.ok) {
+            notices.post(pickerLine(picked.error), { tone: 'error' });
+            return false;
+        }
+        const parent = picked.paths.at(0);
+        if (parent === undefined) return false;
+        const posted = await writes.postCommand(CLONE_PATH, {
+            action: 'github-clone',
+            repo,
+            parent
+        });
+        if (!posted.ok) {
+            notices.post(refusal(posted.body, posted.failed), { tone: 'error' });
+            return false;
+        }
+        notices.post(t('app.clone.done', repo.name));
+        return true;
+    }
+
+    return { cloning: (id) => running.includes(id), cloneProject, githubRepos, cloneRepo };
+}
