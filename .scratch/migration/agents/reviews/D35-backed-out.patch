+    /** Run a case over a started context, closed and its stderr spy restored after it. */
+    async function inRun(
+        body: (run: ReturnType<typeof started>) => void | Promise<void>,
+        hpcHost?: string
+    ): Promise<void> {
+        const run = started(hpcHost);
