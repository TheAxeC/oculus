+            ? t('app.palette.choices_loading')
+            : mode === 'interpreter'
+              ? t('app.palette.interpreter_none')
+              : mode === 'config'
+                ? t('app.palette.config_none')
+                : t('app.palette.database_none')}
+    </p>
+{/if}
+
