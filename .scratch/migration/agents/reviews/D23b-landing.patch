+        detail={askedDetail}
+        confirm={asking.pick?.kind === 'config'
+            ? t('app.palette.config_yes')
+            : t('app.palette.approve_yes')}
+        cancel={t('ui.confirm_cancel')}
+        onconfirm={() => {
+            const row = asking;
+            asking = null;
+            if (row !== null) void press(row, true);
+        }}
+        oncancel={() => (asking = null)}
