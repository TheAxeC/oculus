+    };
+    const walk = (item: unknown): unknown => {
+        if (Array.isArray(item)) return item.map(walk).filter((one) => one !== DROP);
+        if (!isRecord(item)) return item;
+        const copy: Record<string, unknown> = {};
+        for (const [key, inner] of Object.entries(item)) {
