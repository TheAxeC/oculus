+        id: `${parent?.id ?? ''}/${index}`,
+        parent: parent?.id ?? null,
+        name: item.name,
+        detail: typeof item.detail === 'string' ? item.detail : '',
+        ...(library === null
+            ? { root: place?.root ?? '', path: place?.path ?? '' }
+            : { root: '', path: library.library, library: library.name }),
