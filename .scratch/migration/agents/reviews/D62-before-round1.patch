@@ -0,0 +1,69 @@
+// Layer 2, server. Whether an app's host may run, as a function of the apps the server holds, and
+// which apps' `depends` lists form a cycle.
+//
+// A host may run while its app names a host, is enabled, has files whose current hash the approvals
+// file holds (an app kept approved while it is edited is approved but its changed files are not,
+// so its host waits for an approval of them), takes part in no cycle of `depends`, and every app
+// it depends on may run itself. A dependency is a machine app by name; one that is absent, refused,
+// disabled, unapproved, without a host or itself unable to run leaves the depending host waiting,
+// and the verdict names it. A verdict is read again at every change of the apps, so it never
+// outlives the state it judged.
+
+import { appViewId } from '../../../../data/helpers/files/apps.ts';
+import { appById, type AppsHeld, type HeldApp } from '../read/held.ts';
+
+/** Why a host may not run. */
+export type Verdict =
+    | { ok: true }
+    | { ok: false; cause: 'nohost' }
+    | { ok: false; cause: 'disabled' }
+    | { ok: false; cause: 'approval' }
+    | { ok: false; cause: 'cycle' }
+    | {
+          ok: false;
+          cause: 'dependency';
+          /** The name of the dependency that lacks. */
+          dependency: string;
+          /** Whether the dependency lacks because its files are not approved. */
+          approval: boolean;
+      };
+
+/** The view ids of the apps that take part in a cycle of `depends`. */
+export function cyclesOf(held: AppsHeld): Set<string> {
+    const inCycle = new Set<string>();
+    const named = (app: HeldApp): HeldApp[] =>
+        app.row.depends
+            .map((name) => appById(held, appViewId('', name)))
+            .filter((one): one is HeldApp => one !== undefined);
+    const visit = (app: HeldApp, path: HeldApp[]): void => {
+        const at = path.indexOf(app);
+        if (at >= 0) {
+            for (const member of path.slice(at)) inCycle.add(member.id);
+            return;
+        }
+        if (path.length > held.apps.length) return;
+        for (const next of named(app)) visit(next, [...path, app]);
+    };
+    for (const app of held.apps) visit(app, []);
+    return inCycle;
+}
+
+/** The verdict on one app's host. */
+export function judge(held: AppsHeld, app: HeldApp, cycles: ReadonlySet<string>): Verdict {
+    if (app.row.host === '') return { ok: false, cause: 'nohost' };
+    if (app.row.disabled) return { ok: false, cause: 'disabled' };
+    if (!app.row.hashApproved) return { ok: false, cause: 'approval' };
+    if (cycles.has(app.id)) return { ok: false, cause: 'cycle' };
+    for (const name of app.row.depends) {
+        const dependency = appById(held, appViewId('', name));
+        if (dependency === undefined || !judge(held, dependency, cycles).ok) {
+            const approval =
+                dependency !== undefined &&
+                !dependency.row.disabled &&
+                dependency.row.host !== '' &&
+                !dependency.row.hashApproved;
+            return { ok: false, cause: 'dependency', dependency: name, approval };
+        }
+    }
+    return { ok: true };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/process.ts b/tools/oculus/src/lib/server/machine/apps/host/process.ts
new file mode 100644
index 000000000..060d84106
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/process.ts
@@ -0,0 +1,195 @@
+// Layer 2, server. One host process: the runner started under oculus's own node, its connection and
+// the sequence that stops it.
+//
+// The program is `process.execPath` with `ELECTRON_RUN_AS_NODE=1` added to oculus's own
+// environment, started with an argument array and never a shell (a path holding spaces or `$(x)`
+// reaches the runner as one argument), in the app's real folder. Its standard error is the host's
+// output, kept by the caller's `HostOutput`; its standard input and output are the connection.
+//
+// `ready` settles when the host's `activate` answered, and rejects when the host failed to load or
+// ended first. `stop` asks the host to `deactivate`, gives it `stopSeconds` to settle, then sends
+// SIGTERM, and SIGKILL `KILL_AFTER_MS` later; it resolves once the process has ended, and the same
+// promise answers a second call. The runner ends itself after `deactivate` answers, and ends when
+// its standard input closes, so a server that is killed leaves no host running.
+
+import { spawn as nodeSpawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
+import type { Clock, Timer } from '../../../core/file-poll.ts';
+import type { ActivationEvent } from '../read/activation.ts';
+import {
+    connectHost,
+    Refused,
+    type HostCall,
+    type HostHandler,
+    type HostLink
+} from './connection.ts';
+import type { HostOutput } from './output.ts';
+
+/** Milliseconds between SIGTERM and SIGKILL. */
+const KILL_AFTER_MS = 2000;
+
+/** Milliseconds a process that has exited is waited for to close its streams. */
+const CLOSE_GRACE_MS = 1000;
+
+/** How a host ended: its exit code, or the signal that ended it. */
+export type HostEnd = { code: number | null; signal: string };
+
+/** What a host process is started with. */
+export type HostProcessOptions = {
+    /** The program, its argument array and the folder it runs in. */
+    command: string;
+    args: string[];
+    cwd: string;
+    env: NodeJS.ProcessEnv;
+    /** The recorded files of the app as real paths: the only files the host may load. */
+    files: string[];
+    /** The sentences the runner writes to the host's output. */
+    texts: Record<string, string>;
+    event: ActivationEvent;
+    output: HostOutput;
+    /** The handlers of the requests a host makes of oculus. */
+    handlers: Record<string, HostHandler>;
+    stopSeconds: () => number;
+    clock: Clock;
+    spawn?: typeof nodeSpawn;
+    /** The output or the state moved: the rows are published again. */
+    changed: () => void;
+    /** The line that says the host broke its message stream, written to its output. */
+    streamBroken: (reason: string) => string;
+    /** Called once, when the process has ended. */
+    ended: (end: HostEnd) => void;
+};
+
+/** One host process. */
+export class HostProcess {
+    readonly pid: number;
+    readonly started: string;
+    /** Settles when `activate` answered; rejects when the host failed to load or ended first. */
+    readonly ready: Promise<void>;
+    #options: HostProcessOptions;
+    #child: ChildProcessWithoutNullStreams;
+    #link: HostLink;
+    #exited: Promise<HostEnd>;
+    #stopping: Promise<HostEnd> | null = null;
+    #over = false;
+    #kill: Timer | null = null;
+
+    constructor(options: HostProcessOptions) {
+        this.#options = options;
+        const spawn = options.spawn ?? nodeSpawn;
+        const child = spawn(options.command, options.args, {
+            cwd: options.cwd,
+            env: { ...options.env, ELECTRON_RUN_AS_NODE: '1' },
+            stdio: ['pipe', 'pipe', 'pipe']
+        });
+        this.#child = child;
+        this.pid = child.pid ?? 0;
+        this.started = new Date().toISOString();
+        child.stdin.on('error', () => undefined);
+        child.stderr.setEncoding('utf8');
+        child.stderr.on('data', (chunk: string) => {
+            options.output.write(chunk);
+            options.changed();
+        });
+        this.#link = connectHost({
+            input: child.stdout,
+            output: child.stdin,
+            handlers: options.handlers,
+            broken: (reason) => {
+                options.output.note(options.streamBroken(reason));
+                void this.stop();
+            }
+        });
+        this.#exited = new Promise((settle) => {
+            let ended = false;
+            let waiting: Timer | null = null;
+            const finish = (code: number | null, signal: string): void => {
+                if (ended) return;
+                ended = true;
+                if (waiting !== null) options.clock.clearTimeout(waiting);
+                this.#over = true;
+                if (this.#kill !== null) options.clock.clearTimeout(this.#kill);
+                this.#link.dispose();
+                const end = { code, signal };
+                options.ended(end);
+                settle(end);
+            };
+            child.on('error', (error) => {
+                options.output.note(error.message);
+                finish(null, '');
+            });
+            child.on('exit', (code, signal) => {
+                waiting = options.clock.setTimeout(
+                    () => finish(code, signal ?? ''),
+                    CLOSE_GRACE_MS
+                );
+            });
+            child.on('close', (code, signal) => finish(code, signal ?? ''));
+        });
+        this.ready = this.#activate();
+        this.ready.catch(() => undefined);
+    }
+
+    /** Send the first activation; rejects with the host's refusal or when the host ended. */
+    async #activate(): Promise<void> {
+        const options = this.#options;
+        const lost = this.#exited.then(() => {
+            throw new Refused('host_down');
+        });
+        await Promise.race([
+            this.#link.request('oculus/activate', {
+                event: options.event,
+                files: options.files,
+                texts: options.texts
+            }),
+            lost
+        ]);
+    }
+
+    /** Whether the process has ended. */
+    get over(): boolean {
+        return this.#over;
+    }
+
+    /** The promise of the end of the process. */
+    get exited(): Promise<HostEnd> {
+        return this.#exited;
+    }
+
+    /** A request to the host; rejects `host_down` once the process has ended. */
+    request(method: string, params: unknown, call?: HostCall): Promise<unknown> {
+        if (this.#over) return Promise.reject(new Refused('host_down'));
+        return Promise.race([
+            this.#link.request(method, params, call),
+            this.#exited.then((): never => {
+                throw new Refused('host_down');
+            })
+        ]);
+    }
+
+    notify(method: string, params: unknown): void {
+        if (!this.#over) this.#link.notify(method, params);
+    }
+
+    /** Stop the process by deactivate, SIGTERM, SIGKILL; resolves when the process has ended. */
+    stop(): Promise<HostEnd> {
+        if (this.#stopping !== null) return this.#stopping;
+        const { clock } = this.#options;
+        const term = clock.setTimeout(() => {
+            this.#child.kill('SIGTERM');
+            this.#kill = clock.setTimeout(() => this.#child.kill('SIGKILL'), KILL_AFTER_MS);
+        }, this.#options.stopSeconds() * 1000);
+        this.#stopping = (async () => {
+            if (!this.#over) {
+                await Promise.race([
+                    this.#link.request('oculus/deactivate', null).catch(() => undefined),
+                    this.#exited
+                ]);
+                this.#child.stdin.end();
+            }
+            const end = await this.#exited;
+            clock.clearTimeout(term);
+            return end;
+        })();
+        return this.#stopping;
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/triggers.ts b/tools/oculus/src/lib/server/machine/apps/host/triggers.ts
new file mode 100644
index 000000000..92207db69
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/triggers.ts
@@ -0,0 +1,88 @@
+// Layer 2, server. What the server looks at to know that an activation event of a host has
+// happened without a page saying so: whether a root holds a file that a `workspaceContains` glob
+// matches, and the language id of a file whose source tab a page opened.
+//
+// The look at a root is a walk of its folders: at most `scanEntries` entries per root are read,
+// whatever they are, a dot-led folder and `node_modules` are never entered, a link is neither
+// followed nor taken for a file, and the glob is matched on the path relative to the root, so a
+// match can only name a file inside it. The listing of a folder is an argument, so a test lists
+// folders in an order it chooses.
+
+import { opendir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { extensionOf } from '../../../../data/helpers/files/opens-in-program.ts';
+import { nameOf } from '../../../../data/helpers/files/paths.ts';
+import type { LanguageMap } from '../../../../data/helpers/files/languages.ts';
+import { globTest } from '../../../../data/helpers/search/glob.ts';
+
+/** What a folder lists of one entry. */
+type Listed = { name: string; kind: 'file' | 'folder' | 'other' };
+
+/** The first `limit` entries of a folder, in the order the disk gives them. */
+export type List = (folder: string, limit: number) => Promise<Listed[]>;
+
+/** The language the editor gives a file no entry of the map names. */
+const PLAIN = 'plaintext';
+
+/** The folders a look never enters, beside every dot-led one. */
+const SKIPPED = 'node_modules';
+
+/** The listing of the disk. */
+export const diskList: List = async (folder, limit) => {
+    const handle = await opendir(folder);
+    const entries: Listed[] = [];
+    try {
+        for (let read = 0; read < limit; read += 1) {
+            const entry = await handle.read();
+            if (entry === null) break;
+            const kind = entry.isFile() ? 'file' : entry.isDirectory() ? 'folder' : 'other';
+            entries.push({ name: entry.name, kind });
+        }
+    } finally {
+        await handle.close().catch(() => undefined);
+    }
+    return entries;
+};
+
+/**
+ * Whether a file under `dir` matches the glob, reading at most `limit` entries. A folder that
+ * cannot be read is left out.
+ */
+export async function rootHolds(
+    dir: string,
+    glob: string,
+    limit: number,
+    list: List = diskList
+): Promise<boolean> {
+    const matches = globTest(glob);
+    const pending = [''];
+    let left = limit;
+    while (pending.length > 0 && left > 0) {
+        const below = pending.shift() ?? '';
+        let entries: Listed[];
+        try {
+            entries = await list(below === '' ? dir : join(dir, below), left);
+        } catch {
+            continue;
+        }
+        left -= entries.length;
+        for (const entry of entries) {
+            const path = below === '' ? entry.name : `${below}/${entry.name}`;
+            if (entry.kind === 'file' && matches(path)) return true;
+            const entered =
+                entry.kind === 'folder' && !entry.name.startsWith('.') && entry.name !== SKIPPED;
+            if (entered) pending.push(path);
+        }
+    }
+    return false;
+}
+
+/**
+ * The language id the editor opens a file of this path in: the map's entry for its whole name
+ * lowercased, else for its extension, else plain text.
+ */
+export function languageOfPath(path: string, map: LanguageMap): string {
+    const bare = nameOf(path).toLowerCase();
+    const whole = bare.startsWith('.') ? undefined : map.get(bare);
+    return whole ?? map.get(extensionOf(path)) ?? PLAIN;
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/verify.ts b/tools/oculus/src/lib/server/machine/apps/host/verify.ts
new file mode 100644
index 000000000..01a05d0b0
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/verify.ts
@@ -0,0 +1,29 @@
+// Layer 2, server. The check a host start makes right before the process is spawned: the app's
+// folder is walked and hashed again, and the host starts only when the approvals file holds that
+// hash. The hash is the whole folder's (read/record.ts), so a changed host file, a changed library
+// of the host or a changed manifest all fail it, and an app kept approved while it is edited does
+// not start its host on files nobody approved. The recorded files come from the same walk the hash
+// was taken over, as real paths, which is the set of files the runner lets the host load.
+
+import { readFileSync, realpathSync } from 'node:fs';
+import { join } from 'node:path';
+import type { HeldApp } from '../read/held.ts';
+import { hashApp, walkApp, type WalkLimits } from '../read/record.ts';
+
+/** The real paths of the recorded files of an app whose current hash is approved, or null. */
+export function approvedFiles(
+    app: HeldApp,
+    approved: ReadonlySet<string>,
+    limits: WalkLimits
+): string[] | null {
+    const folder = app.row.folder;
+    const walk = walkApp(folder, limits);
+    if (walk.tooLarge) return null;
+    try {
+        const manifest = readFileSync(join(folder, 'app.yml'));
+        if (!approved.has(hashApp(folder, app.row.name, manifest, walk.files))) return null;
+        return walk.files.map((file) => realpathSync(join(folder, file.path)));
+    } catch {
+        return null;
+    }
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/manage/add.ts b/tools/oculus/src/lib/server/machine/apps/manage/add.ts
new file mode 100644
index 000000000..e1042b80e
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/manage/add.ts
@@ -0,0 +1,90 @@
+// Layer 2, server. Add an app from a folder: the checks, then a copy that appears whole or not at
+// all.
+//
+// The folder chosen must hold an `app.yml` and have a name that matches the app name pattern and
+// that no entry of the machine's apps folder holds (an app, a refused folder or any file). It must
+// lie neither inside the apps folder nor hold it, and it must fit `apps.max_files` and
+// `apps.max_mb`; every check is made before a byte is copied, and a link is never followed. The
+// copy leaves out links and dot-led names, as the approval hash does, goes into a temporary folder
+// beside the apps folder, and is renamed into place, so no partial app folder is ever read. The
+// copied app appears unapproved and asks as any app does.
+
+import { cpSync, existsSync, lstatSync, mkdirSync, mkdtempSync, renameSync, rmSync } from 'node:fs';
+import { basename, dirname, join } from 'node:path';
+import { APP_NAME } from '../../../../data/helpers/files/apps.ts';
+import { below, realPath } from '../../../core/paths.ts';
+import { walkApp, type WalkLimits } from '../read/record.ts';
+
+/** The words an addition is refused with. */
+type AddRefusal =
+    'not_folder' | 'no_manifest' | 'name' | 'exists' | 'inside' | 'holds' | 'too_large' | 'copy';
+
+/** What an addition came to: the name of the new app, or the word it was refused with. */
+type AddOutcome = { ok: true; name: string } | { ok: false; error: AddRefusal };
+
+/** Whether something is at the path, a link that points at nothing included. */
+function present(path: string): boolean {
+    try {
+        lstatSync(path);
+        return true;
+    } catch {
+        return false;
+    }
+}
+
+/** Whether a copy of `root` keeps this path: the root itself, else no dot-led name and no link. */
+function keeping(root: string): (path: string) => boolean {
+    return (path) =>
+        path === root || (!basename(path).startsWith('.') && !lstatSync(path).isSymbolicLink());
+}
+
+/**
+ * The real path of a folder that may not exist yet: its deepest existing ancestor resolved, the
+ * names below it kept, so a folder reached through a link compares equal to the same folder read
+ * from the other side.
+ */
+function resolvedFolder(path: string): string {
+    const rest: string[] = [];
+    let probe = path;
+    for (;;) {
+        const real = realPath(probe, true);
+        if (real !== null) return join(real, ...rest);
+        const parent = dirname(probe);
+        if (parent === probe) return path;
+        rest.unshift(basename(probe));
+        probe = parent;
+    }
+}
+
+/** Copy the folder chosen into the apps folder as a new app. */
+export function addApp(chosen: string, appsFolder: string, limits: WalkLimits): AddOutcome {
+    const source = realPath(chosen, true);
+    if (source === null || !lstatSync(source).isDirectory())
+        return { ok: false, error: 'not_folder' };
+    if (!existsSync(join(source, 'app.yml')) || !lstatSync(join(source, 'app.yml')).isFile()) {
+        return { ok: false, error: 'no_manifest' };
+    }
+    const name = basename(chosen);
+    if (!APP_NAME.test(name)) return { ok: false, error: 'name' };
+    const target = resolvedFolder(appsFolder);
+    if (source === target || below(source, target)) return { ok: false, error: 'inside' };
+    if (below(target, source)) return { ok: false, error: 'holds' };
+    if (present(join(target, name))) return { ok: false, error: 'exists' };
+    if (walkApp(source, limits).tooLarge) return { ok: false, error: 'too_large' };
+    const parent = dirname(target);
+    mkdirSync(target, { recursive: true });
+    const staging = mkdtempSync(join(parent, '.app-adding-'));
+    try {
+        cpSync(source, join(staging, name), {
+            recursive: true,
+            dereference: false,
+            filter: keeping(source)
+        });
+        renameSync(join(staging, name), join(target, name));
+    } catch {
+        return { ok: false, error: 'copy' };
+    } finally {
+        rmSync(staging, { recursive: true, force: true });
+    }
+    return { ok: true, name };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/manage/enable.ts b/tools/oculus/src/lib/server/machine/apps/manage/enable.ts
new file mode 100644
index 000000000..1858a4166
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/manage/enable.ts
@@ -0,0 +1,80 @@
+// Layer 2, server. Disable and enable: which apps a change reaches, and the writes of it.
+//
+// Disable and Enable change the machine-wide list of `~/.oculus/apps.json`; Disable (Workspace) and
+// Enable (Workspace) change the lists of the current workspace. Disabling a machine app that other
+// enabled apps depend on, directly or through each other, is refused until the caller says
+// `cascade`, which disables those apps in the same scope as well; enabling an app enables nothing
+// else. The writes are made one app at a time, the app asked for last, so a write that fails leaves
+// the apps that depend on it disabled and the app itself as it was.
+
+import type { AppsHeld, HeldApp } from '../read/held.ts';
+import { changeAppsState, type StateChange } from '../read/state.ts';
+import { appById } from '../read/held.ts';
+
+/** Where a change is kept: for every workspace, or for the current one only. */
+type EnableScope = 'machine' | 'workspace';
+
+/** What is asked: one app disabled or enabled in a scope, with its dependents when asked. */
+export type EnableRequest = {
+    id: string;
+    scope: EnableScope;
+    enabled: boolean;
+    cascade: boolean;
+};
+
+/** What a change came to: done, refused for the apps that depend on the app, or not written. */
+export type EnableOutcome =
+    | { ok: true; changed: string[] }
+    | { ok: false; error: 'missing' }
+    | { ok: false; error: 'dependents'; apps: string[] }
+    | { ok: false; error: 'file'; reason: string };
+
+/** The enabled apps that depend on this app, directly or through each other, nearest first. */
+export function dependentsClosure(held: AppsHeld, app: HeldApp): HeldApp[] {
+    if (app.row.root !== '') return [];
+    const found: HeldApp[] = [];
+    const names = [app.row.name];
+    for (const name of names) {
+        for (const one of held.apps) {
+            if (one === app || found.includes(one) || !one.row.depends.includes(name)) continue;
+            found.push(one);
+            if (one.row.root === '') names.push(one.row.name);
+        }
+    }
+    return found;
+}
+
+/** The change a scope makes of one app. */
+function changeOf(
+    request: EnableRequest,
+    workspace: string,
+    id: string,
+    disabled: boolean
+): StateChange {
+    return request.scope === 'machine'
+        ? { scope: 'machine', id, disabled }
+        : { scope: 'workspace', workspace, id, disabled };
+}
+
+/** Disable or enable an app in a scope; `file` is `~/.oculus/apps.json`. */
+export function changeEnabled(
+    held: AppsHeld,
+    file: string,
+    workspace: string,
+    request: EnableRequest
+): EnableOutcome {
+    const app = appById(held, request.id);
+    if (app === undefined) return { ok: false, error: 'missing' };
+    const dependents = request.enabled
+        ? []
+        : dependentsClosure(held, app).filter((one) => !one.row.disabled);
+    if (dependents.length > 0 && !request.cascade) {
+        return { ok: false, error: 'dependents', apps: dependents.map((one) => one.row.title) };
+    }
+    const ids = [...dependents.map((one) => one.id).reverse(), app.id];
+    for (const id of ids) {
+        const done = changeAppsState(file, changeOf(request, workspace, id, !request.enabled));
+        if (!done.ok) return { ok: false, error: 'file', reason: done.error };
+    }
+    return { ok: true, changed: ids };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/manage/remove.ts b/tools/oculus/src/lib/server/machine/apps/manage/remove.ts
new file mode 100644
index 000000000..db3b648a7
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/manage/remove.ts
@@ -0,0 +1,118 @@
+// Layer 2, server. Remove a machine app: what the reader is asked first, and what the removal does.
+//
+// The question names the app's folder, the number of secrets it holds (or that they could not be
+// counted) and the enabled apps that depend on it. On yes the dependents are disabled machine-wide,
+// the app's host is stopped, its folder and its store file go to the system trash (a folder entry
+// that is a link moves the link and never its target), its secrets are deleted from the keyring,
+// its approval is revoked and its entries of `~/.oculus/apps.json` are dropped. Nothing is changed
+// when the trash refuses, so the app stays whole. A root app is never removed here: its folder
+// belongs to its repository.
+
+import { existsSync, lstatSync } from 'node:fs';
+import { join } from 'node:path';
+import { revokeApp } from '../../approvals/approvals.ts';
+import type { AppHosts } from '../host/manager.ts';
+import type { AppsHeld, HeldApp } from '../read/held.ts';
+import { changeAppsState, readAppsState } from '../read/state.ts';
+import type { AppSecrets } from '../secrets/secrets.ts';
+import { dependentsClosure } from './enable.ts';
+
+/** What the question to the reader is made of. */
+export type Removal = {
+    folder: string;
+    /** The number of secrets, or null when the keyring could not be read. */
+    secrets: number | null;
+    /** The titles of the enabled apps that depend on the app. */
+    dependents: string[];
+};
+
+/** What a removal needs of the process. */
+export type RemoveDeps = {
+    held: () => AppsHeld;
+    hosts: Pick<AppHosts, 'stop' | 'settled'>;
+    secrets: Pick<AppSecrets, 'count' | 'clear'>;
+    trash: (path: string) => Promise<void>;
+    approvalsFile: string;
+    stateFile: string;
+    workspace: string;
+    unkeep: (id: string) => void;
+};
+
+/** What a removal came to. */
+export type RemoveOutcome =
+    | { ok: true; secretsKept: boolean }
+    | {
+          ok: false;
+          error: 'missing' | 'root_app' | 'dependents' | 'trash' | 'approval' | 'file';
+          reason?: string;
+      };
+
+/** The entry of the app in the machine's apps folder: the folder, or the link that names it. */
+function entryOf(held: AppsHeld, app: HeldApp): string | null {
+    for (const folder of held.folders) {
+        const entry = join(folder, app.row.name);
+        try {
+            lstatSync(entry);
+        } catch {
+            continue;
+        }
+        if (entry === app.row.folder || existsSync(join(entry, 'app.yml'))) return entry;
+    }
+    return null;
+}
+
+/** What the question shows for a machine app. */
+export async function describeRemoval(
+    held: AppsHeld,
+    app: HeldApp,
+    secrets: Pick<AppSecrets, 'count'>
+): Promise<Removal> {
+    return {
+        folder: app.row.folder,
+        secrets: app.row.secrets ? await secrets.count(app) : 0,
+        dependents: dependentsClosure(held, app)
