+// Layer 2, server. The JSON-RPC 2.0 connection between oculus and one host, oculus's end of it.
+// The framing, the request ids, the cancellation and the progress are `vscode-jsonrpc`'s
+// `createMessageConnection` over the host process's standard input and output; the runner
+// (host-runner.mjs) is its other end. The methods are in DESIGN.md's "Apps added while oculus
+// runs".
+//
+// Requests and notifications go both ways. A request to the host may be cancelled with a
+// `CancellationToken`, which sends `$/cancelRequest`, and may ask for progress: the host reports
+// with `$/progress` on the token the caller names, and `onProgress` is called with each value. A
+// handler for a request of the host receives the params and a token the host's cancel ends.
+//
+// A refusal is a `Refused`, which carries the word an app is told (`rate`, `not_declared`,
+// `host_down`, `refused:<reason>`). On the wire it is a `ResponseError` with the word as its
+// message; a request that fails any other way, because the connection closed or the host sent a
+// malformed message, is `host_down` to the caller. A message that cannot be read calls `broken`
+// once: the stream is no longer trusted.
+
+import type { Readable, Writable } from 'node:stream';
+import {
+    CancellationToken,
+    ProgressType,
+    ResponseError,
+    StreamMessageReader,
+    StreamMessageWriter,
+    createMessageConnection,
+    type MessageConnection
+} from 'vscode-jsonrpc/node';
+
+/** The code of a `ResponseError` that carries an app-facing word. */
+const REFUSED = 1;
+
+/** An error that carries the word an app is refused with. */
+export class Refused extends Error {
+    readonly word: string;
+
+    constructor(word: string) {
+        super(word);
+        this.word = word;
+    }
+}
+
+/** A handler for a request of the host: its params and the token the host's cancel ends. */
+export type HostHandler = (params: unknown, token: CancellationToken) => unknown;
+
+/** One request to the host, with the cancellation and the progress it may ask for. */
+export type HostCall = {
+    cancel?: CancellationToken;
+    /** Called with each value the host reports on the progress token the params carry. */
+    progress?: { token: string; report: (value: unknown) => void };
+};
+
+/** oculus's end of the connection. */
+export type HostLink = {
+    request(method: string, params: unknown, call?: HostCall): Promise<unknown>;
+    notify(method: string, params: unknown): void;
+    /** Ends the connection; every request in flight is rejected. */
+    dispose(): void;
+};
+
+/** What the connection is made over. */
+export type LinkOptions = {
+    input: Readable;
+    output: Writable;
+    handlers: Record<string, HostHandler>;
+    /** Called once when a message of the host cannot be read. */
+    broken: (reason: string) => void;
+};
+
+/** The word an error stands for toward an app: its own, or `host_down` for a lost connection. */
+function wordOf(error: unknown): string {
+    if (error instanceof ResponseError && error.code === REFUSED) return `refused:${error.message}`;
+    return 'host_down';
+}
+
+/** Connect to a host over its two streams. */
+export function connectHost(options: LinkOptions): HostLink {
+    const connection: MessageConnection = createMessageConnection(
+        new StreamMessageReader(options.input),
+        new StreamMessageWriter(options.output)
+    );
+    let told = false;
+    connection.onError(([error]) => {
+        if (told) return;
+        told = true;
+        options.broken(error.message);
+    });
+    for (const [method, handler] of Object.entries(options.handlers)) {
+        connection.onRequest(method, async (params: unknown, token: CancellationToken) => {
+            try {
+                return (await handler(params, token)) ?? null;
+            } catch (error) {
+                if (error instanceof Refused) throw new ResponseError(REFUSED, error.word);
+                throw new ResponseError(REFUSED, 'failed');
+            }
+        });
+    }
+    connection.listen();
+    return {
+        async request(method, params, call = {}) {
+            const progress = call.progress;
+            const watching =
+                progress === undefined
+                    ? undefined
+                    : connection.onProgress(
+                          new ProgressType<unknown>(),
+                          progress.token,
+                          progress.report
+                      );
+            try {
+                return await connection.sendRequest(method, params, call.cancel);
+            } catch (error) {
+                throw new Refused(wordOf(error));
+            } finally {
+                watching?.dispose();
+            }
+        },
+        notify(method, params) {
+            void connection.sendNotification(method, params).catch(() => undefined);
+        },
+        dispose() {
+            connection.dispose();
+        }
+    };
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/handlers.ts b/tools/oculus/src/lib/server/machine/apps/host/handlers.ts
new file mode 100644
index 000000000..b1640ce96
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/handlers.ts
@@ -0,0 +1,133 @@
+// Layer 2, server. What oculus answers to the requests a host makes: its store, its secrets, a
+// message to its pages and the API of an app it depends on. Each handler reads the app from the
+// host that asked, never from the params, so a host reaches its own store and secrets and nothing
+// else. A refusal is a `Refused` with the word the host's promise rejects with.
+//
+// The store is the one file `getStore` and `setStore` read and write; `update` is one key of it,
+// counted under `apps.writes_per_min` per host. A secret's store and delete count under the same
+// limit, and a message to a page under `apps.messages_per_min`. A message goes to the tab it names,
+// or to every open tab of the app when it names none.
+
+import { isDeepStrictEqual } from 'node:util';
+import { isMap } from '../../../../data/helpers/guards.ts';
+import type { Limiter } from '../../../../data/helpers/run/limiter.ts';
+import type { AppMessage } from '../../../../data/model/index.ts';
+import type { HeldApp } from '../read/held.ts';
+import type { AppSecrets } from '../secrets/secrets.ts';
+import { Refused, type HostHandler } from './connection.ts';
+
+/** What a host reads and writes of its app's store. */
+export type HostStore = {
+    /** The map the store holds now; empty for any other value. */
+    get(app: HeldApp): Record<string, unknown>;
+    update(
+        app: HeldApp,
+        key: unknown,
+        value: unknown
+    ): Promise<{ ok: true } | { ok: false; word: string }>;
+};
+
+/** What the handlers of one host are made over. */
+export type HandlerContext = {
+    /** The app the host belongs to as the server holds it now. */
+    app: () => HeldApp | undefined;
+    store: HostStore;
+    secrets: AppSecrets;
+    writes: Limiter;
+    messages: Limiter;
+    /** The values the host is writing now by key, so a change it made itself is not told back. */
+    wrote: Map<string, unknown>;
+    send: (message: AppMessage) => void;
+    /** The functions of the API of a dependency, or a refusal. */
+    names: (name: string) => Promise<string[]>;
+    /** One call of the API of a dependency, or a refusal. */
+    call: (name: string, fn: string, args: unknown[]) => Promise<unknown>;
+};
+
+/** The params as a map, or a refusal. */
+function paramsOf(params: unknown): Record<string, unknown> {
+    if (!isMap(params)) throw new Refused('refused:params');
+    return params;
+}
+
+/** The answer of a secrets call as the host sees it. */
+function secretly<T>(answer: { ok: true; value: T } | { ok: false; word: string }): T {
+    if (!answer.ok) throw new Refused(answer.word);
+    return answer.value;
+}
+
+/** The handlers of the requests one host makes, by method. */
+export function hostHandlers(context: HandlerContext): Record<string, HostHandler> {
+    const app = (): HeldApp => {
+        const held = context.app();
+        if (held === undefined) throw new Refused('host_down');
+        return held;
+    };
+    return {
+        'oculus/store/get': (params) => {
+            const key = paramsOf(params).key;
+            const map = context.store.get(app());
+            const has = typeof key === 'string' && Object.hasOwn(map, key);
+            return has ? { has, value: map[key] } : { has };
+        },
+        'oculus/store/keys': () => Object.keys(context.store.get(app())),
+        'oculus/store/update': async (params) => {
+            const { key, value } = paramsOf(params);
+            if (!context.writes.take()) throw new Refused('rate');
+            if (typeof key === 'string') context.wrote.set(key, value);
+            try {
+                const done = await context.store.update(app(), key, value);
+                if (!done.ok) throw new Refused(done.word);
+            } finally {
+                if (typeof key === 'string') context.wrote.delete(key);
+            }
+            return null;
+        },
+        'oculus/secrets/get': async (params) =>
+            secretly(await context.secrets.get(app(), paramsOf(params).key)) ?? null,
+        'oculus/secrets/store': async (params) => {
+            if (!context.writes.take()) throw new Refused('rate');
+            const { key, value } = paramsOf(params);
+            return secretly(await context.secrets.store(app(), key, value));
+        },
+        'oculus/secrets/delete': async (params) => {
+            if (!context.writes.take()) throw new Refused('rate');
+            return secretly(await context.secrets.delete(app(), paramsOf(params).key));
+        },
+        'oculus/sendToPage': (params) => {
+            const { method, params: body, tab } = paramsOf(params);
+            if (typeof method !== 'string' || method === '') throw new Refused('refused:method');
+            if (tab !== undefined && tab !== null && typeof tab !== 'string') {
+                throw new Refused('refused:tab');
+            }
+            if (!context.messages.take()) throw new Refused('rate');
+            context.send({ app: app().id, tab: tab ?? '', method, params: body ?? null });
+            return null;
+        },
+        'oculus/apps/get': async (params) => {
+            const name = paramsOf(params).name;
+            if (typeof name !== 'string') throw new Refused('not_declared');
+            return context.names(name);
+        },
+        'oculus/apps/call': async (params) => {
+            const { name, fn, args } = paramsOf(params);
+            if (typeof name !== 'string' || typeof fn !== 'string')
+                throw new Refused('not_declared');
+            if (!Array.isArray(args)) throw new Refused('refused:args');
+            return context.call(name, fn, args as unknown[]);
+        }
+    };
+}
+
+/** The keys of a store map whose values differ between two maps, each key once. */
+export function changedKeys(
+    before: Record<string, unknown>,
+    after: Record<string, unknown>
+): string[] {
+    const keys = new Set([...Object.keys(before), ...Object.keys(after)]);
+    return [...keys].filter(
+        (key) =>
+            Object.hasOwn(before, key) !== Object.hasOwn(after, key) ||
+            !isDeepStrictEqual(before[key], after[key])
+    );
+}
diff --git a/tools/oculus/src/lib/server/machine/apps/host/host-runner.mjs b/tools/oculus/src/lib/server/machine/apps/host/host-runner.mjs
new file mode 100644
index 000000000..b3f21d2a9
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/host-runner.mjs
@@ -0,0 +1,213 @@
+// The process oculus holds for one app's host. It is plain JavaScript that node runs directly,
+// since it must start the same way from `vite dev`, from the built server and from the desktop app,
+// and it needs no package of the app: the app's host file talks to oculus through the object this
+// runner hands it.
+//
+// Arguments: the absolute path of the app's host file, and the absolute path of `vscode-jsonrpc`'s
+// node entry in oculus's own `node_modules`. Standard input and standard output carry JSON-RPC 2.0
+// messages with `Content-Length` headers, the framing `vscode-jsonrpc` writes on both ends; the
+// methods are in DESIGN.md's "Apps added while oculus runs". The process ends when its standard
+// input closes, so a server that is killed leaves no host running.
+//
+// The first `oculus/activate` request carries the real paths of the app's recorded files and the
+// sentences the runner writes to the host's output, worded from oculus's catalog. The
+// runner then installs a module hook that refuses every `file:` import, dynamic `import()` and
+// `require` of a file that is not one of them, loads the host file, and calls its exported
+// `activate(oculus)` once with the connection object. Whatever the host writes to standard output
+// goes to standard error, so the messages are the only thing on standard output; a write to file
+// descriptor 1 that skips this redirection breaks the message stream, which oculus then reports and
+// answers by stopping the host.
+
+import { realpathSync } from 'node:fs';
+import { registerHooks } from 'node:module';
+import { Socket } from 'node:net';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const [hostFile, jsonrpcEntry] = process.argv.slice(2);
+
+const WIRE_FD = 1;
+const wire = new Socket({ fd: WIRE_FD, readable: false, writable: true });
+process.stdout.write = (...parts) => process.stderr.write(...parts);
+
+const rpc = await import(pathToFileURL(jsonrpcEntry).href);
+const {
+    createMessageConnection,
+    StreamMessageReader,
+    StreamMessageWriter,
+    ResponseError,
+    ProgressType
+} = rpc.default ?? rpc;
+const connection = createMessageConnection(
+    new StreamMessageReader(process.stdin),
+    new StreamMessageWriter(wire)
+);
+
+/** The error code a host's own refusal answers with. */
+const REFUSED = 1;
+
+/** The text of a thrown value. */
+function messageOf(error) {
+    return error instanceof Error ? error.message : String(error);
+}
+
+/** Write a line to standard error, then end the process with a code. */
+function endWith(code, text) {
+    process.stderr.write(`${text}\n`, () => process.exit(code));
+}
+
+/** A sentence with `{0}`, `{1}` replaced by the arguments at those positions. */
+function fill(template, args) {
+    return template.replace(/\{(\d+)\}/g, (found, at) => args[Number(at)] ?? found);
+}
+
+/** The sentences of the first activate request. */
+let texts = null;
+
+/** Refuse every `file:` module the host loads that is not one of its recorded files. */
+function guard(files) {
+    const allowed = new Set(files);
+    registerHooks({
+        resolve(specifier, context, next) {
+            const resolved = next(specifier, context);
+            if (!resolved.url.startsWith('file:')) return resolved;
+            const path = fileURLToPath(resolved.url);
+            let real = path;
+            try {
+                real = realpathSync(path);
+            } catch {
+                // A file that cannot be resolved is refused below as one that is not recorded.
+            }
+            if (!allowed.has(real)) {
+                throw new Error(fill(texts.refused, [real, specifier]));
+            }
+            return resolved;
+        }
+    });
+}
+
+let hostModule = null;
+let api = null;
+let activated = false;
+let requestHandler = null;
+const storeListeners = [];
+
+const oculus = {
+    onRequest(handler) {
+        requestHandler = handler;
+    },
+    store: {
+        get: async (key) => {
+            const held = await connection.sendRequest('oculus/store/get', { key });
+            return held.has ? held.value : undefined;
+        },
+        update: (key, value) => connection.sendRequest('oculus/store/update', { key, value }),
+        keys: () => connection.sendRequest('oculus/store/keys'),
+        onDidChange(handler) {
+            storeListeners.push(handler);
+        }
+    },
+    secrets: {
+        get: async (key) =>
+            (await connection.sendRequest('oculus/secrets/get', { key })) ?? undefined,
+        store: (key, value) => connection.sendRequest('oculus/secrets/store', { key, value }),
+        delete: (key) => connection.sendRequest('oculus/secrets/delete', { key })
+    },
+    sendToPage: (method, params, tab) =>
+        connection.sendRequest('oculus/sendToPage', { method, params, tab }),
+    apps: {
+        async get(name) {
+            const names = await connection.sendRequest('oculus/apps/get', { name });
+            const dependency = {};
+            for (const fn of names) {
+                dependency[fn] = (...args) =>
+                    connection.sendRequest('oculus/apps/call', { name, fn, args });
+            }
+            return dependency;
+        }
+    }
+};
+
+/** Load the host file under the guard and call its `activate` once. */
+async function activate(files) {
+    guard(files);
+    hostModule = await import(pathToFileURL(hostFile).href);
+    if (typeof hostModule.activate !== 'function') {
+        throw new Error(fill(texts.noActivate, [hostFile]));
+    }
+    api = (await hostModule.activate(oculus)) ?? null;
+}
+
+connection.onRequest('oculus/activate', async (params) => {
+    if (activated) return null;
+    activated = true;
+    texts = params.texts;
+    try {
+        await activate(params.files);
+    } catch (error) {
+        const text = error instanceof Error ? (error.stack ?? error.message) : String(error);
+        setTimeout(() => endWith(1, fill(texts.failed, [text])), 0);
+        throw new ResponseError(REFUSED, messageOf(error));
+    }
+    return null;
+});
+
+connection.onRequest('oculus/request', async (params, token) => {
+    if (requestHandler === null) throw new ResponseError(REFUSED, texts.noHandler);
+    const kind = new ProgressType();
+    const progress = (value) => {
+        if (typeof params.progress === 'string')
+            connection.sendProgress(kind, params.progress, value);
+    };
+    try {
+        return (
+            (await requestHandler(params.method, params.params, params.tab, token, progress)) ??
+            null
+        );
+    } catch (error) {
+        throw new ResponseError(REFUSED, messageOf(error));
+    }
+});
+
+connection.onRequest('oculus/apiCall', async (params) => {
+    if (api === null || typeof api !== 'object') {
+        if (params.fn === undefined) return [];
+        throw new ResponseError(REFUSED, texts.noApi);
+    }
+    if (params.fn === undefined) {
+        return Object.keys(api).filter((name) => typeof api[name] === 'function');
+    }
+    if (!Object.hasOwn(api, params.fn) || typeof api[params.fn] !== 'function') {
+        throw new ResponseError(REFUSED, fill(texts.noFunction, [params.fn]));
+    }
+    try {
+        return (await api[params.fn](...params.args)) ?? null;
+    } catch (error) {
+        throw new ResponseError(REFUSED, messageOf(error));
+    }
+});
+
+connection.onNotification('oculus/storeChanged', (params) => {
+    for (const listener of storeListeners) {
+        try {
+            listener(params.keys);
+        } catch (error) {
+            process.stderr.write(`${fill(texts.listenerFailed, [messageOf(error)])}\n`);
+        }
+    }
+});
+
+connection.onRequest('oculus/deactivate', async () => {
+    try {
+        await hostModule?.deactivate?.();
+    } catch (error) {
+        process.stderr.write(`${fill(texts.deactivateFailed, [messageOf(error)])}\n`);
+    }
+    setTimeout(() => wire.end(() => process.exit(0)), 0);
+    return null;
+});
+
+connection.onClose(() => process.exit(0));
+connection.onError(([error]) =>
+    process.stderr.write(`${fill(texts?.stream ?? '{0}', [messageOf(error)])}\n`)
+);
+connection.listen();
diff --git a/tools/oculus/src/lib/server/machine/apps/host/manager.ts b/tools/oculus/src/lib/server/machine/apps/host/manager.ts
new file mode 100644
index 000000000..4ef3146f9
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/apps/host/manager.ts
@@ -0,0 +1,623 @@
+// Layer 2, server. The hosts of the apps: which app has a host process, when it starts, how it is
+// answered and when it stops. One manager per server holds one entry per app that names a `host`.
+//
+// A host starts at the first activation event its app names (read/activation.ts) and only while
+// `plan.ts` lets it run: the app is enabled, its files' hash is in the approvals file, no cycle of
+// `depends` holds it and every dependency may run. The hash is taken again right before the process
+// is spawned (verify.ts). Before a host starts, the host of each app in its `depends` is started.
+// Two activations at once start one process; an activation while the host stops starts one after
+// the old process has exited. A host that ends on its own stays ended, with its exit code and
+// signal in its row, until the reader presses Restart; stopping it on purpose, or the app ceasing
+// to be runnable, clears that.
+//
+// `reconcile` is called after every read of the apps: it stops each host whose app may no longer
+// run (dependents first, the dependency last, a dependent saying which dependency's revoke stopped
+// it), fires `onStartupFinished` for each app that became runnable, and looks for the files
+// `workspaceContains` names. `close` stops every host. The rows of the hosts are published on the
+// `app-hosts` channel, the output a little later than the state, and a host's messages to its pages
+// go out on the event channel `app-messages`.
+
+import { spawn as nodeSpawn } from 'node:child_process';
+import { env as processEnv } from 'node:process';
+import { isDeepStrictEqual } from 'node:util';
+import { appViewId } from '../../../../data/helpers/files/apps.ts';
+import type { LanguageMap } from '../../../../data/helpers/files/languages.ts';
+import { createLimiter } from '../../../../data/helpers/run/limiter.ts';
+import { ENGINE_ROOT } from '../../../../data/helpers/hub-names.ts';
+import type {
+    AppHostRow,
+    AppHostsPayload,
+    AppMessage,
+    AppMessagesPayload,
+    Message
+} from '../../../../data/model/index.ts';
+import type { AppsSettings } from '../../../../data/sources/config/settings.ts';
+import type { Hub } from '../../../core/channels.ts';
+import { systemClock, type Clock, type Timer } from '../../../core/file-poll.ts';
+import { words } from '../../../core/words.ts';
+import type { Root } from '../../../files/files.ts';
+import { names, type ActivationEvent } from '../read/activation.ts';
+import { appById, type AppsHeld, type HeldApp } from '../read/held.ts';
+import type { AppSecrets } from '../secrets/secrets.ts';
+import { Refused } from './connection.ts';
+import { changedKeys, hostHandlers, type HostStore } from './handlers.ts';
+import { createOutput, type HostOutput } from './output.ts';
+import { cyclesOf, judge } from './plan.ts';
+import { HostProcess, type HostEnd } from './process.ts';
+import { diskList, languageOfPath, rootHolds, type List } from './triggers.ts';
+import { approvedFiles } from './verify.ts';
+
+/** What a request to a host came to: its answer, or the word it is refused with. */
+export type HostResult = { ok: true; value: unknown } | { ok: false; word: string };
+
+/** Milliseconds the output of the rows waits to be published after it changed. */
+const OUTPUT_DELAY_MS = 250;
+
+/** What the manager is made with. */
+export type HostsOptions = {
+    hub: Hub;
+    apps: { held(): AppsHeld };
+    settings: () => AppsSettings;
+    /** The roots the file browser shows, with their directories written out. */
+    roots: () => Root[];
+    languages: () => LanguageMap;
+    /** The content hashes the approvals file holds. */
+    approved: () => ReadonlySet<string>;
+    store: HostStore;
+    secrets: AppSecrets;
+    /** The server's text catalog. */
+    text: () => Record<string, string>;
+    /** The program the runner is started under, the runner and `vscode-jsonrpc`'s node entry. */
+    node: string;
+    runner: string;
+    jsonrpc: string;
+    env?: NodeJS.ProcessEnv;
+    spawn?: typeof nodeSpawn;
+    clock?: Clock;
+    list?: List;
+};
+
+/** One app that names a host. */
+type Entry = {
+    id: string;
+    name: string;
+    machine: boolean;
+    process: HostProcess | null;
+    /** A start in flight, which every activation during it waits on. */
+    start: Promise<boolean> | null;
+    stopping: Promise<void> | null;
+    /** The running process is being stopped on purpose, so its end is not an end of its own. */
+    intended: boolean;
+    /** How the host ended on its own, until a stop or a restart. */
+    ended: HostEnd | null;
+    /** The dependency whose revoke stopped the host. */
+    stoppedBy: string;
+    /** Whether a process of this host has run since the server started. */
+    ran: boolean;
+    output: HostOutput;
+    writes: ReturnType<typeof createLimiter>;
+    messages: ReturnType<typeof createLimiter>;
+    wrote: Map<string, unknown>;
+    snapshot: Record<string, unknown>;
+};
+
+/** How a stop treats the host's dependents: not at all, or stopped first under a blame. */
+type StopOptions = { blame?: string; dependents?: string };
+
+/** The hosts of the apps. */
+export class AppHosts {
+    #options: HostsOptions;
+    #clock: Clock;
+    #entries = new Map<string, Entry>();
+    #startup = new Set<string>();
+    #looked = new Set<string>();
+    /** The looks at the roots that have not answered yet. */
+    #looking = new Set<Promise<void>>();
+    #closed = false;
+    #timer: Timer | null = null;
+    #published = '';
+
+    constructor(options: HostsOptions) {
+        this.#options = options;
+        this.#clock = options.clock ?? systemClock;
+        options.hub.merge('app-messages', (held: Message, next: Message) => ({
+            ...next,
+            payload: {
+                messages: [
+                    ...(held.payload as AppMessagesPayload).messages,
+                    ...(next.payload as AppMessagesPayload).messages
+                ]
+            }
+        }));
+    }
+
+    /** Judge every app again after the apps were read. */
+    reconcile(): void {
+        if (this.#closed) return;
+        const held = this.#options.apps.held();
+        const cycles = cyclesOf(held);
+        const present = new Set<string>();
+        for (const app of held.apps) {
+            if (app.row.host === '') continue;
+            present.add(app.id);
+            const verdict = judge(held, app, cycles);
+            if (verdict.ok) {
+                if (!this.#startup.has(app.id)) {
+                    this.#startup.add(app.id);
+                    void this.activate(app.id, { kind: 'onStartupFinished' });
+                }
+                continue;
+            }
+            this.#startup.delete(app.id);
+            const entry = this.#entries.get(app.id);
+            if (entry === undefined) continue;
+            entry.ended = null;
+            if (entry.process === null) continue;
+            const lost =
+                verdict.cause === 'dependency' && verdict.approval ? verdict.dependency : '';
+            void this.#stop(entry, {
+                blame: lost,
+                dependents: verdict.cause === 'approval' ? app.row.name : ''
+            });
+        }
+        for (const [id, entry] of this.#entries) {
+            if (present.has(id)) continue;
+            this.#startup.delete(id);
+            void this.#stop(entry, { dependents: '' }).then(() => {
+                if (!present.has(id) && entry.process === null) this.#entries.delete(id);
+                this.#publish(true);
+            });
+        }
+        this.#look(held);
+        this.#publish(true);
+    }
+
+    /** An activation event happened: start the host of the app when it names the event. */
+    async activate(id: string, event: ActivationEvent): Promise<void> {
+        const app = this.#app(id);
+        if (app === undefined || app.row.host === '' || !names(app.row.activation, event)) return;
+        await this.#ensure(id, event);
+    }
+
+    /** A tab of the app is drawn. */
+    tab(id: string): Promise<void> {
+        return this.activate(id, { kind: 'onTab' });
+    }
+
+    /** A source tab of a file of this language opened on a page. */
+    language(language: string): void {
+        for (const app of this.#options.apps.held().apps) {
+            void this.activate(app.id, { kind: 'onLanguage', id: language });
+        }
+    }
+
+    /** A source tab of this path of a root opened: the language of the file is an event. */
+    opened(path: string): void {
+        this.language(languageOfPath(path, this.#options.languages()));
+    }
+
+    /** One request of a page to the host of an app. */
+    async request(id: string, method: unknown, params: unknown, tab: string): Promise<HostResult> {
+        const app = this.#app(id);
+        if (app === undefined) return { ok: false, word: 'missing' };
+        if (app.row.host === '') return { ok: false, word: 'not_declared' };
+        if (app.row.disabled) return { ok: false, word: 'closed' };
+        if (typeof method !== 'string' || method === '')
+            return { ok: false, word: 'refused:method' };
+        if (!(await this.#ensure(id, { kind: 'onTab' }))) return { ok: false, word: 'host_down' };
+        const process = this.#entries.get(id)?.process;
+        if (process === undefined || process === null) return { ok: false, word: 'host_down' };
+        try {
+            return {
+                ok: true,
+                value: await process.request('oculus/request', { method, params, tab })
+            };
+        } catch (error) {
+            return { ok: false, word: error instanceof Refused ? error.word : 'host_down' };
+        }
+    }
+
+    /** Stop the host of an app; its dependents keep running. */
+    async stop(id: string): Promise<void> {
+        const entry = this.#entries.get(id);
+        if (entry !== undefined) await this.#stop(entry, {});
+    }
+
+    /** Stop the host, then start it again. */
+    async restart(id: string): Promise<boolean> {
+        const entry = this.#entries.get(id);
+        if (entry === undefined) return false;
+        await this.#stop(entry, {});
+        entry.ended = null;
+        return this.#ensure(id, { kind: 'onTab' });
+    }
+
+    /** Tell the running hosts of these apps what changed in their stores. */
+    storeChanged(ids: readonly string[]): void {
+        for (const id of ids) {
+            const entry = this.#entries.get(id);
+            const app = this.#app(id);
+            if (entry === undefined || app === undefined || entry.process === null) continue;
+            const now = this.#options.store.get(app);
+            const keys = changedKeys(entry.snapshot, now).filter(
+                (key) =>
+                    !(entry.wrote.has(key) && isDeepStrictEqual(now[key], entry.wrote.get(key)))
+            );
+            entry.snapshot = now;
+            if (keys.length > 0) entry.process.notify('oculus/storeChanged', { keys });
+        }
+    }
+
+    /** The rows of the hosts as the Processes view draws them. */
+    rows(): AppHostRow[] {
+        const held = this.#options.apps.held();
+        const cycles = cyclesOf(held);
+        const rows: AppHostRow[] = [];
+        for (const app of held.apps) {
+            if (app.row.host === '') continue;
+            const entry = this.#entries.get(app.id);
+            const row = this.#rowOf(app, entry, judge(held, app, cycles));
+            if (row !== null) rows.push(row);
+        }
+        return rows.sort((a, b) => a.title.localeCompare(b.title) || a.app.localeCompare(b.app));
+    }
+
+    /** Resolves when no look at a root and no start or stop is in flight. */
+    async settled(): Promise<void> {
+        for (;;) {
+            const pending = [
+                ...this.#looking,
+                ...[...this.#entries.values()].flatMap((entry) => [
+                    ...(entry.start === null ? [] : [entry.start]),
+                    ...(entry.stopping === null ? [] : [entry.stopping])
+                ])
+            ];
+            if (pending.length === 0) return;
+            await Promise.allSettled(pending);
+        }
+    }
+
+    /** Stop every host, dependents first, and take no more activations. */
+    async close(): Promise<void> {
+        this.#closed = true;
+        if (this.#timer !== null) this.#clock.clearTimeout(this.#timer);
+        this.#timer = null;
+        await Promise.all(
+            [...this.#entries.values()].map((entry) => this.#stop(entry, { dependents: '' }))
+        );
+        await this.settled();
+    }
+
+    #app(id: string): HeldApp | undefined {
+        return appById(this.#options.apps.held(), id);
+    }
+
+    /** The entry of an app, made when the app first needs one. */
+    #entryOf(app: HeldApp): Entry {
+        let entry = this.#entries.get(app.id);
+        if (entry === undefined) {
+            const settings = this.#options.settings;
+            entry = {
+                id: app.id,
+                name: app.row.name,
+                machine: app.row.root === '',
+                process: null,
+                start: null,
+                stopping: null,
+                intended: false,
+                ended: null,
+                stoppedBy: '',
+                ran: false,
+                output: createOutput(() => settings().hostOutputKb),
+                writes: createLimiter(() => settings().writesPerMin, 60_000),
+                messages: createLimiter(() => settings().messagesPerMin, 60_000),
+                wrote: new Map(),
+                snapshot: {}
+            };
+            this.#entries.set(app.id, entry);
+        }
+        return entry;
+    }
+
+    /** Make sure the host runs: true when it does, false when it cannot. */
+    async #ensure(id: string, event: ActivationEvent): Promise<boolean> {
+        const app = this.#app(id);
+        if (app === undefined || this.#closed) return false;
+        const entry = this.#entryOf(app);
+        for (;;) {
+            if (entry.stopping !== null) {
+                await entry.stopping;
+                continue;
+            }
+            if (entry.start !== null) return entry.start;
+            if (entry.process !== null) return !entry.process.over;
+            if (entry.ended !== null) return false;
+            break;
+        }
+        const start = this.#begin(entry, event).finally(() => {
+            entry.start = null;
+            this.#publish(true);
+        });
+        entry.start = start;
+        return start;
+    }
+
+    /** The start of one host: dependencies first, the approval taken again, then the process. */
+    async #begin(entry: Entry, event: ActivationEvent): Promise<boolean> {
+        const held = (): AppsHeld => this.#options.apps.held();
+        const may = (app: HeldApp | undefined): app is HeldApp =>
+            app !== undefined && judge(held(), app, cyclesOf(held())).ok;
+        if (!may(this.#app(entry.id))) return false;
+        for (const name of this.#app(entry.id)?.row.depends ?? []) {
+            if (!(await this.#ensure(appViewId('', name), { kind: 'onTab' }))) return false;
+        }
+        const app = this.#app(entry.id);
+        if (this.#closed || !may(app)) return false;
+        const settings = this.#options.settings();
+        const files = approvedFiles(app, this.#options.approved(), {
+            files: settings.maxFiles,
+            bytes: settings.maxMb * 1024 * 1024
+        });
+        if (files === null) return false;
+        const text = this.#options.text;
+        let process: HostProcess;
+        try {
+            process = new HostProcess({
+                command: this.#options.node,
+                args: [
+                    this.#options.runner,
+                    `${app.row.folder}/${app.row.host}`,
+                    this.#options.jsonrpc
+                ],
+                cwd: app.row.folder,
+                env: this.#options.env ?? processEnv,
+                files,
+                texts: this.#runnerTexts(),
+                event,
+                output: entry.output,
+                handlers: hostHandlers(this.#context(entry)),
+                stopSeconds: () => this.#options.settings().hostStopSeconds,
+                clock: this.#clock,
+                spawn: this.#options.spawn,
+                changed: () => this.#publish(false),
+                streamBroken: (reason) => words(text(), 'server.apps.host_stream_broken', reason),
+                ended: (end) => this.#ended(entry, process, end)
+            });
+        } catch (error) {
+            entry.output.note(words(text(), 'server.apps.host_not_started', reason(error)));
+            entry.ended = { code: null, signal: '' };
+            return false;
+        }
+        entry.process = process;
+        entry.ran = true;
+        entry.intended = false;
+        entry.ended = null;
+        entry.stoppedBy = '';
+        this.#publish(true);
+        try {
+            await process.ready;
+        } catch {
+            return false;
+        }
+        entry.snapshot = this.#options.store.get(app);
+        return entry.process === process && !process.over;
+    }
+
+    /** The process of an entry has ended. */
+    #ended(entry: Entry, process: HostProcess, end: HostEnd): void {
+        if (entry.process !== process) return;
+        entry.process = null;
+        if (entry.intended) {
+            entry.intended = false;
+        } else {
+            entry.ended = end;
+            const text = this.#options.text();
+            entry.output.note(
+                end.code === null
+                    ? words(text, 'server.apps.host_ended_signal', end.signal)
+                    : words(text, 'server.apps.host_ended_code', end.code)
+            );
+        }
+        this.#publish(true);
+    }
+
+    /** Stop the host of an entry, the hosts that depend on it first when asked. */
+    #stop(entry: Entry, options: StopOptions): Promise<void> {
+        if (entry.stopping !== null) return entry.stopping;
+        entry.ended = null;
+        const process = entry.process;
+        if (process === null) return Promise.resolve();
+        entry.intended = true;
+        if (options.blame !== undefined && options.blame !== '') entry.stoppedBy = options.blame;
+        const stopping = (async () => {
+            if (options.dependents !== undefined)
+                await this.#stopDependents(entry, options.dependents);
+            this.#publish(true);
+            await process.stop();
+        })().finally(() => {
+            entry.stopping = null;
+            this.#publish(true);
+        });
+        entry.stopping = stopping;
+        return stopping;
+    }
+
+    /** Stop the running hosts of the apps that depend on this one, each under the blame. */
+    async #stopDependents(entry: Entry, blame: string): Promise<void> {
+        if (!entry.machine) return;
+        const stops: Promise<void>[] = [];
+        for (const other of this.#entries.values()) {
+            const app = this.#app(other.id);
+            if (other === entry || other.process === null || app === undefined) continue;
+            if (other.intended) {
+                stops.push(other.stopping ?? Promise.resolve());
+                continue;
+            }
+            if (app.row.depends.includes(entry.name)) {
+                stops.push(this.#stop(other, { blame, dependents: blame }));
+            }
+        }
+        await Promise.all(stops);
+    }
+
+    /** What the handlers of one host are made over. */
+    #context(entry: Entry): Parameters<typeof hostHandlers>[0] {
+        return {
+            app: () => this.#app(entry.id),
+            store: this.#options.store,
+            secrets: this.#options.secrets,
+            writes: entry.writes,
+            messages: entry.messages,
+            wrote: entry.wrote,
+            send: (message: AppMessage) => {
+                const payload: AppMessagesPayload = { messages: [message] };
+                this.#options.hub.send('app-messages', payload);
+            },
+            names: async (name) => {
+                const dependency = await this.#dependency(entry, name);
+                return (await dependency.request('oculus/apiCall', {})) as string[];
+            },
+            call: async (name, fn, args) => {
+                const dependency = await this.#dependency(entry, name);
+                return dependency.request('oculus/apiCall', { fn, args });
+            }
+        };
+    }
+
+    /** The running host of a dependency of this entry's app, started when it is not running. */
+    async #dependency(entry: Entry, name: string): Promise<HostProcess> {
+        const app = this.#app(entry.id);
+        if (app === undefined || name === '' || !app.row.depends.includes(name)) {
+            throw new Refused('not_declared');
+        }
+        const id = appViewId('', name);
+        if (!(await this.#ensure(id, { kind: 'onTab' }))) throw new Refused('host_down');
+        const process = this.#entries.get(id)?.process;
+        if (process === undefined || process === null) throw new Refused('host_down');
+        return process;
+    }
+
+    /** The sentences the runner writes to a host's output. */
+    #runnerTexts(): Record<string, string> {
+        const text = this.#options.text();
+        return {
+            refused: words(text, 'server.apps.host_refused_import', '{0}', '{1}'),
+            noActivate: words(text, 'server.apps.host_no_activate', '{0}'),
+            failed: words(text, 'server.apps.host_activate_failed', '{0}'),
+            stream: words(text, 'server.apps.host_stream_error', '{0}'),
+            listenerFailed: words(text, 'server.apps.host_listener_failed', '{0}'),
+            deactivateFailed: words(text, 'server.apps.host_deactivate_failed', '{0}'),
+            noHandler: words(text, 'server.apps.host_no_handler'),
+            noApi: words(text, 'server.apps.host_no_api'),
+            noFunction: words(text, 'server.apps.host_no_function', '{0}')
+        };
+    }
+
+    /** The row of one app's host, or null when it has none to show. */
+    #rowOf(
+        app: HeldApp,
+        entry: Entry | undefined,
+        verdict: ReturnType<typeof judge>
+    ): AppHostRow | null {
+        const base = {
+            app: app.id,
+            name: app.row.name,
+            root: app.row.root,
+            title: app.row.title,
+            pid: 0,
+            started: '',
+            code: null as number | null,
+            signal: '',
+            dependency: '',
+            stoppedBy: entry?.stoppedBy ?? '',
+            output: entry?.output.lines() ?? []
+        };
+        const process = entry?.process ?? null;
+        if (process !== null) {
+            const starting = entry?.start !== null && entry?.start !== undefined;
+            return {
+                ...base,
+                pid: process.pid,
+                started: process.started,
+                state: starting ? 'starting' : 'running',
+                waiting: ''
+            };
+        }
+        if (entry?.ended !== null && entry?.ended !== undefined) {
+            const { code, signal } = entry.ended;
+            return { ...base, state: 'ended', waiting: '', code, signal };
+        }
+        if (verdict.ok || verdict.cause === 'nohost' || verdict.cause === 'disabled') return null;
+        if (verdict.cause === 'approval') {
+            const changed = app.row.kept && !app.row.hashApproved;
+            return changed || entry?.ran === true
+                ? { ...base, state: 'waiting', waiting: 'approval' }
+                : null;
+        }
+        if (verdict.cause === 'cycle') return { ...base, state: 'waiting', waiting: 'cycle' };
+        return { ...base, state: 'waiting', waiting: 'dependency', dependency: verdict.dependency };
+    }
+
+    /** Look in the roots for the files that `workspaceContains` events name. */
+    #look(held: AppsHeld): void {
+        const roots = this.#options.roots().filter((root) => root.key !== ENGINE_ROOT);
+        const where = roots.map((root) => `${root.key}=${root.dir}`).join('\n');
+        for (const app of held.apps) {
+            if (app.row.host === '' || !judge(held, app, cyclesOf(held)).ok) continue;
+            for (const text of app.row.activation) {
+                if (!text.startsWith('workspaceContains:')) continue;
+                const glob = text.slice('workspaceContains:'.length);
+                const key = `${app.id}|${app.row.hash}|${glob}|${where}`;
+                if (this.#looked.has(key)) continue;
+                this.#looked.add(key);
+                const own =
+                    app.row.root === '' ? roots : roots.filter((root) => root.key === app.row.root);
+                const looking = this.#hold(app.id, own, glob).finally(() => {
+                    this.#looking.delete(looking);
+                });
+                this.#looking.add(looking);
+            }
+        }
+    }
+
+    /** Whether one of the roots holds a file the glob matches; the host starts when it does. */
+    async #hold(id: string, roots: Root[], glob: string): Promise<void> {
+        const limit = this.#options.settings().scanEntries;
+        for (const root of roots) {
+            const found = await rootHolds(root.dir, glob, limit, this.#options.list ?? diskList);
+            if (found && !this.#closed) {
+                await this.activate(id, { kind: 'workspaceContains', glob });
+                return;
+            }
+        }
+    }
+
+    /** Publish the rows: at once when the state moved, a little later when only output did. */
+    #publish(now: boolean): void {
+        if (this.#closed && this.#timer === null && !now) return;
+        if (!now) {
+            if (this.#timer !== null) return;
+            this.#timer = this.#clock.setTimeout(() => {
+                this.#timer = null;
+                this.#flush();
+            }, OUTPUT_DELAY_MS);
+            return;
+        }
+        if (this.#timer !== null) this.#clock.clearTimeout(this.#timer);
+        this.#timer = null;
+        this.#flush();
+    }
+
+    #flush(): void {
+        const payload: AppHostsPayload = { rows: this.rows() };
+        const text = JSON.stringify(payload);
+        if (text === this.#published) return;
+        this.#published = text;
+        this.#options.hub.publish('app-hosts', payload);
+    }
+}
+
+/** The text of a thrown value. */
+function reason(error: unknown): string {
+    return error instanceof Error ? error.message : String(error);
+}
