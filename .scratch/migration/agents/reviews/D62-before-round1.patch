+ */
+export function hostTargets<T extends { id: string; instance: string }>(
+    frames: Iterable<T>,
+    message: { app: string; tab: string }
+): T[] {
+    return [...frames].filter(
+        (frame) =>
+            frame.id === message.app && (message.tab === '' || message.tab === frame.instance)
+    );
+}
