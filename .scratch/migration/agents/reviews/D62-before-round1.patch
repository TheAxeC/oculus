+
+/** Remove the app; `cascade` is the reader's yes to disabling the apps that depend on it. */
+export async function removeApp(
+    app: HeldApp,
+    cascade: boolean,
+    deps: RemoveDeps
+): Promise<RemoveOutcome> {
+    if (app.row.root !== '') return { ok: false, error: 'root_app' };
