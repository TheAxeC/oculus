+        },
+        async count(app) {
+            try {
+                return (await (await keyring()).accounts(serviceOf(app))).length;
+            } catch {
+                return null;
+            }
+        },
+        async clear(app) {
+            try {
+                const ring = await keyring();
+                const service = serviceOf(app);
+                for (const account of await ring.accounts(service))
+                    await ring.remove(service, account);
+                return true;
+            } catch {
+                return false;
+            }
+        }
+    };
+}
