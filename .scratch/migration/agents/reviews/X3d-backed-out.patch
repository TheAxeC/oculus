+            [
+                { root: HUB, path: '', staged: false, worktree: false, group: 'changed' },
+                catalog['repositories.group_diff_changed']
+            ]
+        ]);
+    });
+});
+
+describe('the heads that count', () => {
+    it('draw the count of the Changes section and of every ref section as a badge', () => {
+        const body = html({
+            [HUB]: {
+                ...HUB_GIT,
