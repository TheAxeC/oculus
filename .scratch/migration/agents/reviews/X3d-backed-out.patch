+        color: var(--ink-txt, var(--ink));
+        font-size: calc(var(--button-font) * var(--text-scale, 1));
+        line-height: calc(18px * var(--text-scale, 1));
+    }
+
+    :global(body.wall) .pill {
+        background: transparent;
+    }
+
+    .pill[data-pill='local'],
