+        }
+        // The Graph reads its commits only in a browser, so its head is drawn with the count 0.
+        expect(group(body, 'graph')).toMatch(/class="count[^"]*\bbadge\b/);
+    });
+});
diff --git a/tools/oculus/tests/views/sources/repositories/commit-box.test.ts b/tools/oculus/tests/views/sources/repositories/commit-box.test.ts
