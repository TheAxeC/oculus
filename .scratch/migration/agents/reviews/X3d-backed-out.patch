+        expect(controls).toHaveLength(2);
+        press(controls[0]);
+        press(controls[1]);
+        expect(opened).toEqual([
+            [
+                { root: HUB, path: '', staged: true, worktree: false, group: 'staged' },
+                catalog['repositories.group_diff_staged']
