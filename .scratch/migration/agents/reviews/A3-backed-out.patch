@@ -0,0 +1,42 @@
+// Layer 4, server test. The run record of the update tasks: a file that does not read is never
+// written over. Every case runs over a scratch folder, so nothing reaches ~/.oculus. What this does
+// not cover: the lock a second process holds, and the shape of a record that reads (the schedule
+// suite writes and reads those).
+
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect } from 'vitest';
+import {
+    appendRun,
+    claimDue,
+    readPattern
+} from '../../../../src/lib/server/machine/tasks/record.ts';
+import type { ScheduleRun } from '../../../../src/lib/data/model/index.ts';
+import { it, scratchDir } from '../../../fixtures/scratch.ts';
+
+const RUN: ScheduleRun = {
+    trigger: 'schedule',
+    due: '2026-10-06T05:00:00.000Z',
+    at: '2026-10-06T05:00:00.412Z',
+    outcome: 'started',
+    terminal: null
+};
+
+describe('the run record', () => {
+    it('refuses a write over a schedule record it cannot read, leaving it', async () => {
+        const dir = scratchDir('oculus-record-');
+        for (const held of ['{', '{"litwatch": 5}', '[]']) {
+            const file = join(dir, 'schedule.json');
+            writeFileSync(file, held);
+            const changes = [
+                await readPattern(file, 'litwatch', '0 7 * * *'),
+                await claimDue(file, 'litwatch', '0 7 * * *', RUN),
+                await appendRun(file, 'litwatch', RUN)
+            ];
+            for (const change of changes)
+                expect(change, held).toMatchObject({ ok: false, why: 'unread' });
+            expect(readFileSync(file, 'utf8'), held).toBe(held);
+            expect(existsSync(`${file}.lock`), held).toBe(false);
+        }
+    });
+});
diff --git a/tools/oculus/tests/server/machine/tasks/schedule.test.ts b/tools/oculus/tests/server/machine/tasks/schedule.test.ts
new file mode 100644
index 000000000..5ad8a376f
--- /dev/null
+++ b/tools/oculus/tests/server/machine/tasks/schedule.test.ts
@@ -0,0 +1,327 @@
+// Layer 4, server test. The schedule of the update tasks over the real start (tasks/start.ts), a
+// recording tmux double, a scratch run record and a fake clock: a due time starts one run, however
+// the server met it. No case reaches tmux or `claude`. Every clock is set a week before the real
+// day or earlier, so a lock file's real modification time is never older than the fake `now`, and
+// each case ends by checking that no write took over a lock. What this does not cover: the autumn
+// change of a repeated hour, the page's reading of the payload, and the tmux of a real machine.
+
+import { writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, vi, type MockInstance } from 'vitest';
+import { Hub } from '../../../../src/lib/server/core/channels.ts';
+import { loadRecord } from '../../../../src/lib/server/machine/tasks/record.ts';
+import {
+    watchSchedules,
+    type SchedulesOptions,
+    type SchedulesWatcher
+} from '../../../../src/lib/server/machine/tasks/schedule.ts';
+import { SCHEDULED_SIZE, startUpdateTask } from '../../../../src/lib/server/machine/tasks/start.ts';
+import { stopTerminal } from '../../../../src/lib/server/machine/pty/sessions.ts';
+import { it, scratchDir } from '../../../fixtures/scratch.ts';
+import { HERE, tmux } from '../../../routes/sessions/terminal-fixture.ts';
+
+const NONE = { litwatch: '', scout: '', linkedin: '', inbox: '' };
+const DAILY = { ...NONE, litwatch: '0 7 * * *' };
+const EARLIER = 'aabbcc-claude';
+
+/** The real day, read before any test installs the fake clock. */
+const TODAY = new Date();
+
+/** A local time seven days before the real day, `days` days after it. */
+function local(days: number, hour: number, minute = 0, second = 0): Date {
+    const day = new Date(TODAY);
+    day.setDate(day.getDate() - 7 + days);
+    day.setHours(hour, minute, second, 0);
+    return day;
+}
+
+type Setup = {
+    record: string;
+    driver: ReturnType<typeof tmux>;
+    hub: Hub;
+    watchers: SchedulesWatcher[];
+};
+
+const open: SchedulesWatcher[] = [];
+
+let complaints: MockInstance<typeof console.error>;
+
+beforeEach(() => {
+    vi.useFakeTimers({ now: local(0, 6, 59, 50) });
+    complaints = vi.spyOn(console, 'error');
+});
+
+afterEach(() => {
+    for (const watcher of open.splice(0)) watcher.close();
+    vi.useRealTimers();
+    const lines = complaints.mock.calls.map((call) => String(call[0]));
+    complaints.mockRestore();
+    expect(lines.filter((line) => line.includes('took over'))).toEqual([]);
+});
+
+/** What the running terminals look like on the `sessions` channel. */
+function publishSessions(
+    hub: Hub,
+    terminals: { id: string; pid: number }[],
+    records: { pid: number | null; liveStatus: string | null }[]
+): void {
+    hub.publish('sessions', { records, workspaces: [], terminals });
+}
+
+/** A watcher over the real start, the recording tmux and a scratch record. */
+function watcher(
+    setup: Setup,
+    schedules: typeof NONE,
+    hub: Hub = setup.hub,
+    table: SchedulesOptions['table'] = () => Promise.resolve([])
+): SchedulesWatcher {
+    const common = { run: setup.driver.run, hub: HERE, claudeBin: 'claude' };
+    const made = watchSchedules(hub, {
+        record: setup.record,
+        schedules,
+        text: { 'app.tasks.record_unread': 'unread' },
+        start: (kind, run) =>
+            startUpdateTask(kind, run, {
+                ...common,
+                skipPermissions: false,
+                size: SCHEDULED_SIZE,
+                record: setup.record
+            }),
+        stop: (terminal) => stopTerminal(terminal, { run: setup.driver.run }),
+        table
+    });
+    open.push(made);
+    setup.watchers.push(made);
+    return made;
+}
+
+function setup(): Setup {
+    const dir = scratchDir('oculus-schedule-');
+    return { record: join(dir, 'schedule.json'), driver: tmux(), hub: new Hub(), watchers: [] };
+}
+
+/** Write a record whose litwatch entry holds the given handled due time and runs. */
+function plant(
+    record: string,
+    entry: { handled: Date | null; runs?: object[]; since?: Date; pattern?: string }
+): void {
+    writeFileSync(
+        record,
+        JSON.stringify({
+            litwatch: {
+                pattern: entry.pattern ?? '0 7 * * *',
+                since: (entry.since ?? local(-5, 8)).toISOString(),
+                handled: entry.handled?.toISOString() ?? null,
+                runs: entry.runs ?? []
+            }
+        })
+    );
+}
+
+/** Let every promise the watcher is waiting on run, with the fake clock where it is. */
+async function settle(): Promise<void> {
+    await vi.advanceTimersByTimeAsync(0);
+    await vi.advanceTimersByTimeAsync(200);
+}
+
+function runsOf(record: string): Record<string, unknown>[] {
+    const loaded = loadRecord(record);
+    return loaded.ok ? (loaded.logs.litwatch?.runs ?? []) : [];
+}
+
+function started(driver: Setup['driver']): string[][] {
+    return driver.calls.filter((args) => args.includes('new-session'));
+}
+
+describe('watchSchedules', () => {
+    it('starts one catch-up run at start for the due times missed while the server was down', async () => {
+        for (const [now, handled] of [
+            [local(0, 7, 30), local(-1, 7)],
+            [local(3, 9), local(0, 7)]
+        ] as const) {
+            vi.setSystemTime(now);
+            const held = setup();
+            plant(held.record, { handled });
+            publishSessions(held.hub, [], []);
+            watcher(held, DAILY);
+            await settle();
+            const missed = new Date(now);
+            missed.setHours(7, 0, 0, 0);
+            expect(started(held.driver)).toHaveLength(1);
+            expect(runsOf(held.record)).toMatchObject([
+                { trigger: 'catch-up', due: missed.toISOString(), outcome: 'started' }
+            ]);
+            const loaded = loadRecord(held.record);
+            expect(loaded.ok && loaded.logs.litwatch?.handled).toBe(missed.toISOString());
+        }
+    });
+
+    it("starts nothing for a due time while the task's earlier run is working, and records it skipped", async () => {
+        const rows = [
+            ['busy', [{ pid: 4300, liveStatus: 'busy' }]],
+            ['waiting', [{ pid: 4300, liveStatus: 'waiting' }]],
+            ['no session matched', []]
+        ] as const;
+        for (const [name, records] of rows) {
+            const held = setup();
+            plant(held.record, {
+                handled: local(-1, 7),
+                runs: [
+                    {
+                        trigger: 'schedule',
+                        due: local(-1, 7).toISOString(),
+                        at: local(-1, 7).toISOString(),
+                        outcome: 'started',
+                        terminal: EARLIER
+                    }
+                ]
+            });
+            publishSessions(held.hub, [{ id: EARLIER, pid: 4300 }], [...records]);
+            vi.setSystemTime(local(0, 6, 59, 50));
+            watcher(held, DAILY);
+            await vi.advanceTimersByTimeAsync(20_000);
+            expect(started(held.driver), name).toHaveLength(0);
+            expect(
+                held.driver.calls.filter((args) => args[0] === 'kill-session'),
+                name
+            ).toHaveLength(0);
+            expect(runsOf(held.record)[0], name).toMatchObject({
+                trigger: 'schedule',
+                due: local(0, 7).toISOString(),
+                outcome: 'skipped',
+                terminal: EARLIER
+            });
+        }
+    });
+
+    it("ends the terminal of the task's idle earlier run, and then starts the new run", async () => {
+        const held = setup();
+        plant(held.record, {
+            handled: local(-1, 7),
+            runs: [
+                {
+                    trigger: 'schedule',
+                    due: local(-1, 7).toISOString(),
+                    at: local(-1, 7).toISOString(),
+                    outcome: 'started',
