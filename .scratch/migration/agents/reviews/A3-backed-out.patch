+            answer = resolve;
+        });
+        const second = watcher(waiting, DAILY, waiting.hub, () => table);
+        await vi.advanceTimersByTimeAsync(20_000);
+        second.close();
+        answer([]);
+        await vi.advanceTimersByTimeAsync(24 * 3_600_000);
+        expect(vi.getTimerCount()).toBe(0);
+        expect(waiting.driver.calls.filter((args) => args[0] !== 'list-sessions')).toEqual([]);
+        expect(runsOf(waiting.record)).toHaveLength(1);
+
+        vi.setSystemTime(local(0, 6, 59, 50));
+        const unlisted = setup();
+        plant(unlisted.record, {
+            handled: local(-1, 7),
+            runs: [
+                {
+                    trigger: 'schedule',
+                    due: local(-1, 7).toISOString(),
+                    at: local(-1, 7).toISOString(),
+                    outcome: 'started',
+                    terminal: EARLIER
+                }
+            ]
+        });
+        let reads = 0;
+        const third = watcher(unlisted, DAILY, unlisted.hub, () => {
+            reads += 1;
+            return Promise.resolve([]);
+        });
+        await vi.advanceTimersByTimeAsync(20_000);
+        publishSessions(
+            unlisted.hub,
+            [{ id: EARLIER, pid: 4300 }],
+            [{ pid: 4301, liveStatus: 'idle' }]
+        );
+        third.close();
+        await vi.advanceTimersByTimeAsync(24 * 3_600_000);
+        expect(reads).toBe(0);
+        expect(unlisted.driver.calls.filter((args) => args[0] !== 'list-sessions')).toEqual([]);
+        expect(runsOf(unlisted.record)).toHaveLength(1);
+    });
+});
