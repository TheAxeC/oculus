diff --git a/tools/oculus/src/lib/server/machine/tasks/record.ts b/tools/oculus/src/lib/server/machine/tasks/record.ts
new file mode 100644
index 000000000..494d63735
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/tasks/record.ts
@@ -0,0 +1,291 @@
+// Layer 2, server. The run record of the four update tasks: one machine-local file,
+// `~/.oculus/schedule.json`, holding for each task the cron pattern it was last read with, since
+// when, the newest due time handled, and its latest runs, each a scheduled, catch-up or hand run
+// that started, was skipped or failed. A key of the file that is no update task is kept by every
+// write and is not shown.
+//
+// The file is read through readJsonChecked and written whole by a rename, then read back, as
+// commands/saved.ts does: a missing file is made by the first write, and a file that does not read
+// (not JSON, or not this shape) is never written over, so what the reader put there stays and no
+// scheduled run starts while it does not read. Every change takes `schedule.json.lock` first (a
+// file opened with `wx`), reads the file again under it and writes once, so two oculus servers
+// that share one home start one run per due time. A lock older than a minute is taken over with one
+// stderr line, and a younger one is waited on for a short while.
+
+import { closeSync, mkdirSync, openSync, readFileSync, statSync, unlinkSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { z } from 'zod';
+import type { ScheduleRun } from '../../../data/model/index.ts';
+import { UPDATE_TASKS, type UpdateTask } from '../../../data/helpers/run/tasks.ts';
+import { readJsonChecked, writeTextAtomic } from '../../core/json.ts';
+
+/** The mode of the file: it names the runs of this machine. */
+const FILE_MODE = 0o600;
+
+/** How many runs the record keeps for each task, the oldest dropped by the next one. */
+const RUNS_KEPT = 20;
+
+/** The age at which a lock file is taken to be left by a process that is gone. */
+const STALE_LOCK_MS = 60_000;
+
+/** The wait between two tries of a lock another process holds, and the longest total wait. */
+const LOCK_RETRY_MS = 50;
+const LOCK_WAIT_MS = 2000;
+
+/** How a run was started. */
+export type RunTrigger = ScheduleRun['trigger'];
+
+/** One task's entry of the record. */
+export type TaskLog = {
+    /** The cron pattern the entry was last read with, empty for a task with no schedule. */
+    pattern: string;
+    /** When that pattern was first read: no due time before it is caught up. */
+    since: string;
+    /** The newest due time a run was decided for, or null while none was. */
+    handled: string | null;
+    /** The latest runs, newest first. */
+    runs: ScheduleRun[];
+};
+
+/** The entries the record holds, by task. */
+type TaskLogs = Partial<Record<UpdateTask, TaskLog>>;
+
+/** The record as the file holds it: the entries, and the whole map whose other keys are kept. */
+export type Loaded =
+    { ok: true; whole: Record<string, unknown>; logs: TaskLogs } | { ok: false; reason: string };
+
+/** ~/.oculus/schedule.json, resolved at the call rather than at import. */
+export function defaultRecordPath(): string {
+    return join(homedir(), '.oculus', 'schedule.json');
+}
+
+const runShape = z.object({
+    trigger: z.enum(['schedule', 'catch-up', 'hand']),
+    due: z.string().nullable(),
+    at: z.string(),
+    outcome: z.enum(['started', 'skipped', 'failed']),
+    terminal: z.string().nullable()
+}) satisfies z.ZodType<ScheduleRun>;
+
+const logShape = z.object({
+    pattern: z.string(),
+    since: z.string(),
+    handled: z.string().nullable(),
+    runs: z.array(runShape)
+}) satisfies z.ZodType<TaskLog>;
+
+const wholeShape = z.record(z.string(), z.unknown());
+
+/** The file as it stands: empty when it is not there, and the reason when it does not read. */
+export function loadRecord(file: string): Loaded {
+    const read = readJsonChecked(file);
+    if (!read.ok) return { ok: false, reason: read.reason };
+    if (read.value === undefined) return { ok: true, whole: {}, logs: {} };
+    const whole = wholeShape.safeParse(read.value);
+    if (!whole.success) return { ok: false, reason: 'is not a map' };
+    const logs: TaskLogs = {};
+    for (const task of UPDATE_TASKS) {
+        if (!Object.hasOwn(whole.data, task)) continue;
+        const log = logShape.safeParse(whole.data[task]);
+        if (!log.success) return { ok: false, reason: `holds a ${task} entry of the wrong shape` };
+        logs[task] = log.data;
+    }
+    return { ok: true, whole: whole.data, logs };
+}
+
+/** Why a change did not happen. */
+type Refused = { ok: false; why: 'unread' | 'locked' | 'unwritable'; reason: string };
+
+/** What a change answers: the value its work gave, or why it did not run. */
+export type Outcome<T> = { ok: true; value: T } | Refused;
+
+/** What the work of a change answers: its value, and whether the entries are to be written. */
+type Change<T> = { value: T; write: boolean };
+
+function pause(ms: number): Promise<void> {
+    return new Promise((resolve) => {
+        setTimeout(resolve, ms).unref();
+    });
+}
+
+/**
+ * Take the lock file, waiting for a younger one and taking over one older than STALE_LOCK_MS. A
+ * folder the lock cannot be made in is a write that cannot happen, not a lock that is held.
+ */
+async function takeLock(lock: string): Promise<{ ok: true } | Refused> {
+    for (let waited = 0; waited <= LOCK_WAIT_MS; waited += LOCK_RETRY_MS) {
+        try {
+            closeSync(openSync(lock, 'wx'));
+            return { ok: true };
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code !== 'EEXIST') {
+                return { ok: false, why: 'unwritable', reason: String(error) };
+            }
+        }
+        let age: number;
+        try {
+            age = Date.now() - statSync(lock).mtimeMs;
+        } catch {
+            continue;
+        }
+        if (age > STALE_LOCK_MS) {
+            console.error(`schedule record: took over ${lock}, which was ${age} ms old`);
+            try {
+                unlinkSync(lock);
+            } catch {
+                // another process took it over first
+            }
+            continue;
+        }
+        await pause(LOCK_RETRY_MS);
+    }
+    return { ok: false, why: 'locked', reason: `${lock} stays taken` };
+}
+
+/** Remove the lock file this process took. */
+function dropLock(lock: string): void {
+    try {
+        unlinkSync(lock);
+    } catch {
+        // the lock is gone already
+    }
+}
+
+/**
+ * Read the record under its lock, let `work` change the entries it is handed, and write them back
+ * whole when `work` says to, keeping every other key of the file. A file that does not read is not
+ * written over, a lock that stays taken is not waited on for ever, and a write that does not read
+ * back as written is refused.
+ */
+async function change<T>(
+    file: string,
+    work: (logs: TaskLogs, now: Date) => Change<T>
+): Promise<Outcome<T>> {
+    const lock = `${file}.lock`;
+    try {
+        mkdirSync(dirname(file), { recursive: true });
+    } catch (error) {
+        return { ok: false, why: 'unwritable', reason: String(error) };
+    }
+    const taken = await takeLock(lock);
+    if (!taken.ok) return taken;
+    try {
+        const loaded = loadRecord(file);
+        if (!loaded.ok) return { ok: false, why: 'unread', reason: loaded.reason };
+        const done = work(loaded.logs, new Date());
+        if (!done.write) return { ok: true, value: done.value };
+        const content = `${JSON.stringify({ ...loaded.whole, ...loaded.logs }, null, 4)}\n`;
+        try {
+            writeTextAtomic(file, content, FILE_MODE);
+            if (readFileSync(file, 'utf8') !== content) {
+                throw new Error('what was read back is not what was written');
+            }
+        } catch (error) {
+            const reason = error instanceof Error ? error.message : String(error);
+            return { ok: false, why: 'unwritable', reason };
+        }
+        return { ok: true, value: done.value };
+    } finally {
+        dropLock(lock);
+    }
+}
+
+/** The runs of a task with `run` newest, the oldest dropped past RUNS_KEPT. */
+function withRun(runs: ScheduleRun[], run: ScheduleRun): ScheduleRun[] {
+    return [run, ...runs].slice(0, RUNS_KEPT);
+}
+
+/**
+ * Read a task's pattern: when it differs from the one the entry holds (or the entry is not there
+ * and the pattern is not empty), the entry is written again with `since` now and no due time
+ * handled, so writing or changing a pattern never catches up a due time from before it. A task
+ * with no pattern and no entry writes nothing.
+ */
+export function readPattern(
+    file: string,
+    task: UpdateTask,
+    pattern: string
+): Promise<Outcome<TaskLog | undefined>> {
+    return change(file, (logs, now) => {
+        const held = logs[task];
+        if (held === undefined && pattern === '') return { value: undefined, write: false };
+        if (held?.pattern === pattern) return { value: held, write: false };
+        const next: TaskLog = {
+            pattern,
+            since: now.toISOString(),
+            handled: null,
+            runs: held?.runs ?? []
+        };
+        logs[task] = next;
+        return { value: next, write: true };
+    });
+}
+
+/**
+ * Decide a due time once: when `run.due` is later than the newest due time handled, it becomes the
+ * handled one and `run` is kept, and the answer is `claimed`; otherwise nothing is written and the
+ * answer is `handled`.
+ */
+export function claimDue(
+    file: string,
+    task: UpdateTask,
+    pattern: string,
+    run: ScheduleRun
+): Promise<Outcome<'claimed' | 'handled'>> {
+    return change(file, (logs) => {
+        const held = logs[task] ?? { pattern, since: run.at, handled: null, runs: [] };
+        const due = Date.parse(run.due ?? '');
+        if (held.handled !== null && Date.parse(held.handled) >= due) {
+            return { value: 'handled' as const, write: false };
+        }
+        logs[task] = { ...held, handled: run.due, runs: withRun(held.runs, run) };
+        return { value: 'claimed' as const, write: true };
+    });
+}
+
+/** Keep a run that was not decided for a due time, such as a press by hand. */
+export function appendRun(
+    file: string,
+    task: UpdateTask,
+    run: ScheduleRun
+): Promise<Outcome<true>> {
+    return change(file, (logs, now) => {
+        const held = logs[task] ?? {
+            pattern: '',
+            since: now.toISOString(),
+            handled: null,
+            runs: []
+        };
+        logs[task] = { ...held, runs: withRun(held.runs, run) };
+        return { value: true as const, write: true };
+    });
+}
+
+/** What a started run learns once its terminal is there, or that it failed. */
+export type Settle = { terminal: string } | { failed: true };
+
+/** Settle the run a claim kept for `trigger` and `due`. */
+export function settleRun(
+    file: string,
+    task: UpdateTask,
+    key: { trigger: RunTrigger; due: string | null },
+    settle: Settle
+): Promise<Outcome<boolean>> {
+    return change(file, (logs) => {
+        const held = logs[task];
+        const at = held?.runs.findIndex(
+            (one) => one.trigger === key.trigger && one.due === key.due
+        );
+        if (held === undefined || at === undefined || at < 0) {
+            return { value: false, write: false };
+        }
+        const runs = [...held.runs];
+        runs[at] =
+            'terminal' in settle
+                ? { ...runs[at], terminal: settle.terminal }
+                : { ...runs[at], outcome: 'failed' };
+        logs[task] = { ...held, runs };
+        return { value: true, write: true };
+    });
+}
