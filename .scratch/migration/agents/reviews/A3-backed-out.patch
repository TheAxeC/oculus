+++ b/tools/oculus/src/lib/state/system/machine/schedule.svelte.ts
@@ -0,0 +1,95 @@
+// Layer 2, client state. The update tray's reader of the single `schedule` entity: for each update
+// task the words of its next run and its latest runs, each with the terminal it started when the
+// page still holds that terminal. The tray draws these rows and never reads the payload itself.
+
+import { z } from 'zod';
+import { UPDATE_TASKS, type UpdateTask } from '../../../data/helpers/run/tasks.ts';
+import type { Terminal } from '../../../data/model/index.ts';
+import { stamp } from '../../shared/words/format.ts';
+import { t } from '../../shared/words/text.ts';
+import type { EntitiesStore } from '../../shared/stores/shapes.ts';
+
+/** How many of a task's latest runs the tray lists. */
+const RUNS_SHOWN = 5;
+
+/** One entry of the payload, as the page reads it. */
+const entryShape = z.object({
+    kind: z.enum(UPDATE_TASKS),
+    pattern: z.string(),
+    next: z.string().nullable(),
+    runs: z.array(
+        z.object({
+            trigger: z.enum(['schedule', 'catch-up', 'hand']),
+            at: z.string(),
+            outcome: z.enum(['started', 'skipped', 'failed']),
+            terminal: z.string().nullable()
+        })
+    )
+});
+
+/** One run of a task as a row shows it. */
+type ScheduleRunRow = {
+    /** A key no other row of the task has: the run's time with its place in the list. */
+    key: string;
+    /** When the run was decided, as a row shows a time. */
+    at: string;
+    trigger: string;
+    outcome: string;
+    /** The terminal the run started or found going, while the page still lists it. */
+    terminal: Terminal | null;
+};
+
+/** One task's schedule as the tray draws it. */
+type ScheduleTask = {
+    /** `Next: <time>` while the task has a pattern, and `No schedule` otherwise. */
+    next: string;
+    /** The latest runs, newest first. */
+    runs: ScheduleRunRow[];
+};
+
+/** One client's reader of the schedule. */
+export type ScheduleStore = {
+    /** One task's schedule, or null before the first payload arrives. */
+    task: (kind: UpdateTask) => ScheduleTask | null;
+    /** The sentence the payload carries while the run record does not read, or ''. */
+    error: () => string;
+};
+
+export function createSchedule(
+    entities: EntitiesStore,
+    terminalById: (id: string | null) => Terminal | null
+): ScheduleStore {
+    const triggers = {
+        schedule: () => t('app.tasks.trigger_schedule'),
+        'catch-up': () => t('app.tasks.trigger_catch_up'),
+        hand: () => t('app.tasks.trigger_hand')
+    };
+    const outcomes = {
+        started: () => t('app.tasks.outcome_started'),
+        skipped: () => t('app.tasks.outcome_skipped'),
+        failed: () => t('app.tasks.outcome_failed')
+    };
+
+    return {
+        task(kind) {
+            const payload = entities.schedule();
+            if (payload === null) return null;
+            const entry = payload.tasks
+                .map((one) => entryShape.safeParse(one))
+                .find((read) => read.success && read.data.kind === kind);
+            if (entry?.success !== true) return null;
+            const { next, runs } = entry.data;
+            return {
+                next: next === null ? t('app.tasks.no_schedule') : t('app.tasks.next', stamp(next)),
+                runs: runs.slice(0, RUNS_SHOWN).map((run, at) => ({
+                    key: `${run.at}-${at}`,
+                    at: stamp(run.at),
+                    trigger: triggers[run.trigger](),
+                    outcome: outcomes[run.outcome](),
+                    terminal: terminalById(run.terminal)
+                }))
+            };
+        },
+        error: () => entities.schedule()?.error ?? ''
+    };
+}
