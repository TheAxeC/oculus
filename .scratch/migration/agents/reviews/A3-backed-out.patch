new file mode 100644
index 000000000..e5172abbe
--- /dev/null
+++ b/tools/oculus/src/lib/server/machine/tasks/schedule.ts
@@ -0,0 +1,504 @@
+// Layer 2, server. The schedule of the four update tasks. Each task whose `tasks.<task>.schedule`
+// holds a cron pattern has one croner job, in the local time zone; at each due time the task starts
+// as the tray's press starts it (tasks/start.ts), unless its earlier run is still working. The
+// watcher publishes one complete payload on the `schedule` channel after every change of a job, of
+// the run record or of the record file.
+//
+// A due time is decided once. The run record (tasks/record.ts) keeps the newest due time handled
+// per task, and a decision writes it under the record's lock before anything starts, so a due time
+// that was handled never starts again, after a restart or from a second oculus server over the same
+// home. A due time missed while the server was down starts one catch-up run at the next start; the
+// ones before it start nothing. A pattern first read, or changed, never catches up a due time from
+// before it was read. Croner's timer skips a due time that falls in the hour the clocks skip, and
+// the watcher also looks for a due time every half minute, so that run starts at the first look
+// after its moved due time (03:30 for a 02:30) instead of waiting for the next day, and never
+// before that time.
+//
+// One run of a task works at a time. The task's earlier run is the terminal of the newest run in
+// the record that has one. It is working while that terminal is listed on the `sessions` channel
+// and the Claude session in it is not idle: the session is the registry record whose pid is the
+// terminal's pane pid or a process under it. A working earlier run makes the due time start nothing
+// and be recorded as skipped. An idle one is ended, oculus having started that terminal itself, and
+// the new run starts. A decision waits for the first `sessions` payload that lists terminals, so a
+// terminal that outlived a restart of the server is seen. A due time that arrives while a decision
+// waits is not decided on its own: the newest one replaces the waiting due time, so the payload's
+// arrival starts one run for the latest due time. Only a due time that arrives after the claim is
+// written and while the start is awaited is recorded as skipped.
+
+import { mkdirSync, watch, type FSWatcher } from 'node:fs';
+import { basename, dirname } from 'node:path';
+import { Cron } from 'croner';
+import { z } from 'zod';
+import { UPDATE_TASKS, type UpdateTask } from '../../../data/helpers/run/tasks.ts';
+import type { SchedulePayload, ScheduleRun } from '../../../data/model/index.ts';
+import type { Hub, Sink } from '../../core/channels.ts';
+import { words } from '../../core/words.ts';
+import type { Entry } from '../processes/table.ts';
+import { claimDue, loadRecord, readPattern, type RunTrigger, type TaskLog } from './record.ts';
+import type { TaskStart } from './start.ts';
+
+/** The channel the payload is published on. */
+const CHANNEL = 'schedule';
+
+/** Milliseconds between two checks for a due time croner's timer did not wake for. */
+const CHECK_MS = 30_000;
+
+/** What the watcher needs of the world beyond the hub. */
+export type SchedulesOptions = {
+    /** The run record's file. */
+    record: string;
+    /** The pattern of each task as the configuration reads it, '' for none. */
+    schedules: Record<UpdateTask, string>;
+    /** The text catalog the record's sentence is worded from. */
+    text: Record<string, string>;
+    /** Start one update task for a decided due time. */
+    start: (kind: UpdateTask, run: { trigger: RunTrigger; due: string }) => Promise<TaskStart>;
+    /** End a terminal oculus started. */
+    stop: (terminal: string) => Promise<void>;
+    /** The machine's process table, read when a terminal's session is not found by its pane pid. */
+    table: () => Promise<Entry[]>;
+};
+
+export type SchedulesWatcher = {
+    /** Take the patterns of a configuration push: a changed pattern replaces that task's job. */
+    set(schedules: Record<UpdateTask, string>): void;
+    /** Take the text catalog the next payload is worded from. */
+    setText(text: Record<string, string>): void;
+    /** Stop every job. Nothing starts and nothing is published after it. */
+    close(): void;
+};
+
+/** The parts of the `sessions` payload this module reads. */
+const sessionsShape = z.object({
+    records: z.array(z.object({ pid: z.number().nullable(), liveStatus: z.string().nullable() })),
+    terminals: z.array(z.object({ id: z.string(), pid: z.number() })).optional()
+});
+
+/**
+ * How many due times before a moment `dueAt` looks through: the due times of a minute pattern that
+ * croner moves out of an hour the clocks skip, one per minute of that hour, can all lie after it.
+ */
+const LOOKBACK = 61;
+
+/** The span `walkedDueAt` first walks over, in milliseconds, and the factor it widens by. */
+const WALK_FIRST_MS = 90_000;
+const WALK_GROWTH = 4;
+/** The longest span `walkedDueAt` walks over: a 29 February pattern that also names a weekday. */
+const WALK_LAST_MS = 30 * 366 * 86_400_000;
+
+/**
+ * The newest due time of a job at or before `now` found by walking croner's forward runs from a
+ * moment before `now`, the span widening until a run falls inside it, or undefined when it has
+ * none.
+ */
+function walkedDueAt(job: Cron, now: Date): Date | undefined {
+    const end = now.getTime();
+    for (let span = WALK_FIRST_MS; ; span *= WALK_GROWTH) {
+        const first = job.nextRun(new Date(end - span));
+        if (first !== null && first.getTime() <= end) return lastRunUpTo(job, first, end);
+        if (span > WALK_LAST_MS) return undefined;
+    }
+}
+
+/**
+ * The last run of a job at or before `end`, from `run`, a run at or before it. No run lies after
+ * `upper` and at or before `end`; each turn either moves to a run past the middle of what is left
+ * or halves it, so a pattern that runs every minute of a month takes a few dozen of croner's
+ * forward walks, never one per run.
+ */
+function lastRunUpTo(job: Cron, run: Date, end: number): Date {
+    let latest = run;
+    let upper = end;
+    for (;;) {
+        const after = job.nextRun(latest);
+        if (after === null || after.getTime() > end) return latest;
+        latest = after;
+        const middle = Math.floor((latest.getTime() + upper) / 2);
+        if (middle <= latest.getTime()) continue;
+        const probe = job.nextRun(new Date(middle));
+        if (probe !== null && probe.getTime() <= end) latest = probe;
+        else upper = middle;
+    }
+}
+
+/**
+ * The newest due time of a job at or before `now`, or undefined when it has none. Croner answers
+ * "before" in whole seconds, so a `now` inside the second of a due time still sees the one before
+ * it; asking from the start of the next second gives the due time that second holds. On the day
+ * the clocks skip an hour croner answers the due times inside that hour, moved after it (a 02:30
+ * as 03:30), from the start of the hour, so a due time later than `now` is passed over. Croner's
+ * backward walk throws for some patterns the value rule accepts (`0 0 29 2 *`, `0 7 29 2 *`,
+ * `0 0 30 1-2 *`); the due time of such a job is found by `walkedDueAt`. A pattern croner cannot
+ * walk either way has no due time and is worded once, so a failure of croner never stops the
+ * server.
+ */
+function dueAt(job: Cron, now: Date, unreadable: Set<string>): Date | undefined {
+    try {
+        try {
+            const ask = new Date(Math.floor(now.getTime() / 1000) * 1000 + 1000);
+            return job.previousRuns(LOOKBACK, ask).find((due) => due.getTime() <= now.getTime());
+        } catch {
+            return walkedDueAt(job, now);
+        }
+    } catch (error) {
+        const pattern = job.getPattern() ?? '';
+        if (!unreadable.has(pattern)) {
+            unreadable.add(pattern);
+            const reason = error instanceof Error ? error.message : String(error);
+            console.error(
+                `schedule: the due time of the pattern ${pattern} was not found: ${reason}`
+            );
+        }
+        return undefined;
+    }
+}
+
+/** Whether the process `pid` is `root` or has it among its ancestors in the table. */
+function under(table: Entry[], root: number, pid: number): boolean {
+    const parents = new Map(table.map((entry) => [entry.pid, entry.ppid]));
+    for (let at: number | undefined = pid, steps = 0; at !== undefined; steps += 1) {
+        if (at === root) return true;
+        if (steps > table.length) return false;
+        at = parents.get(at);
+    }
+    return false;
+}
+
+export function watchSchedules(hub: Hub, options: SchedulesOptions): SchedulesWatcher {
+    let text = options.text;
+    let closed = false;
+    /** Read through a call, so a check before an await never stands in for the one after it. */
+    const stopped = (): boolean => closed;
+    const patterns: Record<UpdateTask, string> = {
+        litwatch: '',
+        scout: '',
+        linkedin: '',
+        inbox: ''
+    };
+    const jobs: Partial<Record<UpdateTask, Cron | undefined>> = {};
+    /** The newest due time of each job a decision was made for or that was taken as past. */
+    const seen: Partial<Record<UpdateTask, number>> = {};
+    /** The patterns whose due time could not be found at all, each worded once. */
+    const unreadable = new Set<string>();
+    /** The tasks with a decision or a start in progress. */
+    const deciding = new Set<UpdateTask>();
+    /** The tasks whose claim is written and whose start is awaited; a due time then is skipped. */
+    const starting = new Set<UpdateTask>();
+    /**
+     * The newest due time that arrived while the task's decision had not written its claim, which
+     * the decision takes in place of its own, or a later decision takes if this one starts nothing.
+     */
+    const pending = new Map<UpdateTask, { trigger: RunTrigger; due: Date; pattern: string }>();
+    let lastPublished = '';
+    let unreadSaid = false;
+
+    // ---- the payload -----------------------------------------------------------------------
+
+    const payload = (): SchedulePayload => {
+        const loaded = loadRecord(options.record);
+        if (!loaded.ok && !unreadSaid) {
+            unreadSaid = true;
+            console.error(
+                `schedule record: ${options.record} ${loaded.reason}; no scheduled run starts while it does not read`
+            );
+        }
+        if (loaded.ok) unreadSaid = false;
+        const logs = loaded.ok ? loaded.logs : {};
+        return {
+            tasks: UPDATE_TASKS.map((kind) => ({
+                kind,
+                pattern: patterns[kind],
+                next: jobs[kind]?.nextRun()?.toISOString() ?? null,
+                runs: logs[kind]?.runs ?? []
+            })),
+            ...(loaded.ok ? {} : { error: words(text, 'app.tasks.record_unread') })
+        };
+    };
+
+    /** Publish the payload when it differs from the last one published. */
+    const publish = (): void => {
+        if (stopped()) return;
+        const next = payload();
+        const encoded = JSON.stringify(next);
+        if (encoded === lastPublished) return;
+        lastPublished = encoded;
+        hub.publish(CHANNEL, next);
+    };
+
+    // ---- the sessions payload ----------------------------------------------------------------
+
+    const sessionsNow = (): z.infer<typeof sessionsShape> | null => {
+        const parsed = sessionsShape.safeParse(hub.latest('sessions')?.payload);
+        return parsed.success && parsed.data.terminals !== undefined ? parsed.data : null;
+    };
+
+    let stopWaiting = (): void => undefined;
+    /** Settles once a `sessions` payload that lists terminals has been published. */
+    const sessionsReady = new Promise<void>((resolve) => {
+        if (sessionsNow() !== null) {
+            resolve();
+            return;
+        }
+        const waiting: Sink = {
+            send() {
+                if (sessionsNow() !== null) {
+                    hub.remove(waiting);
+                    resolve();
+                }
+                return Promise.resolve();
+            },
+            close() {
+                // The hub never closes a sink it did not open; there is no socket behind this one.
+            }
+        };
+        hub.subscribe(waiting, ['sessions'], false);
+        stopWaiting = () => hub.remove(waiting);
+    });
+
+    /**
+     * What the task's earlier run is doing now: `gone` when it has no terminal or that terminal is
+     * not listed, `idle` or `working` when it is listed.
+     */
+    const earlierRun = async (
+        log: TaskLog | undefined
+    ): Promise<{ state: 'gone' } | { state: 'idle' | 'working'; terminal: string }> => {
+        const terminalId = log?.runs.find((run) => run.terminal !== null)?.terminal ?? null;
+        const sessions = sessionsNow();
+        if (terminalId === null || sessions === null) return { state: 'gone' };
+        const listed = sessions.terminals?.find((one) => one.id === terminalId);
+        if (listed === undefined) return { state: 'gone' };
+        let session = sessions.records.find((one) => one.pid === listed.pid);
+        if (session === undefined) {
+            const table = await options.table().catch(() => []);
+            session = sessions.records.find(
+                (one) => one.pid !== null && under(table, listed.pid, one.pid)
+            );
+        }
+        const idle = session?.liveStatus === 'idle';
+        return { state: idle ? 'idle' : 'working', terminal: terminalId };
+    };
+
+    // ---- one due time ------------------------------------------------------------------------
+
+    /** A run as the claim keeps it before the start answers. */
+    const runFor = (
+        trigger: RunTrigger,
+        due: Date,
+        outcome: ScheduleRun['outcome'],
+        terminal: string | null
+    ): ScheduleRun => ({
+        trigger,
+        due: due.toISOString(),
+        at: new Date().toISOString(),
+        outcome,
+        terminal
+    });
+
+    /** Record a due time that arrived while the task's own start was awaited as skipped (I2). */
+    const skipWhileStarting = async (
+        kind: UpdateTask,
+        trigger: RunTrigger,
+        due: Date
+    ): Promise<void> => {
+        const claimed = await claimDue(
+            options.record,
+            kind,
+            patterns[kind],
+            runFor(trigger, due, 'skipped', null)
+        );
+        if (!claimed.ok) console.error(`schedule: ${kind} ${due.toISOString()}: ${claimed.reason}`);
+        publish();
+    };
+
+    /**
+     * Decide one due time of a task: claim it and start the run, or claim it as skipped while the
+     * task's earlier run is working. A due time that arrives while an earlier decision of the task
+     * has not written its claim (it waits for the first `sessions` payload, or reads the earlier
+     * run) is held, and the newest one is decided in place of the older. A pattern changed or
+     * emptied while the decision waits ends it; a held due time of the old pattern is dropped, and
+     * one of the new pattern is decided next.
+     */
+    const decide = async (kind: UpdateTask, trigger: RunTrigger, due: Date): Promise<void> => {
+        if (stopped()) return;
+        const pattern = patterns[kind];
+        if (deciding.has(kind)) {
+            if (starting.has(kind)) {
+                await skipWhileStarting(kind, trigger, due);
+                return;
+            }
+            const held = pending.get(kind);
+            if (held?.pattern !== pattern || due.getTime() > held.due.getTime()) {
+                pending.set(kind, { trigger, due, pattern });
+            }
+            return;
+        }
+        deciding.add(kind);
+        try {
+            await sessionsReady;
+            if (stopped()) return;
+            const loaded = loadRecord(options.record);
+            if (!loaded.ok) {
+                publish();
+                return;
+            }
+            const earlier = await earlierRun(loaded.logs[kind]);
+            if (stopped()) return;
+            if (patterns[kind] !== pattern) {
+                if (pending.get(kind)?.pattern !== patterns[kind]) pending.delete(kind);
+                return;
+            }
+            const working = earlier.state === 'working' ? earlier : null;
+            const newest = pending.get(kind);
+            if (newest !== undefined) {
+                pending.delete(kind);
+                trigger = newest.trigger;
+                due = newest.due;
+            }
+            const claimed = await claimDue(
+                options.record,
+                kind,
+                pattern,
+                runFor(
+                    trigger,
+                    due,
+                    working === null ? 'started' : 'skipped',
+                    working?.terminal ?? null
+                )
+            );
+            if (!claimed.ok) {
+                console.error(`schedule: ${kind} ${due.toISOString()}: ${claimed.reason}`);
+                return;
+            }
+            publish();
+            if (claimed.value === 'handled' || working !== null) return;
+            if (stopped()) return;
+            starting.add(kind);
+            const late = pending.get(kind);
+            if (late !== undefined) {
+                pending.delete(kind);
+                void skipWhileStarting(kind, late.trigger, late.due);
+            }
+            if (earlier.state === 'idle') {
+                await options.stop(earlier.terminal).catch((error: unknown) => {
+                    const reason = error instanceof Error ? error.message : String(error);
+                    console.error(
+                        `schedule: ${kind}: the earlier terminal was not ended: ${reason}`
+                    );
+                });
+                if (stopped()) return;
+            }
+            await options.start(kind, { trigger, due: due.toISOString() });
+        } catch (error) {
+            const reason = error instanceof Error ? error.message : String(error);
+            console.error(
+                `schedule: ${kind} ${due.toISOString()}: the run did not start: ${reason}`
+            );
+        } finally {
+            deciding.delete(kind);
+            starting.delete(kind);
+            publish();
+            const next = pending.get(kind);
+            if (next !== undefined) {
+                pending.delete(kind);
+                if (!stopped()) void decide(kind, next.trigger, next.due);
+            }
+        }
+    };
+
+    // ---- one task's job ----------------------------------------------------------------------
+
+    /**
+     * Decide the newest due time of a task's job that no decision has seen yet. Croner's timer
+     * calls it at a due time, and the check below calls it every half minute, because croner's
+     * timer skips a due time inside a daylight saving gap (a daily 02:30 on the day the clocks
+     * jump from 02:00 to 03:00) while its pattern still answers 03:30 for that day; a due time
+     * seen by one path is not decided again by the other.
+     */
+    const consider = (kind: UpdateTask): void => {
+        const job = jobs[kind];
+        if (stopped() || job === undefined) return;
+        const due = dueAt(job, new Date(), unreadable);
+        if (due !== undefined && due.getTime() > (seen[kind] ?? 0)) {
+            seen[kind] = due.getTime();
+            void decide(kind, 'schedule', due);
+        }
+        publish();
+    };
+
+    /** Take a task's pattern: replace its job, keep the record's entry and catch up one run. */
+    const apply = async (kind: UpdateTask, pattern: string): Promise<void> => {
+        jobs[kind]?.stop();
+        jobs[kind] = undefined;
+        patterns[kind] = pattern;
+        let job: Cron | undefined;
+        if (pattern !== '') {
+            try {
+                job = new Cron(pattern, { mode: '5-part' }, () => consider(kind));
+                jobs[kind] = job;
+                seen[kind] = Date.now();
+            } catch (error) {
+                const reason = error instanceof Error ? error.message : String(error);
+                console.error(`schedule: ${kind}: the pattern ${pattern} was not read: ${reason}`);
+            }
+        }
+        publish();
+        const read = await readPattern(options.record, kind, job === undefined ? '' : pattern);
+        if (stopped() || jobs[kind] !== job) return;
+        publish();
+        if (!read.ok || read.value === undefined || job === undefined) return;
+        const missed = dueAt(job, new Date(), unreadable);
+        const after = Math.max(
+            read.value.handled === null ? 0 : Date.parse(read.value.handled),
+            Date.parse(read.value.since)
+        );
+        if (missed !== undefined && missed.getTime() > after) {
+            seen[kind] = Math.max(seen[kind] ?? 0, missed.getTime());
+            await decide(kind, 'catch-up', missed);
+        }
+    };
+
+    // ---- the record file ---------------------------------------------------------------------
+
+    // A press, a run the schedule settles and a second server all write the file; the folder is
+    // watched so every one of them reaches the page. The file is replaced by a rename, so the
+    // folder is the thing to watch.
+    let folder: FSWatcher | null = null;
+    try {
+        const name = basename(options.record);
+        mkdirSync(dirname(options.record), { recursive: true });
+        folder = watch(dirname(options.record), { persistent: false }, (_event, file) => {
+            if (file === null || file === name) publish();
+        });
+        folder.on('error', () => undefined);
+    } catch {
+        folder = null;
+    }
+
+    const check = setInterval(() => {
+        for (const kind of UPDATE_TASKS) consider(kind);
+    }, CHECK_MS);
+    check.unref();
+
+    for (const kind of UPDATE_TASKS) void apply(kind, options.schedules[kind]);
+    publish();
+
+    return {
+        set(schedules): void {
+            if (stopped()) return;
+            for (const kind of UPDATE_TASKS) {
+                if (schedules[kind] !== patterns[kind]) void apply(kind, schedules[kind]);
+            }
+        },
+        setText(next): void {
+            text = next;
+            publish();
+        },
+        close(): void {
+            closed = true;
+            for (const kind of UPDATE_TASKS) jobs[kind]?.stop();
+            stopWaiting();
+            clearInterval(check);
+            folder?.close();
+        }
+    };
+}
