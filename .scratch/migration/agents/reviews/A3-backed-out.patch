@@ -0,0 +1,111 @@
+// Layer 2, server. Start one of the four update tasks. The tray's press reaches it through the
+// terminal endpoint (pty/routes.ts) and the schedule (tasks/schedule.ts) calls it at a due time, so
+// both start the same ordinary interactive Claude session in the hub root and keep the same record.
+//
+// The task is `<claude> '/research-cockpit <kind>'`: the skill invocation is the session's first
+// message, passed as the positional argument, so every permission prompt the CLI raises is
+// answered in the terminal pane by the reader. `tasks.skip_permissions` puts
+// `--dangerously-skip-permissions` back, which runs the task unattended instead.
+
+import type { ScheduleRun, Terminal, TerminalRefusal } from '../../../data/model/index.ts';
+import type { UpdateTask } from '../../../data/helpers/run/tasks.ts';
+import { shellWord } from '../pty/shell-word.ts';
+import { startTerminal, type StartOptions } from '../pty/sessions.ts';
+import { TerminalRefused } from '../pty/refusal.ts';
+import { appendRun, settleRun, type RunTrigger } from './record.ts';
+
+/** What starts an update task, beyond the tmux options of every terminal start. */
+export type TaskStartOptions = StartOptions & {
+    /** The hub root the session starts in. */
+    hub: string;
+    /** The `claude` program, as `claude_bin` of the machine's configuration names it. */
+    claudeBin: string;
+    /** Whether the session carries `--dangerously-skip-permissions`. */
+    skipPermissions: boolean;
+    /** The terminal's grid: the page's size for a press, a fixed one for a scheduled run. */
+    size: { cols: unknown; rows: unknown };
+    /** The run record's file; absent, the run is started and nothing is recorded. */
+    record?: string;
+};
+
+/** The terminal a start made, or the word it was refused with. */
+export type TaskStart = { terminal: Terminal } | { refused: TerminalRefusal };
+
+/** The grid of a scheduled run, which no page is sized for. */
+export const SCHEDULED_SIZE = { cols: 80, rows: 24 };
+
+/**
+ * The server-built shell command for one update task: the skill invocation as the session's first
+ * message, with the flag that turns the prompts off only when the configuration says so.
+ */
+function taskCommand(binary: string, kind: UpdateTask, skip: boolean): string {
+    const argv = [binary];
+    if (skip) argv.push('--dangerously-skip-permissions');
+    argv.push(`/research-cockpit ${kind}`);
+    return argv.map(shellWord).join(' ');
+}
+
+/** Say why the record could not take a run, which never stops the run itself. */
+function unrecorded(reason: string): void {
+    console.error(`schedule record: a run was not recorded: ${reason}`);
+}
+
+/**
+ * Keep the outcome of a run. A press is a new entry; a scheduled or catch-up run settles the entry
+ * the schedule claimed for its due time.
+ */
+async function keep(
+    options: TaskStartOptions,
+    kind: UpdateTask,
+    run: { trigger: RunTrigger; due: string | null },
+    outcome: { terminal: string } | { failed: true }
+): Promise<void> {
+    if (options.record === undefined) return;
+    if (run.trigger === 'hand') {
+        const entry: ScheduleRun = {
+            trigger: 'hand',
+            due: null,
+            at: new Date().toISOString(),
+            outcome: 'terminal' in outcome ? 'started' : 'failed',
+            terminal: 'terminal' in outcome ? outcome.terminal : null
+        };
+        const kept = await appendRun(options.record, kind, entry);
+        if (!kept.ok) unrecorded(kept.reason);
+        return;
+    }
+    const kept = await settleRun(options.record, kind, run, outcome);
+    if (!kept.ok) unrecorded(kept.reason);
+}
+
+/**
+ * Start one update task as a Claude terminal in the hub root, and record the run. A refusal that
+ * names its cause comes back as its word; any other failure is recorded as a failed run and thrown
+ * for the caller to answer.
+ */
+export async function startUpdateTask(
+    kind: UpdateTask,
+    run: { trigger: RunTrigger; due: string | null },
+    options: TaskStartOptions
+): Promise<TaskStart> {
+    try {
+        const terminal = await startTerminal(
+            {
+                kind: 'claude',
+                cwd: options.hub,
+                cols: options.size.cols,
+                rows: options.size.rows,
+                name: `task ${kind}`
+            },
+            {
+                ...options,
+                command: taskCommand(options.claudeBin, kind, options.skipPermissions)
+            }
+        );
+        await keep(options, kind, run, { terminal: terminal.id });
+        return { terminal };
+    } catch (error) {
+        await keep(options, kind, run, { failed: true });
+        if (error instanceof TerminalRefused) return { refused: error.word };
+        throw error;
+    }
+}
