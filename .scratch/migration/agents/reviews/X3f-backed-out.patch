+<script lang="ts">
+    // Layer 3, shared view support. The controls of a file tab, which the tab hands up to the
+    // pane's tab strip to draw at its end through ui/tabs/tab-actions.svelte.ts: Save and Revert
+    // while the text may be written, the star, Open in a browser tab, the program button, Open
+    // Source, and the toggles for the rendered half and for Blame. Every file tab (the source,
+    // file, document, doc and Markdown preview views) draws this one component, so the order and
+    // the look are the same on all of them. Each view decides which controls its tab offers and
+    // what each does; this draws them in the strip's Toolbar.
+    //
+    // A control is drawn when its prop says so: Save and Revert with `editing`, the star with
+    // `bookmarkable`, Open in a browser tab with `onoutside`, the program button with `program`,
+    // Open Source with `onsource`, the rendered-half toggle with `previewable` and Blame with
+    // `blameable`. The star is `BookmarkStar.svelte`, so a reader bookmarks the file in front of
+    // them whichever tab is showing it. The program button, `ProgramButton.svelte`, is drawn for a
+    // file whose extension `open.program_ext` names an application for, such as a `.rtf` whose
+    // bytes are text. The rendered half of a Markdown file is off until turned on.
+
+    import Chip from '$lib/ui/controls/Chip.svelte';
+    import ToolButton from '$lib/ui/controls/ToolButton.svelte';
+    import Toolbar from '$lib/ui/frame/toolbar/Toolbar.svelte';
+    import { t } from '$lib/state/shared/words/text';
+    import BookmarkStar from './BookmarkStar.svelte';
+    import ProgramButton from './ProgramButton.svelte';
+
+    type Props = {
+        root: string;
+        path: string;
+        /** Whether the text may be written, which is when Save and Revert are drawn. */
+        editing?: boolean;
+        /** Whether the file can be bookmarked: it is a served file and not one read at HEAD. */
+        bookmarkable?: boolean;
+        /** Open the file's address in a browser tab; the control is drawn when this is given. */
+        onoutside?: () => void;
+        /** Whether an application is configured for the file, so Open in Program is drawn. */
+        program?: boolean;
+        /** Open the file in the source tab; the control is drawn when this is given. */
+        onsource?: () => void;
+        /** Whether the editor has a rendered half to toggle, and whether it is shown. */
+        previewable?: boolean;
+        rendered?: boolean;
+        /** Whether the file is in a repository, and whether Blame is on. */
+        blameable?: boolean;
+        blamed?: boolean;
+        onsave?: () => void;
+        onrevert?: () => void;
+        onpreview?: () => void;
+        onblame?: () => void;
+        /** What a refused bookmark write or open said. */
+        onsaid: (words: string) => void;
+    };
+
+    let {
+        root,
+        path,
+        editing = false,
+        bookmarkable = false,
+        onoutside,
+        program = false,
+        onsource,
+        previewable = false,
+        rendered = false,
+        blameable = false,
+        blamed = false,
+        onsave,
+        onrevert,
+        onpreview,
+        onblame,
+        onsaid
+    }: Props = $props();
+</script>
+
+<Toolbar label={t('file.toolbar')} overflow>
+    {#if editing}
+        <ToolButton bare label={t('editor.save')} glyph="check" onclick={() => onsave?.()} />
+        <ToolButton
+            bare
+            label={t('editor.revert')}
+            glyph={t('editor.revert_glyph')}
+            onclick={() => onrevert?.()}
+        />
+    {/if}
+    {#if bookmarkable}
+        <BookmarkStar bare {root} {path} {onsaid} />
+    {/if}
+    {#if onoutside !== undefined}
+        <ToolButton
+            bare
+            label={t('file.open_outside')}
+            glyph={t('file.open_outside_glyph')}
+            onclick={onoutside}
+        />
+    {/if}
+    {#if program}
+        <ProgramButton bare {root} {path} {onsaid} />
+    {/if}
+    {#if onsource !== undefined}
+        <ToolButton
+            bare
+            label={t('file.open_source')}
+            glyph={t('file.open_source_glyph')}
+            onclick={onsource}
+        />
+    {/if}
+    {#if previewable}
+        <Chip
+            label={t('source.preview')}
+            title={t('source.preview_title')}
+            glyph={t('source.preview_glyph')}
+            pressed={rendered}
