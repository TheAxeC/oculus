@@ -0,0 +1,29 @@
+// Layer 3, shared view partial. The formulas of a card's Markdown field: a hub writes math in its
+// files as LaTeX between dollars, so a field that holds a dollar asks for KaTeX
+// (`loadMarkdownMath`), and every field drawn with `inlineMarkdown(text, cardMath(text))` is drawn
+// again with its formulas typeset once the modules are in. A field with no dollar loads nothing.
+
+import type { MathDrawing } from '$lib/ui/html';
+import { t } from '$lib/state/shared/words/text';
+import { MATH_OPTIONS, holdsMath, loadMarkdownMath } from './math.ts';
+
+/** The drawing every card shares, null until the modules have loaded. */
+let drawing = $state.raw<MathDrawing | null>(null);
+/** Whether a load is on its way, so a hundred cards ask once. */
+let asked = false;
+
+/** How a field's formulas are drawn: the shared drawing once loaded, null before it. */
+export function cardMath(text: string): MathDrawing | null {
+    if (drawing === null && !asked && holdsMath(text)) {
+        asked = true;
+        loadMarkdownMath().then(
+            (modules) => {
+                drawing = { modules, options: MATH_OPTIONS, refused: t('notes.math_refused') };
+            },
+            () => {
+                asked = false;
+            }
+        );
+    }
+    return drawing;
+}
