+    return value
+        .split(' ')
+        .map((token) => {
+            const end = /^([es],)?(.*?)(!?)$/.exec(token) ?? ['', '', token, ''];
+            const numbers = end[2].split(',').map(Number);
+            const shifted = numbers.map((one, at) => (one + (at % 2 === 0 ? dx : dy)).toFixed(2));
+            return `${end[1] ?? ''}${shifted.join(',')}${end[3]}`;
+        })
+        .join(' ');
