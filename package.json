{
    "name": "oculus",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "main": "src/desktop/main.ts",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run --tagsFilter '!slow' --exclude 'tests/checks/**'",
        "test:checks": "vitest run tests/checks --testTimeout 0 --hookTimeout 0",
        "test:quick": "node tests/tiers/quick.mjs",
        "test:landing": "node tests/tiers/landing.mjs",
        "test:warm": "svelte-kit sync && { svelte-check --incremental --tsconfig ./tsconfig.json > /dev/null & eslint . --cache --cache-location node_modules/.cache/eslint/ > /dev/null & prettier --check --cache . > /dev/null & wait; } && { node tests/tiers/quick.mjs > /dev/null || true; }",
        "test:slow": "vitest run --tagsFilter slow --exclude 'tests/checks/**' --testTimeout 20000",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "diagrams": "node utils/diagrams/diagrams.mjs",
        "app": "electron .",
        "app:package": "node src/desktop/package.ts"
    },
    "devDependencies": {
        "@electron/packager": "20.3.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/culori": "^4.0.1",
        "@types/d3-force": "3.0.10",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.13.4",
        "@types/ws": "^8.18.1",
        "electron": "44.5.1",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "jscpd": "^5.3.3",
        "knip": "6.39.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.6.0",
        "svelte-eslint-parser": "^1.8.1",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.8"
    },
