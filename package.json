        "@types/node": "^24.13.4",
        "@types/ws": "^8.18.1",
        "@viz-js/viz": "3.30.0",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.6.0",
        "svelte-eslint-parser": "^1.8.1",
        "typescript": "^6.0.3",
