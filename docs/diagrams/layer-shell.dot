digraph layer_shell {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_shell" {
        label="shell"; style=solid;
        "folder shell" [label="shell"];
        "folder shell/rail" [label="shell/rail"];
        "folder shell/status" [label="shell/status"];
        "folder shell/panes" [label="shell/panes"];
        "folder shell/keys" [label="shell/keys"];
    }
    "layer state" [label="state", style=dashed];
    "layer ui" [label="ui", style=dashed];
    "folder shell" -> "folder shell/rail" [style=invis, weight=10];
    "folder shell/rail" -> "folder shell/status" [style=invis, weight=10];
    "folder shell/status" -> "folder shell/panes" [style=invis, weight=10];
    "folder shell/panes" -> "folder shell/keys" [style=invis, weight=10];
    "folder shell" -> "folder shell/keys" [label="2"];
    "folder shell" -> "folder shell/panes" [label="6"];
    "folder shell" -> "folder shell/rail" [label="2"];
    "folder shell" -> "folder shell/status" [label="1"];
    "folder shell" -> "layer state" [label="6", style=dashed, constraint=false];
    "folder shell" -> "layer ui" [label="2", style=dashed, constraint=false];
    "folder shell/keys" -> "layer state" [label="8", style=dashed, constraint=false];
    "folder shell/keys" -> "layer ui" [label="2", style=dashed, constraint=false];
    "folder shell/panes" -> "layer state" [label="21", style=dashed, constraint=false];
    "folder shell/panes" -> "layer ui" [label="9", style=dashed, constraint=false];
    "folder shell/rail" -> "layer state" [label="16", style=dashed, constraint=false];
    "folder shell/rail" -> "layer ui" [label="10", style=dashed, constraint=false];
    "folder shell/status" -> "layer state" [label="17", style=dashed, constraint=false];
    "folder shell/status" -> "layer ui" [label="16", style=dashed, constraint=false];
}
