digraph layer_shell {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_shell" {
        label="shell"; style=solid;
        "folder shell" [label="shell"];
        "folder shell/rail" [label="shell/rail"];
        "folder shell/status" [label="shell/status"];
        "folder shell/panes" [label="shell/panes"];
        "folder shell/keys" [label="shell/keys"];
    }
    "layer state" [label="state", style=dashed];
    "layer ui" [label="ui", style=dashed];
    "folder shell" -> "folder shell/rail" [style=invis, weight=10];
    "folder shell/rail" -> "folder shell/status" [style=invis, weight=10];
    "folder shell/status" -> "folder shell/panes" [style=invis, weight=10];
    "folder shell/panes" -> "folder shell/keys" [style=invis, weight=10];
    "folder shell to folder shell/keys" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to folder shell/keys" [arrowhead=none];
    "folder shell to folder shell/keys" -> "folder shell/keys" [];
    "folder shell to folder shell/panes" [label="6", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to folder shell/panes" [arrowhead=none];
    "folder shell to folder shell/panes" -> "folder shell/panes" [];
    "folder shell to folder shell/rail" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to folder shell/rail" [arrowhead=none];
    "folder shell to folder shell/rail" -> "folder shell/rail" [];
    "folder shell to folder shell/status" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to folder shell/status" [arrowhead=none];
    "folder shell to folder shell/status" -> "folder shell/status" [];
    "folder shell to layer state" [label="6", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder shell to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder shell to layer ui" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell" -> "folder shell to layer ui" [arrowhead=none, style=dashed, constraint=false];
    "folder shell to layer ui" -> "layer ui" [style=dashed, constraint=false];
    "folder shell/keys to layer state" [label="8", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/keys" -> "folder shell/keys to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/keys to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder shell/keys to layer ui" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/keys" -> "folder shell/keys to layer ui" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/keys to layer ui" -> "layer ui" [style=dashed, constraint=false];
    "folder shell/panes to layer state" [label="21", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/panes" -> "folder shell/panes to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/panes to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder shell/panes to layer ui" [label="9", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/panes" -> "folder shell/panes to layer ui" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/panes to layer ui" -> "layer ui" [style=dashed, constraint=false];
    "folder shell/rail to layer state" [label="16", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/rail" -> "folder shell/rail to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/rail to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder shell/rail to layer ui" [label="10", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/rail" -> "folder shell/rail to layer ui" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/rail to layer ui" -> "layer ui" [style=dashed, constraint=false];
    "folder shell/status to layer state" [label="17", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/status" -> "folder shell/status to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/status to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder shell/status to layer ui" [label="16", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder shell/status" -> "folder shell/status to layer ui" [arrowhead=none, style=dashed, constraint=false];
    "folder shell/status to layer ui" -> "layer ui" [style=dashed, constraint=false];
}
