digraph layer_ui {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_ui" {
        label="ui"; style=solid;
        "folder ui/tabs" [label="ui/tabs"];
        "folder ui/tree" [label="ui/tree"];
        "folder ui/forms" [label="ui/forms"];
        "folder ui/controls" [label="ui/controls"];
        "folder ui/menu" [label="ui/menu"];
        "folder ui/frame" [label="ui/frame"];
        "folder ui/display" [label="ui/display"];
        "folder ui" [label="ui"];
    }
    "layer state" [label="state", style=dashed];
    "layer themes" [label="themes", style=dashed];
    "folder ui/tabs" -> "folder ui/tree" [style=invis, weight=10];
    "folder ui/tree" -> "folder ui/forms" [style=invis, weight=10];
    "folder ui/forms" -> "folder ui/controls" [style=invis, weight=10];
    "folder ui/controls" -> "folder ui/menu" [style=invis, weight=10];
    "folder ui/menu" -> "folder ui/frame" [style=invis, weight=10];
    "folder ui/frame" -> "folder ui/display" [style=invis, weight=10];
    "folder ui/display" -> "folder ui" [style=invis, weight=10];
    "folder ui to layer themes" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui" -> "folder ui to layer themes" [arrowhead=none, style=dashed, constraint=false];
    "folder ui to layer themes" -> "layer themes" [style=dashed, constraint=false];
    "folder ui/controls to folder ui" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/controls" -> "folder ui/controls to folder ui" [arrowhead=none];
    "folder ui/controls to folder ui" -> "folder ui" [];
    "folder ui/controls to folder ui/display" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/controls" -> "folder ui/controls to folder ui/display" [arrowhead=none];
    "folder ui/controls to folder ui/display" -> "folder ui/display" [];
    "folder ui/controls to folder ui/menu" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/controls" -> "folder ui/controls to folder ui/menu" [arrowhead=none];
    "folder ui/controls to folder ui/menu" -> "folder ui/menu" [];
    "folder ui/controls to layer state" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/controls" -> "folder ui/controls to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder ui/controls to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder ui/display to folder ui" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/display" -> "folder ui/display to folder ui" [arrowhead=none];
    "folder ui/display to folder ui" -> "folder ui" [];
    "folder ui/display to layer state" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/display" -> "folder ui/display to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder ui/display to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder ui/forms to folder ui/controls" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/forms" -> "folder ui/forms to folder ui/controls" [arrowhead=none];
    "folder ui/forms to folder ui/controls" -> "folder ui/controls" [];
    "folder ui/frame to folder ui" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/frame" -> "folder ui/frame to folder ui" [arrowhead=none];
    "folder ui/frame to folder ui" -> "folder ui" [];
    "folder ui/frame to folder ui/display" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/frame" -> "folder ui/frame to folder ui/display" [arrowhead=none];
    "folder ui/frame to folder ui/display" -> "folder ui/display" [];
    "folder ui/frame to layer state" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/frame" -> "folder ui/frame to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder ui/frame to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder ui/menu to folder ui/display" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/menu" -> "folder ui/menu to folder ui/display" [arrowhead=none];
    "folder ui/menu to folder ui/display" -> "folder ui/display" [];
    "folder ui/menu to folder ui/frame" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/menu" -> "folder ui/menu to folder ui/frame" [arrowhead=none];
    "folder ui/menu to folder ui/frame" -> "folder ui/frame" [];
    "folder ui/menu to layer state" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/menu" -> "folder ui/menu to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder ui/menu to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder ui/tabs to folder ui/controls" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/controls" [arrowhead=none];
    "folder ui/tabs to folder ui/controls" -> "folder ui/controls" [];
    "folder ui/tabs to folder ui/display" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/display" [arrowhead=none];
    "folder ui/tabs to folder ui/display" -> "folder ui/display" [];
    "folder ui/tabs to folder ui/menu" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/menu" [arrowhead=none];
    "folder ui/tabs to folder ui/menu" -> "folder ui/menu" [];
    "folder ui/tabs to folder ui/tree" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/tree" [arrowhead=none];
    "folder ui/tabs to folder ui/tree" -> "folder ui/tree" [];
    "folder ui/tabs to layer state" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tabs" -> "folder ui/tabs to layer state" [arrowhead=none, style=dashed, constraint=false];
    "folder ui/tabs to layer state" -> "layer state" [style=dashed, constraint=false];
    "folder ui/tree to folder ui/display" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tree" -> "folder ui/tree to folder ui/display" [arrowhead=none];
    "folder ui/tree to folder ui/display" -> "folder ui/display" [];
    "folder ui/tree to folder ui/menu" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder ui/tree" -> "folder ui/tree to folder ui/menu" [arrowhead=none];
    "folder ui/tree to folder ui/menu" -> "folder ui/menu" [];
}
