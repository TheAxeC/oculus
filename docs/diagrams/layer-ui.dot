digraph layer_ui {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, mclimit=4, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_ui" {
        label="ui"; style=solid;
        "folder ui/tabs" [label="ui/tabs"];
        "folder ui/tree" [label="ui/tree"];
        "folder ui/forms" [label="ui/forms"];
        "folder ui/controls" [label="ui/controls"];
        "folder ui/menu" [label="ui/menu"];
        "folder ui/frame" [label="ui/frame"];
        "folder ui/display" [label="ui/display"];
        "folder ui" [label="ui"];
        "folder ui/tabs to folder ui/controls" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tabs to folder ui/display" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tabs to folder ui/frame" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tabs to folder ui/menu" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tabs to folder ui/tree" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tabs to layer state" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tree to folder ui/controls" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tree to folder ui/display" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/tree to folder ui/menu" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/forms to folder ui/controls" [label="12", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/forms to folder ui/display" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/forms to folder ui/frame" [label="6", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/controls to folder ui/display" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/controls to folder ui/frame" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/controls to folder ui/menu" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/controls to layer data" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/controls to layer state" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/menu to folder ui/display" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/menu to folder ui/frame" [label="5", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/frame to folder ui" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/frame to folder ui/display" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/frame to layer state" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/display to folder ui" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui/display to layer state" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui to layer data" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder ui to layer themes" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    }
    "layer state from folder ui/tabs" [label="state", style=dashed];
    "layer data from folder ui/controls" [label="data", style=dashed];
    "layer state from folder ui/controls" [label="state", style=dashed];
    "layer state from folder ui/frame" [label="state", style=dashed];
    "layer state from folder ui/display" [label="state", style=dashed];
    "layer data from folder ui" [label="data", style=dashed];
    "layer themes from folder ui" [label="themes", style=dashed];
    "folder ui/tabs" -> "folder ui/tree" [style=invis, weight=10, minlen=2];
    "folder ui/tree" -> "folder ui/forms" [style=invis, weight=10, minlen=2];
    "folder ui/forms" -> "folder ui/controls" [style=invis, weight=10, minlen=2];
    "folder ui/controls" -> "folder ui/menu" [style=invis, weight=10, minlen=3];
    "folder ui/menu" -> "folder ui/frame" [style=invis, weight=10, minlen=2];
    "folder ui/frame" -> "folder ui/display" [style=invis, weight=10, minlen=2];
    "folder ui/display" -> "folder ui" [style=invis, weight=10, minlen=2];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/controls" [arrowhead=none, minlen=3, weight=10];
    "folder ui/tabs to folder ui/controls" -> "folder ui/controls" [];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/display" [arrowhead=none, minlen=5, weight=10];
    "folder ui/tabs to folder ui/display" -> "folder ui/display" [];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/frame" [arrowhead=none, minlen=5, weight=10];
    "folder ui/tabs to folder ui/frame" -> "folder ui/frame" [];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/menu" [arrowhead=none, minlen=3, weight=10];
    "folder ui/tabs to folder ui/menu" -> "folder ui/menu" [];
    "folder ui/tabs" -> "folder ui/tabs to folder ui/tree" [arrowhead=none, minlen=1, weight=10];
    "folder ui/tabs to folder ui/tree" -> "folder ui/tree" [];
    "folder ui/tabs" -> "folder ui/tabs to layer state" [arrowhead=none, style=dashed];
    "folder ui/tabs to layer state" -> "layer state from folder ui/tabs" [style=dashed];
    { rank=same; "folder ui/tabs"; "folder ui/tabs to layer state"; "layer state from folder ui/tabs"; }
    "folder ui/tree" -> "folder ui/tree to folder ui/controls" [arrowhead=none, minlen=1, weight=10];
    "folder ui/tree to folder ui/controls" -> "folder ui/controls" [];
    "folder ui/tree" -> "folder ui/tree to folder ui/display" [arrowhead=none, minlen=6, weight=10];
    "folder ui/tree to folder ui/display" -> "folder ui/display" [];
    "folder ui/tree" -> "folder ui/tree to folder ui/menu" [arrowhead=none, minlen=3, weight=10];
    "folder ui/tree to folder ui/menu" -> "folder ui/menu" [];
    "folder ui/forms" -> "folder ui/forms to folder ui/controls" [arrowhead=none, minlen=1, weight=10];
    "folder ui/forms to folder ui/controls" -> "folder ui/controls" [];
    "folder ui/forms" -> "folder ui/forms to folder ui/display" [arrowhead=none, minlen=4, weight=10];
    "folder ui/forms to folder ui/display" -> "folder ui/display" [];
    "folder ui/forms" -> "folder ui/forms to folder ui/frame" [arrowhead=none, minlen=4, weight=10];
    "folder ui/forms to folder ui/frame" -> "folder ui/frame" [];
    "folder ui/controls" -> "folder ui/controls to folder ui/display" [arrowhead=none, minlen=4, weight=10];
    "folder ui/controls to folder ui/display" -> "folder ui/display" [];
    "folder ui/controls" -> "folder ui/controls to folder ui/frame" [arrowhead=none, minlen=2, weight=10];
    "folder ui/controls to folder ui/frame" -> "folder ui/frame" [];
    "folder ui/controls" -> "folder ui/controls to folder ui/menu" [arrowhead=none, minlen=2, weight=10];
    "folder ui/controls to folder ui/menu" -> "folder ui/menu" [];
    "folder ui/controls" -> "folder ui/controls to layer data" [arrowhead=none, style=dashed];
    "folder ui/controls to layer data" -> "layer data from folder ui/controls" [style=dashed];
    { rank=same; "folder ui/controls"; "folder ui/controls to layer data"; "layer data from folder ui/controls"; }
    "folder ui/controls" -> "folder ui/controls to layer state" [arrowhead=none, style=dashed, minlen=1, weight=10];
    "folder ui/controls to layer state" -> "layer state from folder ui/controls" [style=dashed];
    { rank=same; "folder ui/controls to layer state"; "layer state from folder ui/controls"; }
    "folder ui/menu" -> "folder ui/menu to folder ui/display" [arrowhead=none, minlen=1, weight=10];
    "folder ui/menu to folder ui/display" -> "folder ui/display" [];
    "folder ui/menu" -> "folder ui/menu to folder ui/frame" [arrowhead=none, minlen=1, weight=10];
    "folder ui/menu to folder ui/frame" -> "folder ui/frame" [];
    "folder ui/frame" -> "folder ui/frame to folder ui" [arrowhead=none, minlen=1, weight=10];
    "folder ui/frame to folder ui" -> "folder ui" [];
    "folder ui/frame" -> "folder ui/frame to folder ui/display" [arrowhead=none, minlen=1, weight=10];
    "folder ui/frame to folder ui/display" -> "folder ui/display" [];
    "folder ui/frame" -> "folder ui/frame to layer state" [arrowhead=none, style=dashed];
    "folder ui/frame to layer state" -> "layer state from folder ui/frame" [style=dashed];
    { rank=same; "folder ui/frame"; "folder ui/frame to layer state"; "layer state from folder ui/frame"; }
    "folder ui/display" -> "folder ui/display to folder ui" [arrowhead=none, minlen=1, weight=10];
    "folder ui/display to folder ui" -> "folder ui" [];
    "folder ui/display" -> "folder ui/display to layer state" [arrowhead=none, style=dashed];
    "folder ui/display to layer state" -> "layer state from folder ui/display" [style=dashed];
    { rank=same; "folder ui/display"; "folder ui/display to layer state"; "layer state from folder ui/display"; }
    "folder ui" -> "folder ui to layer data" [arrowhead=none, style=dashed];
    "folder ui to layer data" -> "layer data from folder ui" [style=dashed];
    { rank=same; "folder ui"; "folder ui to layer data"; "layer data from folder ui"; }
    "folder ui" -> "folder ui to layer themes" [arrowhead=none, style=dashed, minlen=1, weight=10];
    "folder ui to layer themes" -> "layer themes from folder ui" [style=dashed];
    { rank=same; "folder ui to layer themes"; "layer themes from folder ui"; }
}
