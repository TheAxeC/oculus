    "folder state/sources to folder state/shared" -> "folder state/shared" [];
    "folder state/sources to layer data" [label="6", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/sources" -> "folder state/sources to layer data" [arrowhead=none, style=dashed, constraint=false];
