digraph layer_state {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_state" {
        label="state"; style=solid;
        "folder state/client" [label="state/client"];
        "folder state/workbench" [label="state/workbench"];
        "folder state/feeds" [label="state/feeds"];
        "folder state/sessions" [label="state/sessions"];
        "folder state/system" [label="state/system"];
        "folder state/boards" [label="state/boards"];
        "folder state/sources" [label="state/sources"];
        "folder state/forms" [label="state/forms"];
        "folder state/words" [label="state/words"];
        "folder state/stores" [label="state/stores"];
    }
    "layer data" [label="data", style=dashed];
    "folder state/client" -> "folder state/workbench" [style=invis, weight=10];
    "folder state/workbench" -> "folder state/feeds" [style=invis, weight=10];
    "folder state/feeds" -> "folder state/sessions" [style=invis, weight=10];
    "folder state/sessions" -> "folder state/system" [style=invis, weight=10];
    "folder state/system" -> "folder state/boards" [style=invis, weight=10];
    "folder state/boards" -> "folder state/sources" [style=invis, weight=10];
    "folder state/sources" -> "folder state/forms" [style=invis, weight=10];
    "folder state/forms" -> "folder state/words" [style=invis, weight=10];
    "folder state/words" -> "folder state/stores" [style=invis, weight=10];
    "folder state/boards" -> "folder state/forms" [label="3"];
    "folder state/boards" -> "folder state/sources" [label="3"];
    "folder state/boards" -> "folder state/words" [label="7"];
    "folder state/boards" -> "layer data" [label="12", style=dashed, constraint=false];
    "folder state/client" -> "folder state/boards" [label="1"];
    "folder state/client" -> "folder state/feeds" [label="5"];
    "folder state/client" -> "folder state/forms" [label="3"];
    "folder state/client" -> "folder state/sessions" [label="5"];
    "folder state/client" -> "folder state/sources" [label="5"];
    "folder state/client" -> "folder state/system" [label="5"];
    "folder state/client" -> "folder state/words" [label="5"];
    "folder state/client" -> "folder state/workbench" [label="14"];
    "folder state/client" -> "layer data" [label="4", style=dashed, constraint=false];
    "folder state/feeds" -> "folder state/boards" [label="3"];
    "folder state/feeds" -> "folder state/words" [label="4"];
    "folder state/feeds" -> "layer data" [label="17", style=dashed, constraint=false];
    "folder state/forms" -> "layer data" [label="1", style=dashed, constraint=false];
    "folder state/sessions" -> "folder state/sources" [label="4"];
    "folder state/sessions" -> "folder state/words" [label="2"];
    "folder state/sessions" -> "layer data" [label="2", style=dashed, constraint=false];
    "folder state/sources" -> "folder state/forms" [label="2"];
    "folder state/sources" -> "folder state/words" [label="4"];
    "folder state/sources" -> "layer data" [label="6", style=dashed, constraint=false];
    "folder state/system" -> "folder state/words" [label="3"];
    "folder state/system" -> "layer data" [label="2", style=dashed, constraint=false];
    "folder state/words" -> "layer data" [label="3", style=dashed, constraint=false];
    "folder state/workbench" -> "folder state/boards" [label="1"];
    "folder state/workbench" -> "folder state/feeds" [label="4"];
    "folder state/workbench" -> "folder state/sessions" [label="1"];
    "folder state/workbench" -> "folder state/sources" [label="1"];
    "folder state/workbench" -> "folder state/words" [label="11"];
    "folder state/workbench" -> "layer data" [label="6", style=dashed, constraint=false];
}
