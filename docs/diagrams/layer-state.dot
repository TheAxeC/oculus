    "folder state/sessions" -> "folder state/sessions to folder state/sources" [arrowhead=none];
    "folder state/sessions to folder state/sources" -> "folder state/sources" [];
    "folder state/sessions to layer data" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/sessions" -> "folder state/sessions to layer data" [arrowhead=none, style=dashed, constraint=false];
    "folder state/sessions to layer data" -> "layer data" [style=dashed, constraint=false];
    "folder state/shared to layer data" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/shared" -> "folder state/shared to layer data" [arrowhead=none, style=dashed, constraint=false];
    "folder state/shared to layer data" -> "layer data" [style=dashed, constraint=false];
