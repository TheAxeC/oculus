    "folder state/client" -> "folder state/client to folder state/system" [arrowhead=none];
    "folder state/client to folder state/system" -> "folder state/system" [];
    "folder state/client to folder state/workbench" [label="14", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/client" -> "folder state/client to folder state/workbench" [arrowhead=none];
