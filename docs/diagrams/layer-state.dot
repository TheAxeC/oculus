digraph layer_state {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_state" {
        label="state"; style=solid;
        "folder state/client" [label="state/client"];
        "folder state/workbench" [label="state/workbench"];
        "folder state/feeds" [label="state/feeds"];
        "folder state/life" [label="state/life"];
        "folder state/sessions" [label="state/sessions"];
        "folder state/system" [label="state/system"];
        "folder state/boards" [label="state/boards"];
        "folder state/sources" [label="state/sources"];
        "folder state/forms" [label="state/forms"];
        "folder state/shared" [label="state/shared"];
    }
    "layer data" [label="data", style=dashed];
    "folder state/client" -> "folder state/workbench" [style=invis, weight=10];
    "folder state/workbench" -> "folder state/feeds" [style=invis, weight=10];
    "folder state/feeds" -> "folder state/life" [style=invis, weight=10];
    "folder state/life" -> "folder state/sessions" [style=invis, weight=10];
    "folder state/sessions" -> "folder state/system" [style=invis, weight=10];
    "folder state/system" -> "folder state/boards" [style=invis, weight=10];
    "folder state/boards" -> "folder state/sources" [style=invis, weight=10];
    "folder state/sources" -> "folder state/forms" [style=invis, weight=10];
    "folder state/forms" -> "folder state/shared" [style=invis, weight=10];
    "folder state/boards to folder state/forms" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/boards" -> "folder state/boards to folder state/forms" [arrowhead=none];
    "folder state/boards to folder state/forms" -> "folder state/forms" [];
    "folder state/boards to folder state/shared" [label="7", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/boards" -> "folder state/boards to folder state/shared" [arrowhead=none];
    "folder state/boards to folder state/shared" -> "folder state/shared" [];
    "folder state/boards to folder state/sources" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/boards" -> "folder state/boards to folder state/sources" [arrowhead=none];
    "folder state/boards to folder state/sources" -> "folder state/sources" [];
    "folder state/boards to layer data" [label="12", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/boards" -> "folder state/boards to layer data" [arrowhead=none, style=dashed, constraint=false];
    "folder state/boards to layer data" -> "layer data" [style=dashed, constraint=false];
    "folder state/client to folder state/boards" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "folder state/client" -> "folder state/client to folder state/boards" [arrowhead=none];
    "folder state/client to folder state/boards" -> "folder state/boards" [];
    "folder state/client to folder state/feeds" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
