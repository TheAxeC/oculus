digraph layer_server {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_server" {
        label="server"; style=solid;
        "folder server/root" [label="server/root"];
        "folder server/git" [label="server/git"];
        "folder server/edit" [label="server/edit"];
        "folder server/machine" [label="server/machine"];
        "folder server/content" [label="server/content"];
        "folder server/files" [label="server/files"];
        "folder server/sessions" [label="server/sessions"];
        "folder server/accounts" [label="server/accounts"];
        "folder server/transcripts" [label="server/transcripts"];
        "folder server/core" [label="server/core"];
    }
    "layer data" [label="data", style=dashed];
    "folder server/root" -> "folder server/git" [style=invis, weight=10];
    "folder server/git" -> "folder server/edit" [style=invis, weight=10];
    "folder server/edit" -> "folder server/machine" [style=invis, weight=10];
    "folder server/machine" -> "folder server/content" [style=invis, weight=10];
    "folder server/content" -> "folder server/files" [style=invis, weight=10];
    "folder server/files" -> "folder server/sessions" [style=invis, weight=10];
    "folder server/sessions" -> "folder server/accounts" [style=invis, weight=10];
    "folder server/accounts" -> "folder server/transcripts" [style=invis, weight=10];
    "folder server/transcripts" -> "folder server/core" [style=invis, weight=10];
    "folder server/accounts" -> "folder server/core" [label="3"];
    "folder server/accounts" -> "layer data" [label="14", style=dashed, constraint=false];
    "folder server/content" -> "folder server/core" [label="5"];
    "folder server/content" -> "folder server/files" [label="2"];
    "folder server/content" -> "layer data" [label="10", style=dashed, constraint=false];
    "folder server/core" -> "layer data" [label="3", style=dashed, constraint=false];
    "folder server/edit" -> "folder server/content" [label="1"];
    "folder server/edit" -> "folder server/core" [label="7"];
    "folder server/edit" -> "folder server/files" [label="2"];
    "folder server/edit" -> "folder server/sessions" [label="3"];
    "folder server/edit" -> "layer data" [label="26", style=dashed, constraint=false];
    "folder server/files" -> "folder server/core" [label="11"];
    "folder server/files" -> "layer data" [label="13", style=dashed, constraint=false];
    "folder server/git" -> "folder server/core" [label="5"];
    "folder server/git" -> "folder server/edit" [label="1"];
    "folder server/git" -> "layer data" [label="8", style=dashed, constraint=false];
    "folder server/machine" -> "folder server/content" [label="1"];
    "folder server/machine" -> "folder server/core" [label="4"];
    "folder server/machine" -> "folder server/files" [label="2"];
    "folder server/machine" -> "folder server/sessions" [label="1"];
    "folder server/machine" -> "folder server/transcripts" [label="3"];
    "folder server/machine" -> "layer data" [label="12", style=dashed, constraint=false];
    "folder server/root" -> "folder server/accounts" [label="4"];
    "folder server/root" -> "folder server/content" [label="5"];
    "folder server/root" -> "folder server/core" [label="7"];
    "folder server/root" -> "folder server/edit" [label="1"];
    "folder server/root" -> "folder server/files" [label="6"];
    "folder server/root" -> "folder server/machine" [label="5"];
    "folder server/root" -> "folder server/sessions" [label="8"];
    "folder server/root" -> "layer data" [label="9", style=dashed, constraint=false];
    "folder server/sessions" -> "folder server/core" [label="12"];
    "folder server/sessions" -> "folder server/transcripts" [label="3"];
    "folder server/sessions" -> "layer data" [label="2", style=dashed, constraint=false];
    "folder server/transcripts" -> "layer data" [label="1", style=dashed, constraint=false];
}
