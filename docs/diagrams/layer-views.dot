    "layer state from folder views/academic" [label="state", style=dashed];
    "layer ui from folder views/academic" [label="ui", style=dashed];
    "layer state from folder views/apps" [label="state", style=dashed];
    "layer ui from folder views/apps" [label="ui", style=dashed];
    "layer data from folder views/boards" [label="data", style=dashed];
