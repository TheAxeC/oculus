    "folder views/boards" -> "folder views/feeds" [style=invis, weight=10, minlen=4];
    "folder views/feeds" -> "folder views/personal" [style=invis, weight=10, minlen=4];
    "folder views/personal" -> "folder views/sessions" [style=invis, weight=10, minlen=3];
    "folder views/sessions" -> "folder views/sources" [style=invis, weight=10, minlen=4];
    "folder views/sources" -> "folder views/structure" [style=invis, weight=10, minlen=4];
    "folder views/structure" -> "folder views/system" [style=invis, weight=10, minlen=4];
    "folder views/system" -> "folder views/shared" [style=invis, weight=10, minlen=3];
    "folder views/academic" -> "folder views/academic to folder views/shared" [arrowhead=none, minlen=16, weight=10];
    "folder views/academic to folder views/shared" -> "folder views/shared" [];
    "folder views/academic" -> "folder views/academic to layer state" [arrowhead=none, style=dashed];
    "folder views/academic to layer state" -> "layer state from folder views/academic" [style=dashed];
    { rank=same; "folder views/academic"; "folder views/academic to layer state"; "layer state from folder views/academic"; }
    "folder views/academic" -> "folder views/academic to layer ui" [arrowhead=none, style=dashed, minlen=1, weight=10];
    "folder views/academic to layer ui" -> "layer ui from folder views/academic" [style=dashed];
    { rank=same; "folder views/academic to layer ui"; "layer ui from folder views/academic"; }
    "folder views/apps" -> "folder views/apps to folder views/shared" [arrowhead=none, minlen=13, weight=10];
    "folder views/apps to folder views/shared" -> "folder views/shared" [];
    "folder views/apps" -> "folder views/apps to layer state" [arrowhead=none, style=dashed];
    "folder views/apps to layer state" -> "layer state from folder views/apps" [style=dashed];
    { rank=same; "folder views/apps"; "folder views/apps to layer state"; "layer state from folder views/apps"; }
    "folder views/apps" -> "folder views/apps to layer ui" [arrowhead=none, style=dashed, minlen=1, weight=10];
    "folder views/apps to layer ui" -> "layer ui from folder views/apps" [style=dashed];
    { rank=same; "folder views/apps to layer ui"; "layer ui from folder views/apps"; }
    "folder views/boards" -> "folder views/boards to folder views/shared" [arrowhead=none, minlen=14, weight=10];
