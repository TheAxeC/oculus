digraph layer_views {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, mclimit=4, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_views" {
        label="views"; style=solid;
        "folder views/academic" [label="views/academic"];
        "folder views/apps" [label="views/apps"];
        "folder views/boards" [label="views/boards"];
        "folder views/feeds" [label="views/feeds"];
        "folder views/personal" [label="views/personal"];
        "folder views/sessions" [label="views/sessions"];
        "folder views/sources" [label="views/sources"];
        "folder views/structure" [label="views/structure"];
        "folder views/system" [label="views/system"];
        "folder views/shared" [label="views/shared"];
        "folder views/academic to folder views/shared" [label="16", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder views/academic to layer state" [label="57", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder views/academic to layer ui" [label="44", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
