    "layer ui from folder views/system" [label="ui", style=dashed];
    "layer state from folder views/shared" [label="state", style=dashed];
    "layer ui from folder views/shared" [label="ui", style=dashed];
    "folder views/academic" -> "folder views/apps" [style=invis, weight=10, minlen=3];
