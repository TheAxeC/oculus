    "folder views/personal to layer ui" -> "layer ui from folder views/personal" [style=dashed];
    { rank=same; "folder views/personal to layer ui"; "layer ui from folder views/personal"; }
    "folder views/sessions" -> "folder views/sessions to folder views/shared" [arrowhead=none, minlen=7, weight=10];
    "folder views/sessions to folder views/shared" -> "folder views/shared" [];
    "folder views/sessions" -> "folder views/sessions to layer data" [arrowhead=none, style=dashed];
    "folder views/sessions to layer data" -> "layer data from folder views/sessions" [style=dashed];
