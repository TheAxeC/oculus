    "folder views/feeds to layer ui" -> "layer ui from folder views/feeds" [style=dashed];
    { rank=same; "folder views/feeds to layer ui"; "layer ui from folder views/feeds"; }
    "folder views/personal" -> "folder views/personal to folder views/shared" [arrowhead=none, minlen=10, weight=10];
    "folder views/personal to folder views/shared" -> "folder views/shared" [];
