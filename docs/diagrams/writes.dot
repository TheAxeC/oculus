        label="routes/api/write"; style=solid;
        "routes/api/write/+server.ts" [label="+server.ts"];
    }
    subgraph "cluster_lost" {
        label="not placed"; style=dashed;
        "? src/lib/server/edit/writes/config/audit-mute.ts:65" [label="src/lib/server/edit/writes/config/audit-mute.ts:65 SIGNATURE.test("];
        "? src/lib/server/files/fs.ts:223" [label="src/lib/server/files/fs.ts:223 rootShape.safeParse("];
    }
