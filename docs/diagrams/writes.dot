digraph writes {
    graph [bgcolor="transparent", rankdir=LR, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_lib/server/core" {
        label="lib/server/core"; style=solid;
        "lib/server/core/auth.ts" [label="auth.ts"];
        "lib/server/core/changes.ts" [label="changes.ts"];
        "lib/server/core/json.ts" [label="json.ts"];
    }
    subgraph "cluster_lib/server/edit" {
        label="lib/server/edit"; style=solid;
        "lib/server/edit/feeds.ts" [label="feeds.ts"];
        "lib/server/edit/writes.ts" [label="writes.ts"];
    }
    subgraph "cluster_lib/server/edit/writes" {
        label="lib/server/edit/writes"; style=solid;
        "lib/server/edit/writes/audit-mute.ts" [label="audit-mute.ts"];
        "lib/server/edit/writes/deck.ts" [label="deck.ts"];
        "lib/server/edit/writes/entries.ts" [label="entries.ts"];
        "lib/server/edit/writes/manifest.ts" [label="manifest.ts"];
        "lib/server/edit/writes/rail.ts" [label="rail.ts"];
        "lib/server/edit/writes/subtasks.ts" [label="subtasks.ts"];
        "lib/server/edit/writes/undo.ts" [label="undo.ts"];
    }
    subgraph "cluster_lib/server/files/fs" {
        label="lib/server/files/fs"; style=solid;
        "lib/server/files/fs/bookmarks.ts" [label="bookmarks.ts"];
    }
    subgraph "cluster_lib/server/sessions" {
        label="lib/server/sessions"; style=solid;
        "lib/server/sessions/overrides.ts" [label="overrides.ts"];
    }
    subgraph "cluster_routes/api/write" {
        label="routes/api/write"; style=solid;
        "routes/api/write/+server.ts" [label="+server.ts"];
    }
    subgraph "cluster_lost" {
        label="not placed"; style=dashed;
        "? src/lib/server/edit/writes/audit-mute.ts:66" [label="src/lib/server/edit/writes/audit-mute.ts:66 SIGNATURE.test("];
    }
    "file on disk" [shape=cylinder];
    "lib/server/core/changes.ts" -> "file on disk" [label="appendFileSync, mkdirSync"];
    "lib/server/core/changes.ts" -> "lib/server/core/json.ts" [tooltip="writeTextAtomic"];
    "lib/server/core/json.ts" -> "file on disk" [label="mkdirSync, renameSync, rmSync"];
    "lib/server/edit/feeds.ts" -> "file on disk" [label="renameSync, writeFileSync"];
    "lib/server/edit/feeds.ts" -> "lib/server/core/changes.ts" [tooltip="plain"];
    "lib/server/edit/feeds.ts" -> "lib/server/edit/writes/entries.ts" [tooltip="saved"];
    "lib/server/edit/writes.ts" -> "lib/server/core/auth.ts" [label="hasToken, sameOrigin", style=dashed];
    "lib/server/edit/writes.ts" -> "lib/server/core/changes.ts" [tooltip="changeAt, defaultChangesPath, logChanges
pathOf"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/feeds.ts" [tooltip="addLead, addLinkedinIdea, deleteFeedEntry
markLinkedinPosted, writeFeedField"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/feeds.ts" [label="isFeedKind", style=dashed];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/audit-mute.ts" [tooltip="writeMute"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/deck.ts" [tooltip="writeDeck"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/entries.ts" [tooltip="createEntry, removeEntry, reorderCollection
writeEntry"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/manifest.ts" [tooltip="createIdea, writeManifest"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/rail.ts" [tooltip="writeRail"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/subtasks.ts" [tooltip="writeHost, writeSubtask, writeSubtaskAdd"];
    "lib/server/edit/writes.ts" -> "lib/server/edit/writes/undo.ts" [tooltip="undoChange"];
    "lib/server/edit/writes.ts" -> "lib/server/files/fs/bookmarks.ts" [tooltip="defaultBookmarksPath"];
    "lib/server/edit/writes.ts" -> "lib/server/sessions/overrides.ts" [tooltip="setHidden, setOverride"];
    "lib/server/edit/writes/audit-mute.ts" -> "? src/lib/server/edit/writes/audit-mute.ts:66" [style=dashed];
    "lib/server/edit/writes/audit-mute.ts" -> "file on disk" [label="writeFileSync"];
    "lib/server/edit/writes/deck.ts" -> "file on disk" [label="writeFileSync"];
    "lib/server/edit/writes/entries.ts" -> "file on disk" [label="writeFileSync"];
    "lib/server/edit/writes/entries.ts" -> "lib/server/core/changes.ts" [tooltip="plain"];
    "lib/server/edit/writes/entries.ts" -> "lib/server/files/fs/bookmarks.ts" [tooltip="ensureBookmarksFile"];
    "lib/server/edit/writes/entries.ts" -> "lib/server/files/fs/bookmarks.ts" [tooltip="BOOKMARKS", style=dotted];
    "lib/server/edit/writes/manifest.ts" -> "file on disk" [label="mkdirSync, writeFileSync"];
    "lib/server/edit/writes/manifest.ts" -> "lib/server/core/changes.ts" [tooltip="plain"];
    "lib/server/edit/writes/rail.ts" -> "file on disk" [label="writeFileSync"];
    "lib/server/edit/writes/subtasks.ts" -> "lib/server/core/changes.ts" [tooltip="plain"];
    "lib/server/edit/writes/subtasks.ts" -> "lib/server/edit/writes/entries.ts" [tooltip="identityOf, readCollection, saved"];
    "lib/server/edit/writes/subtasks.ts" -> "lib/server/edit/writes/manifest.ts" [tooltip="insideHub"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/core/changes.ts" [tooltip="same"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/feeds.ts" [tooltip="deleteFeedEntry, isFeedKind, readFeedFile
restoreFeedEntry, writeFeedField"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/feeds.ts" [tooltip="FEED_RULES", style=dotted];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/writes/deck.ts" [tooltip="deckNow, writeDeck"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/writes/entries.ts" [tooltip="createEntry, entryOf, idOfIdentity
identityOrder, readCollection, removeEntry
reorderCollection, writeEntry"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/writes/manifest.ts" [tooltip="manifestValue, writeManifest"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/writes/rail.ts" [tooltip="railNow, writeRail"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/edit/writes/subtasks.ts" [tooltip="hostStatus, restoreSubtask, subtaskValue
writeHost, writeSubtask, writeSubtaskAdd"];
    "lib/server/edit/writes/undo.ts" -> "lib/server/sessions/overrides.ts" [tooltip="overrides, setHidden, setOverride"];
    "lib/server/files/fs/bookmarks.ts" -> "lib/server/core/json.ts" [tooltip="writeTextAtomic"];
    "lib/server/sessions/overrides.ts" -> "lib/server/core/changes.ts" [tooltip="plain"];
    "lib/server/sessions/overrides.ts" -> "lib/server/core/json.ts" [tooltip="readJson, writeJsonAtomic"];
    "routes/api/write/+server.ts" -> "lib/server/edit/writes.ts" [tooltip="handleWrite, target"];
}
