digraph writes {
    graph [bgcolor="transparent", rankdir=LR, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.8];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_lib/server/core" {
        label="lib/server/core"; style=solid;
        "lib/server/core/auth.ts" [label="auth.ts"];
        "lib/server/core/changes.ts" [label="changes.ts"];
        "lib/server/core/json.ts" [label="json.ts"];
    }
    subgraph "cluster_lib/server/edit" {
