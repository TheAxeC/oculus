        "lib/server/edit/writes/config/config-write.ts" [label="config-write.ts"];
        "lib/server/edit/writes/config/deck.ts" [label="deck.ts"];
        "lib/server/edit/writes/config/rail.ts" [label="rail.ts"];
        "lib/server/edit/writes/config/roots.ts" [label="roots.ts"];
    }
    subgraph "cluster_lib/server/files" {
        label="lib/server/files"; style=solid;
        "lib/server/files/fs.ts" [label="fs.ts"];
        "lib/server/files/roots.ts" [label="roots.ts"];
