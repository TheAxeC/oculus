digraph layer_data {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_data" {
        label="data"; style=solid;
        "folder data" [label="data"];
        "folder data/sources" [label="data/sources"];
        "folder data/snapshot" [label="data/snapshot"];
        "folder data/accounts" [label="data/accounts"];
        "folder data/helpers" [label="data/helpers"];
        "folder data/model" [label="data/model"];
        "folder data to folder data/helpers" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data to folder data/snapshot" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data to folder data/sources" [label="8", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data/sources to folder data/accounts" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data/sources to folder data/helpers" [label="17", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data/sources to folder data/snapshot" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data/snapshot to folder data/helpers" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
        "folder data/accounts to folder data/helpers" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    }
    "folder data" -> "folder data/sources" [style=invis, weight=10, minlen=2];
    "folder data/sources" -> "folder data/snapshot" [style=invis, weight=10, minlen=2];
    "folder data/snapshot" -> "folder data/accounts" [style=invis, weight=10, minlen=2];
    "folder data/accounts" -> "folder data/helpers" [style=invis, weight=10, minlen=2];
    "folder data/helpers" -> "folder data/model" [style=invis, weight=10, minlen=2];
    "folder data" -> "folder data to folder data/helpers" [arrowhead=none, minlen=3, weight=10];
    "folder data to folder data/helpers" -> "folder data/helpers" [];
    "folder data" -> "folder data to folder data/snapshot" [arrowhead=none, minlen=1, weight=10];
    "folder data to folder data/snapshot" -> "folder data/snapshot" [];
    "folder data" -> "folder data to folder data/sources" [arrowhead=none, minlen=1, weight=10];
    "folder data to folder data/sources" -> "folder data/sources" [];
    "folder data/sources" -> "folder data/sources to folder data/accounts" [arrowhead=none, minlen=1, weight=10];
    "folder data/sources to folder data/accounts" -> "folder data/accounts" [];
    "folder data/sources" -> "folder data/sources to folder data/helpers" [arrowhead=none, minlen=3, weight=10];
    "folder data/sources to folder data/helpers" -> "folder data/helpers" [];
    "folder data/sources" -> "folder data/sources to folder data/snapshot" [arrowhead=none, minlen=1, weight=10];
    "folder data/sources to folder data/snapshot" -> "folder data/snapshot" [];
    "folder data/snapshot" -> "folder data/snapshot to folder data/helpers" [arrowhead=none, minlen=1, weight=10];
    "folder data/snapshot to folder data/helpers" -> "folder data/helpers" [];
    "folder data/accounts" -> "folder data/accounts to folder data/helpers" [arrowhead=none, minlen=1, weight=10];
    "folder data/accounts to folder data/helpers" -> "folder data/helpers" [];
}
