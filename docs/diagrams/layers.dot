digraph layers {
    graph [bgcolor="transparent", rankdir=TB, concentrate=true, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    subgraph "cluster_data" {
        label="data"; style=solid;
        "data";
        "data/accounts";
        "data/helpers";
        "data/model";
        "data/snapshot";
        "data/sources";
    }
    subgraph "cluster_server" {
        label="server"; style=solid;
        "server/accounts";
        "server/content";
        "server/core";
        "server/edit";
        "server/files";
        "server/git";
        "server/machine";
        "server/sessions";
        "server/watch";
    }
    subgraph "cluster_server/transcripts" {
        label="server/transcripts"; style=solid;
        "server/transcripts";
    }
    subgraph "cluster_state" {
        label="state"; style=solid;
        "state/boards";
        "state/client";
        "state/feeds";
        "state/forms";
        "state/life";
        "state/sessions";
        "state/sources";
        "state/system";
        "state/words";
        "state/workbench";
    }
    subgraph "cluster_ui" {
        label="ui"; style=solid;
        "ui";
        "ui/controls";
        "ui/display";
        "ui/forms";
        "ui/frame";
        "ui/menu";
        "ui/tabs";
        "ui/tree";
    }
    subgraph "cluster_shell" {
        label="shell"; style=solid;
        "shell";
        "shell/keys";
        "shell/panes";
        "shell/rail";
        "shell/status";
    }
    subgraph "cluster_views" {
        label="views"; style=solid;
        "views";
        "views/academic";
        "views/boards";
        "views/feeds";
        "views/personal";
        "views/sessions";
        "views/shared";
        "views/sources";
        "views/structure";
        "views/system";
    }
    subgraph "cluster_themes" {
        label="themes"; style=solid;
        "themes";
    }
    subgraph "cluster_routes" {
        label="routes"; style=solid;
        "routes";
        "routes/api/(accounts)";
        "routes/api/(docs)";
        "routes/api/(files)";
        "routes/api/(git)";
        "routes/api/(machine)";
        "routes/api/(sessions)";
        "routes/api/write";
    }
    subgraph "cluster_src" {
        label="src"; style=solid;
        "src";
    }
    subgraph "cluster_not placed" {
        label="not placed"; style=dashed;
        "assets";
        "highlight-languages.d.ts";
        "? src/server.ts:40" [label="src/server.ts:40 import(built)"];
    }
    "data" -> "data/helpers";
    "data" -> "data/model";
    "data" -> "data/snapshot";
    "data" -> "data/sources";
    "data/accounts" -> "data/helpers";
    "data/accounts" -> "data/model";
    "data/helpers" -> "data";
    "data/snapshot" -> "data";
    "data/snapshot" -> "data/helpers";
    "data/sources" -> "data";
    "data/sources" -> "data/accounts";
    "data/sources" -> "data/helpers";
    "data/sources" -> "data/snapshot";
    "routes" -> "assets";
    "routes" -> "data/snapshot";
    "routes" -> "data/sources";
    "routes" -> "shell";
    "routes" -> "shell/rail";
    "routes" -> "state/client";
    "routes" -> "state/sources";
    "routes" -> "state/words";
    "routes" -> "state/workbench";
    "routes" -> "themes";
