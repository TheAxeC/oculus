digraph layers {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    "data";
    "server";
    "state";
    "ui";
    "shell";
    "views";
    "themes";
    "routes";
    "src" [label="entry"];
    "files: assets" [label="assets"];
    "routes to data" [label="12", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to data" [arrowhead=none];
    "routes to data" -> "data" [];
    "routes to files: assets" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to files: assets" [arrowhead=none];
    "routes to files: assets" -> "files: assets" [];
    "routes to server" [label="60", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to server" [arrowhead=none];
    "routes to server" -> "server" [];
    "routes to shell" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to shell" [arrowhead=none];
    "routes to shell" -> "shell" [];
    "routes to state" [label="14", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to state" [arrowhead=none];
    "routes to state" -> "state" [];
    "routes to themes" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to themes" [arrowhead=none];
    "routes to themes" -> "themes" [];
    "routes to ui" [label="2", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to ui" [arrowhead=none];
    "routes to ui" -> "ui" [];
    "routes to views" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "routes" -> "routes to views" [arrowhead=none];
    "routes to views" -> "views" [];
    "server to data" [label="151", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "server" -> "server to data" [arrowhead=none];
    "server to data" -> "data" [];
    "shell to data" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "shell" -> "shell to data" [arrowhead=none];
    "shell to data" -> "data" [];
    "shell to state" [label="81", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "shell" -> "shell to state" [arrowhead=none];
    "shell to state" -> "state" [];
    "shell to ui" [label="47", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "shell" -> "shell to ui" [arrowhead=none];
    "shell to ui" -> "ui" [];
    "src to data" [label="3", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "src" -> "src to data" [arrowhead=none];
    "src to data" -> "data" [];
    "src to routes" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "src" -> "src to routes" [arrowhead=none];
    "src to routes" -> "routes" [];
    "src to server" [label="8", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "src" -> "src to server" [arrowhead=none];
    "src to server" -> "server" [];
    "state to data" [label="177", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "state" -> "state to data" [arrowhead=none];
    "state to data" -> "data" [];
    "ui to data" [label="1", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "ui" -> "ui to data" [arrowhead=none];
    "ui to data" -> "data" [];
    "ui to state" [label="9", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "ui" -> "ui to state" [arrowhead=none];
    "ui to state" -> "state" [];
    "ui to themes" [label="4", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "ui" -> "ui to themes" [arrowhead=none];
    "ui to themes" -> "themes" [];
    "views to data" [label="15", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "views" -> "views to data" [arrowhead=none];
    "views to data" -> "data" [];
    "views to state" [label="765", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "views" -> "views to state" [arrowhead=none];
    "views to state" -> "state" [];
    "views to ui" [label="685", shape=box, color="transparent", fontsize=8, width=0, height=0, margin="0.04,0.02"];
    "views" -> "views to ui" [arrowhead=none];
    "views to ui" -> "ui" [];
}
