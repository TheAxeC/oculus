digraph layers {
    graph [bgcolor="transparent", rankdir=TB, newrank=true, fontname="Helvetica,Arial,sans-serif", fontsize=12, nodesep=0.2, ranksep=0.5];
    node [shape=box, color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=10, height=0.3, margin="0.12,0.04"];
    edge [color="black", fontcolor="black", fontname="Helvetica,Arial,sans-serif", fontsize=8, arrowsize=0.6];
    "data";
    "server";
    "state";
    "ui";
    "shell";
    "views";
    "themes";
    "routes";
    "src" [label="entry"];
    "? src/server.ts:40" [label="src/server.ts:40 import(built)", style=dashed];
    "routes" -> "data" [label="10"];
    "routes" -> "server" [label="45"];
    "routes" -> "shell" [label="1"];
    "routes" -> "state" [label="12"];
    "routes" -> "themes" [label="2"];
    "routes" -> "ui" [label="1"];
    "routes" -> "views" [label="1"];
    "server" -> "data" [label="98"];
    "shell" -> "state" [label="68"];
    "shell" -> "ui" [label="39"];
    "src" -> "data" [label="3"];
    "src" -> "server" [label="6"];
    "state" -> "data" [label="53"];
    "ui" -> "state" [label="8"];
    "ui" -> "themes" [label="4"];
    "views" -> "state" [label="477"];
    "views" -> "ui" [label="467"];
    "src" -> "? src/server.ts:40" [style=dashed];
}
