{"cocinaVersion":"0.104.1","type":"https://cocina.sul.stanford.edu/models/object","externalIdentifier":"druid:zk881ps0522","label":"A library of human electrocorticographic data and analyses","version":11,"access":{"view":"world","download":"world","controlledDigitalLending":false,"useAndReproductionStatement":"User agrees that, where applicable, content will not be used to identify or to otherwise infringe the privacy or confidentiality rights of individuals. Content distributed via the Stanford Digital Repository may be subject to additional license and use restrictions applied by the depositor.","license":"https://creativecommons.org/licenses/by-sa/4.0/legalcode"},"administrative":{"hasAdminPolicy":"druid:zw306xn5593"},"description":{"title":[{"value":"A library of human electrocorticographic data and analyses"}],"contributor":[{"name":[{"structuredValue":[{"value":"Kai Joshua","type":"forename"},{"value":"Miller","type":"surname"}]}],"type":"person","status":"primary","role":[{"value":"author","code":"aut","uri":"http://id.loc.gov/vocabulary/relators/aut","source":{"code":"marcrelator","uri":"http://id.loc.gov/vocabulary/relators/"}}]}],"event":[{"type":"deposit","date":[{"value":"2019-02-05","type":"publication","encoding":{"code":"edtf"}}]},{"type":"creation","date":[{"value":"2016","type":"creation","encoding":{"code":"edtf"}}]}],"form":[{"structuredValue":[{"value":"Data","type":"type"},{"value":"Documentation","type":"subtype"},{"value":"Code","type":"subtype"}],"type":"resource type","source":{"value":"Stanford self-deposit resource types"}},{"value":"Data sets","type":"genre","uri":"http://id.loc.gov/authorities/genreForms/gf2018026119","source":{"code":"lcgft"}},{"value":"dataset","type":"genre","source":{"code":"local"}},{"value":"computer program","type":"genre","uri":"http://id.loc.gov/vocabulary/marcgt/com","source":{"code":"marcgt"}},{"value":"Dataset","type":"resource type","uri":"http://id.loc.gov/vocabulary/resourceTypes/dat","source":{"uri":"http://id.loc.gov/vocabulary/resourceTypes/"}},{"value":"text","type":"resource type","source":{"value":"MODS resource types"}},{"value":"Dataset","type":"resource type","source":{"value":"DataCite resource types"}}],"note":[{"value":"Electrophysiological data from implanted electrodes in the human brain are rare, and therefore scientific access to it has remained somewhat exclusive. Here we present a freely-available curated library of implanted electrocorticographic (ECoG) data and analyses for 16 benchmark behavioral experiments, with 204 individual datasets  from 34 patients made with the same amplifiers (at the same sampling rate and filter settings). In every case, electrode positions have been carefully registered to brain anatomy. A large set of fully-commented analysis scripts to interpret these data using modern techniques is embedded in the library alongside the data. All data, anatomic correlations, and analysis files (MATLAB code) are in a common, intuitive file structure at https://searchworks.stanford.edu/view/zk881ps0522. The library may be used as course material or serve as a starter package for researchers early in their career or for established groups, to modify the analyses and re-apply them in new settings.","type":"abstract"},{"value":"Miller, Kai Joshua. (2016). A library of human electrocorticographic data and analyses. Stanford Digital Repository. Available at: https://purl.stanford.edu/zk881ps0522","type":"preferred citation"}],"subject":[{"value":"electrocorticography","type":"topic"},{"value":"human","type":"topic"}],"access":{"accessContact":[{"value":"kai.miller@stanford.edu","type":"email","displayLabel":"Contact"}]},"adminMetadata":{"event":[{"type":"creation","date":[{"value":"2016-11-14","encoding":{"code":"edtf"}}]}],"note":[{"value":"Metadata created by user via Stanford self-deposit application","type":"record origin"}]},"purl":"https://purl.stanford.edu/zk881ps0522"},"identification":{"sourceId":"hydrus:object-2105"},"structural"